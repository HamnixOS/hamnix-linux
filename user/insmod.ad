# user/insmod.ad
#
# Hamnix `insmod PATH.ko`. Mirrors Linux's busybox insmod at minimal
# scope: open the file, slurp it into a buffer, hand the buffer +
# size to SYS_INIT_MODULE (175). Exits 0 on success, non-zero on any
# failure (open, oversize, syscall reject).
#
# We do the syscall inline rather than going through user/runtime.S
# because that file is shared with every other user binary and
# already carries a long list of wrappers — adding two more touches
# code that L0/L2 also write to. The asm body just shovels args from
# the spilled SysV stack slots into the syscall registers; the
# enclosing function's epilogue carries %rax (= syscall return) back
# to the caller via the standard ret.

# THE MODULE LOADER ON THIS LINE.
#
# This used to define its own sys_init_module with inline assembly that
# reloaded the arguments from -8(%rbp)/-16(%rbp)/-24(%rbp) -- the native
# backend's frame layout. On the LLVM lane that layout does not exist, so the
# asm read whatever happened to be on the stack and handed the kernel three
# garbage arguments. It also could not link, which is the only reason it was
# noticed rather than shipped.
#
# The runtime provides the entry point instead, and it takes a PATH: Linux's
# finit_module(2) loads from a descriptor, so there is no image buffer and no
# size cap -- the old CAP check ("file exceeds insmod buffer") is gone because
# the limit is gone.
extern def sys_init_module(path: Ptr[char], params: Ptr[char]) -> int32
extern def sys_open(path: Ptr[char]) -> int32
extern def sys_read(fd: int32, buf: Ptr[uint8], count: uint64) -> int64
extern def sys_close(fd: int32) -> int32
extern def sys_write(fd: int32, buf: Ptr[uint8], count: uint64) -> int64


# Static 1 MiB buffer: hello.ko is well under 10 KiB; stock Debian
# 6.12 modules at L40+ push past 100 KiB (raid6_pq.ko is ~150 KiB after
# xz decompression). L59's nf_conntrack.ko lands at 432 KiB — the
# largest distro module to date — so the cap moved from 256 KiB to
# 1 MiB. Bumping this cap is one constant change; the syscall happily
# takes any size the kernel's kmod_linux_load can alloc_pages for.
CAP: uint64 = 1048576
data: Array[1048576, uint8]


def strlen_u8(s: Ptr[uint8]) -> uint64:
    n: uint64 = 0
    while s[n] != 0:
        n = n + 1
    return n


def write_str(fd: int32, s: Ptr[uint8]):
    sys_write(fd, s, strlen_u8(s))


def main(argc: int32, argv: Ptr[uint64]) -> int32:
    if argc < 2:
        write_str(2, "insmod: usage: insmod PATH.ko\n")
        return 1
    path: Ptr[char] = cast[Ptr[char]](argv[1])

    fd: int32 = sys_open(path)
    if fd < 0:
        write_str(2, "insmod: cannot open ")
        write_str(2, cast[Ptr[uint8]](path))
        write_str(2, "\n")
        return 1

    # finit_module(2) loads from the DESCRIPTOR, so there is nothing to read
    # into a buffer and no size limit to hit.
    sys_close(fd)

    rc: int32 = sys_init_module(path, cast[Ptr[char]](""))
    if rc < 0:
        write_str(2, "insmod: init_module failed\n")
        return 1
    return 0

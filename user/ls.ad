# user/ls.ad
#
# Minimal Hamnix `ls`. Two modes:
#
#   ls [path]           — fast path: p9_listdir reads the directory's
#                         NAME\n line stream (the legacy DEV_DIR_FILE
#                         backing) and we dump it straight to stdout.
#                         No per-entry stat, no extra syscalls. The
#                         "default" mode every other caller (du
#                         pre-migration, getdents64, sh's tab-complete)
#                         still relies on.
#
#   ls -l [path]        — F10-6 followup: open the directory, flip its
#                         Chan into Dir-record mode via SYS_CHAN_DIR_MODE
#                         (319), then read Plan-9 Dir records back with
#                         sys_read into a buffer and decode them with
#                         p9_dir_decode_at. Per-entry mode + size + uid
#                         come from the kernel-side stat ladder
#                         (vfs_dir_xform_to_records) — no per-leaf
#                         re-stat from userland. Output format:
#                             <mode-string> <uid> <size>\t<name>
#                         where <mode-string> renders the perm-bits + a
#                         leading 'd' for QTDIR.

extern def sys_write(fd: int32, buf: Ptr[uint8], count: uint64) -> int64
extern def sys_getcwd(buf: Ptr[uint8], count: uint64) -> int64
extern def sys_open(path: Ptr[char]) -> int32
extern def sys_read(fd: int32, buf: Ptr[uint8], count: uint64) -> int64
extern def sys_close(fd: int32) -> int32
extern def sys_stat_p9(path: Ptr[char], buf: Ptr[uint8], nbuf: uint64) -> int64
from lib.p9 import (
    p9_listdir, p9_chan_dir_mode, p9_dir_decode_at, p9_is_dir,
    DIR_CUR_NAME, DIR_CUR_NAME_LEN,
    DIR_CUR_UID, DIR_CUR_UID_LEN,
    DIR_CUR_MODE, DIR_CUR_LENGTH, DIR_CUR_QTYPE,
)
from lib.p9dir import P9_DMDIR
from lib.9p.9p import P9_QTDIR


# LISTBUF — the raw "NAME\n" directory-listing buffer. At 4096 a directory
# whose listing exceeded 4 KiB (~500 short names) was SILENTLY CUT: p9_listdir
# stops when the buffer fills, so `ls` printed a PREFIX of the directory and
# exited 0, and anything piping it (`ls | wc -l`, `ls | grep`) got a confident
# undercount. Same class as the hamsh argv/glob caps fixed 2026-07-28. 64 KiB
# holds ~8000 short names, and a FULL buffer is now reported on stderr with a
# nonzero exit rather than passed off as a complete listing.
LISTBUF:  uint64 = 65536


def strlen_u8(s: Ptr[uint8]) -> uint64:
    n: uint64 = 0
    while s[n] != 0:
        n = n + 1
    return n


def write_str(fd: int32, s: Ptr[uint8]):
    sys_write(fd, s, strlen_u8(s))


def write_dec(fd: int32, v: uint64):
    if v == 0:
        sys_write(fd, "0", 1)
        return
    digits: Array[20, uint8]
    di: uint64 = 0
    while v > 0:
        digits[di] = cast[uint8]((v % 10) + 48)
        v = v / 10
        di = di + 1
    while di > 0:
        di = di - 1
        sys_write(fd, &digits[di], 1)


# BSS scratch buffers — Adder quirks: module-scope BSS only.
ls_buf: Array[65536, uint8]   # LISTBUF
ls_statbuf: Array[560, uint8]     # a full 9P stat record for one operand
ls_modebuf: Array[12, uint8]


def render_mode(qtype: uint8, mode: uint32, out: Ptr[uint8]):
    # Render "drwxr-xr-x" / "-rw-r--r--" / etc. into `out` (10 bytes,
    # NUL-terminated at index 10). Type char + 9 perm chars. Honours the
    # DMDIR bit in `mode` AND the qtype byte — either marks a directory.
    if qtype == P9_QTDIR or (mode & P9_DMDIR) != 0:
        out[0] = 100                                    # 'd'
    else:
        out[0] = 45                                     # '-'
    # 9 perm bits: rwxrwxrwx, mask 0777.
    perms: uint32 = mode & 0x1FF
    bits: Array[9, uint32]
    bits[0] = 0x100
    bits[1] = 0x080
    bits[2] = 0x040
    bits[3] = 0x020
    bits[4] = 0x010
    bits[5] = 0x008
    bits[6] = 0x004
    bits[7] = 0x002
    bits[8] = 0x001
    chars: Array[9, uint8]
    chars[0] = 114                                      # 'r'
    chars[1] = 119                                      # 'w'
    chars[2] = 120                                      # 'x'
    chars[3] = 114
    chars[4] = 119
    chars[5] = 120
    chars[6] = 114
    chars[7] = 119
    chars[8] = 120
    i: uint64 = 0
    while i < 9:
        if (perms & bits[i]) != 0:
            out[1 + i] = chars[i]
        else:
            out[1 + i] = 45                              # '-'
        i = i + 1
    out[10] = 0


def ls_long(target: Ptr[char]) -> int32:
    # F10-6 followup: open the directory, flip into Dir-record mode,
    # read records back via sys_read. The dir-fd's read backing carries
    # the Dir-record buffer (post-transform) so a single sys_read draws
    # all records; we then walk them with p9_dir_decode_at.
    fd: int32 = sys_open(target)
    if fd < 0:
        write_str(2, "ls: open failed: ")
        write_str(2, cast[Ptr[uint8]](target))
        write_str(2, "\n")
        return 1
    if p9_chan_dir_mode(fd, 1, target) != 0:
        # Backing doesn't support Dir-record mode yet. Fall back to the
        # cheap line-stream path (which is the legacy ls behaviour).
        sys_close(fd)
        n_fb: int64 = p9_listdir(target, &ls_buf[0], LISTBUF)
        if n_fb < 0:
            write_str(2, "ls: listdir failed\n")
            return 1
        sys_write(1, &ls_buf[0], cast[uint64](n_fb))
        return 0
    # Drain the Dir-record stream into ls_buf.
    total: uint64 = 0
    while total < LISTBUF:
        slice_ptr: Ptr[uint8] = cast[Ptr[uint8]](
            cast[uint64](&ls_buf[0]) + total)
        n: int64 = sys_read(fd, slice_ptr, LISTBUF - total)
        if n <= 0:
            break
        total = total + cast[uint64](n)
    sys_close(fd)
    # Walk records.
    off: uint64 = 0
    while off < total:
        rl: uint64 = p9_dir_decode_at(&ls_buf[0], off, total)
        if rl == 0:
            break
        render_mode(DIR_CUR_QTYPE, DIR_CUR_MODE,
                    cast[Ptr[uint8]](&ls_modebuf[0]))
        sys_write(1, &ls_modebuf[0], 10)
        sys_write(1, " ", 1)
        if DIR_CUR_UID_LEN > 0:
            sys_write(1, &DIR_CUR_UID[0], DIR_CUR_UID_LEN)
        else:
            sys_write(1, "-", 1)
        sys_write(1, " ", 1)
        write_dec(1, DIR_CUR_LENGTH)
        sys_write(1, "\t", 1)
        sys_write(1, &DIR_CUR_NAME[0], DIR_CUR_NAME_LEN)
        sys_write(1, "\n", 1)
        off = off + rl
    return 0


def ls_one(target: Ptr[char], long_mode: int32) -> int32:
    # A NON-DIRECTORY OPERAND: print the NAME, which is what both POSIX and
    # Plan 9 do, and one long-format line under -l.  Never the contents.
    #
    # The path is OPENED first purely as the existence check -- `ls nosuch`
    # must stay a loud non-zero, and this is the one place left that can tell
    # "a plain file" from "no such path" (p9_is_dir answers 0 for both).
    fd: int32 = sys_open(target)
    if fd < 0:
        write_str(2, "ls: cannot access: ")
        write_str(2, cast[Ptr[uint8]](target))
        write_str(2, "\n")
        return 1
    sys_close(fd)
    if long_mode != 0:
        # Same columns as the directory long listing so the two are readable
        # together: <mode> <uid> <size>\t<name>.  The mode/uid/size come from
        # the 9P stat record rather than from a second, different source.
        n: int64 = sys_stat_p9(target, cast[Ptr[uint8]](&ls_statbuf[0]), 560)
        if n >= 43:
            # THE FULL 9P STAT WIRE LAYOUT, offset by offset, because getting
            # this wrong is silent: a mode read from the wrong place renders a
            # plausible string for EVERY file. Measured when it was wrong --
            # 644, 600, 755 and 444 all printed "-rwxr-xrw-".
            #
            #   0  size[2]      4  dev[4]       9  qid.vers[4]   21 mode[4]
            #   2  type[2]      8  qid.type[1] 13  qid.path[8]   25 atime[4]
            #  29  mtime[4]    33  length[8]   41  name[s]  then uid[s] ...
            #
            # This is the layout lib/p9.ad's p9_is_dir documents (qid.type at
            # 8), NOT the compact record p9_dir_decode_at parses.
            md: uint32 = cast[uint32](ls_statbuf[21]) \
                       | (cast[uint32](ls_statbuf[22]) << 8) \
                       | (cast[uint32](ls_statbuf[23]) << 16) \
                       | (cast[uint32](ls_statbuf[24]) << 24)
            ln: uint64 = 0
            k: uint64 = 0
            while k < 8:
                ln = ln | (cast[uint64](ls_statbuf[33 + k]) << cast[uint64](k * 8))
                k = k + 1
            render_mode(ls_statbuf[8], md, cast[Ptr[uint8]](&ls_modebuf[0]))
            sys_write(1, &ls_modebuf[0], 10)
            sys_write(1, " ", 1)
            # uid is the SECOND variable-length string: name[s] first, so its
            # offset depends on the name's length. Printing "-" instead would
            # have been a second column that never matches the directory
            # listing's, which is the format this is meant to line up with.
            nml: uint64 = cast[uint64](ls_statbuf[41]) \
                        | (cast[uint64](ls_statbuf[42]) << 8)
            uoff: uint64 = 43 + nml
            if uoff + 2 <= cast[uint64](n):
                ul: uint64 = cast[uint64](ls_statbuf[uoff]) \
                           | (cast[uint64](ls_statbuf[uoff + 1]) << 8)
                if ul > 0 and uoff + 2 + ul <= cast[uint64](n):
                    sys_write(1, &ls_statbuf[uoff + 2], ul)
                else:
                    sys_write(1, "-", 1)
            else:
                sys_write(1, "-", 1)
            sys_write(1, " ", 1)
            write_dec(1, ln)
            sys_write(1, "\t", 1)
        else:
            # Stat did not come back; still name the file rather than nothing.
            write_str(2, "ls: stat failed, printing the name only\n")
    write_str(1, cast[Ptr[uint8]](target))
    sys_write(1, "\n", 1)
    return 0


def main(argc: int32, argv: Ptr[uint64]) -> int32:
    # Args: optionally "-l", followed by an optional target path.
    long_mode: int32 = 0
    cwd_buf: Array[256, uint8]
    target: Ptr[char] = cast[Ptr[char]]("/")
    i: int32 = 1
    have_target: int32 = 0
    while i < argc:
        a: Ptr[uint8] = cast[Ptr[uint8]](argv[i])
        if a[0] == 45 and a[1] == 108 and a[2] == 0:        # "-l"
            long_mode = 1
        else:
            target = cast[Ptr[char]](argv[i])
            have_target = 1
        i = i + 1
    if have_target == 0:
        cn: int64 = sys_getcwd(&cwd_buf[0], 256)
        if cn > 0:
            target = cast[Ptr[char]](&cwd_buf[0])
    # IS IT A DIRECTORY AT ALL?  ASKED, RATHER THAN ASSUMED.
    #
    # `ls foo.txt` used to print the FILE'S CONTENTS and exit 0, and so did
    # `ls -l foo.txt`.  The reason is that both paths below reach the target
    # through open()+read(): on a regular file both succeed, so the bytes read
    # ARE the file and a non-negative return is indistinguishable from a
    # directory listing.  p9_listdir's own comment claims it returns -1 when
    # the path "isn't a directory"; it contains no such check.
    #
    # THE TREE ALREADY KNEW THE ANSWER.  user/find.ad's header records the
    # identical bug and its fix -- "the descend decision is made by
    # sys_stat_p9 -> qid.type QTDIR, NOT by a p9_listdir success ... (the bug
    # #146 fixed)" -- and lib/p9.ad exports p9_is_dir() for exactly this,
    # carrying its own note on why p9_listdir cannot answer it.  `ls` simply
    # never asked.  This is that question, asked once, before either path.
    #
    # A MISSING PATH IS STILL AN ERROR, and that is why this does not report
    # "not a directory" on a p9_is_dir() of 0: p9_is_dir cannot tell a plain
    # file from a path that does not exist (both are 0), so a non-directory
    # falls through to the name-printing path, which OPENS the target and
    # fails loudly if it is not there.  One question here, the existence check
    # where it already was.
    if p9_is_dir(target) == 0:
        return ls_one(target, long_mode)
    if long_mode != 0:
        return ls_long(target)
    # Plain ls: line-stream path, unchanged.
    n: int64 = p9_listdir(target, &ls_buf[0], LISTBUF)
    if n < 0:
        write_str(2, "ls: listdir failed: ")
        write_str(2, cast[Ptr[uint8]](target))
        write_str(2, "\n")
        return 1
    sys_write(1, &ls_buf[0], cast[uint64](n))
    if cast[uint64](n) >= LISTBUF:
        # The listing filled the buffer, so entries past it were never read.
        # Say so and fail — a truncated listing reported as success is how a
        # user (or a script) concludes a directory is smaller than it is.
        write_str(2, "ls: listing TRUNCATED at 65536 bytes — output is INCOMPLETE\n")
        return 1
    return 0

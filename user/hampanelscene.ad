def _slen(s: Ptr[uint8]) -> uint64:
    n: uint64 = 0
    while s[n] != 0:
        n = n + 1
    return n


def _writeall(fd: int32, s: Ptr[uint8]):
    sys_write(fd, s, _slen(s))


def _u64_to_dec(v: uint64, out: Ptr[uint8]) -> uint64:
    if v == 0:
        out[0] = 48
        return 1
    digs: Array[24, uint8]
    n: uint64 = 0
    x: uint64 = v
    while x > 0:
        digs[n] = cast[uint8](x % 10) + 48
        x = x / 10
        n = n + 1
    i: uint64 = 0
    while n > 0:
        n = n - 1
        out[i] = digs[n]
        i = i + 1
    return i


# --- DIAGNOSTICS -> the serial console -------------------------------
#
# MEASURED, not assumed (2026-07-28): rc.5 launches the panel with
# `spawn detached`, and hamtermscene's dbg_cons_fd note says a detached
# scene client's stdout is NOT the serial console — so the obvious move
# was to open /dev/cons like hamtermscene does. On a real OVMF boot of
# the shipped image that produced NOTHING, while the panel's existing
# `_writeall(1, "[panel] appmenu entries: …")` marker DID reach the
# serial log. In THIS launch path stdio is inherited from the rc shell
# and fd 1 is the console; /dev/cons is not reachable (or not routed)
# from the panel's namespace. Telemetry therefore goes to fd 1, which is
# the channel that was observed to carry it.
#
# The indirection stays so there is one place to change if the launch
# path ever changes again — and so a future reader sees that the channel
# was picked by experiment.
PANEL_DIAG_FD: int32 = 1


def _pcons_fd() -> int32:
    return PANEL_DIAG_FD


# Telemetry is assembled into ONE line buffer and flushed with a SINGLE
# sys_write. /dev/cons is shared with the kernel printk stream and every
# other console writer; a line emitted as a dozen little writes interleaves
# with a concurrent boot/driver message and arrives on the serial log as
# shredded, ungreppable text — a gate parsing it would then report a
# defect that is really a console race.
_plbuf: Array[512, uint8]
_plpos: uint64 = 0


def _pl_s(s: Ptr[uint8]):
    i: uint64 = 0
    while s[i] != 0 and _plpos < 511:
        _plbuf[_plpos] = s[i]
        _plpos = _plpos + 1
        i = i + 1


def _pl_d(v: uint64):
    if _plpos + 24 < 511:
        _plpos = _plpos + _u64_to_dec(v, &_plbuf[_plpos])


def _pl_bytes(p: Ptr[uint8], n: uint64):
    i: uint64 = 0
    while i < n and _plpos < 511:
        _plbuf[_plpos] = p[i]
        _plpos = _plpos + 1
        i = i + 1


# MEASURED AGAIN (2026-07-28, second OVMF boot): fd 1 does not work
# either. The panel's `[panel] appmenu entries: …` marker reaches serial
# because it is printed BEFORE the panel creates its window; every write
# after that vanishes. Console I/O in this tree is routed by the caller's
# window binding (see hamUI.ad: "/dev/cons reads pop from
# /dev/wsys/<wid>/cmd FIRST — same routing key"), so once the panel owns
# a wid its console writes go to its own window, not to the serial log.
# Both console channels are therefore unusable for panel telemetry, and
# that is exactly why this defect went unobserved for so long: the panel
# has had no way to tell anyone anything since the moment it maps.
#
# The channel that DOES cross the boundary is a file. The panel rewrites
# its current health line into tmpfs; the gate `cat`s it over the serial
# shell whenever it wants a sample. One open/write/close every ~10 s.
# NOTE (compiler quirk, memory/feedback_compiler_quirks): a string literal
# must be used at the CALL SITE, never stored in a module global — a global
# initialised from a literal comes out NUL. The first version of this held
# the two paths in `Ptr[uint8]` globals and sys_open_write was handed an
# empty string, so no health file was ever created and the gate reported
# "no telemetry" for a panel that was working fine. Paths are inline below.


def _pl_flush_fault():
    cf: int32 = _pcons_fd()
    if cf >= 0 and _plpos > 0:
        sys_write(cf, &_plbuf[0], _plpos)
    if _plpos > 0:
        ff: int32 = sys_open_write(cast[Ptr[char]]("/tmp/hamnix-panel.fault"))
        if ff >= 0:
            sys_write(ff, &_plbuf[0], _plpos)
            sys_close(ff)
    _plpos = 0


def _pl_flush():
    cf: int32 = _pcons_fd()
    if cf >= 0 and _plpos > 0:
        sys_write(cf, &_plbuf[0], _plpos)
    if _plpos > 0:
        hf: int32 = sys_open_write(cast[Ptr[char]]("/tmp/hamnix-panel.health"))
        if hf >= 0:
            sys_write(hf, &_plbuf[0], _plpos)
            sys_close(hf)
    _plpos = 0


# How many descriptors does THIS process currently hold open? Reads the
# real per-task fd table through /proc/self/fd (devproc emit_proc_fd —
# one "<fd>\t<target>\n" line per LIVE descriptor) and counts the lines.
# Returns -1 if the file cannot be opened.
#
# This is the measuring instrument for the taskbar-goes-blind bug: if the
# panel leaks a descriptor per loop iteration, this number climbs
# monotonically until the table (TASK_NFDS) is full and every subsequent
# open — including /dev/wsys/windows — fails.
_fdcnt_buf: Array[1024, uint8]
def _open_fd_count() -> int64:
    fd: int32 = sys_open(cast[Ptr[char]]("/proc/self/fd"))
    if fd < 0:
        return -1
    total: uint64 = 0
    while total < 1023:
        r: int64 = sys_read(fd, &_fdcnt_buf[total], 1023 - total)
        if r <= 0:
            break
        total = total + cast[uint64](r)
    sys_close(fd)
    n: int64 = 0
    i: uint64 = 0
    while i < total:
        if _fdcnt_buf[i] == 10:
            n = n + 1
        i = i + 1
    return n


# A weight-aware glyph emit: normal or bold (double-strike) per the panel's
# font setting. Centralized so every applet honours the per-panel weight.
def _glyphs(x: int64, y: int64, s: Ptr[uint8], color: Ptr[uint8], bold: int32):
    if bold != 0:
        hamscene_glyphs_bold(cast[int32](x), cast[int32](y), s, color)
    else:
        hamscene_glyphs(cast[int32](x), cast[int32](y), s, color)


# Create a window via the server-wide ctl, read back the assigned wid.
def _newwindow_once() -> int32:
    wfd: int32 = sys_open_write(cast[Ptr[char]]("/dev/wsys/ctl"))
    if wfd < 0:
        return -1
    sys_write(wfd, cast[Ptr[uint8]]("newwindow\n"), 10)
    sys_close(wfd)
    rfd: int32 = sys_open(cast[Ptr[char]]("/dev/wsys/ctl"))
    if rfd < 0:
        return -1
    rbuf: Array[32, uint8]
    r: int64 = sys_read(rfd, &rbuf[0], 31)
    sys_close(rfd)
    if r <= 0:
        return -1
    wid: int32 = 0
    i: uint64 = 0
    while i < cast[uint64](r):
        c: uint8 = rbuf[i]
        if c >= 48 and c <= 57:
            wid = wid * 10 + cast[int32](c) - 48
        i = i + 1
    return wid


# #288 first-boot DE resilience. See the matching note in user/hamdesktop.ad:
# the panel is launched fire-and-forget by rc.5 concurrently with the heavy
# rc.boot ns capture. If the panel's first client->compositor handshake loses
# that cold-start race the OLD code exited(1), leaving the desktop with NO
# panel/taskbar until a reboot (the reported first-boot symptom). Retry the
# handshake a BOUNDED number of times, spacing attempts with sys_yield() so
# the concurrent bringup progresses between tries. Returns the wid, or -1
# only after all attempts fail.
_NEWWIN_ATTEMPTS: int32 = 40
def _newwindow() -> int32:
    attempt: int32 = 0
    while attempt < _NEWWIN_ATTEMPTS:
        wid: int32 = _newwindow_once()
        if wid > 0:
            if attempt > 0:
                _writeall(1, cast[Ptr[uint8]](
                    "[panel] newwindow ok after retry\n"))
            return wid
        spin: int32 = 0
        while spin < 1000:
            sys_yield()
            spin = spin + 1
        attempt = attempt + 1
    return -1


def _winpath(out: Ptr[uint8], wid: int32, leaf: Ptr[uint8]):
    p: uint64 = 0
    pre: Ptr[uint8] = cast[Ptr[uint8]]("/dev/wsys/")
    j: uint64 = 0
    while pre[j] != 0:
        out[p] = pre[j]
        p = p + 1
        j = j + 1
    p = p + _u64_to_dec(cast[uint64](wid), &out[p])
    k: uint64 = 0
    while leaf[k] != 0:
        out[p] = leaf[k]
        p = p + 1
        k = k + 1
    out[p] = 0


# ====================================================================
# WORKSPACE (pager) state + I/O
# ====================================================================
# Current active workspace (0-based), tracked from /dev/wsys/workspace. The
# pager applet renders WS_COUNT cells with cur_ws lit, and a click writes the
# `ws <N>` ctl verb (1-based) which the compositor turns into workspace_switch.
cur_ws: int64 = 0


# Poll /dev/wsys/workspace ("<gen> <ws>\n"); update cur_ws. Cheap; called once
# per panel tick before render so the lit cell tracks the live desktop.
def _poll_workspace():
    fd: int32 = sys_open(cast[Ptr[char]]("/dev/wsys/workspace"))
    if fd < 0:
        return
    rb: Array[64, uint8]
    n: int64 = sys_read(fd, &rb[0], 63)
    sys_close(fd)
    if n <= 0:
        return
    # Skip the gen field, then parse the ws field.
    i: uint64 = 0
    cap: uint64 = cast[uint64](n)
    while i < cap and rb[i] != 32:
        i = i + 1
    while i < cap and rb[i] == 32:
        i = i + 1
    v: int64 = 0
    while i < cap and rb[i] >= 48 and rb[i] <= 57:
        v = v * 10 + cast[int64](rb[i]) - 48
        i = i + 1
    if v >= 0 and v < WS_COUNT:
        cur_ws = v


# Write "ws <N>\n" (1-based) to /dev/wsys/ctl. The compositor's workspace
# poll bumps its gen and calls workspace_switch(N-1), hiding the windows that
# don't live on the new desktop. This is the real virtual-desktop switch.
def _switch_workspace(n0: int64):
    if n0 < 0 or n0 >= WS_COUNT:
        return
    fd: int32 = sys_open_write(cast[Ptr[char]]("/dev/wsys/ctl"))
    if fd < 0:
        return
    cmd: Array[16, uint8]
    p: uint64 = 0
    cmd[p] = 119                     # 'w'
    p = p + 1
    cmd[p] = 115                     # 's'
    p = p + 1
    cmd[p] = 32                      # ' '
    p = p + 1
    p = p + _u64_to_dec(cast[uint64](n0 + 1), &cmd[p])
    cmd[p] = 10
    p = p + 1
    sys_write(fd, &cmd[0], p)
    sys_close(fd)
    cur_ws = n0


# ====================================================================
# NOTIFICATION BUS / BROKER (scene-native)
# ====================================================================
# The kernel inbox ring at /dev/wsys/post is the Plan 9-shaped notification
# bus: any publisher (the welcome service, rc.5, a shell, hamnotify) writes a
# "<title>\t<body>\t<icon>\n" record there. In the legacy DE hamUId drained
# this ring; in the SCENE DE hamUId is dead, so THE PANEL is the broker. On
# each tick the panel:
#   1. reads the /dev/wsys/post snapshot
#      ("<post_serial> <ack_serial> <count> <slot_serial> <title>\t<body>\t<icon>\n"),
#   2. for each head record while count>0: spawns a scene TOAST
#      (/bin/hamtoast "<title>" "<body>"), appends the record to the tmpfs
#      history log /tmp/hamnix-notif.log, bumps the unread count, then ACKs
#      the slot by writing "ack <slot_serial>\n" back to /dev/wsys/post so the
#      kernel advances its head.
# The tray applet draws a bell + the unread count badge; clicking it spawns
# the scene INBOX (/bin/haminbox), which reads the history log, and clears the
# unread count.
notif_unread: int64 = 0                 # unread notifications since last inbox
notif_last_ack: uint64 = 0             # highest slot serial we've acked
# pid of the notification INBOX popup (/bin/haminbox) we last spawned, or 0.
# The bell click TOGGLES the popup off this: a click while the tracked pid is
# still alive terminates it (and never spawns a second one), so repeated bell
# clicks can never STACK duplicate inbox windows at the same geometry — the
# stack was the "the Close button does nothing, the popup stays stuck" bug
# (closing the top one just revealed an identical popup behind it).
notif_inbox_pid: int32 = 0

# Parsed head record from the last _drain_notifications poll.
_nb_count: int64 = 0
_nb_slot: uint64 = 0
_nb_title: Array[48, uint8]
_nb_body:  Array[72, uint8]


# Append the current head record (_nb_title/_nb_body) to the tmpfs history log
# as "<title>\t<body>\n". Capped to the newest ~16 records by rewriting the
# file from a small in-RAM ring so it never grows unbounded.
NLOG_MAX: uint64 = 16
nlog_buf: Array[1920, uint8]           # 16 * 120
nlog_len: Array[16, uint64]
nlog_n: uint64 = 0


def _nlog_append(title: Ptr[uint8], body: Ptr[uint8]):
    # Build the "<title>\t<body>" record into the ring (drop oldest on full).
    slot: uint64 = nlog_n
    if nlog_n >= NLOG_MAX:
        # shift down by one (drop oldest)
        s: uint64 = 0
        while s + 1 < NLOG_MAX:
            base_d: uint64 = s * 120
            base_s: uint64 = (s + 1) * 120
            k: uint64 = 0
            while k < nlog_len[s + 1]:
                nlog_buf[base_d + k] = nlog_buf[base_s + k]
                k = k + 1
            nlog_len[s] = nlog_len[s + 1]
            s = s + 1
        slot = NLOG_MAX - 1
    else:
        nlog_n = nlog_n + 1
    base: uint64 = slot * 120
    p: uint64 = 0
    ti: uint64 = 0
    while title[ti] != 0 and p < 118:
        nlog_buf[base + p] = title[ti]
        p = p + 1
        ti = ti + 1
    if p < 118:
        nlog_buf[base + p] = 9                       # '\t'
        p = p + 1
    bi: uint64 = 0
    while body[bi] != 0 and p < 119:
        nlog_buf[base + p] = body[bi]
        p = p + 1
        bi = bi + 1
    nlog_len[slot] = p
    # Rewrite /tmp/hamnix-notif.log from the ring (oldest-first).
    fd: int32 = sys_open_write(cast[Ptr[char]]("/tmp/hamnix-notif.log"))
    if fd < 0:
        return
    out: Array[2048, uint8]
    op: uint64 = 0
    r: uint64 = 0
    while r < nlog_n and op + 122 < 2048:
        rb: uint64 = r * 120
        kk: uint64 = 0
        while kk < nlog_len[r]:
            out[op] = nlog_buf[rb + kk]
            op = op + 1
            kk = kk + 1
        out[op] = 10
        op = op + 1
        r = r + 1
    sys_write(fd, &out[0], op)
    sys_close(fd)


# Spawn the scene toast with the head record's title + body as argv.
_toast_argv: Array[4, uint64]
def _spawn_toast():
    _toast_argv[0] = cast[uint64](cast[Ptr[char]]("/bin/hamtoast"))
    _toast_argv[1] = cast[uint64](&_nb_title[0])
    _toast_argv[2] = cast[uint64](&_nb_body[0])
    _toast_argv[3] = 0
    # DETACHED: the panel is a long-running service that never wait4s, so a
    # plain spawn would leak the toast as an un-reapable zombie every time.
    spawn_detached(cast[Ptr[char]]("/bin/hamtoast"), &_toast_argv[0],
                   -2, -2, cast[Ptr[uint64]](0))


# Ack a drained slot so the kernel advances /dev/wsys/post's head.
def _ack_slot(serial: uint64):
    fd: int32 = sys_open_write(cast[Ptr[char]]("/dev/wsys/post"))
    if fd < 0:
        return
    cmd: Array[40, uint8]
    p: uint64 = 0
    pre: Ptr[uint8] = cast[Ptr[uint8]]("ack ")
    while pre[p] != 0:
        cmd[p] = pre[p]
        p = p + 1
    p = p + _u64_to_dec(serial, &cmd[p])
    cmd[p] = 10
    p = p + 1
    sys_write(fd, &cmd[0], p)
    sys_close(fd)


# Read one /dev/wsys/post snapshot into _nb_*; returns count (>0 = head valid).
_nb_rb: Array[256, uint8]
def _read_post_head() -> int64:
    _nb_count = 0
    fd: int32 = sys_open(cast[Ptr[char]]("/dev/wsys/post"))
    if fd < 0:
        return 0
    n: int64 = sys_read(fd, &_nb_rb[0], 255)
    sys_close(fd)
    if n <= 0:
        return 0
    cap: uint64 = cast[uint64](n)
    i: uint64 = 0
    # field 0: post_serial (skip)
    while i < cap and _nb_rb[i] != 32:
        i = i + 1
    while i < cap and _nb_rb[i] == 32:
        i = i + 1
    # field 1: ack_serial (skip)
    while i < cap and _nb_rb[i] != 32:
        i = i + 1
    while i < cap and _nb_rb[i] == 32:
        i = i + 1
    # field 2: count
    cnt: int64 = 0
    while i < cap and _nb_rb[i] >= 48 and _nb_rb[i] <= 57:
        cnt = cnt * 10 + cast[int64](_nb_rb[i]) - 48
        i = i + 1
    _nb_count = cnt
    if cnt <= 0:
        return 0
    while i < cap and _nb_rb[i] == 32:
        i = i + 1
    # field 3: slot_serial
    sl: uint64 = 0
    while i < cap and _nb_rb[i] >= 48 and _nb_rb[i] <= 57:
        sl = sl * 10 + cast[uint64](_nb_rb[i]) - 48
        i = i + 1
    _nb_slot = sl
    while i < cap and _nb_rb[i] == 32:
        i = i + 1
    # title up to tab
    tp: uint64 = 0
    while i < cap and _nb_rb[i] != 9 and tp < 47:
        _nb_title[tp] = _nb_rb[i]
        tp = tp + 1
        i = i + 1
    _nb_title[tp] = 0
    # skip to past the first tab
    while i < cap and _nb_rb[i] != 9:
        i = i + 1
    if i < cap:
        i = i + 1                                     # consume tab
    # body up to next tab (icon) or newline
    bp: uint64 = 0
    while i < cap and _nb_rb[i] != 9 and _nb_rb[i] != 10 and bp < 71:
        _nb_body[bp] = _nb_rb[i]
        bp = bp + 1
        i = i + 1
    _nb_body[bp] = 0
    return cnt


# Drain every pending /dev/wsys/post record: toast it, log it, ack it. Returns
# 1 if any notification was drained (so the panel repaints the unread badge).
def _drain_notifications() -> int32:
    drained: int32 = 0
    guard: int32 = 0
    while guard < 16:
        guard = guard + 1
        cnt: int64 = _read_post_head()
        if cnt <= 0:
            break
        # Guard against re-processing the same head if an ack didn't land.
        if _nb_slot == notif_last_ack and notif_last_ack != 0:
            break
        _spawn_toast()
        _nlog_append(&_nb_title[0], &_nb_body[0])
        notif_unread = notif_unread + 1
        notif_last_ack = _nb_slot
        _ack_slot(_nb_slot)
        drained = 1
    return drained


# The screen size comes from the COMPOSITOR, not from /dev/fb.
#
# These were two functions, _screen_width and _screen_height, each opening
# /dev/fb, each parsing the "W H PITCH BPP FMT\n" header, and each with a
# literal 800 / 600 in every failure branch. On the raw DRM/KMS path the open
# can never succeed -- wsysd holds DRM master and the device is exclusive --
# so the panel spanned 800 px of a 1280 px screen and put the bottom bar 200
# px up from the bottom, silently. lib/hamscreen.ad has the full story; the
# authoritative source is /dev/wsys/screen, which the compositor publishes.
#
# One resolve for both fields, because they are one fact. Returns 1 on
# success, 0 after it has already said why.
def _screen_dims(wp: Ptr[int64], hp: Ptr[int64]) -> int32:
    return hamscreen_dims_or_fail(wp, hp, cast[Ptr[uint8]]("[panel]"))


# --- wall-clock: btime (epoch) from /dev/stat + uptime (ns) from /dev/time

def _read_btime() -> uint64:
    fd: int32 = sys_open(cast[Ptr[char]]("/dev/stat"))
    if fd < 0:
        return 0
    buf: Array[2048, uint8]
    total: uint64 = 0
    while total < 2047:
        r: int64 = sys_read(fd, &buf[total], 2047 - total)
        if r <= 0:
            break
        total = total + cast[uint64](r)
    sys_close(fd)
    i: uint64 = 0
    while i + 6 < total:
        if (i == 0 or buf[i - 1] == 10) and buf[i] == 98 and buf[i+1] == 116 \
                and buf[i+2] == 105 and buf[i+3] == 109 and buf[i+4] == 101 \
                and buf[i+5] == 32:
            j: uint64 = i + 6
            v: uint64 = 0
            while j < total and buf[j] >= 48 and buf[j] <= 57:
                v = v * 10 + cast[uint64](buf[j]) - 48
                j = j + 1
            return v
        i = i + 1
    return 0


def _read_uptime_ns() -> uint64:
    fd: int32 = sys_open(cast[Ptr[char]]("/dev/time"))
    if fd < 0:
        return 0
    buf: Array[32, uint8]
    r: int64 = sys_read(fd, &buf[0], 31)
    sys_close(fd)
    if r <= 0:
        return 0
    v: uint64 = 0
    i: uint64 = 0
    while i < cast[uint64](r) and buf[i] >= 48 and buf[i] <= 57:
        v = v * 10 + cast[uint64](buf[i]) - 48
        i = i + 1
    return v


def _now_secs_of_day(btime: uint64) -> uint64:
    up_ns: uint64 = _read_uptime_ns()
    epoch: uint64 = btime + up_ns / 1000000000
    return epoch % 86400


# Full Unix epoch seconds (boot time + uptime). Used by the MATE-style clock
# so it can show the calendar date, not just the seconds-of-day.
def _now_epoch_secs(btime: uint64) -> uint64:
    up_ns: uint64 = _read_uptime_ns()
    return btime + up_ns / 1000000000


# --- sysmon data sources --------------------------------------------
def _find_kv(buf: Ptr[uint8], total: uint64, lab: Ptr[uint8]) -> uint64:
    ll: uint64 = _slen(lab)
    i: uint64 = 0
    while i + ll < total:
        if i == 0 or buf[i - 1] == 10:
            m: uint64 = 0
            while m < ll and buf[i + m] == lab[m]:
                m = m + 1
            if m == ll:
                j: uint64 = i + ll
                while j < total and not (buf[j] >= 48 and buf[j] <= 57):
                    j = j + 1
                v: uint64 = 0
                while j < total and buf[j] >= 48 and buf[j] <= 57:
                    v = v * 10 + cast[uint64](buf[j]) - 48
                    j = j + 1
                return v
        i = i + 1
    return 0


def _mem_pct() -> int32:
    fd: int32 = sys_open(cast[Ptr[char]]("/dev/meminfo"))
    if fd < 0:
        return 0
    buf: Array[512, uint8]
    total: uint64 = 0
    while total < 511:
        r: int64 = sys_read(fd, &buf[total], 511 - total)
        if r <= 0:
            break
        total = total + cast[uint64](r)
    sys_close(fd)
    memtot: uint64 = _find_kv(&buf[0], total, cast[Ptr[uint8]]("MemTotal:"))
    memused: uint64 = _find_kv(&buf[0], total, cast[Ptr[uint8]]("MemUsed:"))
    if memtot == 0:
        return 0
    return cast[int32]((memused * 100) / memtot)


# --- CPU busy% from /dev/stat busy/total DELTAS (shared lib/cpustat) --
# The applet samples the aggregate "cpu" row of /dev/stat (the Linux
# /proc/stat shape: user nice system idle ...) and computes the classic
# utilisation delta between two panel samples:
#     busy% = d(user+nice+system) / d(user+nice+system+idle) * 100
# This is the SAME source the standalone System Monitor (hammonscene) reads,
# via the shared lib/cpustat.ad parser, so the two never diverge.
#
# It replaces the previous /dev/uptime idle-delta reader, which was WRONG:
# /dev/uptime's idle column (kernel/sched/loadavg.ad _la_idle_jiffies) is
# "wall ticks minus ring-3 ticks", folding all kernel/system time into
# idle. Any load whose busy work ran in the kernel therefore read ~0% on the
# panel while the System Monitor showed real usage. (An even earlier widget
# scaled `load*100/2`, which pegged at 100% for any load >= 2 — also wrong.)
# The FIRST sample has no previous baseline, so it must report 0.
_cpu_prev_busy:  uint64 = 0
_cpu_prev_tot:   uint64 = 0
_cpu_inited:     int32  = 0
_cpu_last_pct:   int32  = 0


def _cpu_pct() -> int32:
    fd: int32 = sys_open(cast[Ptr[char]]("/dev/stat"))
    if fd < 0:
        return _cpu_last_pct
    buf: Array[256, uint8]
    r: int64 = sys_read(fd, &buf[0], 255)
    sys_close(fd)
    if r <= 0:
        return _cpu_last_pct
    bt: Array[2, uint64]
    if cpustat_agg(&buf[0], cast[uint64](r), &bt[0], &bt[1]) == 0:
        return _cpu_last_pct               # no aggregate "cpu" row this read
    busy: uint64 = bt[0]
    tot:  uint64 = bt[1]
    if _cpu_inited == 0:
        # First sample: establish the baseline, report 0% (no interval yet).
        _cpu_prev_busy = busy
        _cpu_prev_tot = tot
        _cpu_inited = 1
        _cpu_last_pct = 0
        return 0
    if tot <= _cpu_prev_tot:
        return _cpu_last_pct               # sampled twice within one tick
    pct: int32 = cpustat_busy_pct(_cpu_prev_busy, _cpu_prev_tot, busy, tot)
    _cpu_prev_busy = busy
    _cpu_prev_tot = tot
    _cpu_last_pct = pct
    return _cpu_last_pct


# --- sysmon rolling-history rings (MATE-style panel graph) -----------
# The applet used to paint a single "percent of the moment" meter. It now keeps
# a scrolling ring of recent CPU (+ memory) samples and draws a sparkline, like
# the MATE System Monitor applet. Samples are pushed once per resample cadence
# (SAMPLE_TICKS in the main loop), NOT per redraw — a redraw can fire for many
# unrelated reasons (window list change, notification) and _cpu_pct is a DELTA
# reader that must be advanced exactly once per interval. _render_sysmon reads
# the cached cur values + the ring; it never advances the delta itself.
SM_HIST: uint64 = 48
_sm_cpu_hist: Array[48, uint8]
_sm_mem_hist: Array[48, uint8]
_sm_n:        uint64 = 0
_sm_cur_cpu:  int32 = 0
_sm_cur_mem:  int32 = 0


def _sm_ring_push(ring: Ptr[uint8], v: uint8):
    if _sm_n < SM_HIST:
        ring[_sm_n] = v
        return
    i: uint64 = 0
    while i + 1 < SM_HIST:
        ring[i] = ring[i + 1]
        i = i + 1
    ring[SM_HIST - 1] = v


def _sm_clamp(p: int32) -> uint8:
    if p < 0:
        return 0
    if p > 100:
        return 100
    return cast[uint8](p)


# Advance the delta readers ONCE and push a fresh (cpu, mem) history sample.
# Called on the resample cadence from the main loop.
def _sm_sample():
    c: int32 = _cpu_pct()
    m: int32 = _mem_pct()
    _sm_cur_cpu = c
    _sm_cur_mem = m
    _sm_ring_push(&_sm_cpu_hist[0], _sm_clamp(c))
    _sm_ring_push(&_sm_mem_hist[0], _sm_clamp(m))
    if _sm_n < SM_HIST:
        _sm_n = _sm_n + 1


# Draw the CPU (filled columns) + memory (polyline) history sparkline into
# [gx,gy,gw,gh] via the shared, host-testable lib/sysmonspark.ad.
def _sm_spark(gx: int64, gy: int64, gw: int64, gh: int64):
    sysmon_spark(&_sm_cpu_hist[0], &_sm_mem_hist[0], _sm_n, SM_HIST,
                 cast[int32](gx), cast[int32](gy), cast[int32](gw),
                 cast[int32](gh))


# --- taskbar window list (parsed from /dev/wsys/windows) -------------
MAX_TASKS: uint64 = 8
task_wid:  Array[8, int32]
task_name: Array[512, uint8]          # 8 * 64
task_namelen: Array[8, uint64]
n_tasks: uint64 = 0
# Content hash of the last /dev/wsys/windows snapshot (FNV-1a over the raw
# bytes: wids + titles + order). The taskbar must re-render whenever ANY of
# these change — not just the window COUNT. Count-only detection missed the
# common case where an app `newwindow`s (enumerated as "winN") and only writes
# its real `title` a moment later: same count, so the taskbar stayed stuck on
# the "winN" placeholder and the freshly-opened app "never appeared" under its
# name. It also missed a same-count swap (close A + open B within one poll).
win_hash: uint64 = 0


# Count of CONSECUTIVE failed /dev/wsys/windows refreshes, and the total
# over the session. Non-zero here means the taskbar the user is looking at
# is NOT the live window set.
win_open_fails: uint64 = 0
win_open_fails_total: uint64 = 0
_win_fail_reported: uint64 = 0


def _refresh_windows():
    fd: int32 = sys_open(cast[Ptr[char]]("/dev/wsys/windows"))
    if fd < 0:
        # LOUD, not silent. This used to `n_tasks = 0; win_hash = 0; return`,
        # i.e. a failed open silently REPAINTED AN EMPTY TASKBAR while four
        # windows were mapped, and nothing anywhere said so — the failure was
        # swallowed into "the desktop has no windows", which is a lie the user
        # sees as a broken panel. Now: keep the last known-good list (a stale
        # taskbar is strictly better than a false-empty one), and SAY SO on
        # /dev/cons with the panel's live descriptor count, which is what
        # distinguishes "the compositor is momentarily busy" from "this
        # process has run out of file descriptors".
        win_open_fails = win_open_fails + 1
        win_open_fails_total = win_open_fails_total + 1
        # Report the first failure, then back off geometrically (1,2,4,8,…)
        # so a persistent fault stays visible without flooding the console.
        if win_open_fails >= _win_fail_reported:
            if _win_fail_reported == 0:
                _win_fail_reported = 1
            else:
                _win_fail_reported = _win_fail_reported * 2
            _pl_s(cast[Ptr[uint8]]("[panel] ERROR open /dev/wsys/windows failed n="))
            _pl_d(win_open_fails)
            nfd: int64 = _open_fd_count()
            _pl_s(cast[Ptr[uint8]](" openfds="))
            if nfd < 0:
                _pl_s(cast[Ptr[uint8]]("unreadable"))
            else:
                _pl_d(cast[uint64](nfd))
            _pl_s(cast[Ptr[uint8]](" keeping stale taskbar tasks="))
            _pl_d(n_tasks)
            _pl_s(cast[Ptr[uint8]]("\n"))
            _pl_flush_fault()
        return
    if win_open_fails != 0:
        _pl_s(cast[Ptr[uint8]]("[panel] RECOVERED /dev/wsys/windows after "))
        _pl_d(win_open_fails)
        _pl_s(cast[Ptr[uint8]](" failed opens\n"))
        _pl_flush()
        win_open_fails = 0
        _win_fail_reported = 0
    buf: Array[1024, uint8]
    total: uint64 = 0
    rerr: int32 = 0
    while total < 1023:
        r: int64 = sys_read(fd, &buf[total], 1023 - total)
        if r < 0:
            rerr = 1
            break
        if r == 0:
            break                                  # EOF: snapshot complete
        total = total + cast[uint64](r)
    sys_close(fd)
    if rerr != 0:
        # A read ERROR is the same swallowed-failure shape as a failed open,
        # and it used to land in exactly the same place: total stays 0, the
        # parse below produces nothing, and the taskbar repaints EMPTY as
        # though the desktop had no windows. r==0 (a genuine EOF, i.e. an
        # empty window set) is a different thing and still means "no
        # windows" — only r<0 is treated as a fault.
        win_open_fails = win_open_fails + 1
        win_open_fails_total = win_open_fails_total + 1
        _pl_s(cast[Ptr[uint8]]("[panel] ERROR read /dev/wsys/windows failed after "))
        _pl_d(total)
        _pl_s(cast[Ptr[uint8]](" bytes; keeping stale taskbar tasks="))
        _pl_d(n_tasks)
        _pl_s(cast[Ptr[uint8]]("\n"))
        _pl_flush_fault()
        return
    n_tasks = 0
    # FNV-1a over the raw snapshot so any change to the window SET (a new
    # window, a closed one, a title that landed after the window mapped, a
    # same-count swap) flips the hash and forces a taskbar re-render.
    h: uint64 = 14695981039346656037
    hi: uint64 = 0
    while hi < total:
        h = h ^ cast[uint64](buf[hi])
        h = h * 1099511628211
        hi = hi + 1
    win_hash = h
    i: uint64 = 0
    while i < total and n_tasks < MAX_TASKS:
        w: int32 = 0
        got: int32 = 0
        while i < total and buf[i] >= 48 and buf[i] <= 57:
            w = w * 10 + cast[int32](buf[i]) - 48
            got = 1
            i = i + 1
        if i < total and buf[i] == 32:
            i = i + 1
        nbase: uint64 = n_tasks * 64
        nl: uint64 = 0
        while i < total and buf[i] != 10 and nl < 63:
            task_name[nbase + nl] = buf[i]
            nl = nl + 1
            i = i + 1
        while i < total and buf[i] != 10:
            i = i + 1
        if i < total:
            i = i + 1
        if got != 0:
            task_wid[n_tasks] = w
            task_namelen[n_tasks] = nl
            n_tasks = n_tasks + 1


# ====================================================================
# CONFIG — /etc/panel.conf parsed into a set of PANELS, each with its
# own edge, appearance, and ordered widget list.
# ====================================================================

# widget kinds
WK_MENU:    int32 = 0
WK_TASKS:   int32 = 1
WK_CLOCK:   int32 = 2
WK_SYSMON:  int32 = 3
WK_SPACER:  int32 = 4
# MATE-parity applets (this build adds three real, functional applets):
#   WK_PAGER   virtual-desktop / workspace switcher. Reads /dev/wsys/workspace
#              (kernel snapshot "<gen> <ws>\n"), draws WS_COUNT clickable cells
#              with the active one lit; a click writes "ws <N>\n" to
#              /dev/wsys/ctl so the compositor's workspace_switch() hides the
#              other desktops' windows. Real virtual desktops, not a stub.
#   WK_TRAY    notification area. Draws a bell glyph + an unread dot when the
#              compositor's /dev/wsys/notif snapshot reports an active toast;
#              a click spawns /bin/hamtray (the message-tray history panel).
#   WK_SESSION session button. A power glyph; a click spawns /bin/hamsessui
#              (the Lock / Log Out / Shut Down / Reboot dialog) so the session
#              menu is reachable straight from the panel, MATE-style.
WK_PAGER:   int32 = 5
WK_TRAY:    int32 = 6
WK_SESSION: int32 = 7
#   WK_LAUNCHER  a one-click application launcher: a placeholder icon chip
#              (the label's first letter — a clean seam for #285's real
#              per-app icons) + a text label. A click spawns the carried Exec
#              path (reusing _launch/spawn_detached, exactly like the menu/tray
#              applets). Its Exec + label live in the parallel p_wexec/p_wlabel
#              stores indexed by the same panel*MAX_WIDGETS+slot grid as
#              p_wkind. Config syntax: `widget launcher <exec> <label>`.
WK_LAUNCHER: int32 = 8

# Workspace count for the pager. Mirrors the compositor's WS_COUNT; if the two
# ever diverge the pager just shows fewer/more cells than exist, harmless.
WS_COUNT: int64 = 4

# edges
EDGE_TOP:    int32 = 0
EDGE_BOTTOM: int32 = 1
EDGE_LEFT:   int32 = 2
EDGE_RIGHT:  int32 = 3

MAX_PANELS:  uint64 = 4
MAX_WIDGETS: uint64 = 12               # per panel

# Per-panel config (struct-of-arrays).
p_edge:  Array[4, int32]
p_size:  Array[4, int64]               # thickness in px
p_bold:  Array[4, int32]               # font weight (0 normal, 1 bold)
p_color: Array[40, uint8]              # 4 * 10  "#RRGGBB\0"
p_nwidg: Array[4, uint64]              # widget count per panel
# widget kind grid: panel * MAX_WIDGETS + slot
p_wkind: Array[48, int32]              # 4 * 12
# ARBITRARY WIDGET POSITION (bug 3): per-widget pinned flow-axis coordinate.
# -1 = AUTO (the classic flow packing: leading widgets from the start edge,
# trailing from the far edge, the elastic taskbar filling the middle). A
# value >= 0 PINS the widget at that exact px on the flow axis (x for a
# horizontal panel, y for a vertical one), clamped into the bar — so a widget
# can sit anywhere, e.g. the CENTRE of the bar, not just a coarse slot. A
# pinned widget is lifted OUT of flow packing so it doesn't shove its
# neighbours. Set by a live Move (bug 2) and persisted to panel.conf.
p_wx_pin: Array[48, int64]            # 4 * 12, -1 = auto-flow
# LAUNCHER payload grid (parallel to p_wkind): for a WK_LAUNCHER slot the Exec
# path and the visible label. Both indexed by the SAME panel*MAX_WIDGETS+slot
# global slot number as p_wkind, so insert/remove/move must shift them in
# lockstep (see _copy_wstr_slot below). Non-launcher slots leave these empty.
LEXEC_SZ:  uint64 = 64                 # max Exec path incl NUL
LLABEL_SZ: uint64 = 24                 # max label incl NUL
p_wexec:  Array[3072, uint8]          # 48 * 64
p_wlabel: Array[1152, uint8]          # 48 * 24
n_panels: uint64 = 0


# Pointers into the launcher payload grid for global slot `g`.
def _wexec_ptr(g: uint64) -> Ptr[uint8]:
    return cast[Ptr[uint8]](cast[uint64](&p_wexec[0]) + g * LEXEC_SZ)


def _wlabel_ptr(g: uint64) -> Ptr[uint8]:
    return cast[Ptr[uint8]](cast[uint64](&p_wlabel[0]) + g * LLABEL_SZ)


# Copy buf[s..e) into dst as a NUL-terminated string, clamped to maxn (incl NUL).
def _copy_tok(buf: Ptr[uint8], s: uint64, e: uint64, dst: Ptr[uint8],
              maxn: uint64):
    k: uint64 = 0
    i: uint64 = s
    while i < e and k + 1 < maxn:
        dst[k] = buf[i]
        k = k + 1
        i = i + 1
    dst[k] = 0


# Copy a NUL-terminated string into a payload cell, clamped to maxn (incl NUL).
def _set_wstr(dp: Ptr[uint8], src: Ptr[uint8], maxn: uint64):
    k: uint64 = 0
    while src[k] != 0 and k + 1 < maxn:
        dp[k] = src[k]
        k = k + 1
    dp[k] = 0


# Move the launcher payload (exec+label) from global slot src to global slot
# dst — used when insert/remove shift the widget grid so a launcher's Exec and
# label follow its kind.
def _copy_wstr_slot(dst: uint64, src: uint64):
    _set_wstr(_wexec_ptr(dst), _wexec_ptr(src), LEXEC_SZ)
    _set_wstr(_wlabel_ptr(dst), _wlabel_ptr(src), LLABEL_SZ)


# Placeholder icon glyph for a launcher: the label's first letter, upper-cased.
# #285 replaces this with a real per-app icon via a shared helper; the seam is
# this single function + the icon-chip fill in _render_launcher.
def _launcher_glyph(label: Ptr[uint8]) -> uint8:
    c: uint8 = label[0]
    if c >= 97 and c <= 122:
        return c - 32
    if c == 0:
        return 63                          # '?'
    return c


# Initialize every pin slot to AUTO once at startup (globals zero-init, so
# without this a freshly-added widget at a never-written slot could read 0 =
# "pinned at x0"). Called from main() before the first config load.
def _init_pins():
    i: uint64 = 0
    while i < 48:
        p_wx_pin[i] = -1
        i = i + 1


def p_color_ptr(i: uint64) -> Ptr[uint8]:
    return cast[Ptr[uint8]](cast[uint64](&p_color[0]) + i * 10)


def _set_pcolor(i: uint64, hx: Ptr[uint8]):
    dp: Ptr[uint8] = p_color_ptr(i)
    k: uint64 = 0
    while hx[k] != 0 and k < 9:
        dp[k] = hx[k]
        k = k + 1
    dp[k] = 0


# Defaults applied when a panel block omits a field.
PANEL_DEF_H: int64 = 26                # default horizontal thickness
PANEL_DEF_V: int64 = 56                # default vertical thickness


def _begin_panel(edge: int32) -> uint64:
    if n_panels >= MAX_PANELS:
        return MAX_PANELS                 # overflow sentinel
    idx: uint64 = n_panels
    p_edge[idx] = edge
    if edge == EDGE_LEFT or edge == EDGE_RIGHT:
        p_size[idx] = PANEL_DEF_V
    else:
        p_size[idx] = PANEL_DEF_H
    p_bold[idx] = 0
    _set_pcolor(idx, cast[Ptr[uint8]]("#eceef2"))
    p_nwidg[idx] = 0
    n_panels = n_panels + 1
    return idx


def _add_widget_pin(panel: uint64, kind: int32, pin: int64):
    if panel >= n_panels:
        return
    nw: uint64 = p_nwidg[panel]
    if nw >= MAX_WIDGETS:
        return
    p_wkind[panel * MAX_WIDGETS + nw] = kind
    p_wx_pin[panel * MAX_WIDGETS + nw] = pin
    p_nwidg[panel] = nw + 1


def _add_widget(panel: uint64, kind: int32):
    _add_widget_pin(panel, kind, -1)


# Append a WK_LAUNCHER widget carrying an Exec path + label to `panel`.
def _add_launcher(panel: uint64, exec: Ptr[uint8], label: Ptr[uint8]):
    if panel >= n_panels:
        return
    nw: uint64 = p_nwidg[panel]
    if nw >= MAX_WIDGETS:
        return
    g: uint64 = panel * MAX_WIDGETS + nw
    p_wkind[g] = WK_LAUNCHER
    p_wx_pin[g] = -1
    _set_wstr(_wexec_ptr(g), exec, LEXEC_SZ)
    _set_wstr(_wlabel_ptr(g), label, LLABEL_SZ)
    p_nwidg[panel] = nw + 1


# Insert a WK_LAUNCHER at flow index `at` (used by a menu-drag drop so the new
# launcher lands next to the Applications menu rather than trailing the bar).
def _insert_launcher(panel: uint64, at: uint64, exec: Ptr[uint8],
                     label: Ptr[uint8]):
    if panel >= n_panels:
        return
    if p_nwidg[panel] >= MAX_WIDGETS:
        return
    _insert_widget(panel, at, WK_LAUNCHER)
    # _insert_widget clamps `at`; recompute the real landing slot.
    nw: uint64 = p_nwidg[panel]
    la: uint64 = at
    if la >= nw:
        la = nw - 1
    g: uint64 = panel * MAX_WIDGETS + la
    _set_wstr(_wexec_ptr(g), exec, LEXEC_SZ)
    _set_wstr(_wlabel_ptr(g), label, LLABEL_SZ)


# Insert `kind` into panel `panel` at flow index `at` (0..p_nwidg), shifting
# later widgets up. No-op if the panel is full or indices are out of range.
def _insert_widget(panel: uint64, at: uint64, kind: int32):
    if panel >= n_panels:
        return
    nw: uint64 = p_nwidg[panel]
    if nw >= MAX_WIDGETS:
        return
    if at > nw:
        at = nw
    base: uint64 = panel * MAX_WIDGETS
    j: uint64 = nw
    while j > at:
        p_wkind[base + j] = p_wkind[base + j - 1]
        p_wx_pin[base + j] = p_wx_pin[base + j - 1]
        _copy_wstr_slot(base + j, base + j - 1)   # launcher payload follows
        j = j - 1
    p_wkind[base + at] = kind
    p_wx_pin[base + at] = -1
    _set_wstr(_wexec_ptr(base + at), cast[Ptr[uint8]](""), LEXEC_SZ)
    _set_wstr(_wlabel_ptr(base + at), cast[Ptr[uint8]](""), LLABEL_SZ)
    p_nwidg[panel] = nw + 1


# Remove the widget at flow index `at` from panel `panel`, shifting later
# widgets down.
def _remove_widget(panel: uint64, at: uint64):
    if panel >= n_panels:
        return
    nw: uint64 = p_nwidg[panel]
    if at >= nw:
        return
    base: uint64 = panel * MAX_WIDGETS
    j: uint64 = at
    while j + 1 < nw:
        p_wkind[base + j] = p_wkind[base + j + 1]
        p_wx_pin[base + j] = p_wx_pin[base + j + 1]
        _copy_wstr_slot(base + j, base + j + 1)   # launcher payload follows
        j = j + 1
    p_nwidg[panel] = nw - 1


def _default_config():
    # MATE-style two-panel default (the no-file fallback). It MUST stay
    # byte-for-byte equivalent to the shipped /etc/panel.conf so the fallback
    # path renders identically to the on-disk config:
    #   TOP    [menu] [spacer ......] [tray] [sysmon] [clock]
    #   BOTTOM [tasks .......................] [pager]
    # The window-list (tasks) lives on the BOTTOM panel ONLY (MATE
    # convention); the TOP panel carries the Applications menu + the status
    # area (notification TRAY, sysmon, clock), with an elastic SPACER as the
    # filler so the trailing tray/sysmon/clock right-align (clock outermost).
    # The workspace PAGER trails the bottom window-list.
    # #264: the window-list used to appear on BOTH panels (tasks top AND
    # bottom) — a redundant duplicate; it is now bottom-only. The tray (bell)
    # and pager are kept in the default (the tray is where the #272 inbox
    # popup anchors; the pager is the #213 Ctrl+Alt+arrows workspace switcher).
    n_panels = 0
    pi: uint64 = _begin_panel(EDGE_TOP)
    _add_widget(pi, WK_MENU)
    # #283: a one-click Terminal launcher next to the Applications menu. Since
    # #282 the DE no longer auto-opens a terminal, so this button is the
    # intended one-click way to get one (spawns /bin/hamtermscene).
    _add_launcher(pi, cast[Ptr[uint8]]("/bin/hamtermscene"),
                  cast[Ptr[uint8]]("Terminal"))
    _add_widget(pi, WK_SPACER)
    _add_widget(pi, WK_TRAY)
    _add_widget(pi, WK_SYSMON)
    _add_widget(pi, WK_CLOCK)
    pb: uint64 = _begin_panel(EDGE_BOTTOM)
    _add_widget(pb, WK_TASKS)
    _add_widget(pb, WK_PAGER)


# Match the word at buf[s..e) against a NUL-terminated literal.
def _word_eq(buf: Ptr[uint8], s: uint64, e: uint64, lit: Ptr[uint8]) -> int32:
    ll: uint64 = _slen(lit)
    if e - s != ll:
        return 0
    k: uint64 = 0
    while k < ll:
        if buf[s + k] != lit[k]:
            return 0
        k = k + 1
    return 1


def _widget_kind(buf: Ptr[uint8], s: uint64, e: uint64) -> int32:
    if _word_eq(buf, s, e, cast[Ptr[uint8]]("menu")) != 0:
        return WK_MENU
    if _word_eq(buf, s, e, cast[Ptr[uint8]]("tasks")) != 0:
        return WK_TASKS
    if _word_eq(buf, s, e, cast[Ptr[uint8]]("clock")) != 0:
        return WK_CLOCK
    if _word_eq(buf, s, e, cast[Ptr[uint8]]("sysmon")) != 0:
        return WK_SYSMON
    if _word_eq(buf, s, e, cast[Ptr[uint8]]("spacer")) != 0:
        return WK_SPACER
    if _word_eq(buf, s, e, cast[Ptr[uint8]]("pager")) != 0:
        return WK_PAGER
    if _word_eq(buf, s, e, cast[Ptr[uint8]]("tray")) != 0:
        return WK_TRAY
    if _word_eq(buf, s, e, cast[Ptr[uint8]]("session")) != 0:
        return WK_SESSION
    return -1


def _edge_kind(buf: Ptr[uint8], s: uint64, e: uint64) -> int32:
    if _word_eq(buf, s, e, cast[Ptr[uint8]]("top")) != 0:
        return EDGE_TOP
    if _word_eq(buf, s, e, cast[Ptr[uint8]]("bottom")) != 0:
        return EDGE_BOTTOM
    if _word_eq(buf, s, e, cast[Ptr[uint8]]("left")) != 0:
        return EDGE_LEFT
    if _word_eq(buf, s, e, cast[Ptr[uint8]]("right")) != 0:
        return EDGE_RIGHT
    return -1


# Parse a decimal int from buf[s..e).
def _parse_i64(buf: Ptr[uint8], s: uint64, e: uint64) -> int64:
    v: int64 = 0
    i: uint64 = s
    while i < e and buf[i] >= 48 and buf[i] <= 57:
        v = v * 10 + cast[int64](buf[i]) - 48
        i = i + 1
    return v


# Copy a hex colour token buf[s..e) into a NUL-terminated dest (<=9 chars).
def _copy_color(buf: Ptr[uint8], s: uint64, e: uint64, dst: Ptr[uint8]):
    k: uint64 = 0
    i: uint64 = s
    while i < e and k < 9:
        dst[k] = buf[i]
        k = k + 1
        i = i + 1
    dst[k] = 0


# Legacy single-panel state assembled from bare left/right/position lines.
_legacy_seen: int32 = 0
_legacy_idx:  uint64 = 0
_legacy_edge: int32 = 0


def _legacy_panel() -> uint64:
    # Lazily create (once) the implicit panel that holds bare left/right
    # widgets. Its edge is whatever the most recent `position` line set.
    if _legacy_seen == 0:
        _legacy_idx = _begin_panel(_legacy_edge)
        _legacy_seen = 1
    return _legacy_idx


# The ACTIVE config is the writable runtime override /tmp/hamnix-panel.conf
# (tmpfs — writable from the DE) if it exists, else the shipped read-only
# default /etc/panel.conf. This is the crux of the position/sysmon-toggle
# bug: the sysroot /etc is NOT writable from the running DE, so a Settings
# (or shell) write to /etc/panel.conf was silently dropped and the panel
# never saw a change. Settings now writes the override in /tmp, which the
# panel reads + live-polls. (Mirrors how the wallpaper already lands in /tmp.)
# Which file _open_config actually opened. Kept so every diagnostic below can
# name THE FILE it is talking about: "unparseable" is useless to the person
# holding the editor unless it says which of the two paths it read.
CFGSRC_NONE: int32 = 0
CFGSRC_TMP:  int32 = 1
CFGSRC_ETC:  int32 = 2
_cfg_src: int32 = 0


def _cfg_src_name() -> Ptr[uint8]:
    if _cfg_src == CFGSRC_TMP:
        return cast[Ptr[uint8]]("/tmp/hamnix-panel.conf")
    return cast[Ptr[uint8]]("/etc/panel.conf")


def _open_config() -> int32:
    fd: int32 = sys_open(cast[Ptr[char]]("/tmp/hamnix-panel.conf"))
    if fd >= 0:
        _cfg_src = CFGSRC_TMP
        return fd
    fd = sys_open(cast[Ptr[char]]("/etc/panel.conf"))
    if fd >= 0:
        _cfg_src = CFGSRC_ETC
    else:
        _cfg_src = CFGSRC_NONE
    return fd


# ---- saying so -----------------------------------------------------------
# A config that cannot be read must SAY SO, by name, on stderr. NORTH_STAR.md:
# "a thing that cannot work here fails loudly and by name. A default is never
# a substitute for an answer." Falling back to _default_config is fine —
# falling back SILENTLY is the bug, and it is the bug that hid this one,
# because the fallback happens to render very nearly the same layout.
_cfg_dnum: Array[24, uint8]


def _cfg_say(head: Ptr[uint8], n: uint64, tail: Ptr[uint8]):
    _writeall(2, cast[Ptr[uint8]]("hampanelscene: "))
    _writeall(2, _cfg_src_name())
    _writeall(2, cast[Ptr[uint8]](": "))
    _writeall(2, head)
    nd: uint64 = _u64_to_dec(n, &_cfg_dnum[0])
    sys_write(2, &_cfg_dnum[0], nd)
    _writeall(2, tail)


# ---- the reader ----------------------------------------------------------
# THE DEFECT THIS SHAPE REMOVES. This used to be "read the whole file into a
# 2047-byte buffer, then split it into lines". etc/panel.conf is 3120 bytes
# and its first `panel` directive does not begin until byte 2834 — the entire
# read landed INSIDE the comment header that documents the format, the file
# parsed to ZERO panels, and the panel silently fell back to _default_config.
# Editing the documented configuration file did nothing at all, and nothing
# said so. The only visible tell was that the bars came up in a colour that is
# not the `color #d4d0c8` the file asks for.
#
# A BIGGER FIXED BUFFER IS THE SAME DEFECT AT A LARGER SIZE. This tree has
# been bitten by exactly that at 16 KiB (hook output), 8 KiB (/etc/modules)
# and 8 KiB (`tail`). So the file is not held in memory at all: it is READ IN
# CHUNKS and parsed A LINE AT A TIME. The config now has NO SIZE CEILING —
# a 3 KB file, a 300 KB file, and a file with a 10,000-line comment header all
# parse identically. The only bound left is the length of ONE LINE, which is a
# real bound on the grammar (the longest legal directive is a
# `widget launcher <exec> <label>`, and LEXEC_SZ + LLABEL_SZ is 88), it is
# generous at 512, and overrunning it is REPORTED rather than swallowed.
CFG_CHUNK:    uint64 = 4096
CFG_LINE_MAX: uint64 = 512

_cfg_chunk: Array[4096, uint8]
_cfg_line:  Array[512, uint8]

# Parser state. `_cfg_cur` was a local of _load_config when the parse ran as
# one loop over one whole-file buffer; a line-at-a-time parser has to carry
# the open `panel` block across calls, so it lives here.
_cfg_cur:   uint64 = 4                 # == MAX_PANELS -> "no open block"
_cfg_bytes: uint64 = 0                 # bytes read on the last parse
_cfg_lines: uint64 = 0                 # lines seen on the last parse
_cfg_long:  uint64 = 0                 # lines that overran CFG_LINE_MAX


def _cfg_parse_line(le: uint64):
    # One config line, already stripped of its newline, in _cfg_line[0..le).
    p: uint64 = 0
    while p < le and (_cfg_line[p] == 32 or _cfg_line[p] == 9):
        p = p + 1
    if p >= le or _cfg_line[p] == 35:               # blank or '#'
        return
    w0s: uint64 = p
    while p < le and _cfg_line[p] != 32 and _cfg_line[p] != 9:
        p = p + 1
    w0e: uint64 = p
    while p < le and (_cfg_line[p] == 32 or _cfg_line[p] == 9):
        p = p + 1
    w1s: uint64 = p
    while p < le and _cfg_line[p] != 32 and _cfg_line[p] != 9:
        p = p + 1
    w1e: uint64 = p

    # --- new block form ---------------------------------------
    if _word_eq(&_cfg_line[0], w0s, w0e, cast[Ptr[uint8]]("panel")) != 0:
        _cfg_cur = _begin_panel(EDGE_TOP)
        return
    if _word_eq(&_cfg_line[0], w0s, w0e, cast[Ptr[uint8]]("end")) != 0:
        _cfg_cur = MAX_PANELS
        return
    if _cfg_cur < n_panels:
        cur_panel: uint64 = _cfg_cur
        if _word_eq(&_cfg_line[0], w0s, w0e, cast[Ptr[uint8]]("edge")) != 0:
            ek: int32 = _edge_kind(&_cfg_line[0], w1s, w1e)
            if ek >= 0:
                p_edge[cur_panel] = ek
                # adopt the matching default thickness for the new
                # orientation unless a size line overrides it later
                if ek == EDGE_LEFT or ek == EDGE_RIGHT:
                    p_size[cur_panel] = PANEL_DEF_V
                else:
                    p_size[cur_panel] = PANEL_DEF_H
            return
        if _word_eq(&_cfg_line[0], w0s, w0e, cast[Ptr[uint8]]("color")) != 0:
            if w1e > w1s:
                _copy_color(&_cfg_line[0], w1s, w1e, p_color_ptr(cur_panel))
            return
        if _word_eq(&_cfg_line[0], w0s, w0e, cast[Ptr[uint8]]("size")) != 0:
            sz: int64 = _parse_i64(&_cfg_line[0], w1s, w1e)
            if sz > 0:
                p_size[cur_panel] = sz
            return
        if _word_eq(&_cfg_line[0], w0s, w0e, cast[Ptr[uint8]]("font")) != 0:
            if _word_eq(&_cfg_line[0], w1s, w1e, cast[Ptr[uint8]]("bold")) != 0:
                p_bold[cur_panel] = 1
            else:
                p_bold[cur_panel] = 0
            return
        if _word_eq(&_cfg_line[0], w0s, w0e, cast[Ptr[uint8]]("widget")) != 0:
            # `widget launcher <exec> <label>` — a launcher carries two
            # extra tokens (Exec path + label) so it is parsed here, not via
            # _widget_kind (which maps a single keyword to a kind).
            if _word_eq(&_cfg_line[0], w1s, w1e,
                        cast[Ptr[uint8]]("launcher")) != 0:
                lq: uint64 = w1e
                while lq < le and (_cfg_line[lq] == 32 or _cfg_line[lq] == 9):
                    lq = lq + 1
                exs: uint64 = lq
                while lq < le and _cfg_line[lq] != 32 and _cfg_line[lq] != 9:
                    lq = lq + 1
                exe: uint64 = lq
                while lq < le and (_cfg_line[lq] == 32 or _cfg_line[lq] == 9):
                    lq = lq + 1
                lbs: uint64 = lq
                while lq < le and _cfg_line[lq] != 32 and _cfg_line[lq] != 9:
                    lq = lq + 1
                lbe: uint64 = lq
                if exe > exs:
                    exbuf: Array[64, uint8]
                    lbbuf: Array[24, uint8]
                    _copy_tok(&_cfg_line[0], exs, exe, &exbuf[0], 64)
                    if lbe > lbs:
                        _copy_tok(&_cfg_line[0], lbs, lbe, &lbbuf[0], 24)
                    else:
                        lbbuf[0] = 63              # '?'
                        lbbuf[1] = 0
                    _add_launcher(cur_panel, &exbuf[0], &lbbuf[0])
                return
            wk: int32 = _widget_kind(&_cfg_line[0], w1s, w1e)
            if wk >= 0:
                # Optional `x <n>` suffix pins the widget at a flow-axis
                # coordinate (bug 3). Scan the rest of the line for it.
                wpin: int64 = -1
                q: uint64 = w1e
                while q < le and (_cfg_line[q] == 32 or _cfg_line[q] == 9):
                    q = q + 1
                w2s: uint64 = q
                while q < le and _cfg_line[q] != 32 and _cfg_line[q] != 9:
                    q = q + 1
                w2e: uint64 = q
                if _word_eq(&_cfg_line[0], w2s, w2e, cast[Ptr[uint8]]("x")) != 0:
                    while q < le and (_cfg_line[q] == 32 or _cfg_line[q] == 9):
                        q = q + 1
                    w3s: uint64 = q
                    while q < le and _cfg_line[q] != 32 and _cfg_line[q] != 9:
                        q = q + 1
                    if q > w3s:
                        wpin = _parse_i64(&_cfg_line[0], w3s, q)
                _add_widget_pin(cur_panel, wk, wpin)
            return
        # unknown key inside a block: ignore
        return

    # --- legacy bare lines (outside any block) ----------------
    if _word_eq(&_cfg_line[0], w0s, w0e, cast[Ptr[uint8]]("position")) != 0:
        ek2: int32 = _edge_kind(&_cfg_line[0], w1s, w1e)
        if ek2 == EDGE_BOTTOM:
            _legacy_edge = EDGE_BOTTOM
        elif ek2 == EDGE_LEFT:
            _legacy_edge = EDGE_LEFT
        elif ek2 == EDGE_RIGHT:
            _legacy_edge = EDGE_RIGHT
        else:
            _legacy_edge = EDGE_TOP
        # if the legacy panel already exists, retro-apply the edge
        if _legacy_seen != 0:
            p_edge[_legacy_idx] = _legacy_edge
            if _legacy_edge == EDGE_LEFT or _legacy_edge == EDGE_RIGHT:
                p_size[_legacy_idx] = PANEL_DEF_V
            else:
                p_size[_legacy_idx] = PANEL_DEF_H
        return
    sidew: int32 = -1
    if _word_eq(&_cfg_line[0], w0s, w0e, cast[Ptr[uint8]]("left")) != 0:
        sidew = 0
    if _word_eq(&_cfg_line[0], w0s, w0e, cast[Ptr[uint8]]("right")) != 0:
        sidew = 1
    if sidew >= 0 and w1e > w1s:
        wk2: int32 = _widget_kind(&_cfg_line[0], w1s, w1e)
        if wk2 >= 0:
            lp: uint64 = _legacy_panel()
            if lp < n_panels:
                # A bare `right <w>` widget that follows the elastic
                # taskbar packs to the far edge; we encode that by making
                # the widget order menu/tasks(left) ... sysmon/clock and
                # relying on the renderer's right-align of trailing fixed
                # widgets. Insert in source order; `right` widgets simply
                # come after `left` ones in the list.
                _add_widget(lp, wk2)
    # unknown bare line: ignore


def _load_config():
    # Parse the active panel config into the panel set. Supports the new
    # `panel ... end` blocks AND the legacy `position`/`left`/`right` bare
    # lines (which build one implicit panel). On ANY failure fall back to the
    # built-in default — LOUDLY, naming the file and what went wrong.
    n_panels = 0
    _legacy_seen = 0
    _legacy_edge = EDGE_TOP
    _cfg_cur = MAX_PANELS                  # MAX_PANELS = "no open block"
    _cfg_bytes = 0
    _cfg_lines = 0
    _cfg_long = 0
    fd: int32 = _open_config()
    if fd < 0:
        _cfg_say(cast[Ptr[uint8]]("cannot open it, and neither config path exists ("),
                 0,
                 cast[Ptr[uint8]](" bytes read) -- using the built-in default layout\n"))
        _default_config()
        return
    ll:   uint64 = 0                       # bytes buffered for this line
    over: int32  = 0                       # this line overran CFG_LINE_MAX
    while 1 == 1:
        r: int64 = sys_read(fd, &_cfg_chunk[0], CFG_CHUNK)
        if r <= 0:
            break
        _cfg_bytes = _cfg_bytes + cast[uint64](r)
        got: uint64 = cast[uint64](r)
        k: uint64 = 0
        while k < got:
            c: uint8 = _cfg_chunk[k]
            k = k + 1
            if c == 10:
                _cfg_lines = _cfg_lines + 1
                if over != 0:
                    _cfg_long = _cfg_long + 1
                _cfg_parse_line(ll)
                ll = 0
                over = 0
            elif ll < CFG_LINE_MAX:
                _cfg_line[ll] = c
                ll = ll + 1
            else:
                over = 1
    sys_close(fd)
    if ll > 0 or over != 0:                # a last line with no trailing \n
        _cfg_lines = _cfg_lines + 1
        if over != 0:
            _cfg_long = _cfg_long + 1
        _cfg_parse_line(ll)
    if _cfg_long > 0:
        _cfg_say(cast[Ptr[uint8]]("TRUNCATED -- "),
                 _cfg_long,
                 cast[Ptr[uint8]](" line(s) are longer than the 512-byte line limit and were cut; those directives are NOT what the file says\n"))
    if n_panels == 0:
        # The file exists and was read to the end, and described no panel.
        # Say the size, so "there is no file" and "the file says nothing I
        # understand" cannot be mistaken for one another.
        _cfg_say(cast[Ptr[uint8]]("parsed 0 panels from "),
                 _cfg_bytes,
                 cast[Ptr[uint8]](" byte(s) -- using the built-in default layout INSTEAD of this file\n"))
        _default_config()
        return
    _cfg_say(cast[Ptr[uint8]]("honoured, "),
             n_panels,
             cast[Ptr[uint8]](" panel(s)\n"))


# Live config re-read. STREAMING, like the parse: the whole file is hashed a
# chunk at a time (FNV-1a 64) and compared against the last hash + length, so
# there is no snapshot buffer and therefore no size at which a change stops
# being noticed. The old code compared the first 2047 bytes, which for the
# shipped file meant it compared nothing but the comment header — an edit to
# the directives at the END of etc/panel.conf did not even register as a
# CHANGE, let alone get parsed.
_cfg_snap_len:  uint64 = 0xffffffffffffffff     # "never primed"
_cfg_snap_hash: uint64 = 0


def _cfg_changed() -> int32:
    fd: int32 = _open_config()
    total: uint64 = 0
    h: uint64 = 0xcbf29ce484222325
    if fd >= 0:
        while 1 == 1:
            r: int64 = sys_read(fd, &_cfg_chunk[0], CFG_CHUNK)
            if r <= 0:
                break
            got: uint64 = cast[uint64](r)
            k: uint64 = 0
            while k < got:
                h = (h ^ cast[uint64](_cfg_chunk[k])) * 0x100000001b3
                k = k + 1
            total = total + got
        sys_close(fd)
    if total == _cfg_snap_len and h == _cfg_snap_hash:
        return 0
    _cfg_snap_len = total
    _cfg_snap_hash = h
    return 1


# Edge index -> config keyword.
def _edge_word(e: int32) -> Ptr[uint8]:
    if e == EDGE_BOTTOM:
        return cast[Ptr[uint8]]("bottom")
    if e == EDGE_LEFT:
        return cast[Ptr[uint8]]("left")
    if e == EDGE_RIGHT:
        return cast[Ptr[uint8]]("right")
    return cast[Ptr[uint8]]("top")


# Widget kind -> config keyword.
def _kind_word(k: int32) -> Ptr[uint8]:
    if k == WK_TASKS:
        return cast[Ptr[uint8]]("tasks")
    if k == WK_CLOCK:
        return cast[Ptr[uint8]]("clock")
    if k == WK_SYSMON:
        return cast[Ptr[uint8]]("sysmon")
    if k == WK_SPACER:
        return cast[Ptr[uint8]]("spacer")
    if k == WK_PAGER:
        return cast[Ptr[uint8]]("pager")
    if k == WK_TRAY:
        return cast[Ptr[uint8]]("tray")
    if k == WK_SESSION:
        return cast[Ptr[uint8]]("session")
    return cast[Ptr[uint8]]("menu")


# The WRITE side of the same file, and the other half of the same audit.
#
# Unlike the READ side, what _save_config emits is BOUNDED at compile time by
# the panel model, so a fixed buffer is the right shape here — but it has to
# be big enough to hold the bound, and 2048 was not. Worst case, exactly:
#
#   file header                                                     50
#   per panel  "panel pN\n" 9 + edge 14 + size 28 + color 16 + font 14 = 81
#   per widget "  widget launcher " 18 + LEXEC_SZ 63 + " " + LLABEL_SZ 23
#              + "\n"                                              = 106
#   per panel  81 + MAX_WIDGETS(12) * 106 + "end\n" 4              = 1357
#   total      50 + MAX_PANELS(4) * 1357                           = 5478
#
# At 2048 a panel set carrying launchers ran off the end: _sb_emit clamped,
# but the bare `_save_buf[p] = 10` newline stores and _u64_to_dec did not, and
# `p` kept climbing past the array — a BSS overrun, not a truncation. 8192
# covers the bound with 2.7 KB of margin, every store is bounds-checked
# through _sb_byte, and a serialization that somehow still hits the cap is
# REFUSED rather than written: half a config on disk is a config the panel
# then reads back and obeys.
SAVE_CAP: uint64 = 8192
_save_buf: Array[8192, uint8]


def _sb_byte(p: uint64, c: uint8) -> uint64:
    if p + 1 >= SAVE_CAP:
        return p
    _save_buf[p] = c
    return p + 1


def _sb_emit(p: uint64, s: Ptr[uint8]) -> uint64:
    k: uint64 = 0
    while s[k] != 0 and p + 1 < SAVE_CAP:
        _save_buf[p] = s[k]
        p = p + 1
        k = k + 1
    return p


def _sb_dec(p: uint64, v: uint64) -> uint64:
    # _u64_to_dec writes up to 20 digits; only call it with room for them.
    if p + 24 >= SAVE_CAP:
        return p
    return p + _u64_to_dec(v, &_save_buf[p])


# Serialize the live panel set to /tmp/hamnix-panel.conf in the EXACT
# `panel ... end` block schema _load_config parses. Called after every
# Add / Move / Remove so edits survive a restart. After writing we re-prime
# the live-reload baseline (_cfg_changed) so our OWN write does NOT trip a
# spurious reload on the next tick (which would otherwise rebuild the panel
# set and momentarily flicker).
def _save_config():
    p: uint64 = 0
    p = _sb_emit(p, cast[Ptr[uint8]]("# hamnix panel config (auto-saved by hampanelscene)\n"))
    pi: uint64 = 0
    while pi < n_panels:
        p = _sb_emit(p, cast[Ptr[uint8]]("panel p"))
        p = _sb_dec(p, pi)
        p = _sb_byte(p, 10)
        p = _sb_emit(p, cast[Ptr[uint8]]("  edge "))
        p = _sb_emit(p, _edge_word(p_edge[pi]))
        p = _sb_byte(p, 10)
        p = _sb_emit(p, cast[Ptr[uint8]]("  size "))
        p = _sb_dec(p, cast[uint64](p_size[pi]))
        p = _sb_byte(p, 10)
        p = _sb_emit(p, cast[Ptr[uint8]]("  color "))
        p = _sb_emit(p, p_color_ptr(pi))
        p = _sb_byte(p, 10)
        p = _sb_emit(p, cast[Ptr[uint8]]("  font "))
        if p_bold[pi] != 0:
            p = _sb_emit(p, cast[Ptr[uint8]]("bold"))
        else:
            p = _sb_emit(p, cast[Ptr[uint8]]("normal"))
        p = _sb_byte(p, 10)
        nw: uint64 = p_nwidg[pi]
        a: uint64 = 0
        while a < nw:
            gslot: uint64 = pi * MAX_WIDGETS + a
            wkv: int32 = p_wkind[gslot]
            p = _sb_emit(p, cast[Ptr[uint8]]("  widget "))
            if wkv == WK_LAUNCHER:
                # `widget launcher <exec> <label>` round-trips the payload.
                p = _sb_emit(p, cast[Ptr[uint8]]("launcher "))
                p = _sb_emit(p, _wexec_ptr(gslot))
                p = _sb_emit(p, cast[Ptr[uint8]](" "))
                p = _sb_emit(p, _wlabel_ptr(gslot))
            else:
                p = _sb_emit(p, _kind_word(wkv))
                pin: int64 = p_wx_pin[gslot]
                if pin >= 0:
                    p = _sb_emit(p, cast[Ptr[uint8]](" x "))
                    p = _sb_dec(p, cast[uint64](pin))
            p = _sb_byte(p, 10)
            a = a + 1
        p = _sb_emit(p, cast[Ptr[uint8]]("end\n"))
        pi = pi + 1
    if p + 32 >= SAVE_CAP:
        # Unreachable given the bound computed at SAVE_CAP — which is exactly
        # why it must say so rather than write. A HALF config is worse than no
        # config: the panel reads its own write back on the next tick and
        # obeys whatever survived the cut.
        _cfg_src = CFGSRC_TMP
        _cfg_say(cast[Ptr[uint8]]("REFUSING TO SAVE -- the serialized panel set needs at least "),
                 p,
                 cast[Ptr[uint8]](" bytes and the buffer is 8192; your edit is NOT on disk\n"))
        return
    fd: int32 = sys_open_write(cast[Ptr[char]]("/tmp/hamnix-panel.conf"))
    if fd >= 0:
        sys_write(fd, &_save_buf[0], p)
        sys_close(fd)
    # Re-prime the live-reload baseline so this write doesn't trigger a reload.
    _cfg_changed()


# ====================================================================
# LAYOUT + RENDER (one panel at a time; main() iterates panels)
# ====================================================================

PANEL_H: int64 = 26                  # nominal horizontal bar height (gate)
GLYPH_Y: int64 = 5
MENU_ROW_H: int64 = 22
APP_BTN_W: int64 = 104               # Apps button box (label fully inside)
APP_DIV_X: int64 = 104               # divider line x within the button cell
MENU_W: int64 = 136
# MENU_H is DYNAMIC: _load_apps() sets it (window-reservation height = the
# taller of the main dropdown OR the "Linux apps" fly-out child, so whichever
# popup is showing fits inside the grown panel window). The 202 default (9
# rows) is the fallback used only if the catalogue is empty at first paint.
MENU_H: int64 = 202
# The main dropdown's OWN box height (native rows + the "Linux apps" parent
# row). Distinct from MENU_H, which also has to cover the child fly-out.
menu_main_h: int64 = 202
# MATE-style HOVER SUBMENUS (child fly-out popups), one PER DISTRIBUTION. The
# main dropdown lists the NATIVE apps plus one parent row per attached
# distribution — "Debian apps ▸", "Alpine apps ▸" — and mousing over one opens
# its child popup listing that distribution's .desktop apps, launched via
# `enter <name> { … }`. Wider than MENU_W so full app names + the
# "No <name> apps installed" placeholder fit (8px mono cell).
SUBMENU_W: int64 = 224
# 0 = no fly-out open; otherwise the section index + 1 (so `!= 0` still reads
# as "a fly-out is showing", which is what every call site asks).
sub_open:  int32 = 0
sub_box_x: int64 = 0
sub_box_y: int64 = 0
SYSMON_W: int64 = 116
CLOCK_W: int64 = 136                 # MATE date+time: "Sat Jul 12  14:30" (17ch)
TASK_BTN_W: int64 = 132
# Workspace-switcher cell: WS_COUNT cells of PAGER_CELL_W with 2px gaps.
PAGER_CELL_W: int64 = 22
PAGER_W: int64 = 92                   # 4*22 + 3*2 gaps, rounded
TRAY_W: int64 = 24                    # bell glyph cell
SESSION_W: int64 = 24                 # power glyph cell

# ====================================================================
# DATA-DRIVEN APPLICATIONS MENU (lib/desktopentry.ad)
# ====================================================================
# The Applications dropdown is populated at startup from the
# *.desktop files under /etc/hamde/apps/ — one file per app. Adding an
# app is dropping a file, never a code edit. Entries are sorted by
# (category, Name) so the flat dropdown clusters apps by section. If the
# directory is missing/empty (e.g. a stripped image), _seed_fallback()
# plants the known native app set so the DE is never menu-less.
# AM_MAX is a HARD cap: _am_add() SILENTLY DROPS every entry past it, so it
# must stay comfortably ahead of the shipped launcher count or apps vanish
# from the Applications menu with no error anywhere. It was 24 while
# etc/hamde/apps/ shipped 26 launchers (+ the /n/linux section on top), which
# is exactly how the office suite (hamwrite/hamsheet/hamslides) went missing
# from a booted image even though every launcher, binary and package was
# staged correctly. Keep this >= `ls etc/hamde/apps/*.desktop | wc -l` plus
# the optional-package launchers plus the Linux-ns section (test:
# scripts/test_de_appmenu_datadriven.sh asserts the headroom).
AM_MAX:      uint64 = 64
AM_NAME_CAP: uint64 = 40
AM_PROG_CAP: uint64 = 96

def _apps_dir() -> Ptr[uint8]:
    return "/etc/hamde/apps"

# ====================================================================
# THE DISTRIBUTION NAMESPACES — one menu section per distribution
# ====================================================================
# This used to be `_linux_apps_dir()`, the literal string
# "/n/linux/usr/share/applications", and ONE menu section called "Linux".
# That is a Debian disk with a general-sounding name, not a mechanism: a
# second distribution needed a code edit here, and the section was empty on
# every image anyway because nothing ever bound /n/linux.
#
# What replaces it is the same description the rest of the system reads:
# /etc/distros, the `<name> <source>` table that `bind '#distro/<name>'`
# resolves (docs/linux_distro_namespaces.md §2.2). The panel reads only the
# NAMES out of it — which is the whole point, and the reason it can: reading
# a `source` means resolving a volume LABEL, which means opening a block
# device, which an unprivileged process cannot do. The name is what crosses
# the boundary; the boot already posted each namespace's server at /n/<name>.
#
# So the scan is: for every name in /etc/distros, if /n/<name> is a real
# populated tree, give it a menu section called after it and scan
# /n/<name>/usr/share/applications for its .desktop files.
#
# THE THREE STATES ARE DELIBERATELY DISTINCT, because this is a dead path
# being made live and the failure modes here are exactly the success-shaped
# ones NORTH_STAR.md names:
#
#   * named in /etc/distros, /n/<name> empty or absent  -> NO SECTION. The
#     distribution is DESCRIBED, not attached (its medium was not built, or
#     the bind failed). A section for it would claim a namespace that is not
#     there, and clicking into it would launch into nothing.
#   * attached, but no usr/share/applications, or none of its .desktop files
#     is displayable -> A SECTION with one disabled row saying so, by name.
#     The namespace IS there; it just ships no launchers. That is a real
#     answer and a different one.
#   * attached with launchers -> the section, its apps, launched with
#     `enter <name> { … }`.
DM_MAX:      uint64 = 6
DM_NAME_CAP: uint64 = 24
dm_count:    uint64 = 0
dm_name:     Array[6, Array[24, uint8]]
dm_name_len: Array[6, uint64]
# Per-section entry count, in the same order. The model stores every
# distribution's entries contiguously after the native ones (they sort by
# cat = DE_CAT_LINUX + section index), so a section's slice is
# [_dm_start(i), _dm_start(i) + dm_apps[i]).
dm_apps:     Array[6, uint64]

am_count: uint64 = 0
am_name:     Array[64, Array[40, uint8]]
am_name_len: Array[64, uint64]
am_prog:     Array[64, Array[96, uint8]]
am_prog_len: Array[64, uint64]
am_cat:      Array[64, int32]
# Per-entry Terminal=true flag (freedesktop). A CLI app (e.g. the Linux
# "Process Viewer" `top`) has no window surface of its own, so it must be
# hosted in a rendered terminal emulator (hamtermscene) rather than launched
# headless — otherwise clicking it opens nothing. 1 = needs a terminal host.
am_term:     Array[64, uint8]

# Scan scratch: the directory listing + one file's contents.
_am_listbuf: Array[4096, uint8]
_am_filebuf: Array[2048, uint8]
_am_path:    Array[160, uint8]

# Distribution-table scratch. Top-level BSS, not frame locals: this compiler
# puts a large frame array nowhere useful.
#
# THE DEFECT THIS SHAPE REMOVES, and it is the panel config's twice over.
# /etc/distros used to be read by ONE UNLOOPED `sys_read(fd, &_dm_buf[0],
# 2047)` into a 2048-byte buffer. The shipped table (etc/distros.linux) is
# 1426 bytes of which ~1300 is the comment header that documents the format,
# so the three rows that matter — `default`, `debian`, `alpine` — live in the
# last hundred bytes, and 621 bytes of headroom stood between them and an
# Applications menu with no distributions in it. Worse than the margin: a
# SHORT READ is legal for any read(2), at any size, and with no accumulate
# loop a short read truncates the table silently — the rows are at the END,
# so what a short read costs is exactly the distributions.
#
# So the file is not held in memory at all. It is READ IN CHUNKS (through
# _cfg_chunk, the config parser's own 4 KiB chunk — the two parses never run
# inside one another) and parsed A LINE AT A TIME, with the read looped until
# EOF. The table now has NO SIZE CEILING; the only bound left is ONE LINE,
# which is a real bound on the grammar (`<name> <source>`, both short) and is
# REPORTED rather than swallowed when it is crossed.
DM_LINE_MAX: uint64 = 512
_dm_line:  Array[512, uint8]      # one row of /etc/distros
_dm_bytes: uint64 = 0             # bytes read on the last load
_dm_lines: uint64 = 0             # lines seen on the last load
_dm_long:  uint64 = 0             # rows longer than DM_LINE_MAX (cut)
_dm_list:  Array[1024, uint8]     # the /n/<name> presence probe's listing
_dm_path:  Array[160, uint8]      # "/n/<name>/usr/share/applications"
_dm_label: Array[48, uint8]       # "<Name> apps" — the parent row's text
_dm_empty: Array[48, uint8]       # "No <name> apps installed"
_dm_cmd:   Array[224, uint8]      # "enter <name> { <prog> }"
_dm_rc:    Array[64, uint8]       # "/etc/rc.de-ns/<name>"


# Compare menu slot `i` against (cat, name) for insertion-sort ordering.
# Returns >0 if slot i sorts AFTER (cat,name), <0 if before, 0 if equal.
def _am_cmp(i: uint64, cat: int32, name: Ptr[uint8], nlen: uint64) -> int32:
    if am_cat[i] > cat:
        return 1
    if am_cat[i] < cat:
        return -1
    # same category: lexicographic by name
    a: uint64 = 0
    while a < am_name_len[i] and a < nlen:
        if am_name[i][a] > name[a]:
            return 1
        if am_name[i][a] < name[a]:
            return -1
        a = a + 1
    if am_name_len[i] > nlen:
        return 1
    if am_name_len[i] < nlen:
        return -1
    return 0


# Insert (name, prog, cat) into the menu model, keeping it sorted by
# (category, Name). Silently drops overflow past AM_MAX.
def _am_add(name: Ptr[uint8], nlen: uint64, prog: Ptr[uint8],
            plen: uint64, cat: int32, term: int32):
    if am_count >= AM_MAX:
        return
    nl: uint64 = nlen
    if nl >= AM_NAME_CAP:
        nl = AM_NAME_CAP - 1
    pl: uint64 = plen
    if pl >= AM_PROG_CAP:
        pl = AM_PROG_CAP - 1
    # Find insertion point.
    pos: uint64 = 0
    while pos < am_count and _am_cmp(pos, cat, name, nl) < 0:
        pos = pos + 1
    # Shift tail up by one.
    j: uint64 = am_count
    while j > pos:
        k: uint64 = 0
        while k < AM_NAME_CAP:
            am_name[j][k] = am_name[j - 1][k]
            k = k + 1
        am_name_len[j] = am_name_len[j - 1]
        k = 0
        while k < AM_PROG_CAP:
            am_prog[j][k] = am_prog[j - 1][k]
            k = k + 1
        am_prog_len[j] = am_prog_len[j - 1]
        am_cat[j] = am_cat[j - 1]
        am_term[j] = am_term[j - 1]
        j = j - 1
    # Write the new slot.
    k2: uint64 = 0
    while k2 < nl:
        am_name[pos][k2] = name[k2]
        k2 = k2 + 1
    am_name[pos][nl] = 0
    am_name_len[pos] = nl
    k2 = 0
    while k2 < pl:
        am_prog[pos][k2] = prog[k2]
        k2 = k2 + 1
    am_prog[pos][pl] = 0
    am_prog_len[pos] = pl
    am_cat[pos] = cat
    am_term[pos] = cast[uint8](term)
    am_count = am_count + 1


# Fallback catalogue when /etc/hamde/apps is absent/empty. Mirrors the
# apps the scene DE ships so the menu is never blank. (cat codes match
# lib/desktopentry: 0 Accessories 1 Internet 2 Games 3 System 4 Settings)
def _seed_one(name: Ptr[uint8], prog: Ptr[uint8], cat: int32):
    _am_add(name, _slen(name), prog, _slen(prog), cat, 0)


# Live-medium probe: /etc/installer-medium is planted in the cpio ONLY by
# scripts/build_installer_img.sh, so it is present on the LIVE/installer boot
# and absent on every installed boot (see etc/rc.boot). Cached (0 unknown,
# 1 live, 2 installed): the installer launcher is surfaced ONLY when live.
_am_live_state: int32 = 0
def _am_is_live() -> int32:
    if _am_live_state == 0:
        fd: int32 = sys_open(cast[Ptr[char]]("/etc/installer-medium"))
        if fd >= 0:
            sys_close(fd)
            _am_live_state = 1
        else:
            _am_live_state = 2
    if _am_live_state == 1:
        return 1
    return 0


# ====================================================================
# A MENU ENTRY WHOSE PROGRAM IS NOT INSTALLED IS NOT AN ENTRY
# ====================================================================
# Found on a real boot. /etc/hamde/apps was staged on no machine at all, so
# every menu ran on a list compiled into it, and hamappmenu's list had drifted
# badly: counted against the image's APPS, NINE of its ELEVEN rows named a
# program /bin did not contain (only /bin/hamfm and /bin/hpm were there).
# A person clicked one and NOTHING HAPPENED, because the failure is invisible
# from this side: fork(2) succeeds, execve(2) fails in the CHILD, and the
# child dies silently -- so the panel logged `[panel] launched /bin/hamview`
# and the screen never changed. That is exactly the shape NORTH_STAR.md is
# about, the gap answering something success-shaped instead of the truth.
#
# This panel's own fallback had NOT drifted; what it needs is the rule for the
# CATALOGUE, which is what every machine reads now that /etc/hamde/apps is
# staged, and which can go stale in the other direction (a launcher shipped
# for a program a particular image does not build).
#
# WHY HIDE RATHER THAN GREY OUT. A disabled row is the right answer when the
# program is a thing you could get (an optional package you have not installed
# yet); it is the wrong answer for a name that exists nowhere in the
# distribution, because it advertises an application this system does not
# have. Every name reachable here is the second kind: the catalogue is
# /etc/hamde/apps, one file per SHIPPED app, and a launcher whose program is
# absent means the two disagree -- a packaging fault, not a user choice. So
# the row is dropped from the menu AND NAMED, on the panel's own stdout, in
# the same shape hamdesktop reports an unknown icon:
#
#     [panel] appmenu-missing <Name> <prog>
#
# Silence in either direction is what this is fixing: a person sees only rows
# that work, and whoever is looking at the boot log sees which launcher lost
# its program and which one.
#
# WHY THE PROBE IS NOT IN lib/desktopentry.ad, where the Exec parse lives:
# that module is deliberately extern-free and dual-target (it links into the
# host unit tests unchanged), so it cannot open a file. The probe is one
# sys_open per launcher, at startup, and hamappmenu carries the same three
# lines for the same reason.
#
# NOT APPLIED TO A DISTRIBUTION'S ENTRIES. A `/n/debian/...` launcher names a
# program inside that namespace, which this process cannot see and must not
# judge: those rows are scanned with force_cat >= 0 and pass through untested.
def _prog_installed(prog: Ptr[uint8]) -> int32:
    if prog[0] == 0:
        return 0
    fd: int32 = sys_open(cast[Ptr[char]](prog))
    if fd < 0:
        return 0
    sys_close(fd)
    return 1


def _report_missing(name: Ptr[uint8], prog: Ptr[uint8]):
    _writeall(1, cast[Ptr[uint8]]("[panel] appmenu-missing "))
    _writeall(1, name)
    _writeall(1, cast[Ptr[uint8]](" "))
    _writeall(1, prog)
    _writeall(1, cast[Ptr[uint8]]("\n"))


# WHY THIS LIST IS **NOT** RUN THROUGH _prog_installed the way the catalogue
# scan is. Its whole job is that the DE is never menu-less; a probe that can
# empty it defeats the only reason it exists, and the case it runs in -- no
# catalogue at all -- is by definition a root nobody staged, where an absent
# /bin/X says as much about the root as about the program. These rows are made
# honest at the CLICK instead: _launch below refuses a program that is not
# there BY NAME. (Every name here IS built by scripts/hamlinux_image.sh; this
# panel's list, unlike hamappmenu's, had not drifted.)
def _seed_fallback():
    _seed_one(cast[Ptr[uint8]]("Terminal"),       cast[Ptr[uint8]]("/bin/hamtermscene"), 3)
    _seed_one(cast[Ptr[uint8]]("Files"),          cast[Ptr[uint8]]("/bin/hamfmscene"),   0)
    _seed_one(cast[Ptr[uint8]]("Web Browser"),    cast[Ptr[uint8]]("/bin/hambrowse"),    1)
    _seed_one(cast[Ptr[uint8]]("Calculator"),     cast[Ptr[uint8]]("/bin/hamcalcscene"), 0)
    _seed_one(cast[Ptr[uint8]]("Editor"),         cast[Ptr[uint8]]("/bin/hameditscene"), 0)
    _seed_one(cast[Ptr[uint8]]("Control Center"), cast[Ptr[uint8]]("/bin/hamctl"),       4)
    _seed_one(cast[Ptr[uint8]]("System Monitor"), cast[Ptr[uint8]]("/bin/hammonscene"),  3)
    _seed_one(cast[Ptr[uint8]]("2048"),           cast[Ptr[uint8]]("/bin/ham2048scene"), 2)
    # The installer launcher is a LIVE-medium-only entry — never on an
    # installed system (matches installer.desktop's X-Hamnix-LiveOnly=true).
    if _am_is_live() != 0:
        _seed_one(cast[Ptr[uint8]]("Install Hamnix"), cast[Ptr[uint8]]("/bin/haminstallui"), 3)


# Build "<dir>/<name>" into _am_path (NUL-terminated).
def _am_build_path(dir: Ptr[uint8], name: Ptr[uint8], nlen: uint64):
    p: uint64 = 0
    while dir[p] != 0:
        _am_path[p] = dir[p]
        p = p + 1
    _am_path[p] = 47                                  # '/'
    p = p + 1
    k: uint64 = 0
    while k < nlen and p < 159:
        _am_path[p] = name[k]
        p = p + 1
        k = k + 1
    _am_path[p] = 0


# ---- /etc/distros: the names, and only the names --------------------

def _dm_is_space(c: uint8) -> int32:
    if c == 32 or c == 9 or c == 13:
        return 1
    return 0


# Is _dm_line[s..e) exactly the literal `lit`?
def _dm_tok_eq(s: uint64, e: uint64, lit: Ptr[uint8]) -> int32:
    k: uint64 = 0
    while s + k < e and lit[k] != 0:
        if _dm_line[s + k] != lit[k]:
            return 0
        k = k + 1
    if s + k == e and lit[k] == 0:
        return 1
    return 0


# "/n/<name>" (apps == 0) or "/n/<name>/usr/share/applications" (apps != 0),
# NUL-terminated, into _dm_path.
def _dm_mkpath(i: uint64, apps: int32):
    _dm_path[0] = 47                                  # '/'
    _dm_path[1] = 110                                 # 'n'
    _dm_path[2] = 47                                  # '/'
    p: uint64 = 3
    k: uint64 = 0
    while k < dm_name_len[i] and p < 100:
        _dm_path[p] = dm_name[i][k]
        p = p + 1
        k = k + 1
    if apps != 0:
        sfx: Ptr[uint8] = cast[Ptr[uint8]]("/usr/share/applications")
        q: uint64 = 0
        while sfx[q] != 0 and p < 159:
            _dm_path[p] = sfx[q]
            p = p + 1
            q = q + 1
    _dm_path[p] = 0


# Is the distribution's server actually posted at /n/<name>, with a tree
# behind it? An EMPTY directory called /n/alpine is the case that must not
# pass: it is what a failed `bind '#distro/alpine' /n/alpine` leaves behind,
# and a section built on it would launch every click into nothing.
def _dm_present(i: uint64) -> int32:
    _dm_mkpath(i, 0)
    if p9_listdir(cast[Ptr[char]](&_dm_path[0]), &_dm_list[0], 1024) <= 0:
        return 0
    return 1


# Record _dm_line[s..e) as a section name.
def _dm_add(s: uint64, e: uint64):
    if dm_count >= DM_MAX:
        return
    n: uint64 = e - s
    if n >= DM_NAME_CAP:
        n = DM_NAME_CAP - 1
    k: uint64 = 0
    while k < n:
        dm_name[dm_count][k] = _dm_line[s + k]
        k = k + 1
    dm_name[dm_count][n] = 0
    dm_name_len[dm_count] = n
    dm_apps[dm_count] = 0
    dm_count = dm_count + 1


# Read the distribution NAMES out of /etc/distros, keeping the ones whose
# namespace is really attached. `default` is skipped: it is an ALIAS for one
# of the other rows (docs/linux_distro_namespaces.md §2.2), so listing it
# would put Debian in the menu twice under two names — which is the same
# class of confidently-wrong answer as entering the wrong distribution.
def _dm_parse_line(le: uint64):
    # One row of /etc/distros, newline already stripped, in _dm_line[0..le).
    if dm_count >= DM_MAX:
        return
    # '#' starts a comment; the row is what precedes it.
    c: uint64 = 0
    while c < le and _dm_line[c] != 35:
        c = c + 1
    # first token = the name
    s: uint64 = 0
    while s < c and _dm_is_space(_dm_line[s]) != 0:
        s = s + 1
    t: uint64 = s
    while t < c and _dm_is_space(_dm_line[t]) == 0:
        t = t + 1
    # a row needs a SECOND token (the source) to be a row at all
    u: uint64 = t
    while u < c and _dm_is_space(_dm_line[u]) != 0:
        u = u + 1
    if t > s and u < c and _dm_tok_eq(s, t, cast[Ptr[uint8]]("default")) == 0:
        _dm_add(s, t)
        if _dm_present(dm_count - 1) == 0:
            # Described but not attached. Say which, once, on the panel
            # log: a distribution silently missing from the menu is how
            # someone spends an hour looking for an app that was never
            # mounted.
            _writeall(1, cast[Ptr[uint8]]("[panel] distribution not attached at /n/: "))
            _writeall(1, &dm_name[dm_count - 1][0])
            _writeall(1, cast[Ptr[uint8]]("\n"))
            dm_count = dm_count - 1


def _dm_say(head: Ptr[uint8], n: uint64, tail: Ptr[uint8]):
    _writeall(1, cast[Ptr[uint8]]("[panel] /etc/distros: "))
    _writeall(1, head)
    nd: uint64 = _u64_to_dec(n, &_cfg_dnum[0])
    sys_write(1, &_cfg_dnum[0], nd)
    _writeall(1, tail)


def _load_distros():
    dm_count = 0
    _dm_bytes = 0
    _dm_lines = 0
    _dm_long = 0
    fd: int32 = sys_open(cast[Ptr[char]]("/etc/distros"))
    if fd < 0:
        _writeall(1, cast[Ptr[uint8]]("[panel] no /etc/distros: no distribution sections\n"))
        return
    ll:   uint64 = 0                       # bytes buffered for this row
    over: int32  = 0                       # this row overran DM_LINE_MAX
    while 1 == 1:
        r: int64 = sys_read(fd, &_cfg_chunk[0], CFG_CHUNK)
        if r <= 0:
            break
        _dm_bytes = _dm_bytes + cast[uint64](r)
        got: uint64 = cast[uint64](r)
        k: uint64 = 0
        while k < got:
            ch: uint8 = _cfg_chunk[k]
            k = k + 1
            if ch == 10:
                _dm_lines = _dm_lines + 1
                if over != 0:
                    _dm_long = _dm_long + 1
                else:
                    _dm_parse_line(ll)
                ll = 0
                over = 0
            elif ll < DM_LINE_MAX:
                _dm_line[ll] = ch
                ll = ll + 1
            else:
                over = 1
    sys_close(fd)
    if ll > 0 or over != 0:                # a last row with no trailing \n
        _dm_lines = _dm_lines + 1
        if over != 0:
            _dm_long = _dm_long + 1
        else:
            _dm_parse_line(ll)
    if _dm_long > 0:
        # A cut row is never parsed at all — half a name is a different
        # distribution, and entering the wrong one is the failure this whole
        # table exists to prevent.
        _dm_say(cast[Ptr[uint8]]("TRUNCATED -- "), _dm_long,
                cast[Ptr[uint8]](" row(s) are longer than the 512-byte line limit and were NOT parsed\n"))
    # ALWAYS say how much was read, whatever the outcome. "there is no table",
    # "the table was read and names nothing that is here", and "the table was
    # cut short" are three different answers, and a byte count is what tells
    # them apart from a log.
    _writeall(1, cast[Ptr[uint8]]("[panel] /etc/distros: "))
    nb: uint64 = _u64_to_dec(_dm_bytes, &_cfg_dnum[0])
    sys_write(1, &_cfg_dnum[0], nb)
    _writeall(1, cast[Ptr[uint8]](" byte(s), "))
    nl2: uint64 = _u64_to_dec(_dm_lines, &_cfg_dnum[0])
    sys_write(1, &_cfg_dnum[0], nl2)
    _writeall(1, cast[Ptr[uint8]](" line(s), "))
    nc: uint64 = _u64_to_dec(dm_count, &_cfg_dnum[0])
    sys_write(1, &_cfg_dnum[0], nc)
    _writeall(1, cast[Ptr[uint8]](" attached distribution(s)\n"))
    if dm_count == 0:
        _writeall(1, cast[Ptr[uint8]]("[panel] /etc/distros: no attached distribution -- the Applications menu will have no distribution sections\n"))


# The parent row's label, "<Name> apps", into _dm_label. The name is the
# distribution's own — the menu says `Alpine`, not `Linux`, because which
# Linux it is, is the entire information the section carries.
def _dm_mklabel(i: uint64):
    p: uint64 = 0
    while p < dm_name_len[i] and p < 30:
        c: uint8 = dm_name[i][p]
        if p == 0 and c >= 97 and c <= 122:
            c = c - 32
        _dm_label[p] = c
        p = p + 1
    sfx: Ptr[uint8] = cast[Ptr[uint8]](" apps")
    q: uint64 = 0
    while sfx[q] != 0 and p < 47:
        _dm_label[p] = sfx[q]
        p = p + 1
        q = q + 1
    _dm_label[p] = 0


# The disabled placeholder for an ATTACHED distribution that ships no
# launchers: "No <name> apps installed". Named, so it cannot be confused
# with the distribution not being there at all (which shows no section).
def _dm_mkempty(i: uint64):
    pre: Ptr[uint8] = cast[Ptr[uint8]]("No ")
    p: uint64 = 0
    while pre[p] != 0:
        _dm_empty[p] = pre[p]
        p = p + 1
    k: uint64 = 0
    while k < dm_name_len[i] and p < 30:
        _dm_empty[p] = dm_name[i][k]
        p = p + 1
        k = k + 1
    sfx: Ptr[uint8] = cast[Ptr[uint8]](" apps installed")
    q: uint64 = 0
    while sfx[q] != 0 and p < 47:
        _dm_empty[p] = sfx[q]
        p = p + 1
        q = q + 1
    _dm_empty[p] = 0


# Scan ONE *.desktop directory into the menu model. `force_cat` >= 0 pins
# every parsed entry to that category (the Linux section); < 0 keeps the
# freedesktop-classified native category. Returns how many entries were
# added. Shared by the native (/etc/hamde/apps) and Linux
# (/n/linux/usr/share/applications) scans so both honour the SAME tolerant
# lib/desktopentry parser and sorted insertion. Linux-ns entries (force_cat
# == DE_CAT_LINUX) sort last and surface under the "Linux apps" fly-out.
def _scan_apps_dir(dir: Ptr[uint8], force_cat: int32) -> uint64:
    # Count what ACTUALLY landed in the model (am_count delta), not what we
    # tried to add: _am_add() silently drops past AM_MAX, and the old
    # optimistic counter made am_linux_count report entries that were never
    # stored — masking the overflow that hid the office apps.
    start: uint64 = am_count
    added: uint64 = 0
    n: int64 = p9_listdir(cast[Ptr[char]](dir), &_am_listbuf[0], 4096)
    if n <= 0:
        return 0
    cap: uint64 = cast[uint64](n)
    i: uint64 = 0
    while i < cap:
        # One "NAME\n" record: [i, e).
        e: uint64 = i
        while e < cap and _am_listbuf[e] != 10:
            e = e + 1
        nm: Array[64, uint8]
        nl: uint64 = 0
        k: uint64 = i
        while k < e and nl < 63:
            nm[nl] = _am_listbuf[k]
            nl = nl + 1
            k = k + 1
        nm[nl] = 0
        if nl > 0 and desktop_name_is_entry(&nm[0]) != 0:
            _am_build_path(dir, &nm[0], nl)
            fd: int32 = sys_open(cast[Ptr[char]](&_am_path[0]))
            if fd >= 0:
                rn: int64 = sys_read(fd, &_am_filebuf[0], 2047)
                sys_close(fd)
                if rn > 0:
                    if desktop_parse(&_am_filebuf[0], cast[uint64](rn)) != 0 and (desktop_liveonly() == 0 or _am_is_live() != 0):
                        cat: int32 = desktop_catcode()
                        if force_cat >= 0:
                            cat = force_cat
                            # Linux-ns entries live under the dedicated "Linux
                            # apps" fly-out submenu, so the display label stays
                            # the plain freedesktop Name (no "(linux)" tag — the
                            # parent row already says these are Linux apps).
                            # launch still routes by cat (DE_CAT_LINUX).
                            _am_add(desktop_name_ptr(), desktop_name_len(),
                                    desktop_prog_ptr(), desktop_prog_len(),
                                    cat, desktop_terminal())
                        else:
                            # NATIVE entry: the Exec names a program in THIS
                            # root, so it can be checked, and must be -- see
                            # _prog_installed above. A launcher whose program
                            # is absent is dropped and named, never drawn as a
                            # row that does nothing when clicked.
                            if _prog_installed(desktop_prog_ptr()) == 0:
                                _report_missing(desktop_name_ptr(),
                                                desktop_prog_ptr())
                            else:
                                _am_add(desktop_name_ptr(), desktop_name_len(),
                                        desktop_prog_ptr(), desktop_prog_len(),
                                        cat, desktop_terminal())
        i = e + 1
    added = am_count - start
    return added


# Scan the native /etc/hamde/apps/*.desktop catalogue AND every attached
# distribution's /n/<name>/usr/share/applications, populating the menu model.
# Native entries keep their freedesktop category; a distribution's entries are
# forced to cat DE_CAT_LINUX + <section index>, which does two jobs at once:
# it sorts them after the native rows AND keeps each distribution's entries
# contiguous and in table order, so a section is a SLICE of the one model
# rather than a second one. Falls back to the hardcoded native set if the
# native directory yields no entries (the distribution sections are additive
# on top). Refreshes MENU_H to the row count.
am_linux_count: uint64 = 0
def _load_apps():
    am_count = 0
    native: uint64 = _scan_apps_dir(_apps_dir(), -1)
    if native == 0:
        _seed_fallback()
    _load_distros()
    am_linux_count = 0
    d: uint64 = 0
    while d < dm_count:
        _dm_mkpath(d, 1)
        dm_apps[d] = _scan_apps_dir(&_dm_path[0], DE_CAT_LINUX + cast[int32](d))
        am_linux_count = am_linux_count + dm_apps[d]
        d = d + 1
    # The main dropdown lists the NATIVE apps + ONE parent row per attached
    # distribution. No distribution attached means no parent rows at all —
    # not an empty "Linux apps" row promising a namespace that is not there.
    nrows: int64 = cast[int64](_native_count()) + cast[int64](dm_count)
    if nrows < 1:
        nrows = 1
    menu_main_h = nrows * MENU_ROW_H + 4
    # The window-reservation height must cover whichever popup is taller: the
    # main dropdown, or the tallest fly-out child.
    mh: int64 = nrows
    d = 0
    while d < dm_count:
        crows: int64 = cast[int64](dm_apps[d])
        if crows < 1:
            crows = 1
        if crows > mh:
            mh = crows
        d = d + 1
    MENU_H = mh * MENU_ROW_H + 4


# Number of NATIVE menu entries — the leading am_* rows, since every
# distribution's cat sorts LAST. A distribution's entries are the slice
# am_[_dm_start(i) .. +dm_apps[i]).
def _native_count() -> uint64:
    if am_linux_count >= am_count:
        return 0
    return am_count - am_linux_count


# Model index of distribution `i`'s first entry.
def _dm_start(i: uint64) -> uint64:
    s: uint64 = _native_count()
    j: uint64 = 0
    while j < i and j < dm_count:
        s = s + dm_apps[j]
        j = j + 1
    return s


# Which fly-out is open: 0 = none, otherwise the section index PLUS ONE, so
# `sub_open != 0` keeps meaning "a fly-out is showing" everywhere it did.
def _sub_idx() -> uint64:
    if sub_open <= 0:
        return 0
    return cast[uint64](sub_open) - 1


# Height of the open fly-out (max(1, its app count) rows — the lone row being
# the disabled "No <name> apps installed" placeholder).
def _sub_h() -> int64:
    rows: int64 = 0
    if sub_open > 0 and _sub_idx() < dm_count:
        rows = cast[int64](dm_apps[_sub_idx()])
    if rows < 1:
        rows = 1
    return rows * MENU_ROW_H + 4

# ---- per-panel render state (set by _layout_panel for the panel being
# rendered / hit-tested this pass). main() restores per-panel persistent
# fields (menu_open) around each call.
cur_sw: int64 = 0                    # this panel's window content width
cur_sh: int64 = 0                    # this panel's window content height
cur_edge: int32 = 0
cur_bold: int32 = 0
cur_horiz: int32 = 1                 # 1 = top/bottom bar, 0 = left/right
cur_thick: int64 = 26
menu_open: int32 = 0                 # menu state of the panel being processed

# Resolved widget rects for the current panel (window-local). For a
# horizontal panel these are x-ranges at the bar row; for a vertical panel
# they are y-ranges down the bar column.
wx0: Array[12, int64]
wx1: Array[12, int64]
n_widg: uint64 = 0
wkind_cur: Array[12, int32]
wpin_cur: Array[12, int64]            # per-slot pinned flow coord (-1 = auto)

menu_slot: int64 = -1                # widget index of the menu, or -1
tasks_slot: int64 = -1
menu_lo: int64 = 0                   # menu widget's start coord (x or y)
tasks_lo: int64 = -1
tasks_hi: int64 = -1

# ====================================================================
# MODERN PANEL CHROME — a cohesive palette + tiny drawing helpers.
# ====================================================================
# The bar keeps its light neutral base (the scene-render gate asserts
# `fill 0 0 <sw> 26 #eceef2`), then layers subtle translucent depth on top: a
# crisp top sheen easing into a soft shade toward the desktop-facing edge, and
# a hairline that defines the bar against the wallpaper. Accent tones echo the
# blue SSD window titlebar (#3c64b4) so the panel, its active taskbar entry, the
# active workspace cell and the hover pills all read as one system.
PC_ACCENT:   Array[9, uint8] = "#3584e4"   # KDE-ish blue accent (active/focus)
PC_ACCENT_D: Array[9, uint8] = "#2f6fce"   # darker accent (borders/underline)
PC_EDGE:     Array[9, uint8] = "#b7bdc9"   # desktop-facing definition hairline
PC_HOVER:    Array[9, uint8] = "#d9e6fb"   # soft hover pill fill
PC_HOVER_BD: Array[9, uint8] = "#bcd2f5"   # hover pill hairline
PC_CHIP:     Array[9, uint8] = "#e6e8ec"   # neutral chip / task face
PC_CHIP_BD:  Array[9, uint8] = "#c2c5cd"   # neutral chip hairline
PC_TROUGH:   Array[9, uint8] = "#d3d6dd"   # meter trough
PC_FG:       Array[9, uint8] = "#242a33"   # primary label ink
PC_FG_ON:    Array[9, uint8] = "#ffffff"   # ink on an accent fill

# Hex digit table for building translucent "#RRGGBBAA" overlay colours.
_PC_HEXD: Array[16, uint8] = "0123456789abcdef"


# Fill a translucent depth overlay: a black (white=0) or white (white=1) wash
# at alpha `a` (0..255). Used for the panel sheen/shade gradient so the bar
# gains depth without a second opaque colour. Blended alpha-over by the
# compositor's scene fill (see _wsys_cache_putpixel).
def _ovl_fill(x: int64, y: int64, w: int64, h: int64, white: int32, a: int64):
    if w <= 0 or h <= 0:
        return
    v: uint8 = 0
    if white != 0:
        v = 255
    aa: int64 = a
    if aa < 0:
        aa = 0
    if aa > 255:
        aa = 255
    c: Array[10, uint8]
    c[0] = 35                                          # '#'
    hi: uint8 = _PC_HEXD[(v >> 4) & 15]
    lo2: uint8 = _PC_HEXD[v & 15]
    c[1] = hi
    c[2] = lo2
    c[3] = hi
    c[4] = lo2
    c[5] = hi
    c[6] = lo2
    c[7] = _PC_HEXD[cast[uint8]((aa >> 4) & 15)]
    c[8] = _PC_HEXD[cast[uint8](aa & 15)]
    c[9] = 0
    hamscene_fill(cast[int32](x), cast[int32](y), cast[int32](w),
                  cast[int32](h), &c[0])


# Paint the modern panel-bar backdrop over the (already-drawn) base fill: a
# top/left sheen, a graded shade near the far edge, and the desktop-facing
# definition hairline. `bar` is the cross-axis origin, `thick` the thickness.
def _panel_depth(bar: int64, thick: int64):
    if cur_horiz != 0:
        _ovl_fill(0, bar, cur_sw, 1, 1, 150)               # crisp top sheen
        _ovl_fill(0, bar + 1, cur_sw, 1, 1, 55)            # soft second sheen
        _ovl_fill(0, bar + thick - 6, cur_sw, 6, 0, 6)     # gentle shade
        _ovl_fill(0, bar + thick - 3, cur_sw, 3, 0, 8)     # deeper near edge
        if cur_edge == EDGE_BOTTOM:
            hamscene_fill(0, cast[int32](bar), cast[int32](cur_sw), 1, &PC_EDGE[0])
        else:
            hamscene_fill(0, cast[int32](bar + thick - 1),
                          cast[int32](cur_sw), 1, &PC_EDGE[0])
    else:
        _ovl_fill(bar, 0, 1, cur_sh, 1, 150)
        _ovl_fill(bar + 1, 0, 1, cur_sh, 1, 55)
        _ovl_fill(bar + thick - 6, 0, 6, cur_sh, 0, 6)
        _ovl_fill(bar + thick - 3, 0, 3, cur_sh, 0, 8)
        if cur_edge == EDGE_LEFT:
            hamscene_fill(cast[int32](bar + thick - 1), 0, 1,
                          cast[int32](cur_sh), &PC_EDGE[0])
        else:
            hamscene_fill(cast[int32](bar), 0, 1, cast[int32](cur_sh),
                          &PC_EDGE[0])


# ---- ACTIVE-WINDOW + HOVER state (taskbar / pager / chips feel alive) ----
# The panel highlights the window it most recently raised+focused (a click on a
# taskbar entry, MATE-style) and, while the pointer is over the bar, the widget
# it sits on. Focus can also change by clicking a window directly, which the
# panel can't observe without a compositor focus feed; the raised-wid tracker
# covers the common taskbar-driven case.
panel_active_wid: int32 = 0            # wid of the last taskbar entry we focused

# Live hover: which panel the pointer is over and its window-local coords.
# hov_valid gates all hover rendering; it clears when the pointer leaves the
# bar strip (or the panel loses focus). Rendering hit-tests these against the
# per-widget rects (which only exist during render), so the motion handler just
# records raw coordinates.
hov_valid: int32 = 0
hov_panel: uint64 = 0
hov_flow:  int64 = -1                  # flow-axis cursor (x horiz, y vert)
hov_cross: int64 = -1                  # cross-axis cursor


# True if the current panel (cur_panel_idx) is the one under the pointer.
def _hov_here() -> int32:
    if hov_valid == 0:
        return 0
    if hov_panel != cur_panel_idx:
        return 0
    return 1


# Record buttonless-motion hover for panel `pi`. Returns 1 if the tracked cell
# changed (caller repaints). Clears hover when the cursor leaves the bar strip.
def _update_hover(x: int64, y: int64, bar: int64, pi: uint64) -> int32:
    flow: int64 = x
    cross: int64 = y
    if cur_horiz == 0:
        flow = y
        cross = x
    inside: int32 = 1
    if cross < bar or cross >= bar + cur_thick:
        inside = 0
    if inside == 0:
        if hov_valid != 0 and hov_panel == pi:
            hov_valid = 0
            return 1
        return 0
    changed: int32 = 0
    if hov_valid == 0 or hov_panel != pi or hov_flow != flow:
        changed = 1
    hov_valid = 1
    hov_panel = pi
    hov_flow = flow
    hov_cross = cross
    return changed

# ---- RIGHT-CLICK CONTEXT MENU (Add to Panel / Move / Remove) -------------
# At most one context menu is open at a time, on exactly one panel. When open
# the owning panel's window GROWS (like the Apps dropdown) so the popup is
# part of that panel's own scene. ctx_kind selects the menu contents:
#   CTXK_ADD    right-click on EMPTY bar space -> add-a-widget list
#   CTXK_WIDGET right-click ON a widget       -> Move / Remove
CTXK_NONE:    int32 = 0
CTXK_ADD:     int32 = 1
CTXK_WIDGET:  int32 = 2
# CTXK_PANELMENU: right-click on EMPTY bar space now opens the MATE PANEL menu
# (Task #124 labels via lib/ctxmenucore) — a concise "Add to Panel..." /
# "Properties" instead of dumping the whole widget list inline. "Add to
# Panel..." opens the searchable applet CHOOSER dialog (addlet_* below).
CTXK_PANELMENU: int32 = 5
# CTXK_APPMENU: right-click ON the Applications (menu) widget -> a desktop
# shortcut menu (Settings / Add to Panel / About) so the user can reach the
# Settings app by right-clicking the Apps button, not only via the menu tree.
CTXK_APPMENU: int32 = 3

CTX_W: int64 = 150                    # context-menu box width
CTX_ROW_H: int64 = 22

# Add menu rows: Clock, Sysmon, Menu, Tasks, Spacer, Pager, Tray, Session (8).
CTX_ADD_ROWS: int64 = 8
# Widget menu rows: Move, Remove From Panel (2).
CTX_WID_ROWS: int64 = 2
# Apps-button shortcut menu rows: Settings, Add to Panel, About (3).
CTX_APP_ROWS: int64 = 3
# Panel menu rows: Add to Panel..., Properties (2). MATE labels come from
# lib/ctxmenucore's ctxm_panel_label so the panel + the #124 host gate share
# them verbatim.
CTX_PANEL_ROWS: int64 = 2

ctx_open:   int32 = 0                 # is a context menu currently open?
ctx_panel:  uint64 = 0               # which panel index owns it
ctx_kind:   int32 = 0                 # CTXK_ADD / CTXK_WIDGET
ctx_widget: int64 = -1               # widget slot the click landed on (CTXK_WIDGET)
ctx_insert: int64 = 0                # flow-axis insertion index (CTXK_ADD)
ctx_box_x:  int64 = 0                # window-local origin of the popup box
ctx_box_y:  int64 = 0

# Move-mode: after picking "Move", the next left-click on the bar drops the
# selected widget at a new flow-axis index.
move_active: int32 = 0
move_panel:  uint64 = 0
move_slot:   int64 = -1

# Set by _drain_events from the parsed button bitmap before each
# _handle_button call: 1 if the right button (bit1, value 2) is down.
g_bv_right: int32 = 0
# Previous button bitmap (across events) and the buttons NEWLY pressed this
# event (up->down transition). Discrete click actions — opening a right-click
# context menu, resolving/dismissing an open one — fire only on a fresh press
# EDGE, never on a held-button MOTION event. Without this, cursor jitter while
# the right button is held re-enters the dispatcher: because a right-click
# lands ON the bar (y<26) but the context box opens BELOW it (y>=26), the held
# event reads as an "outside click" and instantly dismisses the just-opened
# menu — the "Applications applet is hard to right-click" report (#265).
g_prev_bv:    int64 = 0
g_press_edge: int64 = 0
# Buttons NEWLY released this event (down->up transition). Used to COMMIT a
# drag-from-menu launcher drop at the release point (#327).
g_release_edge: int64 = 0

# ---- DRAG-FROM-MENU LAUNCHER DROP (#327) --------------------------------
# hamappmenu writes an app's `<exec> <label>\n` to /tmp/hamnix-panel-drop when
# the user DRAGS an entry OUT of the Applications menu (a plain click still
# launches). Because the menu is a SEPARATE window and the compositor delivers
# no cross-window drag stream (devwsys routes motion/release to the window
# under the cursor only), the menu cannot see WHERE the drop lands — so the
# drop is an OFFER that the receiver (this panel, or the desktop) COMMITS on
# its OWN button RELEASE, at the release coordinate. Each tick we refresh the
# pending offer from the sidecar; on a left RELEASE over the bar we insert the
# launcher at the drop flow-X (NOT a fixed spot next to the Apps button, the
# old bug). While an offer is pending we SUPPRESS normal bar button handling so
# a held-button drag across the bar can't spuriously toggle a widget/launch.
# TTL-guarded so an abandoned drag (released over neither panel nor desktop)
# can't wedge button handling.
pend_active:   int32 = 0
pend_exec:     Array[64, uint8]
pend_label:    Array[24, uint8]
pend_seen_jif: uint64 = 0
# OFFER LIFETIME — the bug that made drag-to-panel LOOK dead ----------------
# This was 48. Jiffies are HZ=100, so that is 480 MILLISECONDS, measured from
# the moment WE first see the sidecar — which is the moment the Applications
# menu crosses its 14 px drag threshold, i.e. the START of the gesture, with
# the button still held and the cursor still nowhere near the bar. Every human
# drag takes longer than that, so the offer ALWAYS self-destructed mid-gesture
# and the release found nothing to commit: the user's "dragging an app from
# the app menu to the panel seems to not work now". It is a REGRESSION from
# the #327 rework (135013df) — before that the panel committed the launcher
# the instant it saw the sidecar (at a fixed spot), which worked; #327 made
# the placement correct and the lifetime wrong. Measured on a real UEFI/OVMF
# boot: offer + click issued ~50 ms apart commits; the same pair 2.5 s apart
# finds the sidecar already truncated.
#
# The TTL now covers a real drag and is pure garbage collection. The reasons
# the short TTL existed ("a stale offer must not wedge/hijack the bar") are
# handled by what a drag actually IS: suppression only while the button is
# DOWN, and a commit only after held-button MOTION over the bar (pend_moved).
PEND_TTL_JIF:  uint64 = 600
pend_moved:    int32 = 0        # saw held-button motion since the offer arrived
pend_last_x:   int64 = -1
pend_last_y:   int64 = -1

# ---- LIVE DROP PREVIEW (user-reported) -----------------------------------
# While a drag-from-menu offer is in flight and the cursor is over the bar, we
# render an INSERTION INDICATOR at the flow position where the launcher would
# land — updated on every pointer-move, committed on release — so the drop is
# WYSIWYG (previously the bar only changed AFTER release). drop_prev_flow is
# the raw cursor flow coord; the render resolves it to a boundary via the same
# dp_panel_insert_index math the commit uses, so the preview and the drop agree.
drop_prev_active: int32 = 0
drop_prev_panel:  uint64 = 0
drop_prev_flow:   int64 = 0

# ---- ADD-TO-PANEL CHOOSER DIALOG (opened by the panel menu) --------------
# A MATE-authentic applet chooser (lib/ctxmenucore searchable model): a
# titled dialog with a search box + category-grouped applet rows carrying a
# name + short description. It renders INSIDE the owning panel's window (which
# grows for it, like the context menu) and a click on an applet row inserts
# that widget at the flow position that was right-clicked. At most one dialog
# is open at a time.
addlet_open:   int32 = 0
addlet_panel:  uint64 = 0
addlet_insert: int64 = 0              # flow-axis insertion index
addlet_flow:   int64 = 0              # flow coord the right-click landed on
addlet_box_x:  int64 = 0             # window-local origin of the dialog box
addlet_box_y:  int64 = 0
addlet_ready:  int32 = 0             # registry populated once


# Map a ctxmenucore CTXM_APPLET_* identity to this panel's widget kind (WK_*).
def _applet_to_wk(applet: int32) -> int32:
    if applet == CTXM_APPLET_MENUBAR:
        return WK_MENU
    if applet == CTXM_APPLET_CLOCK:
        return WK_CLOCK
    if applet == CTXM_APPLET_SYSMON:
        return WK_SYSMON
    if applet == CTXM_APPLET_WINLIST:
        return WK_TASKS
    if applet == CTXM_APPLET_PAGER:
        return WK_PAGER
    if applet == CTXM_APPLET_NOTIF:
        return WK_TRAY
    if applet == CTXM_APPLET_SESSION:
        return WK_SESSION
    return WK_SPACER

# Number of rows the currently-open context menu has.
def ctx_rows() -> int64:
    if ctx_kind == CTXK_WIDGET:
        return CTX_WID_ROWS
    if ctx_kind == CTXK_APPMENU:
        return CTX_APP_ROWS
    if ctx_kind == CTXK_PANELMENU:
        return CTX_PANEL_ROWS
    return CTX_ADD_ROWS


def ctx_box_h() -> int64:
    return ctx_rows() * CTX_ROW_H + 4


# Width (horizontal) or height (vertical) a fixed widget occupies in flow.
def _widget_extent(kind: int32) -> int64:
    if cur_horiz != 0:
        if kind == WK_MENU:
            return APP_BTN_W + 8
        if kind == WK_SYSMON:
            return SYSMON_W + 8
        if kind == WK_CLOCK:
            return CLOCK_W + 8
        if kind == WK_PAGER:
            return PAGER_W + 8
        if kind == WK_TRAY:
            return TRAY_W + 8
        if kind == WK_SESSION:
            return SESSION_W + 8
        return 0                     # tasks / spacer = elastic
    # vertical panel: stack rows
    if kind == WK_MENU:
        return 24
    if kind == WK_SYSMON:
        return 28
    if kind == WK_CLOCK:
        return 20
    if kind == WK_PAGER:
        return 24
    if kind == WK_TRAY:
        return 24
    if kind == WK_SESSION:
        return 24
    if kind == WK_LAUNCHER:
        return 24
    return 0


# Placeholder-icon width (a square chip; #285 swaps in real icons).
LAUNCH_ICON: int64 = 16


# Horizontal box width of the launcher at global slot `g`: pad + icon + gap +
# label glyphs (~8px/char, matching the panel's other labelled widgets) + pad.
def _launcher_w(g: uint64) -> int64:
    ll: int64 = cast[int64](_slen(_wlabel_ptr(g)))
    return 6 + LAUNCH_ICON + 6 + ll * 8 + 6


# Slot-aware extent: launchers size to their label (needs the slot to reach the
# payload store); every other kind is fixed and defers to _widget_extent.
def _widget_extent_at(kind: int32, slot: uint64) -> int64:
    if kind == WK_LAUNCHER:
        if cur_horiz != 0:
            return _launcher_w(cur_panel_idx * MAX_WIDGETS + slot) + 8
        return 24
    return _widget_extent(kind)


# Lay out the current panel's widget list into wx0/wx1 (the flow axis).
# Fixed widgets before the first elastic widget pack from the start; fixed
# widgets after it pack toward the far end; the elastic widget(s) fill the
# slack. (Multiple elastic widgets share equally is overkill; we treat the
# first elastic as the slack-filler and any later spacer/tasks as zero.)
def _layout_panel():
    menu_slot = -1
    tasks_slot = -1
    tasks_lo = -1
    tasks_hi = -1
    span: int64 = cur_sw
    if cur_horiz == 0:
        span = cur_sh
    # find the first NON-PINNED elastic widget (tasks or spacer). Pinned
    # widgets are out of flow and never act as the slack-filler.
    first_elastic: int64 = -1
    a: uint64 = 0
    while a < n_widg:
        k: int32 = wkind_cur[a]
        if wpin_cur[a] < 0 and (k == WK_TASKS or k == WK_SPACER) \
                and first_elastic < 0:
            first_elastic = cast[int64](a)
        a = a + 1
    lo: int64 = 0
    hi: int64 = span
    # pack leading AUTO-FLOW fixed widgets from start (skip pinned)
    b: uint64 = 0
    while b < n_widg:
        if first_elastic >= 0 and cast[int64](b) >= first_elastic:
            b = n_widg
        elif wpin_cur[b] >= 0:
            b = b + 1
        else:
            k2: int32 = wkind_cur[b]
            ext: int64 = _widget_extent_at(k2, b)
            wx0[b] = lo
            wx1[b] = lo + ext
            if k2 == WK_MENU:
                menu_slot = cast[int64](b)
                menu_lo = lo
            lo = lo + ext
            b = b + 1
    # pack trailing AUTO-FLOW fixed widgets (after the elastic) from far end
    if first_elastic >= 0:
        c: int64 = cast[int64](n_widg) - 1
        while c > first_elastic:
            if wpin_cur[c] >= 0:
                c = c - 1
            else:
                k3: int32 = wkind_cur[c]
                ext2: int64 = _widget_extent_at(k3, cast[uint64](c))
                hi = hi - ext2
                wx0[c] = hi + 8
                # Bound the rect to the widget's ACTUAL end (was `span`, which
                # made every trailing applet's hit-rect run to the far screen
                # edge — so a click anywhere right of the first trailing widget
                # hit that widget, and the empty gaps between applets weren't
                # recognisable as blank bar space for the right-click Add menu).
                wx1[c] = hi + ext2
                c = c - 1
        # the elastic widget itself
        ei: uint64 = cast[uint64](first_elastic)
        ek: int32 = wkind_cur[ei]
        wx0[ei] = lo + 4
        wx1[ei] = hi - 4
        if ek == WK_TASKS:
            tasks_slot = first_elastic
            tasks_lo = wx0[ei]
            tasks_hi = wx1[ei]
        # any further elastic widgets collapse (already covered by trailing
        # pack or empty)
    # PINNED widgets (bug 3): placed at their exact flow coord, clamped into
    # the bar, OUTSIDE the flow packing above so they never shove neighbours.
    pa: uint64 = 0
    while pa < n_widg:
        if wpin_cur[pa] >= 0:
            pk: int32 = wkind_cur[pa]
            pext: int64 = _widget_extent_at(pk, pa)
            if pext <= 0:
                pext = TASK_BTN_W            # give elastic kinds a visible box
            px: int64 = wpin_cur[pa]
            if px + pext > span:
                px = span - pext
            if px < 0:
                px = 0
            wx0[pa] = px
            wx1[pa] = px + pext
            if pk == WK_MENU:
                menu_slot = cast[int64](pa)
                menu_lo = px
        pa = pa + 1


# --- modern render helpers ------------------------------------------
# A soft rounded HOVER PILL behind a clickable chip, drawn only when the
# pointer is over this widget's flow-axis span [lo, lo+ext). `active != 0`
# swaps the soft hover tint for a stronger accent tint so a focused item reads
# as pressed. Horizontal panels inset the pill vertically; vertical panels
# inset horizontally.
def _chip_pill(lo: int64, ext: int64, bar: int64, active: int32):
    face: Ptr[uint8] = &PC_HOVER[0]
    bd: Ptr[uint8] = &PC_HOVER_BD[0]
    if active != 0:
        face = cast[Ptr[uint8]]("#c6dbfa")
        bd = &PC_ACCENT[0]
    if cur_horiz != 0:
        hamscene_roundrect(cast[int32](lo + 1), cast[int32](bar + 3),
                           cast[int32](ext - 2), cast[int32](cur_thick - 6),
                           5, bd)
        hamscene_roundrect(cast[int32](lo + 2), cast[int32](bar + 4),
                           cast[int32](ext - 4), cast[int32](cur_thick - 8),
                           4, face)
    else:
        hamscene_roundrect(cast[int32](bar + 3), cast[int32](lo + 1),
                           cast[int32](cur_thick - 6), cast[int32](ext - 2),
                           5, bd)
        hamscene_roundrect(cast[int32](bar + 4), cast[int32](lo + 2),
                           cast[int32](cur_thick - 8), cast[int32](ext - 4),
                           4, face)


# True if the live hover falls within this widget's flow span [lo, lo+ext) on
# the current panel.
def _hov_span(lo: int64, ext: int64) -> int32:
    if _hov_here() == 0:
        return 0
    if hov_flow >= lo and hov_flow < lo + ext:
        return 1
    return 0


# A rounded meter (CPU/mem): a soft trough with a rounded coloured fill. Softer
# and more modern than the dark hamscene_hbar trough.
def _meter(x: int64, y: int64, w: int64, h: int64, pct: int32,
           col: Ptr[uint8]):
    p: int32 = pct
    if p < 0:
        p = 0
    if p > 100:
        p = 100
    rad: int32 = cast[int32](h) / 2
    hamscene_roundrect(cast[int32](x), cast[int32](y), cast[int32](w),
                       cast[int32](h), rad, &PC_TROUGH[0])
    fw: int64 = (w * cast[int64](p)) / 100
    if fw >= h:
        hamscene_roundrect(cast[int32](x), cast[int32](y), cast[int32](fw),
                           cast[int32](h), rad, col)
    elif fw > 0:
        hamscene_fill(cast[int32](x), cast[int32](y), cast[int32](fw),
                      cast[int32](h), col)


# Map a taskbar window TITLE to a #285 icon glyph code by keyword, so the
# taskbar entries carry the same per-app glyphs as the app menu / desktop.
# Falls back to the generic document glyph.
_ti_scr: Array[64, uint8]
def _task_icon(t: uint64) -> int32:
    nbase: uint64 = t * 64
    nl: uint64 = task_namelen[t]
    if nl > 63:
        nl = 63
    k: uint64 = 0
    while k < nl:
        c: uint8 = task_name[nbase + k]
        if c >= 65 and c <= 90:                       # lower-case
            c = c + 32
        _ti_scr[k] = c
        k = k + 1
    _ti_scr[nl] = 0
    s: Ptr[uint8] = &_ti_scr[0]
    if _substr(s, cast[Ptr[uint8]]("term")) != 0:
        return hamscene_icon_code(cast[Ptr[uint8]]("terminal"))
    if _substr(s, cast[Ptr[uint8]]("file")) != 0 \
            or _substr(s, cast[Ptr[uint8]]("hamfm")) != 0:
        return hamscene_icon_code(cast[Ptr[uint8]]("system-file-manager"))
    if _substr(s, cast[Ptr[uint8]]("calc")) != 0:
        return hamscene_icon_code(cast[Ptr[uint8]]("accessories-calculator"))
    if _substr(s, cast[Ptr[uint8]]("monitor")) != 0 \
            or _substr(s, cast[Ptr[uint8]]("sysmon")) != 0:
        return hamscene_icon_code(cast[Ptr[uint8]]("utilities-system-monitor"))
    if _substr(s, cast[Ptr[uint8]]("brows")) != 0 \
            or _substr(s, cast[Ptr[uint8]]("web")) != 0:
        return hamscene_icon_code(cast[Ptr[uint8]]("web-browser"))
    if _substr(s, cast[Ptr[uint8]]("note")) != 0 \
            or _substr(s, cast[Ptr[uint8]]("edit")) != 0:
        return hamscene_icon_code(cast[Ptr[uint8]]("accessories-text-editor"))
    if _substr(s, cast[Ptr[uint8]]("setting")) != 0 \
            or _substr(s, cast[Ptr[uint8]]("control")) != 0:
        return hamscene_icon_code(cast[Ptr[uint8]]("preferences-system"))
    if _substr(s, cast[Ptr[uint8]]("2048")) != 0 \
            or _substr(s, cast[Ptr[uint8]]("game")) != 0:
        return hamscene_icon_code(cast[Ptr[uint8]]("ham2048"))
    if _substr(s, cast[Ptr[uint8]]("install")) != 0:
        return hamscene_icon_code(cast[Ptr[uint8]]("system-installer"))
    return hamscene_icon_code(cast[Ptr[uint8]](""))


# Substring search: 1 if needle occurs in haystack (both NUL-terminated).
def _substr(hay: Ptr[uint8], needle: Ptr[uint8]) -> int32:
    if needle[0] == 0:
        return 0
    i: uint64 = 0
    while hay[i] != 0:
        j: uint64 = 0
        while needle[j] != 0 and hay[i + j] == needle[j]:
            j = j + 1
        if needle[j] == 0:
            return 1
        i = i + 1
    return 0


# --- per-widget render ----------------------------------------------
# `bar` = the start coord of the panel bar on the cross axis (window-local).
# For horizontal panels widgets sit at y=bar..bar+thick; for vertical they
# sit at x=bar..bar+thick. `lo` is the widget's start coord on the flow axis.

def _render_menu(lo: int64, bar: int64):
    fg: Ptr[uint8] = &PC_FG[0]
    if cur_horiz != 0:
        # Accent pill while open; soft hover pill while hovered.
        if menu_open != 0:
            _chip_pill(lo, APP_BTN_W, bar, 1)
            fg = &PC_ACCENT_D[0]
        elif _hov_span(lo, APP_BTN_W + 8) != 0:
            _chip_pill(lo, APP_BTN_W, bar, 0)
        _glyphs(lo + 8, bar + 5, cast[Ptr[uint8]]("Applications"), fg, cur_bold)
        hamscene_fill(cast[int32](lo + APP_DIV_X + 4), cast[int32](bar) + 4,
                      1, 18, cast[Ptr[uint8]]("#cfd2d8"))
    else:
        # vertical: short "Apps" label centred in its row
        if menu_open != 0:
            _chip_pill(lo, 24, bar, 1)
            fg = &PC_ACCENT_D[0]
        elif _hov_span(lo, 24) != 0:
            _chip_pill(lo, 24, bar, 0)
        _glyphs(bar + 6, lo + 4, cast[Ptr[uint8]]("Apps"), fg, cur_bold)


# One rounded taskbar button: neutral by default, soft-hover under the cursor,
# and an accent-tinted face with an accent underline for the active (focused)
# window — the MATE/KDE "which window am I on" cue.
def _task_button(x: int64, y: int64, w: int64, h: int64, state: int32):
    # state: 0 normal, 1 hover, 2 active
    face: Ptr[uint8] = &PC_CHIP[0]
    bd: Ptr[uint8] = &PC_CHIP_BD[0]
    if state == 1:
        face = &PC_HOVER[0]
        bd = &PC_HOVER_BD[0]
    elif state == 2:
        face = cast[Ptr[uint8]]("#c6dbfa")
        bd = &PC_ACCENT[0]
    hamscene_roundrect(cast[int32](x), cast[int32](y), cast[int32](w),
                       cast[int32](h), 5, bd)
    hamscene_roundrect(cast[int32](x + 1), cast[int32](y + 1),
                       cast[int32](w - 2), cast[int32](h - 2), 4, face)
    # subtle top sheen for a touch of dimensionality
    _ovl_fill(x + 3, y + 1, w - 6, 1, 1, 110)
    if state == 2:
        # accent underline anchoring the active entry
        hamscene_fill(cast[int32](x + 4), cast[int32](y + h - 2),
                      cast[int32](w - 8), 2, &PC_ACCENT[0])


def _render_tasks(lo: int64, hi: int64, bar: int64):
    fg: Ptr[uint8] = &PC_FG[0]
    if cur_horiz != 0:
        by: int32 = cast[int32](bar)
        t: uint64 = 0
        while t < n_tasks:
            bx: int64 = lo + cast[int64](t) * (TASK_BTN_W + 4)
            if bx + TASK_BTN_W > hi:
                t = n_tasks
            else:
                st: int32 = 0
                if panel_active_wid != 0 and task_wid[t] == panel_active_wid:
                    st = 2
                elif _hov_span(bx, TASK_BTN_W) != 0:
                    st = 1
                _task_button(bx, cast[int64](by) + 3, TASK_BTN_W, 20, st)
                # per-app icon glyph, then the window title beside it
                hamscene_icon_draw(cast[int32](bx) + 5, by + 5, 15, 15,
                                   _task_icon(t))
                lbl: Array[16, uint8]
                nbase: uint64 = t * 64
                nl: uint64 = task_namelen[t]
                if nl > 13:
                    nl = 13
                k: uint64 = 0
                while k < nl:
                    ch: uint8 = task_name[nbase + k]
                    if ch == 34 or ch == 10:
                        ch = 32
                    lbl[k] = ch
                    k = k + 1
                lbl[k] = 0
                _glyphs(bx + 24, bar + 5, &lbl[0], fg, cur_bold)
                t = t + 1
    else:
        # vertical taskbar: one button per window stacked down the column
        t2: uint64 = 0
        while t2 < n_tasks:
            byv: int64 = lo + cast[int64](t2) * 24
            if byv + 22 > hi:
                t2 = n_tasks
            else:
                stv: int32 = 0
                if panel_active_wid != 0 and task_wid[t2] == panel_active_wid:
                    stv = 2
                elif _hov_span(byv, 22) != 0:
                    stv = 1
                _task_button(bar + 3, byv, cur_thick - 6, 22, stv)
                lbl2: Array[12, uint8]
                nbase2: uint64 = t2 * 64
                nl2: uint64 = task_namelen[t2]
                # Clip the label to the panel CROSS-AXIS width: text begins at
                # bar+6 and must stay inside the bar+3..bar+cur_thick-3 button,
                # so the budget is (cur_thick-9)/8 glyphs (8px advance). This
                # stops names overflowing past the right of a left/right panel.
                vmax: int64 = (cur_thick - 9) / 8
                if vmax < 1:
                    vmax = 1
                if vmax > 11:
                    vmax = 11
                if nl2 > cast[uint64](vmax):
                    nl2 = cast[uint64](vmax)
                k2: uint64 = 0
                while k2 < nl2:
                    ch2: uint8 = task_name[nbase2 + k2]
                    if ch2 == 34 or ch2 == 10:
                        ch2 = 32
                    lbl2[k2] = ch2
                    k2 = k2 + 1
                lbl2[k2] = 0
                _glyphs(bar + 6, byv + 3, &lbl2[0], fg, cur_bold)
                t2 = t2 + 1


SYSMON_CPU: Array[9, uint8] = "#57bb6e"    # soft green
SYSMON_MEM: Array[9, uint8] = "#5b8def"    # soft blue


# MATE-style system-monitor applet: a scrolling CPU (green columns) + memory
# (blue line) history sparkline. Clicking it opens the full System Monitor app
# (/bin/hammonscene) — wired in _handle_bar_click's widget dispatch.
def _render_sysmon(lo: int64, bar: int64):
    if cur_horiz != 0:
        # Graph fills the widget box; a compact "nn%" CPU readout sits at the
        # right so the current value is legible at a glance.
        gw: int64 = SYSMON_W - 26
        _sm_spark(lo, bar + 3, gw, cur_thick - 6)
        lab: Array[8, uint8]
        lp: uint64 = _u64_to_dec(cast[uint64](_sm_clamp(_sm_cur_cpu)), &lab[0])
        lab[lp] = 37                                      # '%'
        lab[lp + 1] = 0
        _glyphs(lo + gw + 3, bar + (cur_thick - 12) / 2, &lab[0],
                &PC_FG[0], cur_bold)
    else:
        # Vertical panel: a single square-ish sparkline in the column.
        _sm_spark(bar + 3, lo, cur_thick - 6, 24)


def _render_clock(lo: int64, bar: int64, btime: uint64):
    # MATE-style clock: horizontal panels show the full weekday/month/day
    # AND the time ("Sat Jul 12  14:30"); narrow vertical panels stay compact
    # (HH:MM only). Both formats live in lib/panelclock.ad (pure, host-testable).
    fg: Ptr[uint8] = &PC_FG[0]
    epoch: uint64 = _now_epoch_secs(btime)
    if cur_horiz != 0:
        panelclock_render(cast[int32](lo), cast[int32](bar) + 5, epoch,
                          cur_bold, fg)
    else:
        panelclock_render_time(cast[int32](bar) + 6, cast[int32](lo), epoch,
                               cur_bold, fg)


# --- Workspace switcher (pager) -------------------------------------
# Draws WS_COUNT cells. The active workspace cell is lit blue with its 1-based
# number in white; inactive cells are sunken grey with a dark number. The
# whole applet is a real virtual-desktop switcher: clicking a cell calls
# _switch_workspace which drives the compositor's workspace_switch.
# Draw one rounded workspace cell (active = lit accent, hover = soft tint,
# else neutral) with its 1-based number centred.
def _pager_cell(x: int64, y: int64, w: int64, h: int64, num: int64,
                active: int32, hover: int32):
    face: Ptr[uint8] = cast[Ptr[uint8]]("#dfe1e6")
    bd: Ptr[uint8] = &PC_CHIP_BD[0]
    fgc: Ptr[uint8] = cast[Ptr[uint8]]("#384150")
    if active != 0:
        face = &PC_ACCENT[0]
        bd = &PC_ACCENT_D[0]
        fgc = &PC_FG_ON[0]
    elif hover != 0:
        face = &PC_HOVER[0]
        bd = &PC_HOVER_BD[0]
    hamscene_roundrect(cast[int32](x), cast[int32](y), cast[int32](w),
                       cast[int32](h), 4, bd)
    hamscene_roundrect(cast[int32](x + 1), cast[int32](y + 1),
                       cast[int32](w - 2), cast[int32](h - 2), 3, face)
    if active != 0:
        _ovl_fill(x + 3, y + 1, w - 6, 1, 1, 90)          # active-cell sheen
    lab: Array[4, uint8]
    _u64_to_dec(cast[uint64](num), &lab[0])
    lab[1] = 0
    # centre the digit (8px cell)
    _glyphs(x + (w - 8) / 2, y + (h - 12) / 2, &lab[0], fgc, cur_bold)


def _render_pager(lo: int64, bar: int64):
    gap: int64 = 2
    if cur_horiz != 0:
        w: int64 = 0
        while w < WS_COUNT:
            cx: int64 = lo + w * (PAGER_CELL_W + gap)
            if cx + PAGER_CELL_W > lo + PAGER_W + 2:
                w = WS_COUNT
            else:
                hov: int32 = 0
                if w != cur_ws and _hov_span(cx, PAGER_CELL_W) != 0:
                    hov = 1
                act: int32 = 0
                if w == cur_ws:
                    act = 1
                _pager_cell(cx, bar + 4, PAGER_CELL_W, 18, w + 1, act, hov)
                w = w + 1
    else:
        # vertical: stack cells down the column
        w2: int64 = 0
        while w2 < WS_COUNT:
            cy: int64 = lo + w2 * (PAGER_CELL_W + gap)
            hov2: int32 = 0
            if w2 != cur_ws and _hov_span(cy, 18) != 0:
                hov2 = 1
            act2: int32 = 0
            if w2 == cur_ws:
                act2 = 1
            _pager_cell(bar + 4, cy, cur_thick - 8, 18, w2 + 1, act2, hov2)
            w2 = w2 + 1


# --- Notification-area / tray applet --------------------------------
# A bell glyph in a flat cell. When there are unread notifications we paint a
# red badge with the unread COUNT at the bell's top-right. A click spawns
# /bin/haminbox (the scene message-history inbox) and clears the unread count.
def _render_tray(lo: int64, bar: int64):
    if _hov_span(lo, TRAY_W) != 0:
        _chip_pill(lo, TRAY_W, bar, 0)
    bell: Ptr[uint8] = cast[Ptr[uint8]]("#38414f")
    bx: int32 = cast[int32](lo)
    by: int32 = cast[int32](bar)
    # Bell body: a rounded-ish trapezoid faked with two stacked rects + clapper.
    hamscene_fill(bx + 7, by + 6, 8, 9, bell)
    hamscene_fill(bx + 5, by + 14, 12, 2, bell)
    hamscene_fill(bx + 9, by + 5, 4, 2, bell)
    hamscene_fill(bx + 10, by + 16, 2, 2, bell)
    if notif_unread > 0:
        # Red badge + count digit at the bell's top-right.
        hamscene_fill(bx + 13, by + 2, 9, 9, cast[Ptr[uint8]]("#e03030"))
        cnt: int64 = notif_unread
        if cnt > 9:
            cnt = 9
        cbuf: Array[2, uint8]
        _u64_to_dec(cast[uint64](cnt), &cbuf[0])
        cbuf[1] = 0
        _glyphs(cast[int64](bx) + 14, cast[int64](by) + 2, &cbuf[0],
                cast[Ptr[uint8]]("#ffffff"), 0)


# --- Session / power button applet ----------------------------------
# A power-symbol glyph (ring + stem). A click spawns /bin/hamsessui (the
# Lock / Log Out / Shut Down / Reboot dialog).
def _render_session(lo: int64, bar: int64):
    if _hov_span(lo, SESSION_W) != 0:
        _chip_pill(lo, SESSION_W, bar, 0)
    col: Ptr[uint8] = cast[Ptr[uint8]]("#2f7d43")
    bx: int32 = cast[int32](lo)
    by: int32 = cast[int32](bar)
    # Ring: four short segments forming an open circle.
    hamscene_fill(bx + 6, by + 9, 2, 6, col)        # left
    hamscene_fill(bx + 16, by + 9, 2, 6, col)       # right
    hamscene_fill(bx + 8, by + 16, 8, 2, col)       # bottom
    hamscene_fill(bx + 7, by + 7, 4, 2, col)        # top-left arc
    hamscene_fill(bx + 13, by + 7, 4, 2, col)       # top-right arc
    # Stem (the power-symbol vertical bar through the gap).
    hamscene_fill(bx + 11, by + 5, 2, 7, col)


# --- Launcher applet (#283) -----------------------------------------
# A one-click app launcher: a placeholder icon chip (a coloured square with the
# label's first letter — the #285 seam for real per-app icons) followed by the
# text label. A click spawns the carried Exec path (see _handle_click). `g` is
# the global slot (cur_panel_idx*MAX_WIDGETS+slot) whose p_wexec/p_wlabel hold
# the payload; `lo` is the widget's flow-axis start.
# Map a launcher LABEL to a #285 icon code by keyword (so the Terminal chip
# shows the real terminal glyph, etc.); returns -1 when unrecognised so the
# caller falls back to the coloured initial-letter chip.
def _launcher_icon(label: Ptr[uint8]) -> int32:
    ls: Array[24, uint8]
    k: uint64 = 0
    while label[k] != 0 and k < 23:
        c: uint8 = label[k]
        if c >= 65 and c <= 90:
            c = c + 32
        ls[k] = c
        k = k + 1
    ls[k] = 0
    s: Ptr[uint8] = &ls[0]
    if _substr(s, cast[Ptr[uint8]]("term")) != 0:
        return hamscene_icon_code(cast[Ptr[uint8]]("terminal"))
    if _substr(s, cast[Ptr[uint8]]("file")) != 0:
        return hamscene_icon_code(cast[Ptr[uint8]]("system-file-manager"))
    if _substr(s, cast[Ptr[uint8]]("calc")) != 0:
        return hamscene_icon_code(cast[Ptr[uint8]]("accessories-calculator"))
    if _substr(s, cast[Ptr[uint8]]("brows")) != 0 \
            or _substr(s, cast[Ptr[uint8]]("web")) != 0:
        return hamscene_icon_code(cast[Ptr[uint8]]("web-browser"))
    if _substr(s, cast[Ptr[uint8]]("setting")) != 0:
        return hamscene_icon_code(cast[Ptr[uint8]]("preferences-system"))
    return -1


def _render_launcher(g: uint64, lo: int64, bar: int64):
    fg: Ptr[uint8] = &PC_FG[0]
    label: Ptr[uint8] = _wlabel_ptr(g)
    ic: int32 = _launcher_icon(label)
    if cur_horiz != 0:
        if _hov_span(lo, _launcher_w(g)) != 0:
            _chip_pill(lo, _launcher_w(g), bar, 0)
        iy: int32 = cast[int32](bar) + 5
        if ic >= 0:
            hamscene_icon_draw(cast[int32](lo) + 6, iy,
                               cast[int32](LAUNCH_ICON),
                               cast[int32](LAUNCH_ICON), ic)
        else:
            # Fallback: a rounded blue chip + the initial letter.
            hamscene_roundrect(cast[int32](lo) + 6, iy,
                               cast[int32](LAUNCH_ICON),
                               cast[int32](LAUNCH_ICON), 4,
                               cast[Ptr[uint8]]("#5a7fb0"))
            gl: Array[2, uint8]
            gl[0] = _launcher_glyph(label)
            gl[1] = 0
            _glyphs(lo + 10, bar + 7, &gl[0], cast[Ptr[uint8]]("#ffffff"),
                    cur_bold)
        # Label to the right of the chip.
        _glyphs(lo + 6 + LAUNCH_ICON + 6, bar + 5, label, fg, cur_bold)
    else:
        # Vertical panel: icon chip centred in the 24px cell; no label (narrow).
        by: int32 = cast[int32](lo)
        if ic >= 0:
            hamscene_icon_draw(cast[int32](bar) + 4, by + 4,
                               cast[int32](LAUNCH_ICON),
                               cast[int32](LAUNCH_ICON), ic)
        else:
            hamscene_roundrect(cast[int32](bar) + 4, by + 4,
                               cast[int32](LAUNCH_ICON),
                               cast[int32](LAUNCH_ICON), 4,
                               cast[Ptr[uint8]]("#5a7fb0"))
            gl2: Array[2, uint8]
            gl2[0] = _launcher_glyph(label)
            gl2[1] = 0
            _glyphs(bar + 8, lo + 6, &gl2[0], cast[Ptr[uint8]]("#ffffff"),
                    cur_bold)


# The menu dropdown box origin (window-local). For a top panel it opens below
# the bar; bottom opens above; vertical panels open to the inside edge.
menu_box_x: int64 = 0
menu_box_y: int64 = 26


def _compute_menu_box(bar: int64):
    if cur_horiz != 0:
        menu_box_x = menu_lo
        if cur_edge == EDGE_BOTTOM:
            menu_box_y = 0
        else:
            menu_box_y = bar + cur_thick
    else:
        # vertical: open to the inside edge, aligned with the Apps row
        if cur_edge == EDGE_LEFT:
            menu_box_x = bar + cur_thick
        else:
            menu_box_x = bar - MENU_W
        menu_box_y = menu_lo


# Compute the open child fly-out's box origin (window-local). MATE style: the
# child opens to the RIGHT of the main dropdown, its top roughly aligned with
# ITS OWN parent row ("Debian apps" / "Alpine apps"), clamped so it stays
# inside the grown panel window (MENU_H tall). If it would overflow the
# window's right edge it flips to the LEFT of the main box. Requires
# _compute_menu_box first.
def _compute_sub_box(bar: int64):
    nc: uint64 = _native_count() + _sub_idx()
    # parent-row top within the main box.
    prtop: int64 = menu_box_y + 2 + cast[int64](nc) * MENU_ROW_H
    sh: int64 = _sub_h()
    sy: int64 = prtop - 2
    # keep the child within the reserved window band [menu_box_y, +MENU_H].
    if sy + sh > menu_box_y + MENU_H:
        sy = menu_box_y + MENU_H - sh
    if sy < menu_box_y:
        sy = menu_box_y
    sub_box_y = sy
    # default: to the right, overlapping the main frame by 1px for continuity.
    sx: int64 = menu_box_x + MENU_W - 1
    if sx + SUBMENU_W > cur_sw:
        sx = menu_box_x - SUBMENU_W + 1      # flip left
    if sx < 0:
        sx = 0
    sub_box_x = sx


# Compute the context-menu box origin (window-local). It anchors at the
# right-click flow coordinate (ctx_flow) and opens into the popup band on the
# inside (desktop-facing) edge, mirroring the Apps dropdown geometry. ctx_flow
# is the click's flow-axis coordinate (x for horizontal panels, y for vertical)
# captured when the menu opened.
ctx_flow: int64 = 0
def _compute_ctx_box(bar: int64):
    bh: int64 = ctx_box_h()
    if cur_horiz != 0:
        cx: int64 = ctx_flow
        if cx + CTX_W > cur_sw:
            cx = cur_sw - CTX_W
        if cx < 0:
            cx = 0
        ctx_box_x = cx
        if cur_edge == EDGE_BOTTOM:
            ctx_box_y = bar - bh             # opens above the bar
            if ctx_box_y < 0:
                ctx_box_y = 0
        else:
            ctx_box_y = bar + cur_thick      # opens below the bar
    else:
        cy: int64 = ctx_flow
        if cy + bh > cur_sh:
            cy = cur_sh - bh
        if cy < 0:
            cy = 0
        ctx_box_y = cy
        if cur_edge == EDGE_LEFT:
            ctx_box_x = bar + cur_thick
        else:
            ctx_box_x = bar - CTX_W


# Compute the add-applet dialog box origin (window-local). Anchors at the
# right-click flow coordinate and opens into the popup band on the inside
# (desktop-facing) edge, mirroring the context-menu geometry but sized to the
# larger chooser.
def _compute_addlet_box(bar: int64):
    dw: int64 = cast[int64](ctxm_choice_w())
    dh: int64 = cast[int64](ctxm_choice_content_h())
    if cur_horiz != 0:
        cx: int64 = addlet_flow
        if cx + dw > cur_sw:
            cx = cur_sw - dw
        if cx < 0:
            cx = 0
        addlet_box_x = cx
        if cur_edge == EDGE_BOTTOM:
            addlet_box_y = bar - dh             # opens above the bar
            if addlet_box_y < 0:
                addlet_box_y = 0
        else:
            addlet_box_y = bar + cur_thick      # opens below the bar
    else:
        cy: int64 = addlet_flow
        if cy + dh > cur_sh:
            cy = cur_sh - dh
        if cy < 0:
            cy = 0
        addlet_box_y = cy
        if cur_edge == EDGE_LEFT:
            addlet_box_x = bar + cur_thick
        else:
            addlet_box_x = bar - dw


def _drop_preview_boundary() -> int64:
    # Resolve the raw cursor flow coord to the insertion BOUNDARY, using the
    # shared, host-tested placement math (lib/dropplace) so the preview caret
    # and the release-time commit agree pixel-for-pixel.
    return dp_panel_insert_boundary(drop_prev_flow, &wx0[0], &wx1[0], n_widg)


def _render_drop_preview(bar: int64):
    # A MATE-style insertion caret: a 3px accent line spanning the bar
    # thickness with small end caps, at the resolved drop boundary.
    f: int64 = _drop_preview_boundary()
    if cur_horiz != 0:
        x: int32 = cast[int32](f - 1)
        hamscene_fill(x, cast[int32](bar + 2), 3,
                      cast[int32](cur_thick - 4), &PC_ACCENT[0])
        hamscene_fill(x - 2, cast[int32](bar + 2), 7, 2, &PC_ACCENT_D[0])
        hamscene_fill(x - 2, cast[int32](bar + cur_thick - 4), 7, 2,
                      &PC_ACCENT_D[0])
    else:
        y: int32 = cast[int32](f - 1)
        hamscene_fill(cast[int32](bar + 2), y,
                      cast[int32](cur_thick - 4), 3, &PC_ACCENT[0])
        hamscene_fill(cast[int32](bar + 2), y - 2, 2, 7, &PC_ACCENT_D[0])
        hamscene_fill(cast[int32](bar + cur_thick - 4), y - 2, 2, 7,
                      &PC_ACCENT_D[0])


def _emit_panel(bar: int64, btime: uint64):
    hamscene_begin()
    # NO whole-window backdrop fill. When a popup (Apps dropdown / context menu
    # / add-applet chooser) opens, this window GROWS to hold it (full screen
    # width for a horizontal panel). Filling the whole grown rect painted a
    # solid band to the RIGHT of (and below) the menu card — the user-reported
    # "solid fill instead of the desktop to the right of the Applications menu".
    # Instead we paint ONLY the bar strip (below) and the popup card (in
    # _render_menu / the ctx/addlet emitters); every un-painted pixel of the
    # grown band stays alpha-0 (the compositor memsets the cache each frame).
    # The panel window is `keyed 1`, so the compositor's alpha-keyed present
    # skips those alpha-0 pixels and the desktop / lower windows composite
    # through — exactly the MATE look of a menu card floating on the desktop.
    # The panel bar itself: an opaque neutral base (the scene-render gate
    # asserts this `fill 0 0 <sw> 26 #eceef2` line for the top panel) topped
    # with a modern translucent sheen/shade gradient + a desktop-facing
    # hairline (see _panel_depth).
    if cur_horiz != 0:
        hamscene_fill(0, cast[int32](bar), cast[int32](cur_sw),
                      cast[int32](cur_thick), cur_panel_color())
    else:
        hamscene_fill(cast[int32](bar), 0, cast[int32](cur_thick),
                      cast[int32](cur_sh), cur_panel_color())
    _panel_depth(bar, cur_thick)
    # widgets
    a: uint64 = 0
    while a < n_widg:
        k: int32 = wkind_cur[a]
        if k == WK_MENU:
            _render_menu(wx0[a], bar)
        elif k == WK_TASKS:
            _render_tasks(wx0[a], wx1[a], bar)
        elif k == WK_SYSMON:
            _render_sysmon(wx0[a], bar)
        elif k == WK_CLOCK:
            _render_clock(wx0[a], bar, btime)
        elif k == WK_PAGER:
            _render_pager(wx0[a], bar)
        elif k == WK_TRAY:
            _render_tray(wx0[a], bar)
        elif k == WK_SESSION:
            _render_session(wx0[a], bar)
        elif k == WK_LAUNCHER:
            _render_launcher(cur_panel_idx * MAX_WIDGETS + a, wx0[a], bar)
        a = a + 1
    # LIVE DROP PREVIEW: while a drag-from-menu offer hovers THIS bar, draw an
    # insertion indicator at the boundary the launcher would land on, resolved
    # with the SAME placement math the release-time commit uses.
    if pend_active != 0 and drop_prev_active != 0 \
            and drop_prev_panel == cur_panel_idx:
        _render_drop_preview(bar)
    # dropdown
    if menu_open != 0 and menu_slot >= 0:
        _compute_menu_box(bar)
        mx: int32 = cast[int32](menu_box_x)
        my: int32 = cast[int32](menu_box_y)
        # Rounded popover card (KDE-ish): a 1px border ring + inset face.
        hamscene_roundrect(mx, my, cast[int32](MENU_W),
                           cast[int32](menu_main_h), 8,
                           cast[Ptr[uint8]]("#cfd2d8"))
        hamscene_roundrect(mx + 1, my + 1, cast[int32](MENU_W) - 2,
                           cast[int32](menu_main_h) - 2, 7,
                           cast[Ptr[uint8]]("#f7f8fa"))
        fg: Ptr[uint8] = cast[Ptr[uint8]]("#202020")
        nc: uint64 = _native_count()
        # Native .desktop rows (sorted by category+Name).
        mi: uint64 = 0
        while mi < nc:
            ry: int64 = menu_box_y + 5 + cast[int64](mi) * MENU_ROW_H
            _glyphs(menu_box_x + 10, ry, &am_name[mi][0], fg, cur_bold)
            mi = mi + 1
        # One parent row per ATTACHED distribution, named for it — hovering
        # one opens its child fly-out. No distribution attached draws no rows
        # here at all, which is the honest picture of a machine with no
        # distribution namespace on it.
        di: uint64 = 0
        while di < dm_count:
            prtop: int64 = menu_box_y + 2 + cast[int64](nc + di) * MENU_ROW_H
            pry: int64 = prtop + 3
            if sub_open != 0 and _sub_idx() == di:
                # highlight the parent row while its fly-out is showing.
                hamscene_fill(mx + 1, cast[int32](prtop),
                              cast[int32](MENU_W - 2), cast[int32](MENU_ROW_H),
                              cast[Ptr[uint8]]("#d3e3fb"))
            _dm_mklabel(di)
            _glyphs(menu_box_x + 10, pry, &_dm_label[0], fg, cur_bold)
            # right-pointing chevron marking the sub-menu.
            _glyphs(menu_box_x + MENU_W - 16, pry, cast[Ptr[uint8]](">"), fg,
                    cur_bold)
            di = di + 1
        # The child fly-out popup with that distribution's apps.
        if sub_open != 0 and _sub_idx() < dm_count:
            si: uint64 = _sub_idx()
            _compute_sub_box(bar)
            sh: int64 = _sub_h()
            sx: int32 = cast[int32](sub_box_x)
            sy: int32 = cast[int32](sub_box_y)
            hamscene_roundrect(sx, sy, cast[int32](SUBMENU_W),
                               cast[int32](sh), 8,
                               cast[Ptr[uint8]]("#cfd2d8"))
            hamscene_roundrect(sx + 1, sy + 1, cast[int32](SUBMENU_W) - 2,
                               cast[int32](sh) - 2, 7,
                               cast[Ptr[uint8]]("#f7f8fa"))
            if dm_apps[si] == 0:
                # Disabled placeholder. The namespace IS attached; it just
                # ships no launchers — a different answer from "there is no
                # such distribution", which shows no section at all.
                _dm_mkempty(si)
                _glyphs(sub_box_x + 10, sub_box_y + 5, &_dm_empty[0],
                        cast[Ptr[uint8]]("#909090"), cur_bold)
            else:
                base: uint64 = _dm_start(si)
                li: uint64 = 0
                while li < dm_apps[si]:
                    idx: uint64 = base + li
                    sry: int64 = sub_box_y + 5 + cast[int64](li) * MENU_ROW_H
                    _glyphs(sub_box_x + 10, sry, &am_name[idx][0], fg,
                            cur_bold)
                    li = li + 1
    # right-click context menu (Add to Panel / Move / Remove)
    if ctx_open != 0 and ctx_panel == cur_panel_idx:
        _compute_ctx_box(bar)
        bh: int64 = ctx_box_h()
        cmx: int32 = cast[int32](ctx_box_x)
        cmy: int32 = cast[int32](ctx_box_y)
        # Rounded popover card to match the launcher menu (border ring + face).
        hamscene_roundrect(cmx, cmy, cast[int32](CTX_W), cast[int32](bh), 7,
                           cast[Ptr[uint8]]("#cfd2d8"))
        hamscene_roundrect(cmx + 1, cmy + 1, cast[int32](CTX_W) - 2,
                           cast[int32](bh) - 2, 6,
                           cast[Ptr[uint8]]("#f7f8fa"))
        cfg: Ptr[uint8] = cast[Ptr[uint8]]("#202020")
        nr: int64 = ctx_rows()
        ri: int64 = 0
        while ri < nr:
            ry: int64 = ctx_box_y + 5 + ri * CTX_ROW_H
            _glyphs(ctx_box_x + 10, ry, _ctx_row_label(ri), cfg, cur_bold)
            ri = ri + 1
    # add-applet chooser DIALOG (opened by the panel menu's "Add to Panel...")
    if addlet_open != 0 and addlet_panel == cur_panel_idx:
        _compute_addlet_box(bar)
        ctxm_choice_draw(cast[int32](addlet_box_x), cast[int32](addlet_box_y),
                         -1)
    # THE UPDATE NOTICE, LAST, so it is on top of every popup above it. It is
    # the one thing on this panel that is not a menu the person opened, and a
    # dropdown drawn over the sentence explaining why that dropdown is empty
    # would be the original defect with an extra step. _handle_click tests it
    # FIRST for the matching reason.
    if notice_on != 0 and notice_panel == cur_panel_idx:
        _notice_draw(bar)


# Label for context-menu row `ri` given the active ctx_kind.
def _ctx_row_label(ri: int64) -> Ptr[uint8]:
    if ctx_kind == CTXK_PANELMENU:
        # MATE panel menu: "Add to Panel..." (0), "Properties" (1). Shared with
        # the #124 host gate via ctxm_panel_label.
        return ctxm_panel_label(cast[uint64](ri))
    if ctx_kind == CTXK_APPMENU:
        if ri == 0:
            return cast[Ptr[uint8]]("Settings")
        if ri == 1:
            return cast[Ptr[uint8]]("Add to Panel")
        return cast[Ptr[uint8]]("About")
    if ctx_kind == CTXK_WIDGET:
        if ri == 0:
            return cast[Ptr[uint8]]("Move")
        return cast[Ptr[uint8]]("Remove From Panel")
    # CTXK_ADD: Clock, Sysmon, Menu, Tasks, Spacer, Pager, Tray, Session
    if ri == 0:
        return cast[Ptr[uint8]]("Clock")
    if ri == 1:
        return cast[Ptr[uint8]]("Sysmon")
    if ri == 2:
        return cast[Ptr[uint8]]("Menu")
    if ri == 3:
        return cast[Ptr[uint8]]("Tasks")
    if ri == 4:
        return cast[Ptr[uint8]]("Spacer")
    if ri == 5:
        return cast[Ptr[uint8]]("Workspaces")
    if ri == 6:
        return cast[Ptr[uint8]]("Notifications")
    return cast[Ptr[uint8]]("Session")


# Map an Add-menu row index to a widget kind.
def _ctx_add_kind(ri: int64) -> int32:
    if ri == 0:
        return WK_CLOCK
    if ri == 1:
        return WK_SYSMON
    if ri == 2:
        return WK_MENU
    if ri == 3:
        return WK_TASKS
    if ri == 4:
        return WK_SPACER
    if ri == 5:
        return WK_PAGER
    if ri == 6:
        return WK_TRAY
    return WK_SESSION


# the bar fill colour for the current panel: an index into p_color, set by
# _select_panel. (A Ptr[uint8] global can't take a cast initializer, so we
# key by index and resolve through p_color_ptr at use sites.)
cur_panel_idx: uint64 = 0
def cur_panel_color() -> Ptr[uint8]:
    return p_color_ptr(cur_panel_idx)


# Set a window's geometry: origin (x,y) + content size (w,h).
def _set_geometry_xy(ctlpath: Ptr[char], x: int64, y: int64, w: int64, h: int64):
    cfd: int32 = sys_open_write(ctlpath)
    if cfd < 0:
        return
    geo: Array[64, uint8]
    gp: uint64 = 0
    pre: Ptr[uint8] = cast[Ptr[uint8]]("geometry ")
    j: uint64 = 0
    while pre[j] != 0:
        geo[gp] = pre[j]
        gp = gp + 1
        j = j + 1
    gp = gp + _u64_to_dec(cast[uint64](x), &geo[gp])
    geo[gp] = 32
    gp = gp + 1
    gp = gp + _u64_to_dec(cast[uint64](y), &geo[gp])
    geo[gp] = 32
    gp = gp + 1
    gp = gp + _u64_to_dec(cast[uint64](w), &geo[gp])
    geo[gp] = 32
    gp = gp + 1
    gp = gp + _u64_to_dec(cast[uint64](h), &geo[gp])
    geo[gp] = 10
    gp = gp + 1
    sys_write(cfd, &geo[0], gp)
    sys_close(cfd)


# Spawn a scene app by absolute path. Detached stdio (-2/-2).
launch_argv: Array[6, uint64]
# pid of the most recent _launch() spawn (or <0 on failure). Read straight
# after a _launch call to associate the spawned app with a tracked slot.
last_launched_pid: int32 = 0
def _launch(prog: Ptr[char]):
    launch_argv[0] = cast[uint64](prog)
    launch_argv[1] = 0
    # THE SECOND HALF OF THE MISSING-PROGRAM ANSWER. The scan above keeps a
    # dead launcher out of the menu, but a click can still reach a name that
    # has gone since (a package removed under a running session, a launch
    # queued by hand on /dev/wsys/appmenu/launch). spawn_detached CANNOT tell
    # us: fork(2) succeeds and it is execve(2) in the child that fails, so the
    # call returns a perfectly good pid for a program that never ran and the
    # line below would report `launched`. Probe first, and fail BY NAME.
    if _prog_installed(cast[Ptr[uint8]](prog)) == 0:
        last_launched_pid = -1
        _writeall(1, cast[Ptr[uint8]]("[panel] LAUNCH FAILED "))
        _writeall(1, cast[Ptr[uint8]](prog))
        _writeall(1, cast[Ptr[uint8]](": not installed\n"))
        return
    # DETACHED: the panel never wait4s its launched apps, so a plain spawn
    # would leak each one as an un-reapable zombie (a still-live parent makes
    # reap_orphan_zombies skip it) — the app menu eventually hit fork-EAGAIN
    # and stopped launching. RFNOWAIT lets the kernel reclaim them at exit.
    pid: int32 = spawn_detached(prog, &launch_argv[0], -2, -2,
                                cast[Ptr[uint64]](0))
    last_launched_pid = pid
    if pid >= 0:
        _writeall(1, cast[Ptr[uint8]]("[panel] launched "))
        _writeall(1, cast[Ptr[uint8]](prog))
        _writeall(1, cast[Ptr[uint8]]("\n"))


# Spawn a queued launch line that carries ARGUMENTS: "/bin/prog a1 a2 ...".
# `line` is a mutable, NUL-terminated copy of the queue payload; each space is
# overwritten with a NUL in place so every token becomes its own C string, and
# up to LAUNCH_MAX_ARGS-1 arguments are passed through to the app. A line with
# no space takes the plain _launch path, byte-for-byte as before.
#
# WHY: the DE launch queue could only ever spawn argv[0]. Anything that needs a
# parameter — `hamctl --wall 2` to apply a wallpaper, a viewer with a file —
# had no way in, and running it from the serial shell instead is NOT the same
# thing: the shell's session is not the DE's, so /dev/wsys/ctl verbs that the
# DE may issue are refused there. Splitting here means an automated check can
# exercise the app exactly as a click would.
LAUNCH_MAX_ARGS: uint64 = 6
def _launch_line(line: Ptr[uint8]):
    n: uint64 = 0
    launch_argv[0] = cast[uint64](line)
    n = 1
    i: uint64 = 0
    while line[i] != 0:
        if line[i] == 32:
            line[i] = 0
            j: uint64 = i + 1
            while line[j] == 32:                        # collapse runs
                j = j + 1
            if line[j] != 0 and n + 1 < LAUNCH_MAX_ARGS:
                launch_argv[n] = cast[uint64](&line[j])
                n = n + 1
            i = j
        else:
            i = i + 1
    launch_argv[n] = 0
    if n == 1:
        _launch(cast[Ptr[char]](line))                   # no args: unchanged
        return
    # Same probe as _launch(): a bad path here would spawn a child that dies in
    # execve and still report "launched".
    if _prog_installed(line) == 0:
        last_launched_pid = -1
        _writeall(1, cast[Ptr[uint8]]("[panel] LAUNCH FAILED "))
        _writeall(1, line)
        _writeall(1, cast[Ptr[uint8]](": not installed\n"))
        return
    pid: int32 = spawn_detached(cast[Ptr[char]](line), &launch_argv[0], -2, -2,
                                cast[Ptr[uint64]](0))
    last_launched_pid = pid
    if pid >= 0:
        _writeall(1, cast[Ptr[uint8]]("[panel] launched "))
        _writeall(1, cast[Ptr[uint8]](line))
        _writeall(1, cast[Ptr[uint8]](" (with args)\n"))


# Is `pid` still the LIVE inbox popup we spawned? Reads /proc/<pid>/comm (the
# task's command name) and returns 1 iff it is "haminbox". Checking the comm
# name — not merely that /proc/<pid> exists — closes the pid-REUSE hole: once
# our inbox exits, its pid may be recycled by an unrelated task, and we must
# NOT send that task a terminate note (nor treat it as "popup still open").
_pidpath: Array[40, uint8]
_commbuf: Array[32, uint8]
_statbuf: Array[64, uint8]


# Is `pid` a ZOMBIE (exited-but-unreaped) task? A DETACHED child (the menu /
# inbox popups are spawn_detached) is only reclaimed by reap_orphan_zombies()
# at the NEXT fork, so between the popup's sys_exit and that reap it lingers in
# /proc as STATE_EXITED — and /proc/<pid>/comm STILL reads its comm name. A
# plain comm-name liveness check therefore reports a CLOSED popup as "alive",
# so the toggle sends a no-op terminate instead of re-spawning and the menu
# WON'T REOPEN until some unrelated fork happens to reap it (the intermittent
# "odd state" #313, worst on the click-away path which forks nothing). We
# additionally consult /proc/<pid>/stat, whose field 3 is the Linux state
# letter ('Z' for a zombie/exited task), and treat 'Z' as dead. Returns 1 iff
# the task is a zombie; a missing/unreadable stat conservatively returns 0.
def _proc_is_zombie(pid: int32) -> int32:
    if pid <= 0:
        return 0
    p: uint64 = 0
    pre: Ptr[uint8] = cast[Ptr[uint8]]("/proc/")
    j: uint64 = 0
    while pre[j] != 0:
        _pidpath[p] = pre[j]
        p = p + 1
        j = j + 1
    p = p + _u64_to_dec(cast[uint64](pid), &_pidpath[p])
    leaf: Ptr[uint8] = cast[Ptr[uint8]]("/stat")
    k: uint64 = 0
    while leaf[k] != 0:
        _pidpath[p] = leaf[k]
        p = p + 1
        k = k + 1
    _pidpath[p] = 0
    fd: int32 = sys_open(cast[Ptr[char]](&_pidpath[0]))
    if fd < 0:
        return 0
    n: int64 = sys_read(fd, &_statbuf[0], 63)
    sys_close(fd)
    if n <= 0:
        return 0
    # Format: "pid (comm) STATE ...". Scan to the LAST ')' (comm is
    # parenthesised), then the first non-space byte after it is the state
    # letter. 'Z' == zombie/exited.
    cap: uint64 = cast[uint64](n)
    rp: int64 = -1
    q: uint64 = 0
    while q < cap:
        if _statbuf[q] == 41:                    # ')'
            rp = cast[int64](q)
        q = q + 1
    if rp < 0:
        return 0
    s: uint64 = cast[uint64](rp) + 1
    while s < cap and _statbuf[s] == 32:
        s = s + 1
    if s < cap and _statbuf[s] == 90:            # 'Z'
        return 1
    return 0
def _inbox_alive(pid: int32) -> int32:
    if pid <= 0:
        return 0
    p: uint64 = 0
    pre: Ptr[uint8] = cast[Ptr[uint8]]("/proc/")
    j: uint64 = 0
    while pre[j] != 0:
        _pidpath[p] = pre[j]
        p = p + 1
        j = j + 1
    p = p + _u64_to_dec(cast[uint64](pid), &_pidpath[p])
    leaf: Ptr[uint8] = cast[Ptr[uint8]]("/comm")
    k: uint64 = 0
    while leaf[k] != 0:
        _pidpath[p] = leaf[k]
        p = p + 1
        k = k + 1
    _pidpath[p] = 0
    fd: int32 = sys_open(cast[Ptr[char]](&_pidpath[0]))
    if fd < 0:
        return 0
    n: int64 = sys_read(fd, &_commbuf[0], 31)
    sys_close(fd)
    if n <= 0:
        return 0
    # Compare against "haminbox" (comm is the basename + '\n').
    want: Ptr[uint8] = cast[Ptr[uint8]]("haminbox")
    m: uint64 = 0
    while want[m] != 0:
        if m >= cast[uint64](n):
            return 0
        if _commbuf[m] != want[m]:
            return 0
        m = m + 1
    # Reject a zombie (detached popup lingers with comm intact after close
    # until the next fork reaps it) so a closed inbox reopens deterministically
    # — same #313 reopen fix as _appmenu_alive.
    if _proc_is_zombie(pid) != 0:
        return 0
    return 1


# The bell/tray click TOGGLES the notification inbox popup:
#   * if our last-spawned /bin/haminbox is still alive, terminate it (the
#     kernel's wsys reaper frees its window on the next panel tick) and do
#     NOT spawn another — a second click closes the popup instead of
#     stacking a duplicate on top of it;
#   * otherwise spawn a fresh inbox and clear the unread badge.
# Tracking the pid + liveness guarantees at most ONE inbox window exists, so
# the popup's own Close button (and Escape / click-away) always fully
# dismisses it. This is the fix for the "close button does nothing, the
# popup stays stuck" report (repeated bell clicks used to stack identical
# popups, so closing the top one merely revealed the one behind it).
def _toggle_notif_inbox():
    if _inbox_alive(notif_inbox_pid) != 0:
        # Popup already open: ask it to close (best-effort terminate note)
        # and, crucially, do NOT spawn a duplicate. We KEEP tracking the pid
        # so that even if the note is a no-op on this kernel, a further bell
        # click still refuses to stack a second popup — the popup's own Close
        # button (proven working) then dismisses the single window. Once it
        # does exit, _inbox_alive() reads a dead/recycled pid and the next
        # click opens a fresh inbox.
        p9_note(notif_inbox_pid, cast[Ptr[uint8]]("terminate"))
        return
    _launch(cast[Ptr[char]]("/bin/haminbox"))
    notif_inbox_pid = last_launched_pid
    notif_unread = 0


# Is `pid` still the LIVE Applications menu we spawned? Same comm-name check as
# _inbox_alive (closing the pid-REUSE hole), matching "hamappmenu".
def _appmenu_alive(pid: int32) -> int32:
    if pid <= 0:
        return 0
    p: uint64 = 0
    pre: Ptr[uint8] = cast[Ptr[uint8]]("/proc/")
    j: uint64 = 0
    while pre[j] != 0:
        _pidpath[p] = pre[j]
        p = p + 1
        j = j + 1
    p = p + _u64_to_dec(cast[uint64](pid), &_pidpath[p])
    leaf: Ptr[uint8] = cast[Ptr[uint8]]("/comm")
    k: uint64 = 0
    while leaf[k] != 0:
        _pidpath[p] = leaf[k]
        p = p + 1
        k = k + 1
    _pidpath[p] = 0
    fd: int32 = sys_open(cast[Ptr[char]](&_pidpath[0]))
    if fd < 0:
        return 0
    n: int64 = sys_read(fd, &_commbuf[0], 31)
    sys_close(fd)
    if n <= 0:
        return 0
    want: Ptr[uint8] = cast[Ptr[uint8]]("hamappmenu")
    m: uint64 = 0
    while want[m] != 0:
        if m >= cast[uint64](n):
            return 0
        if _commbuf[m] != want[m]:
            return 0
        m = m + 1
    # comm still matches — but a DETACHED menu lingers as a zombie (comm
    # intact) after it closes, until the next fork reaps it. Reject a zombie
    # so a closed menu reads DEAD and the toggle re-spawns it deterministically
    # (#313 reopen fix).
    if _proc_is_zombie(pid) != 0:
        return 0
    return 1


# pid of the most-recently-spawned /bin/hamappmenu (the CATEGORIZED, hover-
# fly-out Applications menu — #206/#220), or 0.
appmenu_pid: int32 = 0


# Panel-direct spawn of the Applications menu. We must NOT use the generic
# _launch() here: hamappmenu, when spawned directly by us, would consult
# /dev/wsys/self to self-discover a wid — but that file's ancestor walk-up
# (devwsys _wsys_wid_for_pid_or_ancestor) returns the PANEL'S OWN wid, since
# the panel is hamappmenu's parent and owns a window. hamappmenu would then
# bind OUR window instead of allocating its own dropdown, so no menu ever
# appears (the intermittent "Applications menu doesn't open" report — it only
# bit when the detached child's parent pointer still resolved to the panel at
# the self-read, hence a reboot sometimes dodged it). Passing "-self" tells
# hamappmenu to IGNORE /dev/wsys/self and always self-allocate, exactly like
# the reliable haminbox/hamcalscene/hamsessui popups (which never read self).
_appmenu_prog: Array[20, uint8] = "/bin/hamappmenu"
_appmenu_self_flag: Array[8, uint8] = "-self"
_appmenu_argv: Array[3, uint64]
def _launch_appmenu():
    _appmenu_argv[0] = cast[uint64](&_appmenu_prog[0])
    _appmenu_argv[1] = cast[uint64](&_appmenu_self_flag[0])
    _appmenu_argv[2] = 0
    pid: int32 = spawn_detached(cast[Ptr[char]](&_appmenu_prog[0]),
                                &_appmenu_argv[0], -2, -2,
                                cast[Ptr[uint64]](0))
    last_launched_pid = pid
    if pid >= 0:
        _writeall(1, cast[Ptr[uint8]]("[panel] launched /bin/hamappmenu -self\n"))


# Is the separate categorized menu client actually installed? Cached (-1
# unknown, 0 absent, 1 present).
#
# THIS IS NOT A DEFENSIVE CHECK, it is a bug being closed. #263 pointed the
# Applications button at /bin/hamappmenu, a separate v2 window client, instead
# of the panel's own in-panel dropdown. hamnix-linux's image does not build
# hamappmenu (it is not in scripts/hamlinux_image.sh's APPS list), so on this
# line the button spawned a program that does not exist and the menu never
# appeared -- measured: the click is delivered, the panel drains the event,
# `[panel] launched /bin/hamappmenu -self` is printed, and nothing opens. A
# claim of a launch with no window is precisely the success-shaped answer this
# tree keeps being bitten by, so the button now falls back to the dropdown the
# panel draws itself, and says once which one it is using.
#
# AND THE OTHER HALF: PRESENT IS NOT THE SAME AS WORKING. Once hamappmenu
# ships (it is in scripts/hamlinux_image.sh's APPS and in DESKTOP_CMDS now, so
# the `fd >= 0` branch below is the one every real machine takes), the
# remaining way for this button to answer a click with NOTHING is a menu that
# starts and cannot get a window -- the compositor's table full, /dev/wsys
# unreachable in the spawned namespace. It then prints to a stderr a detached
# spawn has already closed and dies, and the screen does not change.
#
# So hamappmenu writes $HOME/.hamde/appmenu.fault when its window allocation
# fails and REMOVES it the moment one succeeds (user/hamappmenu.ad's
# _fav_fault_set / _fav_fault_clear), and this function honours it: the button
# goes back to the dropdown the panel draws itself, and says so by name. It is
# re-checked on EVERY call while the menu is believed good, not cached with
# the first answer -- a menu that broke after the panel started is exactly the
# case a cached "present" would answer success-shaped forever.
#
# NOT a fixed /tmp name, deliberately: see the header of hamappmenu's
# favourites store, and tests/linux/private_ns.sh for what one of those cost.
_appmenu_present: int32 = -1
_am_fault_path: Array[224, uint8]
_am_fault_have: int32 = 0
_am_fault_home: Array[160, uint8]
def _am_fault_build() -> int32:
    if _am_fault_have != 0:
        return 1
    hn: uint64 = hd_resolve_home(&_am_fault_home[0], 160)
    if hn == 0:
        return 0
    p: uint64 = 0
    while p < hn and p < 200:
        _am_fault_path[p] = _am_fault_home[p]
        p = p + 1
    sfx: Ptr[uint8] = cast[Ptr[uint8]]("/.hamde/appmenu.fault")
    k: uint64 = 0
    while sfx[k] != 0 and p < 223:
        _am_fault_path[p] = sfx[k]
        p = p + 1
        k = k + 1
    _am_fault_path[p] = 0
    _am_fault_have = 1
    return 1


def _appmenu_faulted() -> int32:
    if _am_fault_build() == 0:
        return 0
    fd: int32 = sys_open(cast[Ptr[char]](&_am_fault_path[0]))
    if fd < 0:
        return 0
    sys_close(fd)
    return 1


def _appmenu_available() -> int32:
    if _appmenu_present < 0:
        fd: int32 = sys_open(cast[Ptr[char]]("/bin/hamappmenu"))
        if fd >= 0:
            sys_close(fd)
            _appmenu_present = 1
            _writeall(1, cast[Ptr[uint8]]("[panel] Applications button -> /bin/hamappmenu\n"))
        else:
            _appmenu_present = 0
            _writeall(1, cast[Ptr[uint8]]("[panel] no /bin/hamappmenu; Applications button -> the panel's own dropdown\n"))
    if _appmenu_present == 1 and _appmenu_faulted() != 0:
        _appmenu_present = 0
        _writeall(1, cast[Ptr[uint8]]("[panel] /bin/hamappmenu could not open a window (it left appmenu.fault); Applications button -> the panel's own dropdown\n"))
    return _appmenu_present


# The Applications button click TOGGLES the categorized Applications menu
# (/bin/hamappmenu), mirroring the tray inbox toggle: if our last-spawned menu
# is still up, ask it to close and do NOT stack a duplicate; otherwise spawn a
# fresh one. #263: previously this toggled a FLAT in-panel dropdown, so the
# user never saw the categorized fly-out menu that already shipped as a
# separate v2 client — the panel now defaults to it WHEN IT IS THERE.
def _toggle_appmenu():
    if _appmenu_available() == 0:
        if menu_open != 0:
            menu_open = 0
            sub_open = 0
        else:
            menu_open = 1
        return
    if _appmenu_alive(appmenu_pid) != 0:
        p9_note(appmenu_pid, cast[Ptr[uint8]]("terminate"))
        return
    _launch_appmenu()
    appmenu_pid = last_launched_pid


def _raise_focus(idx: uint64):
    if idx >= n_tasks:
        return
    w: int32 = task_wid[idx]
    panel_active_wid = w                 # light this entry as the active window
    cp: Array[64, uint8]
    _winpath(&cp[0], w, cast[Ptr[uint8]]("/ctl"))
    f1: int32 = sys_open_write(cast[Ptr[char]](&cp[0]))
    if f1 >= 0:
        _writeall(f1, cast[Ptr[uint8]]("raise\n"))
        sys_close(f1)
    f2: int32 = sys_open_write(cast[Ptr[char]](&cp[0]))
    if f2 >= 0:
        _writeall(f2, cast[Ptr[uint8]]("focus\n"))
        sys_close(f2)
    _writeall(1, cast[Ptr[uint8]]("[panel] raise+focus window\n"))


# Launch a Debian/Linux-namespace app INSIDE the `enter linux { ... }`
# namespace, NOT the native ns — its Exec (e.g. /usr/bin/weston-terminal)
# only exists on the #distro tree. We reuse the EXISTING Linux-ns launcher
# recipe /etc/rc.de-wayland: `spawn_detached("/bin/hamsh",
# ["/bin/hamsh", "/etc/rc.de-wayland", <prog>])` — the SAME path that
# already renders weston-terminal / Xwayland / Qt clients as real windows on
# the native Wayland server (scripts/test_wayland_phase4_term.sh et al).
# hamsh main() stamps HAMNIX_DE_PROG=<prog> from argv[2]; the recipe captures
# the `linux` ns template, drops to the regular user, sets the Wayland client
# env, and runs `enter linux { $HAMNIX_DE_PROG }`. A GUI Linux app maps its
# window on first buffer commit; a CLI (Terminal=true) one runs headless.
# DETACHED because the panel never wait4s its launched apps (an un-reapable
# zombie would eventually starve fork) — NOT because the launch is expected
# to fail. (Firefox/Chromium-class browsers are the one parked case — their
# SW-WebRender thread needs a GL/EGL stack — but every other Linux GUI app
# renders through the passthrough.)
_lx_argv: Array[4, uint64]
_lx_rc: Array[24, uint8] = "/etc/rc.de-wayland"
_lx_sh: Array[16, uint8] = "/bin/hamsh"
def _launch_linux(prog: Ptr[char]):
    _lx_argv[0] = cast[uint64](&_lx_sh[0])
    _lx_argv[1] = cast[uint64](&_lx_rc[0])
    _lx_argv[2] = cast[uint64](prog)
    _lx_argv[3] = 0
    pid: int32 = spawn_detached(cast[Ptr[char]](&_lx_sh[0]), &_lx_argv[0],
                                -2, -2, cast[Ptr[uint64]](0))
    if pid >= 0:
        _writeall(1, cast[Ptr[uint8]]("[panel] launched (linux ns) "))
        _writeall(1, cast[Ptr[uint8]](prog))
        _writeall(1, cast[Ptr[uint8]]("\n"))


# Launch a Terminal=true Linux-ns app (e.g. the "Linux Process Viewer" `top`)
# INSIDE a rendered native scene terminal. A CLI Linux tool has no Wayland
# window surface of its own, so the plain `enter linux { … }` launch above ran
# it headless and NO window appeared (the user-reported bug). Instead we spawn
# the native scene terminal /bin/hamtermscene — which owns a real DE window and
# whose shell sources /etc/rc.de-user (capturing the `linux` ns template) — and
# hand it the command `enter linux { <prog> }` as argv[1]. hamtermscene feeds
# that to its shell after startup, so the app runs in the linux ns with its
# output streaming into a visible terminal window. This honours the freedesktop
# Terminal=true contract without depending on any Linux-ns GUI (weston-terminal)
# being staged — hamtermscene ships on every image.
_lt_argv: Array[3, uint64]
_lt_term: Array[20, uint8] = "/bin/hamtermscene"
_lt_cmd:  Array[160, uint8]
def _launch_linux_term(prog: Ptr[char]):
    pre: Ptr[uint8] = cast[Ptr[uint8]]("enter linux { ")
    q: uint64 = 0
    while pre[q] != 0:
        _lt_cmd[q] = pre[q]
        q = q + 1
    pp: Ptr[uint8] = cast[Ptr[uint8]](prog)
    r: uint64 = 0
    while pp[r] != 0 and q < 156:
        _lt_cmd[q] = pp[r]
        q = q + 1
        r = r + 1
    _lt_cmd[q] = 32                                   # ' '
    q = q + 1
    _lt_cmd[q] = 125                                  # '}'
    q = q + 1
    _lt_cmd[q] = 0
    _lt_argv[0] = cast[uint64](&_lt_term[0])
    _lt_argv[1] = cast[uint64](&_lt_cmd[0])
    _lt_argv[2] = 0
    pid: int32 = spawn_detached(cast[Ptr[char]](&_lt_term[0]), &_lt_argv[0],
                                -2, -2, cast[Ptr[uint64]](0))
    if pid >= 0:
        _writeall(1, cast[Ptr[uint8]]("[panel] launched (linux term) "))
        _writeall(1, cast[Ptr[uint8]](prog))
        _writeall(1, cast[Ptr[uint8]]("\n"))


# ---- launching INTO a named distribution namespace ------------------
# Both of these carry ONE thing across the boundary: the distribution's NAME.
# Not a path, not a device, not a descriptor — the same thing `bind` falls
# back to when it cannot open a block device to read a volume label
# (docs/linux_distro_namespaces.md §2.4). The panel never learns which medium
# is behind `alpine`, and does not need to.
#
# A CLI app (freedesktop Terminal=true) has no window surface, so it is hosted
# in a rendered native terminal, which is handed the literal command text
# `enter <name> { <prog> }`. That works because a shell parses text: the
# NAME is a word in a command line, and hamtermscene's shell has the template
# captured (etc/rc.de-user sources /etc/rc.distros).
#
# A GUI app cannot go that way, and this is the part worth stating plainly:
# hamsh's `enter` takes a namespace VALUE, not a string, so `enter $NAME { }`
# cannot be written in a shared rc. So the launcher rc is GENERATED PER NAME
# at image-build time from the same /etc/distros this menu reads —
# /etc/rc.de-ns/<name>, five lines, no hand-written copy per distribution
# (scripts/hamlinux_image.sh). Adding Fedora is still a line in a file.
_dn_argv: Array[4, uint64]
_dn_sh:   Array[16, uint8]

# "/etc/rc.de-ns/<name>" into _dm_rc; "/bin/hamsh" into _dn_sh.
def _dn_paths(si: uint64):
    pre: Ptr[uint8] = cast[Ptr[uint8]]("/etc/rc.de-ns/")
    p: uint64 = 0
    while pre[p] != 0:
        _dm_rc[p] = pre[p]
        p = p + 1
    k: uint64 = 0
    while k < dm_name_len[si] and p < 62:
        _dm_rc[p] = dm_name[si][k]
        p = p + 1
        k = k + 1
    _dm_rc[p] = 0
    sh: Ptr[uint8] = cast[Ptr[uint8]]("/bin/hamsh")
    p = 0
    while sh[p] != 0:
        _dn_sh[p] = sh[p]
        p = p + 1
    _dn_sh[p] = 0


# GUI app: `/bin/hamsh /etc/rc.de-ns/<name> <prog>`. hamsh main() stamps
# HAMNIX_DE_PROG from argv[2]; the generated rc captures that ONE namespace
# template, sets the Wayland client environment and runs
# `enter <name> { $HAMNIX_DE_PROG }`.
def _launch_distro_ns(si: uint64, prog: Ptr[char]):
    _dn_paths(si)
    _dn_argv[0] = cast[uint64](&_dn_sh[0])
    _dn_argv[1] = cast[uint64](&_dm_rc[0])
    _dn_argv[2] = cast[uint64](prog)
    _dn_argv[3] = 0
    pid: int32 = spawn_detached(cast[Ptr[char]](&_dn_sh[0]), &_dn_argv[0],
                                -2, -2, cast[Ptr[uint64]](0))
    _writeall(1, cast[Ptr[uint8]]("[panel] launch in ns "))
    _writeall(1, &dm_name[si][0])
    _writeall(1, cast[Ptr[uint8]](" -> "))
    _writeall(1, cast[Ptr[uint8]](prog))
    if pid < 0:
        _writeall(1, cast[Ptr[uint8]](" FAILED to spawn"))
    _writeall(1, cast[Ptr[uint8]]("\n"))


# CLI app: a rendered native terminal running `enter <name> { <prog> }`.
def _launch_distro_term(si: uint64, prog: Ptr[char]):
    pre: Ptr[uint8] = cast[Ptr[uint8]]("enter ")
    q: uint64 = 0
    while pre[q] != 0:
        _dm_cmd[q] = pre[q]
        q = q + 1
    k: uint64 = 0
    while k < dm_name_len[si] and q < 40:
        _dm_cmd[q] = dm_name[si][k]
        q = q + 1
        k = k + 1
    mid: Ptr[uint8] = cast[Ptr[uint8]](" { ")
    r: uint64 = 0
    while mid[r] != 0:
        _dm_cmd[q] = mid[r]
        q = q + 1
        r = r + 1
    pp: Ptr[uint8] = cast[Ptr[uint8]](prog)
    r = 0
    while pp[r] != 0 and q < 218:
        _dm_cmd[q] = pp[r]
        q = q + 1
        r = r + 1
    _dm_cmd[q] = 32                                   # ' '
    q = q + 1
    _dm_cmd[q] = 125                                  # '}'
    q = q + 1
    _dm_cmd[q] = 0
    _lt_argv[0] = cast[uint64](&_lt_term[0])
    _lt_argv[1] = cast[uint64](&_dm_cmd[0])
    _lt_argv[2] = 0
    pid: int32 = spawn_detached(cast[Ptr[char]](&_lt_term[0]), &_lt_argv[0],
                                -2, -2, cast[Ptr[uint64]](0))
    _writeall(1, cast[Ptr[uint8]]("[panel] launch in terminal: "))
    _writeall(1, &_dm_cmd[0])
    if pid < 0:
        _writeall(1, cast[Ptr[uint8]](" FAILED to spawn"))
    _writeall(1, cast[Ptr[uint8]]("\n"))


# Dispatch one fly-out row: section `si`, model slot `idx`.
def _launch_distro(si: uint64, idx: uint64):
    if si >= dm_count or idx >= am_count:
        return
    if am_term[idx] != 0:
        _launch_distro_term(si, cast[Ptr[char]](&am_prog[idx][0]))
    else:
        _launch_distro_ns(si, cast[Ptr[char]](&am_prog[idx][0]))


# ---- DE launch-queue drain (#99) -----------------------------------
# THE BUG THIS FIXES: /dev/wsys/run/launch and /dev/wsys/appmenu/launch
# are the compositor's launch queues — a Run dialog (Alt-F2), the
# appmenu popup, or any client writes "<prog>\n" and the DE is meant to
# spawn that prog as a fresh window. In the LEGACY userland DE those
# queues were drained by hamUId's main loop (run_drain_launch /
# appmenu_drain_launch). But the scene-file DE (docs/de_scene_file_arch)
# RETIRES hamUId's present loop: at runlevel 5 hamUId latches the KERNEL
# scene compositor as the /dev/fb owner and EXITS immediately
# (cmd_daemon_auto autoflag==0 returns after the `desktop` flip). Nothing
# then drains the queues, so a launch-queue write spawned NOTHING and the
# requested app's window never appeared — the "apps launched via the DE
# launch queue don't render" bug (#99).
#
# THE FIX: the panel (hampanelscene) is a LIVE scene client with a
# capable namespace (rc.5's scenepanelns inherits PID-1's ambient binds,
# incl. `#c /dev`, so /dev/wsys resolves), and it already spawns its OWN
# Applications-menu apps via _launch (spawn_detached). So the panel is
# the natural drain point: each main-loop tick it snapshots both launch
# queues and, on a serial bump, spawns the requested prog through the
# EXACT SAME working path its menu uses. A spawned app inherits the
# panel's namespace (RFNAMEG COW), self-`newwindow`s an OWNED wid, writes
# its `scene` display list, and the kernel scene compositor composites +
# presents it — identical to how the rc.5 scene apps render.
_run_launch_last_serial: uint64 = 0
_appmenu_launch_last_serial: uint64 = 0
_launch_q_buf: Array[320, uint8]

# Read a launch queue's current serial WITHOUT spawning anything (used at
# startup to prime the last-serial baseline).
def _peek_launch_serial(path: Ptr[char]) -> uint64:
    fd: int32 = sys_open(path)
    if fd < 0:
        return 0
    n: int64 = sys_read(fd, &_launch_q_buf[0], 319)
    sys_close(fd)
    if n <= 0:
        return 0
    cap: uint64 = cast[uint64](n)
    p: uint64 = 0
    serial: uint64 = 0
    while p < cap and _launch_q_buf[p] >= 48 and _launch_q_buf[p] <= 57:
        serial = serial * 10 + cast[uint64](_launch_q_buf[p] - 48)
        p = p + 1
    return serial


# Read one launch queue ("<serial> <path>\n") at `path` and, if its serial
# is newer than *last_serial, spawn the parsed prog. Returns the (possibly
# unchanged) serial to store back as the new last-serial. A `wl:` prefix
# routes to the Linux-ns Wayland launcher (mirrors hamUId's drain logic).
def _drain_one_launch_queue(path: Ptr[char], last_serial: uint64) -> uint64:
    fd: int32 = sys_open(path)
    if fd < 0:
        return last_serial
    n: int64 = sys_read(fd, &_launch_q_buf[0], 319)
    sys_close(fd)
    if n <= 0:
        return last_serial
    cap: uint64 = cast[uint64](n)
    # Parse leading decimal serial.
    p: uint64 = 0
    serial: uint64 = 0
    while p < cap and _launch_q_buf[p] >= 48 and _launch_q_buf[p] <= 57:
        serial = serial * 10 + cast[uint64](_launch_q_buf[p] - 48)
        p = p + 1
    if serial == 0:
        return last_serial
    if serial == last_serial:
        return last_serial
    # Single separating space, then the path up to newline.
    if p < cap and _launch_q_buf[p] == 32:
        p = p + 1
    ps: uint64 = p
    while p < cap and _launch_q_buf[p] != 10:
        p = p + 1
    pe: uint64 = p
    if pe <= ps:
        return serial
    # NUL-terminate the path in place so it can be passed as Ptr[char].
    if pe < 320:
        _launch_q_buf[pe] = 0
    # `wl:` sentinel (bytes 119,108,58) → Linux-ns Wayland client.
    if pe > ps + 3 and _launch_q_buf[ps] == 119 \
            and _launch_q_buf[ps + 1] == 108 \
            and _launch_q_buf[ps + 2] == 58:
        _launch_linux(cast[Ptr[char]](&_launch_q_buf[ps + 3]))
    else:
        # "/bin/prog [args...]" — _launch_line splits on spaces (a bare path
        # takes the identical no-args path it always did).
        _launch_line(&_launch_q_buf[ps])
    return serial


# Poll both DE launch queues once. Cheap open/read/close per queue, called
# from the panel main loop (like _drain_notifications).
def _drain_launch_queues():
    _run_launch_last_serial = _drain_one_launch_queue(
        cast[Ptr[char]]("/dev/wsys/run/launch"), _run_launch_last_serial)
    _appmenu_launch_last_serial = _drain_one_launch_queue(
        cast[Ptr[char]]("/dev/wsys/appmenu/launch"), _appmenu_launch_last_serial)


# ---- THE "RESTART BEFORE OPENING APPS" NOTICE ----------------------
# WHAT A PERSON SEES WHEN THE WINDOW SYSTEM IS UPDATED UNDER THEM.
#
# user/linux-wsys.c bumps WSYS_VERSION when the shape of /srv/wsys changes,
# and shm_attach() REFUSES to attach a new-version program to a LIVE
# old-version segment rather than wiping the desktop somebody is sitting in
# front of (see A LIVE SESSION IS NOT A LEFTOVER there). That refusal is the
# safety property and nothing here may weaken it. But it was measured on a
# real installed machine at 7 -> 8 (tests/linux/installed_update_wsysver.sh)
# and what the PERSON got was: click Applications, the panel logs the click,
# the spawned hamappmenu refuses correctly and dies -- and the screen does
# not change. The five explaining lines go to stderr, which on this image is
# the serial console. A correct refusal and a broken button look identical.
#
# WHY THE PANEL DRAWS IT. The refused program cannot draw; that is what being
# refused means. The processes that CAN draw are the ones that attached
# before the update -- wsysd and this panel. wsysd owns no window and has
# never drawn a text card; the panel already owns a keyed, growing window
# with roundrect+glyph popups and a click-to-dismiss path, so the notice is
# ~80 lines here and would be new machinery there.
#
# WHY IT CANNOT LIE. The marker is written in exactly one place in the whole
# tree: inside seg_refuse_message() in user/linux-wsys.c, past its
# once-per-process guard, so the mark and the five stderr lines have one
# condition between them. Nothing else opens the path. Deliberately NOT
# reused for this: $HOME/.hamde/appmenu.fault, which the panel already reads
# (_appmenu_faulted) -- it means "the menu did not get a window", which a
# crash, a missing font or an out-of-wids condition all satisfy, and a notice
# telling somebody to reboot because their text editor segfaulted is worse
# than no notice at all.
#
# WHY IT CANNOT GO STALE. The marker lives beside the segment in /srv, which
# linuxinit mounts as tmpfs and which is made fresh every boot. The notice's
# advice is RESTART, so the evidence for it must not outlive the restart that
# fixes it -- and it cannot: the file is gone before the panel that would
# read it exists.
#
# THE SERIAL is the marker's SIZE. The C side appends one short line per
# refusing process and never rewrites, so size only grows; `notice_ack` is
# the offset already shown-and-dismissed. Same shape as the DE launch queues
# above, and it means dismissing cannot be undone by the next poll while a
# genuinely NEW refusal still re-raises the notice.
#
# WHAT IT DOES NOT REPLACE. scripts/hamlinux_packages.py's hamnix-desktop
# install hook already prints the same warning to the TERMINAL somebody typed
# `hpm update` into, and it reaches the update that needs it, which nothing in
# this file can. The two are for different people: that one is for whoever ran
# the update, this one is for whoever walks up to the machine afterwards and
# clicks Applications. Neither is a substitute for the other.
#
# NOT PRIMED AT STARTUP, unlike _peek_launch_serial. A panel that starts and
# finds a marker is a panel in a session that still needs restarting -- the
# condition is still true, so the honest answer is to show it.
NOTICE_W: int64 = 340
NOTICE_H: int64 = 86
notice_on: int32 = 0
notice_panel: uint64 = 0
notice_ack: int64 = 0
notice_box_x: int64 = 0
notice_box_y: int64 = 0
_notice_path: Array[600, uint8]
_notice_path_ready: int32 = 0


# "<segment>.refused", resolved once, the same way user/linux-wsys.c derives
# it: $HAMWSYS if set, else /srv/wsys. A harness pointed at another segment
# watches THAT one and cannot show a notice about somebody else's desktop.
def _notice_resolve_path():
    if _notice_path_ready != 0:
        return
    _notice_path_ready = 1
    n: int64 = sys_getenv(cast[Ptr[char]]("HAMWSYS"), &_notice_path[0], 560)
    p: uint64 = 0
    if n > 0:
        p = cast[uint64](n)
    else:
        d: Ptr[uint8] = cast[Ptr[uint8]]("/srv/wsys")
        i: uint64 = 0
        while d[i] != 0:
            _notice_path[p] = d[i]
            p = p + 1
            i = i + 1
    s: Ptr[uint8] = cast[Ptr[uint8]](".refused")
    j: uint64 = 0
    while s[j] != 0:
        _notice_path[p] = s[j]
        p = p + 1
        j = j + 1
    _notice_path[p] = 0


# The panel carrying the Applications button is the one that gets the notice
# -- it is the button the person pressed and got nothing from. A layout with
# no menu widget at all falls back to panel 0 so the notice is never
# addressed to a panel that does not exist.
def _notice_first_menu_panel() -> uint64:
    pi: uint64 = 0
    while pi < n_panels:
        b: uint64 = 0
        while b < p_nwidg[pi]:
            if p_wkind[pi * MAX_WIDGETS + b] == WK_MENU:
                return pi
            b = b + 1
        pi = pi + 1
    return 0


# One open + fstat + close per tick. Returns 1 only on the transition to
# showing, which is the caller's cue to re-apply panel geometry (the window
# has to grow to hold the card).
def _notice_poll() -> int32:
    if notice_on != 0:
        return 0
    _notice_resolve_path()
    fd: int32 = sys_open(cast[Ptr[char]](&_notice_path[0]))
    if fd < 0:
        return 0
    sz: int64 = sys_fd_size(fd)
    sys_close(fd)
    if sz <= notice_ack:
        return 0
    notice_on = 1
    notice_panel = _notice_first_menu_panel()
    return 1


# Window-local box, same convention as _compute_menu_box: on a top bar the
# card hangs below the bar, on a bottom bar it sits above it.
def _notice_box(bar: int64):
    if cur_horiz != 0:
        notice_box_x = 8
        if cur_edge == EDGE_BOTTOM:
            notice_box_y = 0
        else:
            notice_box_y = bar + cur_thick
    else:
        if cur_edge == EDGE_LEFT:
            notice_box_x = bar + cur_thick
        else:
            notice_box_x = bar - NOTICE_W
        notice_box_y = 8


def _notice_hit(x: int64, y: int64, bar: int64) -> int32:
    if notice_on == 0:
        return 0
    if notice_panel != cur_panel_idx:
        return 0
    _notice_box(bar)
    if x < notice_box_x or x >= notice_box_x + NOTICE_W:
        return 0
    if y < notice_box_y or y >= notice_box_y + NOTICE_H:
        return 0
    return 1


# Dismiss: acknowledge every byte of the marker that exists RIGHT NOW, so a
# refusal that has already happened stays dismissed and a refusal that has
# not happened yet still raises the card again.
def _notice_dismiss():
    _notice_resolve_path()
    fd: int32 = sys_open(cast[Ptr[char]](&_notice_path[0]))
    if fd >= 0:
        sz: int64 = sys_fd_size(fd)
        if sz > notice_ack:
            notice_ack = sz
        sys_close(fd)
    notice_on = 0


# Amber, because every other card this panel draws is grey-on-white and this
# one is the only one that is telling the person the machine is in a state
# they have to act on. The colours are also what the gate's screendump
# assertion counts, so they are deliberately not a shade already on screen.
def _notice_draw(bar: int64):
    _notice_box(bar)
    nx: int32 = cast[int32](notice_box_x)
    ny: int32 = cast[int32](notice_box_y)
    hamscene_roundrect(nx, ny, cast[int32](NOTICE_W), cast[int32](NOTICE_H), 8,
                       cast[Ptr[uint8]]("#b06a00"))
    hamscene_roundrect(nx + 2, ny + 2, cast[int32](NOTICE_W) - 4,
                       cast[int32](NOTICE_H) - 4, 6,
                       cast[Ptr[uint8]]("#ffe9b0"))
    _glyphs(notice_box_x + 12, notice_box_y + 10,
            cast[Ptr[uint8]]("The window system was updated."),
            cast[Ptr[uint8]]("#000000"), 1)
    _glyphs(notice_box_x + 12, notice_box_y + 30,
            cast[Ptr[uint8]]("Restart before opening new apps."),
            cast[Ptr[uint8]]("#202020"), cur_bold)
    _glyphs(notice_box_x + 12, notice_box_y + 48,
            cast[Ptr[uint8]]("Windows already open are safe."),
            cast[Ptr[uint8]]("#202020"), cur_bold)
    _glyphs(notice_box_x + 12, notice_box_y + 68,
            cast[Ptr[uint8]]("Click this notice to dismiss it."),
            cast[Ptr[uint8]]("#7a5a10"), 0)


# --- Drag-from-menu launcher drop (#327; was #283) ------------------
# hamappmenu writes an app's `<exec> <label>\n` to /tmp/hamnix-panel-drop when
# the user DRAGS an app entry out of the Applications menu (a plain click still
# launches). This is an OFFER, not a placement: we do NOT commit here. Each
# tick _poll_panel_offer refreshes the pending offer (pend_*) from the sidecar;
# the launcher is only COMMITTED on a left button RELEASE over the bar, at the
# release flow-X (_commit_panel_drop), so it lands where you drop it — NOT a
# fixed spot next to the Apps button (the old #283 bug). Purely client-side —
# no compositor/devwsys involvement.
_drop_buf: Array[128, uint8]

# Truncate the drop sidecar to empty (consume the offer exactly once).
def _consume_drop_sidecar():
    tfd: int32 = sys_open_write(cast[Ptr[char]]("/tmp/hamnix-panel-drop"))
    if tfd >= 0:
        sys_close(tfd)

# Refresh the pending drag-offer state from the sidecar. Sets pend_active +
# pend_exec/pend_label on a fresh non-empty record; clears it when the sidecar
# is empty (consumed by us or the desktop); and EXPIRES a stale offer (an
# abandoned drag) after PEND_TTL_JIF so it can't wedge button handling.
def _poll_panel_offer():
    fd: int32 = sys_open(cast[Ptr[char]]("/tmp/hamnix-panel-drop"))
    n: int64 = 0
    if fd >= 0:
        n = sys_read(fd, &_drop_buf[0], 127)
        sys_close(fd)
    if n <= 0:
        pend_active = 0                    # empty sidecar: no offer pending
        return
    cap: uint64 = cast[uint64](n)
    # Parse "<exec> <label>". Skip leading blanks.
    i: uint64 = 0
    while i < cap and (_drop_buf[i] == 32 or _drop_buf[i] == 9 or _drop_buf[i] == 10):
        i = i + 1
    exs: uint64 = i
    while i < cap and _drop_buf[i] != 32 and _drop_buf[i] != 9 and _drop_buf[i] != 10:
        i = i + 1
    exe: uint64 = i
    while i < cap and (_drop_buf[i] == 32 or _drop_buf[i] == 9):
        i = i + 1
    lbs: uint64 = i
    while i < cap and _drop_buf[i] != 32 and _drop_buf[i] != 9 and _drop_buf[i] != 10:
        i = i + 1
    lbe: uint64 = i
    if exe <= exs:
        pend_active = 0                    # malformed: ignore
        return
    _copy_tok(&_drop_buf[0], exs, exe, &pend_exec[0], 64)
    if lbe > lbs:
        _copy_tok(&_drop_buf[0], lbs, lbe, &pend_label[0], 24)
    else:
        pend_label[0] = 63                 # '?'
        pend_label[1] = 0
    now: uint64 = sys_get_jiffies()
    if pend_active == 0:
        pend_active = 1                    # newly seen offer: start the TTL
        pend_seen_jif = now
        pend_moved = 0                     # fresh offer: no motion yet
        pend_last_x = -1
        pend_last_y = -1
    elif now - pend_seen_jif > PEND_TTL_JIF:
        # Abandoned drag: discard so the panel/desktop aren't wedged.
        _consume_drop_sidecar()
        pend_active = 0

# Commit the pending drag-offer as a panel launcher inserted at flow index
# derived from the RELEASE coordinate `flow` on panel `pi`. Honors the drop
# location (dp_panel_insert_index), persists, and consumes the offer. Returns 1.
def _commit_panel_drop(pi: uint64, flow: int64) -> int32:
    if pend_active == 0:
        return 0
    at: int64 = _insert_index_at_flow(flow)
    if at < 0:
        at = 0
    _insert_launcher(pi, cast[uint64](at), &pend_exec[0], &pend_label[0])
    _save_config()
    _consume_drop_sidecar()
    pend_active = 0
    return 1


# Find the widget slot (0..n_widg-1) whose flow-axis rect [wx0,wx1) contains
# `flow`, or -1 if the click is in empty bar space. Requires _layout_panel to
# have run for the current panel.
def _widget_at_flow(flow: int64) -> int64:
    a: uint64 = 0
    while a < n_widg:
        if flow >= wx0[a] and flow < wx1[a]:
            return cast[int64](a)
        a = a + 1
    return -1


# Flow-axis insertion index for a drop/add at coordinate `flow`: the index of
# the first widget whose start (wx0) is past `flow`; i.e. insert BEFORE it.
# Returns n_widg to append at the end.
def _insert_index_at_flow(flow: int64) -> int64:
    # Shared, host-tested placement math (lib/dropplace): the launcher lands at
    # the DROP coordinate, never a fixed spot. See tests/dropplace_host.ad.
    return dp_panel_insert_index(flow, &wx0[0], n_widg)


# Track a button-LESS pointer motion while the Apps dropdown is open, driving
# the MATE-style "Linux apps" HOVER submenu: mousing onto the parent row (or
# staying over the open child fly-out) opens/keeps the fly-out; moving onto any
# other native row closes it. Returns 1 if sub_open changed (needs a redraw).
def _handle_menu_hover(x: int64, y: int64, bar: int64) -> int32:
    _compute_menu_box(bar)
    nc: uint64 = _native_count()
    ptop: int64 = menu_box_y + 2 + cast[int64](nc) * MENU_ROW_H
    pbot: int64 = ptop + cast[int64](dm_count) * MENU_ROW_H
    # WHICH parent row, not just "a parent row": with N distributions the
    # answer has to say which fly-out to open, or hovering Alpine would leave
    # Debian's showing.
    over_parent: int32 = 0
    if x >= menu_box_x and x < menu_box_x + MENU_W \
            and y >= ptop and y < pbot:
        over_parent = cast[int32]((y - ptop) / MENU_ROW_H) + 1
    over_child: int32 = 0
    if sub_open != 0:
        _compute_sub_box(bar)
        if x >= sub_box_x and x < sub_box_x + SUBMENU_W \
                and y >= sub_box_y and y < sub_box_y + _sub_h():
            over_child = 1
    over_native: int32 = 0
    if x >= menu_box_x and x < menu_box_x + MENU_W \
            and y >= menu_box_y + 2 and y < ptop:
        over_native = 1
    want: int32 = sub_open
    if over_parent != 0:
        want = over_parent
    elif over_child != 0:
        want = sub_open
    elif over_native != 0:
        want = 0
    # otherwise (pointer off both popups) leave the state as-is (no flicker).
    if want != sub_open:
        sub_open = want
        return 1
    return 0


# Hit-test a window-local click for the current panel. Mutates menu_open +
# may launch/raise. Returns 1 if a redraw is needed. Uses the layout + the
# bar/menu-box coords computed in the last emit.
def _handle_click(x: int64, y: int64, bar: int64) -> int32:
    # THE UPDATE NOTICE IS TESTED FIRST because it is DRAWN LAST (see the end
    # of _emit_panel): the card sits over the top-left corner where the Apps
    # dropdown also opens, and a hit test in draw order would let a click land
    # on a menu row the person cannot see. Clicking the card dismisses it and
    # consumes the click -- it does not also launch whatever is underneath.
    if _notice_hit(x, y, bar) != 0:
        _notice_dismiss()
        return 1
    # dropdown open?
    if menu_open != 0 and menu_slot >= 0:
        _compute_menu_box(bar)
        nc: uint64 = _native_count()
        # 1) A click inside the open child fly-out launches that
        #    distribution's app (via `enter <name> { … }`) and dismisses the
        #    whole menu.
        if sub_open != 0 and _sub_idx() < dm_count:
            si: uint64 = _sub_idx()
            _compute_sub_box(bar)
            if x >= sub_box_x and x < sub_box_x + SUBMENU_W \
                    and y >= sub_box_y and y < sub_box_y + _sub_h():
                if dm_apps[si] > 0:
                    li: int64 = (y - sub_box_y - 2) / MENU_ROW_H
                    if li >= 0 and cast[uint64](li) < dm_apps[si]:
                        idx: uint64 = _dm_start(si) + cast[uint64](li)
                        _launch_distro(si, idx)
                menu_open = 0
                sub_open = 0
                return 1
        # 2) A click inside the main dropdown box.
        if x >= menu_box_x and x < menu_box_x + MENU_W \
                and y >= menu_box_y and y < menu_box_y + menu_main_h:
            row: int64 = (y - menu_box_y - 2) / MENU_ROW_H
            if row >= 0 and cast[uint64](row) < nc:
                # a native app row.
                _launch(cast[Ptr[char]](&am_prog[cast[uint64](row)][0]))
                menu_open = 0
                sub_open = 0
                return 1
            if row >= 0 and cast[uint64](row) >= nc \
                    and cast[uint64](row) < nc + dm_count:
                # a distribution's parent row: toggle ITS fly-out (also lets a
                # tap open it, not just hover) — keep the main menu open.
                want: int32 = cast[int32](cast[uint64](row) - nc) + 1
                if sub_open == want:
                    sub_open = 0
                else:
                    sub_open = want
                return 1
            # a click in the empty tail of the box: dismiss.
            menu_open = 0
            sub_open = 0
            return 1
    # on the bar?
    onbar: int32 = 0
    flow: int64 = x
    cross: int64 = y
    if cur_horiz != 0:
        if y >= bar and y < bar + cur_thick:
            onbar = 1
        flow = x
    else:
        if x >= bar and x < bar + cur_thick:
            onbar = 1
        flow = y
    if onbar != 0:
        # Apps button opens the CATEGORIZED Applications menu (/bin/hamappmenu,
        # the #206/#220 hover-fly-out client) as a separate v2 window — NOT the
        # legacy flat in-panel dropdown. Toggled, pid-tracked (see
        # _toggle_appmenu).
        if menu_slot >= 0:
            ms: uint64 = cast[uint64](menu_slot)
            if flow >= wx0[ms] and flow < wx1[ms]:
                _toggle_appmenu()
                return 1
        # taskbar buttons
        if tasks_slot >= 0 and flow >= tasks_lo and flow < tasks_hi:
            step: int64 = TASK_BTN_W + 4
            if cur_horiz == 0:
                step = 24
            t: uint64 = 0
            while t < n_tasks:
                bx: int64 = tasks_lo + cast[int64](t) * step
                hit: int32 = 0
                if cur_horiz != 0 and flow >= bx and flow < bx + TASK_BTN_W:
                    hit = 1
                if cur_horiz == 0 and flow >= bx and flow < bx + 22:
                    hit = 1
                if hit != 0:
                    _raise_focus(t)
                    if menu_open != 0:
                        menu_open = 0
                        return 1
                    return 0
                t = t + 1
        # pager / tray / session / clock applets (fixed widgets)
        ai: uint64 = 0
        while ai < n_widg:
            ak: int32 = wkind_cur[ai]
            if ak == WK_LAUNCHER:
                if flow >= wx0[ai] and flow < wx1[ai]:
                    # Spawn the carried Exec (same _launch/spawn_detached path
                    # the menu/tray applets use).
                    _launch(cast[Ptr[char]](
                        _wexec_ptr(cur_panel_idx * MAX_WIDGETS + ai)))
                    if menu_open != 0:
                        menu_open = 0
                    return 1
            if ak == WK_SYSMON:
                if flow >= wx0[ai] and flow < wx1[ai]:
                    # MATE-style: clicking the CPU/memory applet opens the full
                    # System Monitor app (per-core + total CPU graphs, memory
                    # graph, and the live process list).
                    _launch(cast[Ptr[char]]("/bin/hammonscene"))
                    if menu_open != 0:
                        menu_open = 0
                    return 1
            if ak == WK_CLOCK:
                if flow >= wx0[ai] and flow < wx1[ai]:
                    # MATE-style clock: a click opens the SAME unified
                    # Calendar app the app-menu "Calendar" entry launches
                    # (/bin/hamcalscene) — a month grid with today highlighted,
                    # clickable date cells + relative-time readout, arrow-key
                    # navigation and a stopwatch. Previously this opened the
                    # separate /bin/hamclock (a DIFFERENT calendar UI); both
                    # entry points now converge on the one working app.
                    _launch(cast[Ptr[char]]("/bin/hamcalscene"))
                    if menu_open != 0:
                        menu_open = 0
                    return 1
            if ak == WK_PAGER or ak == WK_TRAY or ak == WK_SESSION:
                if flow >= wx0[ai] and flow < wx1[ai]:
                    if ak == WK_PAGER:
                        # which cell?
                        rel: int64 = flow - wx0[ai]
                        step: int64 = PAGER_CELL_W + 2
                        cell: int64 = rel / step
                        if cell >= 0 and cell < WS_COUNT:
                            _switch_workspace(cell)
                        if menu_open != 0:
                            menu_open = 0
                        return 1
                    elif ak == WK_TRAY:
                        # TOGGLE the scene notification inbox popup (open it +
                        # mark all read, or close the one already showing). The
                        # toggle NEVER stacks a second /bin/haminbox at the same
                        # geometry, so its Close button always fully dismisses
                        # the popup (the "close does nothing / stays stuck" bug
                        # was a click on the bell spawning a duplicate popup).
                        _toggle_notif_inbox()
                        if menu_open != 0:
                            menu_open = 0
                        return 1
                    else:
                        # The End-Session modal is a self-opening scene
                        # client (user/hamsessui.ad): spawning it pops the
                        # dialog immediately and it handles its own row
                        # clicks (Lock / Log Out / Shut Down / Reboot).
                        _launch(cast[Ptr[char]]("/bin/hamsessui"))
                        if menu_open != 0:
                            menu_open = 0
                        return 1
            ai = ai + 1
        if menu_open != 0:
            menu_open = 0
            return 1
    return 0


# Is (x,y) on this panel's bar (cross-axis within the bar band)? Returns the
# flow-axis coordinate via the caller reading cur_horiz.
def _on_bar(x: int64, y: int64, bar: int64) -> int32:
    if cur_horiz != 0:
        if y >= bar and y < bar + cur_thick:
            return 1
        return 0
    if x >= bar and x < bar + cur_thick:
        return 1
    return 0


def _flow_of(x: int64, y: int64) -> int64:
    if cur_horiz != 0:
        return x
    return y


# Central button dispatcher: routes left vs right clicks, drives the
# right-click Add / Move / Remove context menus, and the move-mode drop.
# Returns 1 if a redraw is needed. Mutates ctx_*/move_*/menu_open and (on
# Add/Move/Remove) the panel's widget list + persists via _save_config.
# The owning _drain_events re-applies geometry afterwards if a popup toggled.
def _handle_button(x: int64, y: int64, bar: int64, pi: uint64) -> int32:
    # Geometry re-apply (after a popup toggles) is handled by _drain_events;
    # here we only need flow-axis hit-testing within this window.
    bv_right: int32 = g_bv_right
    # 0) The add-applet chooser DIALOG is open on this panel: a click on an
    #    applet row inserts that widget at the recorded flow position; a click
    #    outside dismisses; a click on the title/search/header is a no-op.
    if addlet_open != 0 and addlet_panel == pi:
        if g_press_edge == 0:
            return 0                       # held-button motion: leave dialog up
        _compute_addlet_box(bar)
        crow: int64 = ctxm_choice_hit(cast[int32](addlet_box_x),
                                      cast[int32](addlet_box_y),
                                      cast[int32](x), cast[int32](y))
        if crow < 0:
            addlet_open = 0                     # click outside -> dismiss
            return 1
        if ctxm_choice_row_kind(cast[uint64](crow)) == CTXM_CC_ROW_ENTRY:
            applet: int32 = ctxm_choice_row_applet(cast[uint64](crow))
            wk: int32 = _applet_to_wk(applet)
            at: uint64 = cast[uint64](addlet_insert)
            if at > p_nwidg[pi]:
                at = p_nwidg[pi]
            _insert_widget(pi, at, wk)
            _save_config()
            addlet_open = 0
            return 1
        return 0                                # header/search row: keep open
    # 1) A context menu is open on this panel: a fresh CLICK resolves it (a
    #    row select inside the box, or a dismiss outside). Held-button MOTION
    #    (no press edge) is ignored so cursor jitter right after the opening
    #    right-click — which lands on the bar, OUTSIDE the below-bar context
    #    box — can't instantly dismiss the menu it just opened (#265).
    if ctx_open != 0 and ctx_panel == pi:
        if g_press_edge == 0:
            return 0
        _compute_ctx_box(bar)
        bh: int64 = ctx_box_h()
        if x >= ctx_box_x and x < ctx_box_x + CTX_W \
                and y >= ctx_box_y and y < ctx_box_y + bh:
            row: int64 = (y - ctx_box_y - 2) / CTX_ROW_H
            if row < 0:
                row = 0
            if row >= ctx_rows():
                row = ctx_rows() - 1
            _ctx_select_row(pi, row)
            return 1
        # click outside the menu: dismiss it.
        ctx_open = 0
        ctx_kind = CTXK_NONE
        return 1
    # 2) Move-mode: a left click on the bar drops the carried widget.
    if move_active != 0 and move_panel == pi and bv_right == 0:
        if _on_bar(x, y, bar) != 0:
            flow: int64 = _flow_of(x, y)
            _do_move_drop(pi, flow)
            return 1
        # click off-bar cancels the move
        move_active = 0
        return 1
    # 3) A right-click PRESS on the bar opens a context menu. Gate on the
    #    right-button press edge (not merely "right button held") so the menu
    #    opens once, cleanly, on the click — and a held right-drag afterwards
    #    doesn't re-open/re-target it (#265).
    if (g_press_edge & 2) != 0 and _on_bar(x, y, bar) != 0:
        flow2: int64 = _flow_of(x, y)
        ws: int64 = _widget_at_flow(flow2)
        # The elastic taskbar / spacer fills the empty middle of the bar; a
        # right-click there is "blank panel space" -> ADD a widget, not a
        # Move/Remove of the window-list. Treat those kinds as empty space so
        # right-clicking the empty bar offers the add-a-widget menu (A3).
        if ws >= 0:
            wsk: int32 = wkind_cur[cast[uint64](ws)]
            if wsk == WK_TASKS or wsk == WK_SPACER:
                ws = -1
        ctx_open = 1
        ctx_panel = pi
        ctx_flow = flow2
        if ws >= 0:
            # ANY real widget -- INCLUDING the Applications (menu) button --
            # opens the per-widget Move / Remove menu, so the Apps widget can be
            # moved or removed like any other applet (A4, MATE parity). (The old
            # CTXK_APPMENU Settings/About shortcut is reachable from the menu
            # tree instead.)
            ctx_kind = CTXK_WIDGET
            ctx_widget = ws
        else:
            # MATE workflow: a right-click on blank bar space opens the PANEL
            # menu ("Add to Panel..." / "Properties"), NOT the old giant inline
            # widget list. "Add to Panel..." then opens the searchable chooser.
            ctx_kind = CTXK_PANELMENU
            ctx_insert = _insert_index_at_flow(flow2)
        # close the apps dropdown if it was open
        menu_open = 0
        return 1
    # 4) Plain left-click: the menu/taskbar behaviour — but only on the press
    #    EDGE, so a bar-button action (Apps menu toggle, taskbar raise, clock/
    #    tray/session) fires once per click, not repeatedly while a button is
    #    held and the cursor jitters over the widget.
    if g_press_edge != 0:
        return _handle_click(x, y, bar)
    return 0


# Apply the chosen context-menu row.
def _ctx_select_row(pi: uint64, row: int64):
    if ctx_kind == CTXK_PANELMENU:
        if row == 0:
            # Add to Panel...: open the searchable applet chooser DIALOG at the
            # right-clicked flow position. The panel window grows for it.
            if addlet_ready == 0:
                ctxm_choice_init()
                addlet_ready = 1
            ctxm_choice_layout()
            addlet_open = 1
            addlet_panel = pi
            addlet_flow = ctx_flow
            addlet_insert = ctx_insert
        else:
            # Properties -> the Control Center (panel/appearance preferences).
            _launch(cast[Ptr[char]]("/bin/hamctl"))
        ctx_open = 0
        ctx_kind = CTXK_NONE
        return
    if ctx_kind == CTXK_APPMENU:
        if row == 1:
            # Add to Panel: morph this popup into the add-a-widget kind picker
            # (Clock/Sysmon/Menu/Tasks/Spacer), inserting at the Apps button's
            # flow position. Keep the menu OPEN so the user picks a kind next.
            ctx_kind = CTXK_ADD
            ctx_insert = _insert_index_at_flow(ctx_flow)
            return
        # Settings (row 0) -> the Control Center; About (row 2) -> the
        # dedicated About-this-system scene dialog (/bin/hamabout: OS name,
        # kernel, memory, uptime). MATE's "About This Computer".
        if row == 2:
            _launch(cast[Ptr[char]]("/bin/hamabout"))
        else:
            _launch(cast[Ptr[char]]("/bin/hamctl"))
        ctx_open = 0
        ctx_kind = CTXK_NONE
        return
    if ctx_kind == CTXK_WIDGET:
        if row == 0:
            # Move: enter move-mode carrying this widget.
            move_active = 1
            move_panel = pi
            move_slot = ctx_widget
        else:
            # Remove From Panel.
            if ctx_widget >= 0:
                _remove_widget(pi, cast[uint64](ctx_widget))
                _save_config()
        ctx_open = 0
        ctx_kind = CTXK_NONE
        return
    # CTXK_ADD: insert the chosen kind at the recorded flow index.
    k: int32 = _ctx_add_kind(row)
    at: uint64 = cast[uint64](ctx_insert)
    if at > p_nwidg[pi]:
        at = p_nwidg[pi]
    _insert_widget(pi, at, k)
    _save_config()
    ctx_open = 0
    ctx_kind = CTXK_NONE


# Drop the carried widget (move_slot) at flow index derived from `flow`.
def _do_move_drop(pi: uint64, flow: int64):
    if move_slot < 0:
        move_active = 0
        return
    src: uint64 = cast[uint64](move_slot)
    if src >= p_nwidg[pi]:
        move_active = 0
        move_slot = -1
        return
    k: int32 = p_wkind[pi * MAX_WIDGETS + src]
    dst: int64 = _insert_index_at_flow(flow)
    # Remove from old index first; if the destination was after it, the
    # removal shifts everything down by one, so decrement dst accordingly.
    _remove_widget(pi, src)
    if dst > cast[int64](src):
        dst = dst - 1
    if dst < 0:
        dst = 0
    _insert_widget(pi, cast[uint64](dst), k)
    move_active = 0
    move_slot = -1
    _save_config()


# LIVE MOVE (bug 2): while move-mode is active, every pointer-motion event
# (button or not) drags the carried widget so it TRACKS the cursor in real
# time, MATE-style. A fixed-extent widget is PINNED at the cursor (arbitrary
# position, bug 3); the elastic taskbar/spacer falls back to the classic
# flow-index reorder on the drop click. The LEFT button drops + persists; the
# RIGHT button cancels. Returns 1 if a redraw is needed. cur_* / layout must
# already be set for this panel (the caller _drain_events does that).
def _handle_move_motion(x: int64, y: int64, bar: int64, pi: uint64,
                        bv: int64) -> int32:
    if (bv & 2) != 0:                       # right button cancels the move
        move_active = 0
        move_slot = -1
        return 1
    if move_slot < 0:
        move_active = 0
        return 0
    src: uint64 = cast[uint64](move_slot)
    if src >= p_nwidg[pi]:
        move_active = 0
        move_slot = -1
        return 0
    kind: int32 = p_wkind[pi * MAX_WIDGETS + src]
    ext: int64 = _widget_extent_at(kind, src)
    flow: int64 = _flow_of(x, y)
    # Elastic widgets aren't free-positioned: drop = classic flow reorder.
    if ext <= 0:
        if (bv & 1) != 0:
            _do_move_drop(pi, flow)
            return 1
        return 0
    span: int64 = cur_sw
    if cur_horiz == 0:
        span = cur_sh
    nx: int64 = flow - ext / 2                # centre the widget on the cursor
    if nx + ext > span:
        nx = span - ext
    if nx < 0:
        nx = 0
    p_wx_pin[pi * MAX_WIDGETS + src] = nx     # follow the pointer live
    if (bv & 1) != 0:
        # Left click drops the widget here and persists the new position.
        move_active = 0
        move_slot = -1
        _save_config()
    return 1


# ====================================================================
# MULTI-PANEL DRIVER
# ====================================================================

# Per-panel live runtime state (parallel to the config arrays).
pw_wid:   Array[4, int32]
pw_ctl:   Array[256, uint8]          # 4 * 64
pw_ev:    Array[256, uint8]          # 4 * 64
pw_menu:  Array[4, int32]            # menu_open per panel
pw_geoh:  Array[4, int64]            # last applied window cross-axis size
_wait_efds: Array[4, int32]          # per-iter /event fds parked on by sys_waitfds
# WINDOW POOL SIZE: how many compositor windows we have ever allocated.
# pw_wid[0 .. pw_alloc_n) are live wids we own; only pw_wid[0 .. n_panels)
# are currently ON SCREEN — the rest are hidden and waiting to be reused.
#
# A live config edit that REDUCES the panel count used to leave the surplus
# windows allocated-but-unmanaged, and a later edit that GREW the count
# allocated brand-new ones on top of them, so a few Settings edits leaked
# through the 32-slot compositor window table. Keeping the pool means the
# panel allocates at most MAX_PANELS windows for its whole life.
pw_alloc_n: uint64 = 0


def pw_ctl_ptr(i: uint64) -> Ptr[char]:
    return cast[Ptr[char]](cast[uint64](&pw_ctl[0]) + i * 64)


def pw_ev_ptr(i: uint64) -> Ptr[char]:
    return cast[Ptr[char]](cast[uint64](&pw_ev[0]) + i * 64)


# Load this panel's config into the cur_* render registers.
# Cross-axis grow (px) a panel's window needs for any open popup: the Apps
# dropdown (when the menu widget exists + is open) and/or the right-click
# context menu (when open on THIS panel). Take the larger so whichever popup
# is showing fits. horiz controls which popup dimension is the cross axis
# (MENU_H/CTX height for horizontal panels, MENU_W/CTX_W for vertical).
def _panel_grow_px(pi: uint64, horiz: int32) -> int64:
    g: int64 = 0
    mopen: int32 = pw_menu[pi]
    has_menu: int32 = 0
    nw: uint64 = p_nwidg[pi]
    b: uint64 = 0
    while b < nw:
        if p_wkind[pi * MAX_WIDGETS + b] == WK_MENU:
            has_menu = 1
        b = b + 1
    if mopen != 0 and has_menu != 0:
        if horiz != 0:
            g = MENU_H
        else:
            g = MENU_W
    if ctx_open != 0 and ctx_panel == pi:
        cg: int64 = 0
        if horiz != 0:
            cg = ctx_box_h()
        else:
            cg = CTX_W
        if cg > g:
            g = cg
    # The update notice is a popup too, and it is the one the person did not
    # ask for -- so it takes the max alongside the others rather than
    # replacing them: a dropdown opened while the notice is up must still fit.
    if notice_on != 0 and notice_panel == pi:
        ng: int64 = 0
        if horiz != 0:
            ng = NOTICE_H
        else:
            ng = NOTICE_W
        if ng > g:
            g = ng
    # The add-applet chooser dialog needs the most room of all.
    if addlet_open != 0 and addlet_panel == pi:
        ag: int64 = 0
        if horiz != 0:
            ag = cast[int64](ctxm_choice_content_h())
        else:
            ag = cast[int64](ctxm_choice_w())
        if ag > g:
            g = ag
    return g


def _select_panel(pi: uint64, sw: int64, sh: int64):
    cur_edge = p_edge[pi]
    cur_bold = p_bold[pi]
    cur_thick = p_size[pi]
    cur_panel_idx = pi
    if cur_edge == EDGE_LEFT or cur_edge == EDGE_RIGHT:
        cur_horiz = 0
    else:
        cur_horiz = 1
    menu_open = pw_menu[pi]
    # copy widget kinds into the working list
    n_widg = p_nwidg[pi]
    a: uint64 = 0
    while a < n_widg:
        wkind_cur[a] = p_wkind[pi * MAX_WIDGETS + a]
        wpin_cur[a] = p_wx_pin[pi * MAX_WIDGETS + a]
        a = a + 1
    # window content size: thick + whatever popup grow this panel needs.
    grow: int64 = _panel_grow_px(pi, cur_horiz)
    if cur_horiz != 0:
        cur_sw = sw
        cur_sh = cur_thick + grow
    else:
        cur_sh = sh
        cur_sw = cur_thick + grow


# Compute the bar's cross-axis offset within the window + the window's
# screen origin; write the geometry ctl only when do_apply != 0 (so a plain
# content redraw can fetch the bar offset WITHOUT a redundant geometry write
# every tick — keeping the flicker gate quiet). Returns the bar offset.
def _panel_geometry(pi: uint64, sw: int64, sh: int64, do_apply: int32) -> int64:
    edge: int32 = p_edge[pi]
    horiz: int32 = 1
    if edge == EDGE_LEFT or edge == EDGE_RIGHT:
        horiz = 0
    thick: int64 = p_size[pi]
    grow: int64 = _panel_grow_px(pi, horiz)
    win_w: int64 = sw
    win_h: int64 = thick
    ox: int64 = 0
    oy: int64 = 0
    bar: int64 = 0
    if horiz != 0:
        win_w = sw
        win_h = thick + grow
        if edge == EDGE_BOTTOM:
            # bar pinned to screen bottom; popups grow upward (above the bar)
            oy = sh - (thick + grow)
            bar = grow                       # bar sits below any popup band
        else:
            oy = 0
            bar = 0
        if oy < 0:
            oy = 0
    else:
        win_w = thick + grow
        win_h = sh
        if edge == EDGE_RIGHT:
            # bar pinned to screen right; popups grow leftward (inside edge)
            ox = sw - (thick + grow)
            bar = grow
        else:
            ox = 0
            bar = 0
        if ox < 0:
            ox = 0
    if do_apply != 0:
        _set_geometry_xy(pw_ctl_ptr(pi), ox, oy, win_w, win_h)
    return bar


# Apply geometry (writes the ctl). Returns bar offset.
def _apply_panel_geometry(pi: uint64, sw: int64, sh: int64) -> int64:
    return _panel_geometry(pi, sw, sh, 1)


# Render + commit one panel. Geometry is applied separately (init / reload /
# menu toggle); here we only fetch the bar offset + emit content so a routine
# tick redraw doesn't write the geometry ctl needlessly.
def _redraw_panel(pi: uint64, sw: int64, sh: int64, btime: uint64):
    bar: int64 = _panel_geometry(pi, sw, sh, 0)
    _select_panel(pi, sw, sh)
    _layout_panel()
    _emit_panel(bar, btime)
    hamscene_commit(pw_wid[pi])


_drain_evbuf: Array[256, uint8]
def _drain_events(pi: uint64, sw: int64, sh: int64) -> int32:
    need_redraw: int32 = 0
    efd: int32 = sys_open(cast[Ptr[char]](pw_ev_ptr(pi)))
    if efd < 0:
        return 0
    r: int64 = sys_read(efd, &_drain_evbuf[0], 255)
    sys_close(efd)
    if r <= 0:
        return 0
    # set up cur_* + layout so hit-test uses this panel's geometry. Record
    # the pre-click menu/ctx state so a toggle below can resize the window.
    pre_menu: int32 = pw_menu[pi]
    pre_ctx_open: int32 = ctx_open
    pre_addlet_open: int32 = addlet_open
    pre_notice: int32 = notice_on
    pre_ctx_h: int64 = 0
    if ctx_open != 0 and ctx_panel == pi:
        pre_ctx_h = ctx_box_h()
    bar: int64 = _panel_geometry(pi, sw, sh, 0)
    _select_panel(pi, sw, sh)
    _layout_panel()
    i: uint64 = 0
    while i < cast[uint64](r):
        if _drain_evbuf[i] == 102 and i + 1 < cast[uint64](r) \
                and _drain_evbuf[i+1] == 32:               # "f "
            if i + 4 < cast[uint64](r) and _drain_evbuf[i+2] == 111 \
                    and _drain_evbuf[i+3] == 117 \
                    and _drain_evbuf[i+4] == 116:          # "out"
                if menu_open != 0:
                    menu_open = 0
                    need_redraw = 1
                # focus-out is our cleanest "pointer left" signal: drop any
                # sticky hover pill so it doesn't linger over the desktop.
                if hov_valid != 0 and hov_panel == pi:
                    hov_valid = 0
                    need_redraw = 1
            while i < cast[uint64](r) and _drain_evbuf[i] != 10:
                i = i + 1
            i = i + 1
            continue
        if _drain_evbuf[i] == 109 and i + 1 < cast[uint64](r) \
                and _drain_evbuf[i+1] == 32:               # "m "
            j: uint64 = i + 2
            xneg: int32 = 0
            if j < cast[uint64](r) and _drain_evbuf[j] == 45:
                xneg = 1
                j = j + 1
            xv: int64 = 0
            while j < cast[uint64](r) and _drain_evbuf[j] >= 48 and _drain_evbuf[j] <= 57:
                xv = xv * 10 + cast[int64](_drain_evbuf[j]) - 48
                j = j + 1
            if xneg != 0:
                xv = 0 - xv
            if j < cast[uint64](r) and _drain_evbuf[j] == 32:
                j = j + 1
            yneg: int32 = 0
            if j < cast[uint64](r) and _drain_evbuf[j] == 45:
                yneg = 1
                j = j + 1
            yv: int64 = 0
            while j < cast[uint64](r) and _drain_evbuf[j] >= 48 and _drain_evbuf[j] <= 57:
                yv = yv * 10 + cast[int64](_drain_evbuf[j]) - 48
                j = j + 1
            if yneg != 0:
                yv = 0 - yv
            if j < cast[uint64](r) and _drain_evbuf[j] == 32:
                j = j + 1
            bv: int64 = 0
            while j < cast[uint64](r) and _drain_evbuf[j] >= 48 and _drain_evbuf[j] <= 57:
                bv = bv * 10 + cast[int64](_drain_evbuf[j]) - 48
                j = j + 1
            if (bv & 2) != 0:
                g_bv_right = 1
            else:
                g_bv_right = 0
            # Buttons newly pressed this event (up->down edge): bits set in bv
            # that were NOT set last event. (bv & (bv ^ prev) isolates them.)
            g_press_edge = bv & (bv ^ g_prev_bv)
            # Buttons newly RELEASED (down->up): set last event, clear now.
            g_release_edge = g_prev_bv & (bv ^ g_prev_bv)
            g_prev_bv = bv
            if pend_active != 0 and ((bv & 1) != 0 or (g_release_edge & 1) != 0):
                # A drag-from-menu offer is in flight AND the gesture is LIVE
                # (button down, or this very event is its release edge).
                # SUPPRESS normal bar button handling (a held-button drag
                # across the bar must not toggle a widget or launch), and
                # COMMIT the launcher at the release point on the left-button
                # RELEASE over this bar (#327). A pending offer with the button
                # already UP is a drag that ended elsewhere: it falls through
                # to normal handling so it cannot eat the user's clicks for the
                # rest of the (now long) TTL.
                if (bv & 1) != 0:
                    # Held-button motion over the bar = a live inbound drag.
                    if pend_last_x >= 0 and (xv != pend_last_x
                                             or yv != pend_last_y):
                        pend_moved = 1
                    pend_last_x = xv
                    pend_last_y = yv
                if (g_release_edge & 1) != 0 and pend_moved != 0 \
                        and _on_bar(xv, yv, bar) != 0:
                    if _commit_panel_drop(pi, _flow_of(xv, yv)) != 0:
                        need_redraw = 1
                    # committed: tear down the live preview.
                    if drop_prev_active != 0:
                        drop_prev_active = 0
                        need_redraw = 1
                elif _on_bar(xv, yv, bar) != 0:
                    # LIVE DROP PREVIEW: the drag is hovering this bar — show an
                    # insertion indicator at the current drop flow-X and refresh
                    # it as the cursor moves. Only repaint when the tracked
                    # position actually changes so we don't spin the compositor.
                    nf: int64 = _flow_of(xv, yv)
                    if drop_prev_active == 0 or drop_prev_panel != pi \
                            or drop_prev_flow != nf:
                        drop_prev_active = 1
                        drop_prev_panel = pi
                        drop_prev_flow = nf
                        need_redraw = 1
                else:
                    # dragged off this bar — erase its preview.
                    if drop_prev_active != 0 and drop_prev_panel == pi:
                        drop_prev_active = 0
                        need_redraw = 1
            elif move_active != 0 and move_panel == pi:
                # LIVE MOVE: route EVERY motion (even button-less) to the
                # drag handler so the carried widget tracks the cursor.
                if _handle_move_motion(xv, yv, bar, pi, bv) != 0:
                    need_redraw = 1
            elif bv != 0:
                if _handle_button(xv, yv, bar, pi) != 0:
                    need_redraw = 1
            elif menu_open != 0:
                # Button-LESS motion with the Apps dropdown open: hover-track
                # the MATE "Linux apps" fly-out submenu.
                if _handle_menu_hover(xv, yv, bar) != 0:
                    need_redraw = 1
            else:
                # Button-LESS motion over the bar: track a live hover highlight
                # (taskbar entry / pager cell / chip under the cursor).
                if _update_hover(xv, yv, bar, pi) != 0:
                    need_redraw = 1
            i = j
        else:
            i = i + 1
    # The fly-out is a child of the dropdown: if the dropdown closed (any
    # dismiss path), drop the fly-out too.
    #
    # `pre_menu != 0` is load-bearing and was not there. `sub_open` is ONE
    # global but `menu_open` is PER PANEL (restored from pw_menu[pi] by
    # _select_panel), and this image ships two panels. So draining an event on
    # the panel that does NOT have the dropdown open -- the bottom taskbar,
    # under a pointer on its way somewhere -- read its own menu_open of 0 and
    # closed the OTHER panel's fly-out. The dropdown stayed up, the fly-out
    # vanished, and nothing anywhere said why: exactly the shape of a menu that
    # half-works. Now the fly-out is dropped only when THIS panel's dropdown
    # actually closed during THIS drain.
    if menu_open == 0 and pre_menu != 0:
        sub_open = 0
    # persist this panel's menu state; if the menu OR the context menu toggled
    # (or the context menu changed height), the window must grow/shrink —
    # re-apply geometry so the popup room appears / the vacated band is
    # reclaimed before the content redraw.
    pw_menu[pi] = menu_open
    cur_ctx_h: int64 = 0
    if ctx_open != 0 and ctx_panel == pi:
        cur_ctx_h = ctx_box_h()
    if menu_open != pre_menu or ctx_open != pre_ctx_open \
            or cur_ctx_h != pre_ctx_h or addlet_open != pre_addlet_open \
            or notice_on != pre_notice:
        _apply_panel_geometry(pi, sw, sh)
        need_redraw = 1
    return need_redraw


# Helpers returning uint8* for _winpath (which writes bytes).
def pw_ctl_ptr_u8(i: uint64) -> Ptr[uint8]:
    return cast[Ptr[uint8]](cast[uint64](&pw_ctl[0]) + i * 64)


def pw_ev_ptr_u8(i: uint64) -> Ptr[uint8]:
    return cast[Ptr[uint8]](cast[uint64](&pw_ev[0]) + i * 64)


# Show or withdraw one of our pooled panel windows through the compositor's
# `hide` verb (sys/src/9/port/devwsys.ad).
#
# This used to be `_set_geometry_xy(ctl, 0, 0, 0, 0)` — "collapse it to a
# zero-size off-screen geometry", per the old comment. It never did that. The
# geometry verb deliberately treats a non-positive w/h as "leave that
# dimension alone" so a client can MOVE a window without restating its size,
# so the width and height survived and only the ORIGIN changed: the surplus
# panel became a full-width bar parked at (0,0), still displaying its last
# committed scene, sitting on top of the real top panel and swallowing every
# click meant for it. Changing the panel layout — the one thing this file is
# for — left the desktop with a dead bar where the panel should be.
def _set_window_hidden(wid: int32, hidden: int32):
    if wid < 0:
        return
    hp: Array[64, uint8]
    _winpath(&hp[0], wid, cast[Ptr[uint8]]("/ctl"))
    hfd: int32 = sys_open_write(cast[Ptr[char]](&hp[0]))
    if hfd < 0:
        return
    if hidden != 0:
        _writeall(hfd, cast[Ptr[uint8]]("hide 1\n"))
    else:
        _writeall(hfd, cast[Ptr[uint8]]("hide 0\n"))
    sys_close(hfd)


# Re-read the config and rebuild the panel set. The window COUNT may change;
# we reuse the window POOL 1:1 by index, allocate more only when the config
# asks for more panels than we have ever had, and HIDE the ones the new
# config does not use. The common Settings edits (edge / widgets / colour /
# size / font of the SAME panel count) reuse the same windows in place.
def _reload_panels(sw: int64, sh: int64, btime: uint64):
    _load_config()
    pi: uint64 = 0
    while pi < n_panels:
        if pi >= pw_alloc_n:
            # First time we have needed this many panels: allocate + chrome.
            wid: int32 = _newwindow()
            pw_wid[pi] = wid
            pw_menu[pi] = 0
            if wid >= 0:
                _winpath(pw_ctl_ptr_u8(pi), wid, cast[Ptr[uint8]]("/ctl"))
                cfd2: int32 = sys_open_write(pw_ctl_ptr(pi))
                if cfd2 >= 0:
                    _writeall(cfd2, cast[Ptr[uint8]]("decorate 0\n"))
                    sys_close(cfd2)
                cfd3: int32 = sys_open_write(pw_ctl_ptr(pi))
                if cfd3 >= 0:
                    _writeall(cfd3, cast[Ptr[uint8]]("z 100\n"))
                    sys_close(cfd3)
                cfdk: int32 = sys_open_write(pw_ctl_ptr(pi))
                if cfdk >= 0:
                    _writeall(cfdk, cast[Ptr[uint8]]("keyed 1\n"))
                    sys_close(cfdk)
                pw_alloc_n = pi + 1
        _winpath(pw_ctl_ptr_u8(pi), pw_wid[pi], cast[Ptr[uint8]]("/ctl"))
        _winpath(pw_ev_ptr_u8(pi), pw_wid[pi], cast[Ptr[uint8]]("/event"))
        _apply_panel_geometry(pi, sw, sh)
        # A pooled window reclaimed from an earlier, larger layout comes back
        # hidden; put it on screen before we redraw into it.
        _set_window_hidden(pw_wid[pi], 0)
        pi = pi + 1
    # Withdraw the pooled windows the new config no longer uses, so they
    # leave NOTHING on screen. They stay allocated for the next grow.
    while pi < pw_alloc_n and pi < MAX_PANELS:
        _set_window_hidden(pw_wid[pi], 1)
        pw_menu[pi] = 0
        pi = pi + 1
    # One line per applied reload, so a gate (and a human reading the serial
    # log) can tell when the panel has actually PICKED UP a config edit
    # instead of guessing with a sleep.
    _writeall(1, cast[Ptr[uint8]]("[panel] config reload applied: "))
    _rn: Array[24, uint8]
    _rnl: uint64 = _u64_to_dec(n_panels, &_rn[0])
    _rn[_rnl] = 0
    _writeall(1, &_rn[0])
    _writeall(1, cast[Ptr[uint8]](" panel(s)\n"))


# ---- ADD-TO-PANEL CHOOSER: live search typing ---------------------------
# While the chooser dialog is open its owning panel window holds keyboard
# focus (the clicks that opened it were content presses that focused the
# panel window), so the compositor routes physical keystrokes to that
# window's /dev/wsys/<wid>/keys stream as press lines "d <code>\n" (raw ASCII;
# see sys/src/9/port/devwsys.ad wsys_route_key_byte). We feed typed chars into
# the EXISTING lib/ctxmenucore search filter (ctxm_choice_filter_push /
# _backspace) and re-run ctxm_choice_layout — the identical filter the host
# gate (scripts/test_ctxmenu_host.sh) proves. Enter adds the first filtered
# applet; Esc dismisses. Arrow keys arrive as the ESC '[' 'A' 3-byte sequence,
# so a lone ESC (nothing follows) dismisses but an ESC that opens a sequence
# does not.
_addlet_keybuf:        Array[256, uint8]
_addlet_esc_pending:   int32 = 0
_addlet_arrow_consume: int32 = 0


# First CTXM_CC_ROW_ENTRY row in the current (filtered) layout, or -1.
def _addlet_first_entry() -> int64:
    i: uint64 = 0
    rc: uint64 = ctxm_choice_row_count()
    while i < rc:
        if ctxm_choice_row_kind(i) == CTXM_CC_ROW_ENTRY:
            return cast[int64](i)
        i = i + 1
    return -1


# Insert the applet for chooser row `crow` at the recorded flow position and
# close the dialog. Mirrors the chooser-click path in _handle_button.
def _addlet_activate(pi: uint64, crow: uint64):
    applet: int32 = ctxm_choice_row_applet(crow)
    wk: int32 = _applet_to_wk(applet)
    at: uint64 = cast[uint64](addlet_insert)
    if at > p_nwidg[pi]:
        at = p_nwidg[pi]
    _insert_widget(pi, at, wk)
    _save_config()
    addlet_open = 0


# Apply one decoded key code to the chooser. Returns:
#   0  nothing / swallowed
#   1  filter changed -> repaint (window already sized for the full list)
#   2  dialog closed (dismiss or activate) -> re-apply geometry + repaint
def _addlet_key_apply(pi: uint64, code: int32) -> int32:
    if _addlet_arrow_consume != 0:                   # 3rd byte of ESC [ X
        _addlet_arrow_consume = 0
        return 0
    if _addlet_esc_pending != 0:
        _addlet_esc_pending = 0
        if code == 91:                               # '[' -> arrow sequence
            _addlet_arrow_consume = 1
            return 0
        addlet_open = 0                              # standalone ESC = dismiss
        return 2
    if code == 27:                                   # ESC -> pending
        _addlet_esc_pending = 1
        return 0
    if code == 13 or code == 10:                     # Enter -> add first row
        fe: int64 = _addlet_first_entry()
        if fe >= 0:
            _addlet_activate(pi, cast[uint64](fe))
            return 2
        return 0
    if code == 8 or code == 127:                     # Backspace / DEL
        ctxm_choice_filter_backspace()
        ctxm_choice_layout()
        return 1
    if code >= 32 and code < 127:                    # printable -> append
        ctxm_choice_filter_push(cast[uint8](code))
        ctxm_choice_layout()
        return 1
    return 0


# Drain the focused panel window's /keys stream while the chooser is open.
# Returns the strongest action: 0 nothing, 1 repaint, 2 dialog-closed.
def _drain_addlet_keys(pi: uint64) -> int32:
    kpath: Array[64, uint8]
    _winpath(&kpath[0], pw_wid[pi], cast[Ptr[uint8]]("/keys"))
    kfd: int32 = sys_open(cast[Ptr[char]](&kpath[0]))
    if kfd < 0:
        return 0
    act: int32 = 0
    n: int64 = sys_read_nb(kfd, &_addlet_keybuf[0], 256)
    while n > 0:
        cap: uint64 = cast[uint64](n)
        i: uint64 = 0
        while i < cap:
            t: uint8 = _addlet_keybuf[i]              # 'd' press
            i = i + 1
            if i < cap and _addlet_keybuf[i] == 32:
                i = i + 1
            code: int32 = 0
            have: int32 = 0
            while i < cap and _addlet_keybuf[i] >= 48 and _addlet_keybuf[i] <= 57:
                code = code * 10 + cast[int32](_addlet_keybuf[i]) - 48
                i = i + 1
                have = 1
            while i < cap and _addlet_keybuf[i] != 10:
                i = i + 1
            if i < cap:
                i = i + 1
            if t == 100 and have != 0:
                rc: int32 = _addlet_key_apply(pi, code)
                if rc == 2:
                    sys_close(kfd)
                    return 2
                if rc == 1 and act == 0:
                    act = 1
        n = sys_read_nb(kfd, &_addlet_keybuf[0], 256)
    sys_close(kfd)
    # A lone ESC left pending (nothing followed it) dismisses.
    if _addlet_esc_pending != 0:
        _addlet_esc_pending = 0
        addlet_open = 0
        return 2
    return act


# Host test hook: build panel 0's scene and dump the raw display list (no
# /dev/wsys). Guarded by the "--scene-dump" argv the live DE never passes, so
# native behaviour is byte-for-byte unchanged. Reproduces the "scene-DE-blank"
# --opt miscompile host-side (scripts/test_de_scene_opt_host.sh).
def _panel_scene_dump(outp: Ptr[char]) -> int32:
    _init_pins()
    _cfg_changed()
    _load_config()
    _load_apps()
    _sm_sample()
    btime: uint64 = _read_btime()
    sw: int64 = 800
    sh: int64 = 600
    bar: int64 = _panel_geometry(0, sw, sh, 0)
    _select_panel(0, sw, sh)
    _layout_panel()
    _emit_panel(bar, btime)
    dl: Ptr[uint8] = hamscene_bufptr()
    dln: uint64 = hamscene_length()
    nb: Array[24, uint8]
    ndig: uint64 = _u64_to_dec(dln, &nb[0])
    _writeall(1, cast[Ptr[uint8]]("[paneldump] display-list bytes="))
    sys_write(1, &nb[0], ndig)
    _writeall(1, cast[Ptr[uint8]]("\n"))
    fd: int32 = sys_open_write(outp)
    if fd < 0:
        _writeall(1, cast[Ptr[uint8]]("[paneldump] FAIL open\n"))
        return 1
    sys_write(fd, dl, dln)
    sys_close(fd)
    return 0


def main(argc: int32, argv: Ptr[uint64]) -> int32:
    if argc > 2:
        a: Ptr[uint8] = cast[Ptr[uint8]](argv[1])
        if a[0] == 45 and a[1] == 45 and a[2] == 115 and a[3] == 99:  # "--sc"
            return _panel_scene_dump(cast[Ptr[char]](argv[2]))
    sys_bind(cast[Ptr[char]]("/dev"), cast[Ptr[char]]("#c"), 0)
    # Both or neither, and no starting value that could be mistaken for an
    # answer: a panel that does not know the screen width cannot place a
    # single one of its bars.
    sw: int64 = 0
    sh: int64 = 0
    if _screen_dims(&sw, &sh) == 0:
        return 1

    _init_pins()
    _cfg_changed()
    _load_config()
    # Scan /etc/hamde/apps/*.desktop → the Applications menu model (sets
    # MENU_H). Data-driven: adding an app is dropping a .desktop file.
    _load_apps()
    _writeall(1, cast[Ptr[uint8]]("[panel] appmenu entries: "))
    _apn: Array[24, uint8]
    _apnl: uint64 = _u64_to_dec(am_count, &_apn[0])
    _apn[_apnl] = 0
    _writeall(1, &_apn[0])
    _writeall(1, cast[Ptr[uint8]]("\n"))
    # ONE LINE PER DISTRIBUTION SECTION, naming it and its count. The old
    # single "(linux section: N)" could not distinguish "no distributions" from
    # "one distribution with nothing in it", and both were printed as 0.
    _dsi: uint64 = 0
    while _dsi < dm_count:
        _writeall(1, cast[Ptr[uint8]]("[panel] distro section "))
        _writeall(1, &dm_name[_dsi][0])
        _writeall(1, cast[Ptr[uint8]](": "))
        _lxn: Array[24, uint8]
        _lxnl: uint64 = _u64_to_dec(dm_apps[_dsi], &_lxn[0])
        _lxn[_lxnl] = 0
        _writeall(1, &_lxn[0])
        _writeall(1, cast[Ptr[uint8]](" apps\n"))
        _dsi = _dsi + 1
    if dm_count == 0:
        _writeall(1, cast[Ptr[uint8]]("[panel] no distribution namespace attached under /n\n"))

    btime: uint64 = _read_btime()

    # Allocate a window per panel + set chrome (decorate 0, z 100).
    pi: uint64 = 0
    while pi < n_panels:
        wid: int32 = _newwindow()
        if wid < 0:
            _writeall(1, cast[Ptr[uint8]]("[panel] FAIL newwindow\n"))
            return 1
        pw_wid[pi] = wid
        pw_menu[pi] = 0
        pw_alloc_n = pi + 1
        _winpath(pw_ctl_ptr_u8(pi), wid, cast[Ptr[uint8]]("/ctl"))
        _winpath(pw_ev_ptr_u8(pi), wid, cast[Ptr[uint8]]("/event"))
        _apply_panel_geometry(pi, sw, sh)
        cfd2: int32 = sys_open_write(pw_ctl_ptr(pi))
        if cfd2 >= 0:
            _writeall(cfd2, cast[Ptr[uint8]]("decorate 0\n"))
            sys_close(cfd2)
        cfd3: int32 = sys_open_write(pw_ctl_ptr(pi))
        if cfd3 >= 0:
            _writeall(cfd3, cast[Ptr[uint8]]("z 100\n"))
            sys_close(cfd3)
        # Alpha-keyed present: the grown popup band shows the desktop through
        # every un-painted (alpha-0) pixel instead of a solid backdrop fill.
        cfdk: int32 = sys_open_write(pw_ctl_ptr(pi))
        if cfdk >= 0:
            _writeall(cfdk, cast[Ptr[uint8]]("keyed 1\n"))
            sys_close(cfdk)
        pi = pi + 1

    _writeall(1, cast[Ptr[uint8]]("[panel] scene windows ready\n"))

    # #99: prime the launch-queue serials to whatever is pending NOW so a
    # panel (re)start does not replay a launch that predates us. Any write
    # AFTER this point bumps the serial and is spawned. (At a fresh boot
    # both queues read serial 0 = empty, so this primes to 0 = no-op.)
    _run_launch_last_serial = _peek_launch_serial(
        cast[Ptr[char]]("/dev/wsys/run/launch"))
    _appmenu_launch_last_serial = _peek_launch_serial(
        cast[Ptr[char]]("/dev/wsys/appmenu/launch"))

    # First frame for every panel. Seed one sysmon sample so the applet has a
    # baseline data point (the delta reader reports 0% on this first read).
    _sm_sample()
    _refresh_windows()
    pi = 0
    while pi < n_panels:
        _redraw_panel(pi, sw, sh, btime)
        pi = pi + 1

    last_minute: uint64 = 9999
    last_win_hash: uint64 = win_hash
    # OVER-TIME HEALTH BEACON (see scripts/test_de_panel_taskbar_soak.sh).
    # The taskbar-goes-blind defect took ~18 MINUTES of session time to
    # appear, so nothing that samples the panel at an instant can see it.
    # Once every ~10 s of wall clock the panel states, on /dev/cons: how many
    # descriptors it holds open, how many taskbar entries it is RENDERING,
    # and how many window-list refreshes have failed. A leak shows up as a
    # monotone `fds=` climb long before the panel goes blind, and a blind
    # panel shows up as `tasks=` diverging from the live window set.
    _beacon_last: uint64 = sys_get_jiffies()
    _beacon_iters: uint64 = 0
    BEACON_JIFFIES: uint64 = 1000                    # HZ=100 -> ~10 s
    # Iteration-count fallback. The wall-clock cadence alone is a single
    # point of failure for the whole instrument: if sys_get_jiffies() does
    # not advance for this task, the beacon never fires and the gate can
    # only report "no telemetry" — which is what happened on the first
    # attempt with /dev/cons and is indistinguishable from a dead panel.
    # An iteration counter cannot stall while the loop is running, so the
    # two together separate "the panel stopped looping" from "the clock
    # stopped ticking".
    BEACON_ITERS: uint64 = 600                       # ~10 s at the 16ms park
    _beacon_next_iter: uint64 = 1                    # beacon on iteration 1
    _pl_s(cast[Ptr[uint8]]("[panelbeacon] loop entry jiffies="))
    _pl_d(_beacon_last)
    _pl_s(cast[Ptr[uint8]]("\n"))
    _pl_flush()
    sysmon_tick: uint64 = 0
    SAMPLE_TICKS: uint64 = 20
    cfg_tick: uint64 = 0
    # Poll the panel config EVERY loop iteration (was every 8). A Settings
    # widget Move/Up/Down/Add/Del writes /tmp/hamnix-panel.conf and the panel
    # must reflect it on the very next wake so the reorder is visibly LIVE (no
    # extra click). Combined with the short park timeout below the reload lands
    # within ~one frame of the Settings write.
    CFG_TICKS: uint64 = 1

    while True:
        any_redraw: int32 = 0

        _beacon_iters = _beacon_iters + 1
        _bnow: uint64 = sys_get_jiffies()
        _bdue: int32 = 0
        if _bnow - _beacon_last >= BEACON_JIFFIES:
            _bdue = 1
        if _beacon_iters >= _beacon_next_iter:
            _bdue = 1
        if _bdue != 0:
            _beacon_last = _bnow
            _beacon_next_iter = _beacon_iters + BEACON_ITERS
            _pl_s(cast[Ptr[uint8]]("[panelbeacon] up_s="))
            _pl_d(_bnow / 100)
            _pl_s(cast[Ptr[uint8]](" iters="))
            _pl_d(_beacon_iters)
            _pl_s(cast[Ptr[uint8]](" openfds="))
            _bfds: int64 = _open_fd_count()
            if _bfds < 0:
                _pl_s(cast[Ptr[uint8]]("unreadable"))
            else:
                _pl_d(cast[uint64](_bfds))
            _pl_s(cast[Ptr[uint8]](" tasks="))
            _pl_d(n_tasks)
            _pl_s(cast[Ptr[uint8]](" winfail="))
            _pl_d(win_open_fails_total)
            # The taskbar BUTTON LABELS actually being drawn (wid:title),
            # so a gate can assert on the panel's RENDERED content rather
            # than on a count or an exit status.
            _pl_s(cast[Ptr[uint8]](" bar="))
            _bi: uint64 = 0
            while _bi < n_tasks:
                if _bi != 0:
                    _pl_s(cast[Ptr[uint8]]("|"))
                _pl_d(cast[uint64](task_wid[_bi]))
                _pl_s(cast[Ptr[uint8]](":"))
                _pl_bytes(&task_name[_bi * 64], task_namelen[_bi])
                _bi = _bi + 1
            _pl_s(cast[Ptr[uint8]]("\n"))
            _pl_flush()

        # #327: refresh the pending drag-from-menu OFFER before draining input,
        # so a left-button RELEASE this tick commits the launcher at the drop
        # point (and a held-button drag over the bar is suppressed, not acted
        # on). The launcher is placed by _commit_panel_drop inside _drain_events.
        pend_was: int32 = pend_active
        _poll_panel_offer()
        # If the offer just ended (TTL-expired / consumed elsewhere) while a live
        # drop preview was showing, erase the stale insertion indicator.
        if pend_was != 0 and pend_active == 0 and drop_prev_active != 0:
            ep: uint64 = drop_prev_panel
            drop_prev_active = 0
            if ep < n_panels:
                _redraw_panel(ep, sw, sh, btime)

        # per-panel input
        pi = 0
        while pi < n_panels:
            if _drain_events(pi, sw, sh) != 0:
                _redraw_panel(pi, sw, sh, btime)
            pi = pi + 1

        # Live search typing in the Add-to-Panel chooser dialog. Its owning
        # panel window holds keyboard focus while open, so drain that window's
        # /keys and feed the ctxmenucore filter. (Picked up within the ~16ms
        # park timeout below even without waking on the keys fd.)
        if addlet_open != 0:
            kchg: int32 = _drain_addlet_keys(addlet_panel)
            if kchg == 2:
                _apply_panel_geometry(addlet_panel, sw, sh)
                _redraw_panel(addlet_panel, sw, sh, btime)
            elif kchg == 1:
                _redraw_panel(addlet_panel, sw, sh, btime)

        # live config reload (re-allocates the panel set if needed)
        cfg_tick = cfg_tick + 1
        if cfg_tick >= CFG_TICKS:
            cfg_tick = 0
            if _cfg_changed() != 0:
                _reload_panels(sw, sh, btime)
                any_redraw = 1

        _refresh_windows()
        if win_hash != last_win_hash:
            any_redraw = 1

        # Track the live workspace (pager lit cell) and drain the notification
        # bus (/dev/wsys/post): each new record spawns a toast, is logged to
        # the inbox history, and bumps the unread badge. A change in either
        # repaints the panels.
        prev_ws: int64 = cur_ws
        prev_unread: int64 = notif_unread
        _poll_workspace()
        # #99: drain the DE launch queues (/dev/wsys/run/launch +
        # /dev/wsys/appmenu/launch) and spawn requested apps as scene
        # clients. hamUId's retired present loop used to do this; the panel
        # is the live scene client that now owns it.
        _drain_launch_queues()
        # Has anything been REFUSED by the window system since we last said
        # so? One open + fstat + close. On the transition to showing, every
        # panel's geometry is re-applied because the one carrying the notice
        # has to grow to hold the card.
        if _notice_poll() != 0:
            pi = 0
            while pi < n_panels:
                _apply_panel_geometry(pi, sw, sh)
                pi = pi + 1
            any_redraw = 1
        # #327: the drag-from-menu launcher drop is committed on the button
        # RELEASE inside _drain_events (at the drop point), not here.
        if _drain_notifications() != 0:
            any_redraw = 1
        if cur_ws != prev_ws or notif_unread != prev_unread:
            any_redraw = 1

        sod: uint64 = _now_secs_of_day(btime)
        minute: uint64 = sod / 60
        if minute != last_minute:
            any_redraw = 1

        sysmon_tick = sysmon_tick + 1
        if sysmon_tick >= SAMPLE_TICKS:
            sysmon_tick = 0
            # Advance the CPU/mem delta readers ONCE and push a history sample
            # so the applet's rolling graph scrolls with real data.
            _sm_sample()
            any_redraw = 1

        if any_redraw != 0:
            pi = 0
            while pi < n_panels:
                _redraw_panel(pi, sw, sh, btime)
                pi = pi + 1
            last_minute = minute
            last_win_hash = win_hash

        # Park (instead of busy-spinning sys_yield) until a panel event
        # arrives or the resample cadence (~30ms) lapses. Opening the
        # /event fds fresh each iteration keeps us robust across a live
        # config reload that re-allocates the panel set (pw_wid changes);
        # the open cost is negligible — it was the SPIN that pegged a core
        # at 100%. sys_waitfds sleeps the task OFF the runqueue: an idle
        # panel now sits at ~0% CPU and still wakes instantly on input
        # (devwsys_event_write -> waitfds_notify) or after the timeout for
        # the once-a-second clock/sysmon refresh.
        nwf: uint64 = 0
        pi = 0
        while pi < n_panels and nwf < 4:
            efd2: int32 = sys_open(pw_ev_ptr(pi))
            if efd2 >= 0:
                _wait_efds[nwf] = efd2
                nwf = nwf + 1
            pi = pi + 1
        if nwf == 0:
            # No panel /event fd opened this pass. This was a 30 ms
            # sys_yield() window -- a spin, in the branch taken exactly when
            # there is nothing to be woken by, i.e. the branch that most needs
            # a real sleep. nfds 0 makes sys_waitfds a plain timed wait at the
            # same 30 ms.
            sys_waitfds(&_wait_efds[0], 0, 30)
        else:
            # ~16ms timeout: long enough that an idle panel sits near 0% CPU
            # (it still wakes instantly on input via waitfds_notify), short
            # enough that a Settings config write (which doesn't poke our event
            # fds) is picked up by the per-iteration _cfg_changed poll within
            # one frame — so a widget reorder shows on the LIVE panel at once.
            sys_waitfds(&_wait_efds[0], nwf, 16)
            wi: uint64 = 0
            while wi < nwf:
                sys_close(_wait_efds[wi])
                wi = wi + 1
    return 0

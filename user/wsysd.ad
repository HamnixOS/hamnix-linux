extern def sys_write(fd: int32, buf: Ptr[uint8], count: uint64) -> int64
extern def sys_read(fd: int32, buf: Ptr[uint8], count: uint64) -> int64
extern def sys_read_nb(fd: int32, buf: Ptr[uint8], count: uint64) -> int64
extern def sys_open(path: Ptr[char]) -> int32
extern def sys_open_write(path: Ptr[char]) -> int32
extern def sys_unlink(path: Ptr[char]) -> int32
extern def sys_close(fd: int32) -> int32
extern def sys_lseek(fd: int32, offset: int64, whence: int32) -> int64
extern def sys_waitfds(fds: Ptr[int32], nfds: uint64, timeout_ms: int64) -> int64
extern def sys_get_jiffies() -> uint64
extern def sys_clock_gettime(clockid: int32, tp: Ptr[uint64]) -> int64
extern def sys_exit(code: uint64)
extern def hamwsys_wake_listen() -> int32
extern def hamwsys_wake_drain()
# THE MEDIATOR'S TRANSPORT, stage 1 of docs/wsys_server_design.md. All three
# are inert unless HAMWSYS_SERVER=1. See THE MEDIATOR'S TRANSPORT in
# user/linux-wsys.h for why claim() is separate from listen().
extern def hamwsys_srv_claim()
extern def hamwsys_srv_listen() -> int32
extern def hamwsys_srv_service() -> int32
extern def hamfb_frame_us() -> int32
extern def hamfb_attach_scanout(dmabuf_fd: int32, w: uint32, h: uint32,
                                pitch: uint32) -> int32
extern def hamfb_probe_mode(w: Ptr[uint32], h: Ptr[uint32]) -> int32
# glibc's own getenv. This lane links glibc dynamically (HANDOFF §7.4), so the
# environment is right there and needs no syscall of its own; the only two
# variables read here are the backend overrides.
extern def getenv(name: Ptr[char]) -> Ptr[uint8]

# ====================================================================
# BENCH INSTRUMENTATION
# ====================================================================
# `wsysd -bench N` paints N frames back to back with the window set that is
# up, and reports where the wall clock went. It exists because every choice
# about GPU acceleration here is a claim about a cost, and a claim about a
# cost that has not been measured is a guess. It runs offscreen against
# HAMFB_FILE, so it needs neither a display nor a GPU.
CLOCK_MONOTONIC: int32 = 1
ts_scratch: Array[2, uint64]
bench_on: int32 = 0
# Accumulated microseconds, per phase of a frame.
t_clear:  uint64 = 0                  # desktop background fill
t_scene:  uint64 = 0                  # read /dev/wsys/<wid>/scene
t_rast:   uint64 = 0                  # hamui_host rasterize (the vk2d path)
t_copy:   uint64 = 0                  # window image -> screen composite
t_bb:     uint64 = 0                  # v2 backbuffer read + copy
t_cur:    uint64 = 0                  # cursor
t_pres:   uint64 = 0                  # write the composite to /dev/fb
# NOTE, and it cost a wrong conclusion once: the DEVICE SUBMIT AND FENCE WAIT
# is in none of these phases. On the device-compositing path vkc_end() -- the
# submit and the wait for it -- runs after t_rast has stopped accumulating and
# before present(), so a frame whose phases sum to 0.29 ms actually costs
# 0.29 + submit_us. On the scanout path submit_us is ~2.5 ms and the phases are
# ~0.3 ms, so reading the phase table alone understates the frame by 10x. The
# bench line prints submit_us next to them for exactly this reason; add it.
# THE READBACK, SPLIT OUT OF `present` BY ITSELF.
#
# `present` is open + lseek + the write loop + close + flip, and the claim that
# the GPU path's 67 ms is the CPU READING the composite out of device memory
# rests entirely on the write loop being the whole of it. That is a reading of
# the source until it is a measurement, so it is a measurement: t_pres_w times
# ONLY the sys_write loop, and b_pres_w counts the bytes it moved, so the cost
# can be quoted per frame AND as a bandwidth -- and a bandwidth is the thing
# that can be compared against memcpy out of the same mapping.
#
# If t_pres_w is NOT ~all of t_pres, the diagnosis is wrong and the syscall
# overhead or the flip is the story instead. That is the point of splitting it.
# THE LOOP ITSELF, outside paint_frame(). At a 2 ms fallback both the software
# and the scanout paths land at ~210-220 fps -- a 4.7 ms period -- while the
# frame costs 2.3 ms and 0.23 ms respectively. So most of the period is
# NEITHER the compositor NOR the tick, and nothing measured it.
t_scan:   uint64 = 0                  # scan_windows + pick_focus
t_pub:    uint64 = 0                  # publish_state
t_loop_n: uint64 = 0                  # loop iterations
t_pres_w: uint64 = 0
b_pres_w: uint64 = 0
n_pres_w: uint64 = 0                  # write loop entries (not syscalls)


# ---- THE LIVE PHASE BREAKDOWN, and why -bench could not produce it --------
# `wsysd -bench N` composites with NO WINDOWS: it is a standalone arm that
# scans an empty window table, so paint_window() never runs, the vk router is
# never armed (it is armed inside paint_window for the full-screen backdrop)
# and the device rasterizes nothing. Every -bench number is therefore about
# clear + present and says nothing about a frame with windows in it.
#
# A DRAG is the opposite: every frame is a full repaint of a real window set.
# So the one measurement that could explain a drag gap is exactly the one
# -bench cannot make, and the gap went unexplained for that reason.
#
# HAMNIX_WSYSD_BENCH_LIVE=N turns the same counters on in the LIVE loop and
# dumps them to stderr every N full frames, then resets. It changes no pixels
# and costs two clock_gettime calls per phase, which is what -bench already
# pays.
bench_live_every: int32 = 0
bench_live_n:     int32 = 0
bench_live_seq:   int32 = 0
bench_live_t0:    uint64 = 0          # wall clock at the last dump

# INPUT -> PRESENT, MEASURED INSIDE THE COMPOSITOR.
#
# The two shipped harnesses measure input->pixel by watching the framebuffer
# FILE change. On the scanout path there is no file -- the pixels go straight
# to VRAM the display reads -- so those harnesses cannot see a frame at all and
# reported nothing rather than something wrong. This is the replacement: wsysd
# timestamps the first input event it consumes after a present, and again when
# the frame carrying it has been submitted.
#
# WHAT IT IS AND IS NOT. It is input-read to frame-submitted, in process. It
# does NOT include the scanout hardware's own latency to photons, which is
# bounded by the refresh interval and which nothing here can see. It is
# therefore comparable BETWEEN the two paths -- which is the question -- and is
# not an absolute photon latency. Measured the same way on both, so the
# comparison is fair even though the absolute number is optimistic.
LAT_CAP: uint64 = 256
lat_ring:    Array[256, uint32]       # microseconds
lat_n:       uint64 = 0               # samples this window
lat_pending: uint64 = 0               # us at which the waiting input arrived
lat_sort:    Array[256, uint32]


def env_int(name: Ptr[char]) -> int32:
    v: Ptr[uint8] = getenv(name)
    if cast[uint64](v) == 0:
        return 0
    n: int32 = 0
    i: uint64 = 0
    while v[i] >= 48 and v[i] <= 57:
        n = n * 10 + cast[int32](v[i] - 48)
        i = i + 1
    return n


def now_us() -> uint64:
    ts_scratch[0] = 0
    ts_scratch[1] = 0
    if sys_clock_gettime(CLOCK_MONOTONIC, &ts_scratch[0]) != 0:
        return 0
    return ts_scratch[0] * 1000000 + ts_scratch[1] / 1000

# --- screen -----------------------------------------------------------
# THE COMPOSITE'S CEILING, AND IT IS A RECTANGLE BECAUSE THE DEVICE'S IS.
#
# 2026-08-15: the owner booted a ThinkPad with a 1920x1200 panel -- ordinary
# 16:10 -- and the desktop did not start. This was 1920x1080, read_screen()
# refused, and because it refused the compositor never announced, so
# /dev/wsys/screen never answered and every client died on "no screen
# geometry": one cause, two messages, and only the second one was visible.
#
# COMP_W x COMP_H MUST EQUAL BB_W x BB_H in user/linux-wsys.c. That file argues
# the number (2560x1600: it covers 1920x1080, 1920x1200, 2560x1440 and
# 2560x1600, and stops there because WSYS_CARRY_CAP is a real per-descriptor
# allocation ceiling a client can drive). This is a SECOND COPY of it, kept
# because Adder cannot include a C header -- and a second copy of a constant is
# exactly how the 1920x1080 above outlived the panel it was picked for. So it is
# not trusted: the device publishes `maxsurface <w>x<h>` on /dev/wsys/pool for
# this purpose and check_maxsurface() below reads it back at startup.
#
# THE ARRAY IS A CEILING, NOT A COST. Every read and write of the composite in
# this file is addressed through scr_w/scr_h -- rasterize clips to them (line
# ~950), the row address is y*scr_w (line ~900), and present_rows() writes
# scr_h rows of scr_w*4 bytes. MAX_PIXELS appears in exactly three places and
# all three are capacity checks. So the tail of this array past the actual
# screen is never touched, and BSS that is never touched is never resident:
# raising it from 8.29 MB to 16.38 MB costs address space, and the resident
# cost stays scr_w*scr_h*4 -- 9.2 MB on his panel.
COMP_W: int32 = 2560
COMP_H: int32 = 1600
MAX_PIXELS: uint64 = 4096000           # COMP_W * COMP_H
composite:  Array[16384000, uint8]     # MAX_PIXELS * 4, BGRX as /dev/fb wants
# EVERY read and write of the screen composite goes through this address, and
# it is the whole of the zero-copy story: it is `composite` normally, and it
# is the GPU-resident frame returned by vk_linux_frame_alloc() when the vk
# backend is armed. Nothing else in the file changes between the two cases --
# the rasterizer, the cursor save-under and present() all just address the
# buffer the device is also writing, so a routed frame costs no upload and no
# readback. Set once, in vk_arm(), before the first frame.
comp_base:  uint64 = 0
scr_w: int32 = 0
scr_h: int32 = 0
scr_pitch: int32 = 0

# --- the window set ---------------------------------------------------
# TWO HUNDRED AND FIFTY-SIX, because that is how many windows the device
# holds. This used to be 32 while /dev/wsys held 32, which agreed by
# accident; when the device's table was raised to 128 for rootless Xwayland
# this array was the next silent ceiling in the chain -- a 33rd window would
# have existed, been listed, and never been PAINTED, which is the exact
# failure the backbuffer pool was just fixed for. The two numbers are the
# same number and tests/linux/wsyswl_ceiling.sh is what keeps them so.
#
# It moved again with WSYS_MAX_WINDOWS 128 -> 256 (user/linux-wsys.c, for
# user/wsyswl.ad's MAXCONN 16), and again 256 -> 512 for MAXCONN 32, which is
# what makes TWO BROWSERS fit. So did `dirbuf` below, which is the OTHER
# place a window count is compiled into this file and the easier one to
# miss: it is the buffer /dev/wsys's directory listing is slurped into, and
# a listing that does not fit is silently truncated -- the compositor would
# simply never see the windows past the cut, with every return code 0.
MAX_WIN: uint64 = 512
win_id:  Array[512, int32]
win_x:   Array[512, int32]
win_y:   Array[512, int32]
win_w:   Array[512, int32]
win_h:   Array[512, int32]
win_z:   Array[512, int32]
win_dec: Array[512, int32]
win_vis: Array[512, int32]
win_gen: Array[512, int32]
win_bbgen: Array[512, int32]
# The named-image content serial, field 12 of <wid>/ctl. It is in the frame
# signature below because a re-uploaded image leaves the scene text identical:
# without it a video's picture freezes on frame one and nothing says so.
win_imggen: Array[512, int32]
win_proto: Array[512, int32]
# devwsys's `keyed` and `blend`, fields 13 and 14 of <wid>/ctl. See the long
# note on blit_window_image_keyed below for what each one is FOR; both were
# ignored by this port while the clients that need them were already asking.
win_keyed: Array[512, int32]
win_blend: Array[512, int32]
n_win:   uint64 = 0

# --- window titles ----------------------------------------------------
# EVERY window on this desktop had a title bar and NONE of them had a name on
# it, for the whole life of this compositor. Three terminals were three
# identical grey bars. The title was never missing -- the device has held it
# per window since the port began (user/linux-wsys.c, `title` on <wid>/ctl,
# capped at 64 bytes) and publishes it; nothing here read it.
#
# WHERE IT IS READ FROM, and why not <wid>/ctl. /dev/wsys/<wid>/ctl is a fixed
# vector of integers parsed positionally with take_int, and a title contains
# spaces: appending it would make the field after it unparseable and there is
# no field after it to hide behind. /dev/wsys/windows is the file the device
# already publishes for exactly this -- "<wid> <title>\n" per VISIBLE,
# DECORATED window, which is precisely the set that has a title bar -- and it
# is what hampanelscene's taskbar already reads. One read per frame for the
# whole set, not one per window.
#
# IT IS UNTRUSTED INPUT AND IS TREATED AS SUCH. The window table lives in
# /srv/wsys, segment A, mode 0666, and it has to: an unprivileged session must
# be able to map its own windows. user/linux-wsys.c says so in as many words
# above chrome_attach() -- "a bypasser can retitle another client's window".
# So any uid on this machine can put any 63 bytes it likes on any window's
# title bar, including this one's. Everything that bounds what that can do is
# in title_build() and title_draw() below, and is stated there.
WSYSD_TITLE_CAP: uint64 = 64
win_title: Array[32768, uint8]         # MAX_WIN * WSYSD_TITLE_CAP
winsbuf:   Array[41984, uint8]         # /dev/wsys/windows: MAX_WIN * (64 + 18)
# The sanitized run actually drawn: the title's 63 bytes plus room for an
# ellipsis and a NUL. NOT a frame local -- a buffer this size on the stack is
# the shape that has broken this tree before.
titlebuf:  Array[80, uint8]

# --- scratch ----------------------------------------------------------
pathbuf:  Array[128, uint8]
dirbuf:   Array[8192, uint8]        # MAX_WIN wids + the fixed leaves
ctlbuf:   Array[256, uint8]
# ONE BYTE LARGER THAN THE PRODUCER'S CAP, AND THAT BYTE IS THE POINT.
#
# slurp() reads at most `cap - 1` and spends the last byte on a NUL
# terminator, which is a coherent contract and one its five other callers
# rely on. This buffer was sized at exactly WSYS_SCENE_CAP (16384, the
# largest display list user/linux-wsys.c will store), so the NUL ate the
# last byte: a scene of exactly 16384 bytes came back as 16383, silently,
# with no flag and a short read indistinguishable from a complete one. A
# scene is a line-oriented grammar, so the byte lost is the end of the last
# op.
#
# FIXED AT THE CALLER RATHER THAN IN slurp, deliberately: slurp is shared,
# and removing its NUL would break every caller that relies on it to end a
# string. The defect was never slurp's contract -- it was asking slurp for
# room it had already promised to spend. tests/test_slurp_cap.ad holds the
# boundary (cap-1, cap, cap+1); only the exactly-at-cap case ever failed.
SCENEBUF_CAP: uint64 = 16385          # WSYS_SCENE_CAP + 1 for slurp's NUL
scenebuf: Array[16385, uint8]
numbuf:   Array[24, uint8]
# The startup-refusal text, composed ONCE and written to both fd 2 and
# /tmp/hamnix-wsysd.fault so the two cannot drift into telling different
# stories. See screen_fault().
faultbuf: Array[1024, uint8]
inbuf:    Array[256, uint8]
inpath:   Array[256, uint8]            # HAMWSYSD_INPUT, see open_inputs

# --- the wait set: WHAT WAKES THE COMPOSITOR --------------------------
# This array was `Array[4, int32]`, was never written, and was passed with
# nfds LITERALLY 0. So the main loop was a fixed 16 ms sleep that no input
# could cut short, and input-to-pixel latency was measured at p50 8.9 ms /
# p95 16.1 (tests/linux/de_fps_latency.sh, 150 trials) against a composite
# that costs 0.6 ms and a pointer-only frame that costs 5 us. 93% of what a
# person felt was this line.
#
# THE BOUND. One slot per input device (MAX_INPUT is 12 -- open_inputs scans
# /dev/input/event0..15 and stops at 12) plus one for stdin, which is the only
# keyboard a serial boot has. 13 rounded to 16, and 16 is checked against
# sys_waitfds's own WAITFDS_MAX of 64 with room to spare; nothing here scales
# with the number of CLIENTS, so this does not move when MAXCONN does.
#
# WHAT IS NOT IN IT, STATED RATHER THAN WORKED AROUND. A CLIENT REPAINT
# CANNOT WAKE THIS LOOP. wsysd learns that a window changed by re-reading
# /dev/wsys/<wid>/ctl and comparing a signature (frame_signature below), and
# a snapshot file under /dev/wsys is "ready" by definition -- sys_waitfds
# counts it ready without sleeping, which would turn this park into a spin.
# The /dev/wsys thing that CAN be waited on is a per-window event RING, and
# putting one in this set would be strictly worse than the tick it replaced:
# a set holding a ring sleeps in the futex on `inputgen` and caps its poll at
# 20 ms (user/linux-syscalls.c says so at length), and an evdev fd cannot
# futex-wake anything -- so mixing the two would make INPUT wait up to 20 ms
# instead of waking the loop at once. This set is therefore ALL ORDINARY FDS,
# which is the one shape sys_waitfds answers with a single uncapped poll(2).
# Client repaints keep the 16 ms fallback below, and that is a real remaining
# cost: a window that redraws still waits up to a tick to be composited.
WAITSET_CAP: uint64 = 16
WAIT_FALLBACK_MS: int64 = 16           # the fallback tick, not the pacer
waitset:  Array[16, int32]
n_wait:   uint64 = 0
probefd:  Array[1, int32]

fb_fd: int32 = -1
fbctl_fd: int32 = -1                   # persistent write fd to /dev/fbctl
fbctl_tried: int32 = 0                 # ... opened once, failure is permanent
focus_wid: int32 = 0
last_sig: uint64 = 0                   # change signature of the last frame
last_csig: uint64 = 0                  # ... of the cursor position alone
n_curframes: int32 = 0                 # frames served by the cursor-only path
highest_wid: int32 = 0                 # the newest window we have seen
n_frames: int32 = 0
n_keys:   int32 = 0
n_ptr:    int32 = 0
verbose: int32 = 0

# --- input ------------------------------------------------------------
# One fd per /dev/input/eventN we could open. evdev hands us 24-byte records
# (struct input_event: 16 bytes of timeval, then u16 type, u16 code, s32
# value) and we decode them here rather than teaching the userland about
# Linux input -- exactly the split devwsys.ad has, where the kernel turns
# scancodes into the bytes a window's /keys ring carries.
MAX_INPUT: uint64 = 12
in_fd:   Array[12, int32]
n_input: uint64 = 0
evbuf:   Array[2400, uint8]            # 100 events per read

ptr_x: int32 = 0
ptr_y: int32 = 0
ptr_btn: int32 = 0
ptr_dz: int32 = 0
ptr_moved: int32 = 0
ptr_edge: int32 = 0                    # a button changed state this poll
cursor_dirty: int32 = 1

# Keycode -> ASCII, unshifted and shifted. Indexed by the evdev KEY_* code.
# This is the table atkbd_process_byte owns in the Hamnix kernel; on Linux the
# kernel stops at the keycode, so the translation lives here.
kmap:   Array[128, uint8]
kshift: Array[128, uint8]
shift_down: int32 = 0
ctrl_down:  int32 = 0


# ====================================================================
# tiny helpers
# ====================================================================
def slen(s: Ptr[uint8]) -> uint64:
    n: uint64 = 0
    while s[n] != 0:
        n = n + 1
    return n


def puts(fd: int32, s: Ptr[uint8]):
    sys_write(fd, s, slen(s))


def putd(fd: int32, v: int32):
    if v < 0:
        puts(fd, "-")
        putd(fd, 0 - v)
        return
    n: uint64 = 0
    x: int32 = v
    if x == 0:
        numbuf[0] = 48
        n = 1
    while x > 0:
        numbuf[n] = cast[uint8](48 + x % 10)
        x = x / 10
        n = n + 1
    i: uint64 = n
    while i > 0:
        i = i - 1
        sys_write(fd, &numbuf[i], 1)


def emit_int(buf: Ptr[uint8], at: uint64, v: int32) -> uint64:
    i: uint64 = at
    if v < 0:
        buf[i] = 45
        i = i + 1
        return emit_int(buf, i, 0 - v)
    d: Array[12, uint8]
    n: uint64 = 0
    x: int32 = v
    if x == 0:
        d[0] = 48
        n = 1
    while x > 0:
        d[n] = cast[uint8](48 + x % 10)
        x = x / 10
        n = n + 1
    while n > 0:
        n = n - 1
        buf[i] = d[n]
        i = i + 1
    return i


# Parse the next signed decimal from buf[*p..n); returns -2147483647 when
# there is no number left (a value no field here ever takes).
NOVAL: int32 = -2147483647

def take_int(buf: Ptr[uint8], p: Ptr[uint64], n: uint64) -> int32:
    i: uint64 = p[0]
    while i < n and (buf[i] == 32 or buf[i] == 9):
        i = i + 1
    neg: int32 = 0
    if i < n and buf[i] == 45:
        neg = 1
        i = i + 1
    if i >= n or buf[i] < 48 or buf[i] > 57:
        p[0] = i
        return NOVAL
    v: int32 = 0
    while i < n and buf[i] >= 48 and buf[i] <= 57:
        v = v * 10 + cast[int32](buf[i]) - 48
        i = i + 1
    p[0] = i
    if neg != 0:
        return 0 - v
    return v


def winpath(wid: int32, leaf: Ptr[uint8]):
    i: uint64 = 0
    p: Ptr[uint8] = "/dev/wsys/"
    k: uint64 = 0
    while p[k] != 0:
        pathbuf[i] = p[k]
        i = i + 1
        k = k + 1
    i = emit_int(&pathbuf[0], i, wid)
    pathbuf[i] = 47
    i = i + 1
    k = 0
    while leaf[k] != 0:
        pathbuf[i] = leaf[k]
        i = i + 1
        k = k + 1
    pathbuf[i] = 0


def slurp(path: Ptr[char], out: Ptr[uint8], cap: uint64) -> int64:
    fd: int32 = sys_open(path)
    if fd < 0:
        return -1
    total: uint64 = 0
    while total < cap - 1:
        k: int64 = sys_read(fd, &out[total], cap - 1 - total)
        if k <= 0:
            break
        total = total + cast[uint64](k)
    sys_close(fd)
    out[total] = 0
    return cast[int64](total)


def write_path(path: Ptr[char], data: Ptr[uint8]) -> int32:
    fd: int32 = sys_open_write(path)
    if fd < 0:
        return -1
    sys_write(fd, data, slen(data))
    sys_close(fd)
    return 0


# ====================================================================
# the screen
# ====================================================================
# THE STARTUP FAULT, WRITTEN WHERE A PERSON WITH NO SHELL CAN FIND IT
# --------------------------------------------------------------------
# On 2026-08-15 the compositor refused to start and printed, in full:
#
#     wsysd: screen larger than the composite buffer
#
# and the desktop -- the only thing the owner could see -- printed
#
#     Fatal: no screen geometry. /dev/wsys/screen never answered
#
# Both are true. Neither says a number, neither names the other, and the second
# one is the only one anybody saw, because the first is printed by a program
# nothing had run yet. The owner learned the real cause by running `wsysd` by
# hand; a person with no shell would have been stuck with a black screen.
#
# So a refusal to start now lands in THREE places, and the reason is the same
# text in all three:
#
#   1. fd 2. Since user/linux-syscalls.c:consmirror, every console write is
#      copied into /dev/kmsg at <7>, which user/bootlogd.ad snapshots into
#      \HAMNIX.LOG on the FAT ESP. That is the file he can unplug and hand us
#      after a failed boot, and it costs nothing here to reach it: writing to
#      the console IS writing to the boot log.
#   2. /tmp/hamnix-wsysd.fault, so a program that starts LATER can quote it.
#      lib/hamscreen.ad reads exactly this file, which is how "the compositor
#      has not published a geometry" becomes "and here is why it did not".
#   3. the return value, so the caller stops.
def screen_fault(msg: Ptr[uint8], a: int32, b: int32, c: int32, d: int32):
    i: uint64 = 0
    k: uint64 = 0
    p: Ptr[uint8] = "wsysd: FATAL: "
    while p[k] != 0:
        faultbuf[i] = p[k]
        i = i + 1
        k = k + 1
    k = 0
    while msg[k] != 0:
        faultbuf[i] = msg[k]
        i = i + 1
        k = k + 1
    # "<a>x<b>" then " ... " then "<c>x<d>": the two rectangles the refusal
    # knows about. It knows BOTH -- it compared them -- so it says both. The
    # old line said neither, which is why a photograph of the screen was not
    # enough and a shell was.
    p = " -- this screen is "
    k = 0
    while p[k] != 0:
        faultbuf[i] = p[k]
        i = i + 1
        k = k + 1
    i = emit_int(&faultbuf[0], i, a)
    faultbuf[i] = 120
    i = i + 1
    i = emit_int(&faultbuf[0], i, b)
    p = " and the composite buffer holds "
    k = 0
    while p[k] != 0:
        faultbuf[i] = p[k]
        i = i + 1
        k = k + 1
    i = emit_int(&faultbuf[0], i, c)
    faultbuf[i] = 120
    i = i + 1
    i = emit_int(&faultbuf[0], i, d)
    p = ". The compositor is NOT starting, so /dev/wsys/screen will never answer and every client will report `no screen geometry` -- that message is this one's symptom. Raise COMP_W/COMP_H in user/wsysd.ad and BB_W/BB_H in user/linux-wsys.c together.\n"
    k = 0
    while p[k] != 0:
        faultbuf[i] = p[k]
        i = i + 1
        k = k + 1
    faultbuf[i] = 0
    # fd 2 first: it is the one that reaches the boot log, and it must happen
    # even if /tmp is read-only or absent.
    sys_write(2, &faultbuf[0], i)
    write_path(cast[Ptr[char]]("/tmp/hamnix-wsysd.fault"), &faultbuf[0])


# --------------------------------------------------------------------
# THE DEVICE STATES ITS OWN CEILING; THIS READS IT BACK RATHER THAN AGREEING
# WITH IT BY HAND.
#
# COMP_W/COMP_H above are a second copy of BB_W/BB_H in user/linux-wsys.c, and
# a second copy of a constant is precisely how a 1920x1080 ceiling outlived the
# panel it was picked for. /dev/wsys/pool publishes `maxsurface <w>x<h>` -- its
# comment says, in as many words, that it exists because "everybody who needed
# the number had their own copy of it and one of them was wrong". So: read it.
#
# THIS DOES NOT REFUSE TO START. A disagreement means windows are clipped at
# one number and the screen at another, which is a bug to be told about, not a
# reason to leave a machine with no desktop -- the whole complaint being fixed
# here is a compositor that refused to run over a number. It is LOUD instead.
#
# ONE SIDE EFFECT, NAMED BECAUSE IT WAS MEASURED RATHER THAN INTENDED: reading
# /dev/wsys/pool runs snap_pool, which calls bb_attach, so the backbuffer
# accounting segment is now created at STARTUP instead of when the first v2
# window appears. It is 65,536 bytes (BB_HDR_BYTES; no pixels have lived there
# since the pixel-out rewrite) and it is created by the segment's OWNER, which
# is the process that should own it -- previously whichever client made the
# first v2 window got there first. Measured green afterwards: install_from_usb
# 75/0, wsys_srv_deboot 36/0, de_appmenu_brisk 17/0, de_appmenu_band 11/0.
def check_maxsurface():
    n: int64 = slurp(cast[Ptr[char]]("/dev/wsys/pool"), &ctlbuf[0], 200)
    if n <= 0:
        return
    # Find "maxsurface " and take "<w>x<h>" after it.
    i: uint64 = 0
    lim: uint64 = cast[uint64](n)
    found: uint64 = 0
    hit: int32 = 0
    while i + 11 <= lim:
        if ctlbuf[i] == 109 and ctlbuf[i+1] == 97 and ctlbuf[i+2] == 120 \
           and ctlbuf[i+3] == 115 and ctlbuf[i+4] == 117 and ctlbuf[i+5] == 114 \
           and ctlbuf[i+6] == 102 and ctlbuf[i+7] == 97 and ctlbuf[i+8] == 99 \
           and ctlbuf[i+9] == 101 and ctlbuf[i+10] == 32:
            found = i + 11
            hit = 1
        i = i + 1
    if hit == 0:
        return
    pos: Array[1, uint64]
    pos[0] = found
    dw: int32 = take_int(&ctlbuf[0], &pos[0], lim)
    # take_int stops on the 'x'; step over it and take the height.
    if pos[0] < lim and ctlbuf[pos[0]] == 120:
        pos[0] = pos[0] + 1
    dh: int32 = take_int(&ctlbuf[0], &pos[0], lim)
    if dw == COMP_W and dh == COMP_H:
        return
    if dw == NOVAL or dh == NOVAL:
        return
    puts(2, "wsysd: WARNING: the device says its largest surface is ")
    putd(2, dw)
    puts(2, "x")
    putd(2, dh)
    puts(2, " but this compositor's composite buffer is ")
    putd(2, COMP_W)
    puts(2, "x")
    putd(2, COMP_H)
    puts(2, " -- COMP_W/COMP_H in user/wsysd.ad and BB_W/BB_H in user/linux-wsys.c have drifted apart. Windows will be clipped at one number and the screen bounded by the other.\n")


def read_screen() -> int32:
    # "/dev/fb" answers "W H PITCH BPP PIXFMT\n" to a read. Opening it FOR
    # WRITING is what suspends the text console (user/linux-fb.c), so the
    # geometry read is a separate, read-only open — exactly as hamUId does it.
    n: int64 = slurp(cast[Ptr[char]]("/dev/fb"), &ctlbuf[0], 256)
    if n <= 0:
        puts(2, "wsysd: cannot read /dev/fb geometry\n")
        return -1
    pos: Array[1, uint64]
    pos[0] = 0
    scr_w = take_int(&ctlbuf[0], &pos[0], cast[uint64](n))
    scr_h = take_int(&ctlbuf[0], &pos[0], cast[uint64](n))
    scr_pitch = take_int(&ctlbuf[0], &pos[0], cast[uint64](n))
    if scr_w <= 0 or scr_h <= 0:
        puts(2, "wsysd: /dev/fb geometry is not sane\n")
        return -1
    # PER AXIS, NOT BY AREA, and the old check was by area. `w*h > MAX_PIXELS`
    # let a 4096x500 panel through to be silently clipped at BB_W by every
    # window's backbuffer, and it refused 1920x1200 with a message that named
    # neither number. The clamps this ceiling exists to agree with
    # (bb_clamp_w/bb_clamp_h in user/linux-wsys.c) are per axis, so this is too;
    # w <= COMP_W and h <= COMP_H also implies w*h <= MAX_PIXELS, so the array
    # bound is still covered by the same test.
    if scr_w > COMP_W or scr_h > COMP_H:
        screen_fault("the screen is larger than the composite buffer",
                     scr_w, scr_h, COMP_W, COMP_H)
        return -1
    return 0


def announce_screen():
    i: uint64 = 0
    p: Ptr[uint8] = "screen "
    k: uint64 = 0
    while p[k] != 0:
        ctlbuf[i] = p[k]
        i = i + 1
        k = k + 1
    i = emit_int(&ctlbuf[0], i, scr_w)
    ctlbuf[i] = 32
    i = i + 1
    i = emit_int(&ctlbuf[0], i, scr_h)
    ctlbuf[i] = 10
    i = i + 1
    ctlbuf[i] = 0
    write_path(cast[Ptr[char]]("/dev/wsys/ctl"), &ctlbuf[0])


# ====================================================================
# the window set
# ====================================================================
def load_window(wid: int32) -> int32:
    winpath(wid, "ctl")
    n: int64 = slurp(cast[Ptr[char]](&pathbuf[0]), &ctlbuf[0], 256)
    if n <= 0:
        return 0
    pos: Array[1, uint64]
    pos[0] = 0
    cap: uint64 = cast[uint64](n)
    id: int32 = take_int(&ctlbuf[0], &pos[0], cap)
    if id != wid:
        return 0
    i: uint64 = n_win
    win_id[i]  = id
    win_x[i]   = take_int(&ctlbuf[0], &pos[0], cap)
    win_y[i]   = take_int(&ctlbuf[0], &pos[0], cap)
    win_w[i]   = take_int(&ctlbuf[0], &pos[0], cap)
    win_h[i]   = take_int(&ctlbuf[0], &pos[0], cap)
    win_z[i]   = take_int(&ctlbuf[0], &pos[0], cap)
    win_dec[i] = take_int(&ctlbuf[0], &pos[0], cap)
    win_vis[i] = take_int(&ctlbuf[0], &pos[0], cap)
    win_proto[i] = take_int(&ctlbuf[0], &pos[0], cap)
    win_gen[i]   = take_int(&ctlbuf[0], &pos[0], cap)
    win_bbgen[i] = take_int(&ctlbuf[0], &pos[0], cap)
    win_imggen[i] = take_int(&ctlbuf[0], &pos[0], cap)
    win_keyed[i] = take_int(&ctlbuf[0], &pos[0], cap)
    win_blend[i] = take_int(&ctlbuf[0], &pos[0], cap)
    # A device that predates these two fields answers -1 for both, which is
    # neither keyed nor blended -- the old behaviour, exactly.
    if win_keyed[i] < 0:
        win_keyed[i] = 0
    if win_blend[i] < 0:
        win_blend[i] = 0
    n_win = n_win + 1
    return 1


def scan_windows():
    # /dev/wsys is a directory: a packed "NAME\n" stream of the fixed leaves
    # plus one line per live wid. The numeric lines are the windows.
    n_win = 0
    n: int64 = slurp(cast[Ptr[char]]("/dev/wsys"), &dirbuf[0], 8192)
    if n <= 0:
        return
    i: uint64 = 0
    cap: uint64 = cast[uint64](n)
    while i < cap and n_win < MAX_WIN:
        if dirbuf[i] >= 48 and dirbuf[i] <= 57:
            pos: Array[1, uint64]
            pos[0] = i
            wid: int32 = take_int(&dirbuf[0], &pos[0], cap)
            i = pos[0]
            if wid > 0:
                load_window(wid)
        while i < cap and dirbuf[i] != 10:
            i = i + 1
        if i < cap:
            i = i + 1
    # z-order ascending (insertion sort; MAX_WIN at most, and the set
    # changes rarely).
    a: uint64 = 1
    while a < n_win:
        b: uint64 = a
        while b > 0 and win_z[b - 1] > win_z[b]:
            t: int32 = win_z[b - 1]
            win_z[b - 1] = win_z[b]
            win_z[b] = t
            t = win_id[b - 1]
            win_id[b - 1] = win_id[b]
            win_id[b] = t
            t = win_x[b - 1]
            win_x[b - 1] = win_x[b]
            win_x[b] = t
            t = win_y[b - 1]
            win_y[b - 1] = win_y[b]
            win_y[b] = t
            t = win_w[b - 1]
            win_w[b - 1] = win_w[b]
            win_w[b] = t
            t = win_h[b - 1]
            win_h[b - 1] = win_h[b]
            win_h[b] = t
            t = win_dec[b - 1]
            win_dec[b - 1] = win_dec[b]
            win_dec[b] = t
            t = win_vis[b - 1]
            win_vis[b - 1] = win_vis[b]
            win_vis[b] = t
            t = win_gen[b - 1]
            win_gen[b - 1] = win_gen[b]
            win_gen[b] = t
            t = win_bbgen[b - 1]
            win_bbgen[b - 1] = win_bbgen[b]
            win_bbgen[b] = t
            t = win_imggen[b - 1]
            win_imggen[b - 1] = win_imggen[b]
            win_imggen[b] = t
            t = win_proto[b - 1]
            win_proto[b - 1] = win_proto[b]
            win_proto[b] = t
            t = win_keyed[b - 1]
            win_keyed[b - 1] = win_keyed[b]
            win_keyed[b] = t
            t = win_blend[b - 1]
            win_blend[b - 1] = win_blend[b]
            win_blend[b] = t
            b = b - 1
        a = a + 1
    # Reclaim cache slots whose window is gone. A wid is reused, and a cache
    # that kept a dead window's pictures would both leak all sixteen slots to
    # churn and hand a recycled wid a picture it never uploaded.
    c: uint64 = 0
    while c < WSYSD_IMG_SLOTS:
        if imgc_used[c] != 0:
            live: int32 = 0
            q: uint64 = 0
            while q < n_win:
                if win_id[q] == imgc_wid[c]:
                    live = 1
                q = q + 1
            if live == 0:
                forget_window_images(imgc_wid[c])
        c = c + 1
    # AFTER the z-sort, and keyed by wid rather than by slot. The sort above
    # permutes every parallel array by hand; a title array swapped in that
    # chain is one more line to forget, and forgetting it would put one
    # window's name on another window's bar -- which is worse than no name at
    # all, because it is confidently wrong. Loading by wid afterwards cannot
    # have that bug.
    scan_titles()


# Fill win_title[] from /dev/wsys/windows, the device's published
# "<wid> <title>\n" list. Every slot is cleared first: a window that has no
# title, or that this read did not mention, must come back with an EMPTY
# name, not the name of whoever held that slot last.
def scan_titles():
    i: uint64 = 0
    while i < n_win:
        win_title[i * WSYSD_TITLE_CAP] = 0
        i = i + 1
    n: int64 = slurp(cast[Ptr[char]]("/dev/wsys/windows"), &winsbuf[0], 41984)
    if n <= 0:
        return
    cap: uint64 = cast[uint64](n)
    p: uint64 = 0
    while p < cap:
        # "<wid> <title>\n". take_int stops at the space; the rest of the line
        # up to the newline is the title, verbatim -- it is sanitized where it
        # is DRAWN, not here, so that what wsysd holds is what the device said.
        pos: Array[1, uint64]
        pos[0] = p
        wid: int32 = take_int(&winsbuf[0], &pos[0], cap)
        q: uint64 = pos[0]
        if q < cap and winsbuf[q] == 32:
            q = q + 1
        slot: int64 = -1
        if wid > 0:
            slot = win_index(wid)
        k: uint64 = 0
        while q < cap and winsbuf[q] != 10:
            if slot >= 0 and k < WSYSD_TITLE_CAP - 1:
                win_title[cast[uint64](slot) * WSYSD_TITLE_CAP + k] = winsbuf[q]
                k = k + 1
            q = q + 1
        if slot >= 0:
            win_title[cast[uint64](slot) * WSYSD_TITLE_CAP + k] = 0
        p = q
        if p < cap:
            p = p + 1


def frame_signature() -> uint64:
    # FNV-1a over everything that can change what the screen looks like. The
    # scene GENERATION is in here, so a window that repainted without moving
    # still forces a frame -- and a desktop where nothing happened costs one
    # directory read, not a rasterization.
    h: uint64 = 14695981039346656037
    i: uint64 = 0
    while i < n_win:
        vals: Array[11, int32]
        vals[0] = win_id[i]
        vals[1] = win_x[i]
        vals[2] = win_y[i]
        vals[3] = win_w[i]
        vals[4] = win_h[i]
        vals[5] = win_z[i]
        vals[6] = win_dec[i]
        vals[7] = win_vis[i]
        vals[8] = win_gen[i]
        vals[9] = win_bbgen[i]
        vals[10] = win_imggen[i]
        k: uint64 = 0
        while k < 11:
            h = h ^ cast[uint64](cast[uint32](vals[k]))
            h = h * 1099511628211
            k = k + 1
        # THE TITLE IS PART OF WHAT THE SCREEN LOOKS LIKE, so it has to be in
        # here. `title Foo` moves nothing, resizes nothing and commits no
        # scene: it bumps the device's gen and NOTHING ELSE in this hash. A
        # retitle would have been read, stored, and never painted until some
        # unrelated change happened to force a frame -- a title that updates
        # when you wiggle the mouse is a worse bug than one that never
        # updates, because it looks intermittent.
        t: uint64 = 0
        while t < WSYSD_TITLE_CAP:
            c: uint8 = win_title[i * WSYSD_TITLE_CAP + t]
            h = h ^ cast[uint64](c)
            h = h * 1099511628211
            if c == 0:
                t = WSYSD_TITLE_CAP
            else:
                t = t + 1
        i = i + 1
    h = h ^ cast[uint64](n_win)
    h = h * 1099511628211
    # The focus ring is drawn in the decoration colour, so a focus change is a
    # change to the screen even when no window moved.
    h = h ^ cast[uint64](cast[uint32](focus_wid))
    h = h * 1099511628211
    return h


# The cursor is composited, so moving it IS a change to the screen -- but it is
# a change nothing else in the frame depends on, and it is by far the most
# frequent one. It is hashed SEPARATELY from the window set so the main loop
# can tell "only the pointer moved" (the cheap incremental path) from "a window
# changed" (the full repaint). Folding the two together, as this used to, is
# what made a one-pixel mouse move cost a whole frame.
def cursor_signature() -> uint64:
    h: uint64 = 14695981039346656037
    h = h ^ cast[uint64](cast[uint32](ptr_x))
    h = h * 1099511628211
    h = h ^ cast[uint64](cast[uint32](ptr_y))
    h = h * 1099511628211
    return h


# ====================================================================
# painting
# ====================================================================
def put_px(x: int32, y: int32, rgb: uint32):
    if x < 0 or y < 0 or x >= scr_w or y >= scr_h:
        return
    o: uint64 = comp_base + (cast[uint64](y) * cast[uint64](scr_w)
                             + cast[uint64](x)) * 4
    # /dev/fb is XRGB8888 little-endian: the bytes in memory are B, G, R, X.
    cast[Ptr[uint8]](o)[0] = cast[uint8](rgb & 255)
    cast[Ptr[uint8]](o + 1)[0] = cast[uint8]((rgb >> 8) & 255)
    cast[Ptr[uint8]](o + 2)[0] = cast[uint8]((rgb >> 16) & 255)
    cast[Ptr[uint8]](o + 3)[0] = 0


# The composite as 32-bit words. /dev/fb is XRGB8888 little-endian, so ONE
# word store lays down the same four bytes B,G,R,X that four byte stores did --
# and the compiler cannot prove that for itself through the uint8 array, which
# is why the fills below reach for the word view explicitly.
# THE RASTERIZE TARGET, which is not always the composite.
#
# hamui_host_begin_into() needs a CPU-addressable surface, and so does the
# vk_2d router -- it uses the base address to decide "is this op aimed at the
# screen?", which is a three-integer compare and nothing more. On the SCANOUT
# path the composite has no CPU address at all, so passing comp_base (0) makes
# begin_into fail, the `direct` path is abandoned, and the full-screen
# backdrop is instead rasterized on the CPU and staged into the device arena:
# 8 MiB of memcpy per frame, measured as `copy` 1.6-2.0 ms with `rast` at
# 10-12 ms. That is the whole win handed back.
#
# So on the scanout path the ROUTER'S IDENTITY is the host composite array
# while the ops it routes land on the device frame. The address is only ever
# compared, never written, when every op is encodable.
def rast_target() -> uint64:
    if vk_scanout != 0:
        return cast[uint64](&composite[0])
    return comp_base


def comp_words() -> Ptr[uint32]:
    return cast[Ptr[uint32]](comp_base)


def fill_rect(x: int32, y: int32, w: int32, h: int32, rgb: uint32):
    # Clip the WHOLE rectangle once, then run a word-store span per row. The
    # old shape called put_px per pixel, which re-clipped and did four byte
    # stores every time: at full screen that is 1.02 ms of a 5.3 ms frame
    # spent proving 1,024,000 times that the screen is still the same size.
    x0: int32 = x
    y0: int32 = y
    x1: int32 = x + w
    y1: int32 = y + h
    if x0 < 0:
        x0 = 0
    if y0 < 0:
        y0 = 0
    if x1 > scr_w:
        x1 = scr_w
    if y1 > scr_h:
        y1 = scr_h
    if x1 <= x0 or y1 <= y0:
        return
    # SITE 1 of 5. With device compositing the fill is a device op and the CPU
    # never touches the composite. The device does its own clipping, so the
    # clipped x0/y0/x1/y1 above are passed rather than the raw rect purely so
    # the two paths agree exactly at the edges.
    if vk_devcomp != 0:
        # vk_2d's colour convention is 0xRRGGBBAA; wsysd's is 0x00RRGGBB.
        vk_linux_fill_rect(0, x0, y0, x1 - x0, y1 - y0,
                           ((rgb & 16777215) << 8) | 255)
        return
    # The X byte is 0, exactly as put_px wrote it.
    word: uint32 = rgb & 16777215
    dst: Ptr[uint32] = comp_words()
    j: int32 = y0
    while j < y1:
        wo: uint64 = cast[uint64](j) * cast[uint64](scr_w) + cast[uint64](x0)
        i: int32 = x0
        while i < x1:
            dst[wo] = word
            wo = wo + 1
            i = i + 1
        j = j + 1


# Is the whole screen already covered by an OPAQUE window? Then clearing it
# first is pure waste -- and it is not a corner case: a session's backdrop
# (hamdesktop) is exactly a visible, undecorated, full-screen window at z 0,
# so on a real desktop the clear is ALWAYS waste. Only scene windows count:
# hamui_host_begin() opens every rasterize with an opaque full-image fill, so
# a scene window's image has no holes. A v2 window's backbuffer can be short
# (a client that has not blitted every row yet), so those do not qualify.
def screen_is_covered() -> int32:
    i: uint64 = 0
    while i < n_win:
        if win_vis[i] != 0 and win_proto[i] != 2:
            if win_x[i] <= 0 and win_y[i] <= 0:
                if win_x[i] + win_w[i] >= scr_w and win_y[i] + win_h[i] >= scr_h:
                    return 1
        i = i + 1
    return 0


def clear_desktop():
    # A flat slate blue, so an empty desktop is obviously the compositor's and
    # not a stale text console.
    if screen_is_covered() != 0:
        return
    fill_rect(0, 0, scr_w, scr_h, 2110280)              # 0x203348


# ====================================================================
# THE VULKAN BACKEND: the gate, the zero-copy binding, and the op router
# ====================================================================
# See the header. Three things live here and nothing else in the file knows
# about any of them:
#
#   vk_arm()      decides ON or OFF, once, at startup, and says why.
#   comp_base     is the GPU frame when it decided ON (the zero-copy binding).
#   _rt_*         are the five op hooks lib/vk/vk_2d.ad calls instead of its
#                 CPU inner loops while the router is armed.
#
# A hook returns 0 when the device took the op and non-zero when it did not;
# vk_2d then runs its own CPU path over the SAME memory, which is only sound
# because the hook syncs the device first. That ordering rule is the reason
# these are five three-line functions and not a table.
vk_armed:      int32 = 0        # the device is up AND we chose to use it
vk_forced:     int32 = 0        # 1 = armed by override, -1 = refused by override
vk_zero_copy:  int32 = 0        # the composite IS the GPU frame
vk_devlocal:   int32 = 0        # ... and that frame is device-local memory
vk_hostcached: int32 = 0        # ... and the CPU can READ it at RAM speed,
                                # which is the one that decides present's cost
# DEVICE COMPOSITING. 1 = every write into the composite is a device op and
# the CPU must never touch comp_base. This is what a scanout frame REQUIRES
# (there is no mapping to touch) and what makes the composite able to live in
# device-local VRAM, which is worth 3x on rasterize: measured, the same frame
# submits in 2.1 ms device-local against 6.3 ms in host memory.
#
# It is a separate flag from scanout so it can be validated OFFSCREEN, against
# a mapped frame, by byte-comparing the framebuffer with the software
# rasterizer (tests/linux/pixcmp.sh). Converting five CPU writes into device
# ops is mechanical and is exactly the kind of change that yields a frame that
# looks like a desktop and is wrong.
vk_devcomp:    int32 = 0
# Nesting depth for vk_linux_frame_begin/end. paint_window already opens a
# device frame for the full-screen backdrop; with device compositing the WHOLE
# of paint_frame is one device frame, and the inner begin/end must not close
# it out from under the outer one.
vk_frame_depth: int32 = 0
# 1 = the display is scanning out our GPU buffer; present() is a no-op.
vk_scanout:     int32 = 0
vk_frames_gpu: int32 = 0        # frames the device actually rasterized
vkname:        Array[256, uint8]


# -1 = unset, 0 = off, 1 = on. Accepts 0/1, on/off, yes/no, true/false; an
# unparseable value is ON, because someone who sets the variable at all wants
# the non-default and a silent "I ignored you" is the worst answer available.
def env_flag(name: Ptr[char]) -> int32:
    v: Ptr[uint8] = getenv(name)
    if cast[uint64](v) == 0:
        return -1
    if v[0] == 0:
        return -1
    c: uint8 = v[0]
    if c == 48 or c == 110 or c == 78 or c == 102 or c == 70:   # 0 n N f F
        return 0
    if c == 111 or c == 79:                                     # o O
        if v[1] == 102 or v[1] == 70:                           # "off"
            return 0
        return 1
    return 1


def vk_say_sw(why: Ptr[uint8]):
    puts(1, "wsysd: vk backend SOFTWARE -- ")
    puts(1, why)
    puts(1, "\n")


# Decide, bind and log. Called once, after read_screen(), before any frame.
probe_wh: Array[2, uint32]


# ====================================================================
# SCANOUT ARMING, and the reason it is this paranoid
# ====================================================================
# Returns 1 if the display is now scanning out a GPU buffer. On ANY failure it
# returns 0 having changed nothing, and the caller carries on down the
# ordinary /dev/fb path.
#
# THIS TAKES DRM MASTER, and on nvidia-drm, MEASURED, both the CRTC restore
# and DROP_MASTER hang afterwards -- the console has only ever come back
# because the PROCESS DIED and the kernel dropped master with the fd. So:
#
#   * it is opt-in and a normal boot cannot reach it (HAMNIX_WSYSD_SCANOUT=1);
#   * it REFUSES unless HAMNIX_WSYSD_SCANOUT_SUPERVISED=1 is also set, which
#     is the caller asserting that something is armed to kill this process.
#     tests/linux/kms_watchdog.sh is that something and is proven to fire
#     (tests/linux/hangmaster.c is the proof). A compositor that takes the
#     display on a machine whose console is the same device, with nothing able
#     to kill it, is a machine with no picture and no console.
#
# The order is forced: the buffer must exist before it can be attached, and it
# must be exactly one of the connector's advertised modes, so the mode is
# probed FIRST (which needs no master) and the frame allocated to fit it.
def vk_arm_scanout() -> int32:
    if env_flag(cast[Ptr[char]]("HAMNIX_WSYSD_SCANOUT")) != 1:
        return 0
    if env_flag(cast[Ptr[char]]("HAMNIX_WSYSD_SCANOUT_SUPERVISED")) != 1:
        puts(2, "wsysd: scanout REFUSED -- HAMNIX_WSYSD_SCANOUT=1 without\n")
        puts(2, "wsysd: HAMNIX_WSYSD_SCANOUT_SUPERVISED=1. This path takes DRM\n")
        puts(2, "wsysd: master, and on nvidia-drm DROP_MASTER hangs afterwards:\n")
        puts(2, "wsysd: the console comes back only when this process DIES.\n")
        puts(2, "wsysd: Run it under tests/linux/kms_watchdog.sh.\n")
        return 0
    if vk_set_backend(VK_BACKEND_LINUX) != VK_SUCCESS:
        puts(2, "wsysd: scanout: no usable Vulkan device\n")
        return 0
    if vk_linux_can_export() == 0:
        puts(2, "wsysd: scanout: this driver cannot export a dmabuf\n")
        return 0
    probe_wh[0] = 0
    probe_wh[1] = 0
    if hamfb_probe_mode(&probe_wh[0], &probe_wh[1]) != 0:
        puts(2, "wsysd: scanout: no connected connector with a mode\n")
        return 0
    w: int32 = cast[int32](probe_wh[0])
    h: int32 = cast[int32](probe_wh[1])
    if w <= 0 or h <= 0:
        return 0
    # Per axis, for read_screen()'s reason. NOT screen_fault(): this returns 0,
    # which means "do not use scanout", and read_screen() then runs on the
    # /dev/fb path and produces the fatal, fault-file-writing refusal if the
    # mode really is too large. Two fault files for one cause would be worse
    # than one, and a message that says both numbers is what was missing.
    if w > COMP_W or h > COMP_H:
        puts(2, "wsysd: scanout: the display mode is ")
        putd(2, w)
        puts(2, "x")
        putd(2, h)
        puts(2, " and the composite buffer holds ")
        putd(2, COMP_W)
        puts(2, "x")
        putd(2, COMP_H)
        puts(2, " -- not arming scanout\n")
        return 0
    fd: int32 = vk_linux_frame_scanout_alloc(w, h, 1)
    if fd < 0:
        puts(2, "wsysd: scanout: the GPU frame could not be exported\n")
        return 0
    if hamfb_attach_scanout(fd, cast[uint32](w), cast[uint32](h),
                            cast[uint32](w * 4)) != 0:
        puts(2, "wsysd: scanout: DRM would not take the buffer\n")
        return 0
    scr_w = w
    scr_h = h
    scr_pitch = w * 4
    # THERE IS NO CPU POINTER TO THE COMPOSITE. comp_base stays 0 and device
    # compositing is not optional here -- every one of the five write sites
    # would otherwise dereference it.
    comp_base = 0
    vk_devcomp = 1
    vk_armed = 1
    vk_zero_copy = 1
    vk_devlocal = 1
    vk_scanout = 1
    puts(1, "wsysd: SCANOUT armed -- the display reads GPU VRAM directly; the\n")
    puts(1, "wsysd: composite is never copied and /dev/fb is never written.\n")
    return 1


def vk_arm():
    comp_base = cast[uint64](&composite[0])
    ov: int32 = env_flag(cast[Ptr[char]]("HAMNIX_WSYSD_VK"))
    if ov == 0:
        vk_forced = -1
        vk_say_sw("forced off by HAMNIX_WSYSD_VK")
        return
    # vk_set_backend(LINUX) is what brings the ICD, the device and the compute
    # pipeline up, and it REFUSES rather than half-succeeds. Nothing above has
    # touched Vulkan, so an override of 0 costs no device bring-up at all.
    if vk_set_backend(VK_BACKEND_LINUX) != VK_SUCCESS:
        vk_linux_device_name(&vkname[0], 256)
        puts(1, "wsysd: vk backend SOFTWARE -- no usable Vulkan device (")
        puts(1, &vkname[0])
        puts(1, ")\n")
        return
    vk_linux_device_name(&vkname[0], 256)
    sil: int32 = vk_linux_device_is_silicon()
    if sil == 0 and ov != 1:
        # THE GATE. A conformant software ICD is a real Vulkan device and this
        # backend runs on it correctly -- it is simply slower than vk_2d, by a
        # measured 2.3x on fills and 2.9x with glyphs, because it is the same
        # CPU doing the same arithmetic with a JIT and a thread pool in the
        # way. Defaulting on here would penalise exactly the machines that
        # have no GPU. Disarm and say so, naming the device.
        vk_set_backend(VK_BACKEND_SW)
        puts(1, "wsysd: vk backend SOFTWARE -- device is a CPU ICD (")
        puts(1, &vkname[0])
        puts(1, ", VkPhysicalDeviceType 4); vk_2d is 2.3-2.9x faster there")
        puts(1, "\n")
        return
    fb: uint64 = vk_linux_frame_alloc(cast[uint64](scr_w),
                                      cast[uint64](scr_h), 1)
    if fb == 0:
        vk_set_backend(VK_BACKEND_SW)
        vk_say_sw("the GPU frame could not be allocated")
        return
    # THE ZERO-COPY BINDING. From here the composite IS device memory.
    comp_base = fb
    vk_zero_copy = 1
    vk_devlocal = vk_linux_frame_device_local()
    vk_hostcached = vk_linux_frame_host_cached()
    vk_armed = 1
    if sil == 0:
        vk_forced = 1
    puts(1, "wsysd: vk backend GPU -- ")
    puts(1, &vkname[0])
    puts(1, " (VkPhysicalDeviceType ")
    putd(1, vk_linux_device_type())
    puts(1, ", silicon ")
    putd(1, sil)
    puts(1, ", zero-copy 1, device-local ")
    putd(1, vk_devlocal)
    puts(1, ", host-cached ")
    putd(1, vk_hostcached)
    puts(1, ")")
    if vk_forced == 1:
        puts(1, " [forced on by HAMNIX_WSYSD_VK; NOT the default here]")
    puts(1, "\n")
    # DEVICE COMPOSITING is opt-in and a normal boot cannot reach it. It is
    # the prerequisite for scanout (where there is no mapping to write) and is
    # separately switchable so it can be validated offscreen against the
    # software rasterizer, byte for byte, before any modeset exists.
    if env_flag(cast[Ptr[char]]("HAMNIX_WSYSD_VKCOMP")) == 1:
        vk_devcomp = 1
        puts(1, "wsysd: vk devcomp ON -- the composite is written ONLY by the")
        puts(1, " device; the cursor save-under is off and every frame is full\n")
    if vk_hostcached == 0 and vk_devlocal != 0:
        # THIS is the configuration that measured 13x slower than software, and
        # for two years it printed as the GOOD one. present_rows() and the
        # cursor save-under read the composite from the CPU every frame, and
        # out of a device-local mapping on a discrete card that read is 88 ms
        # per 4 MiB. Say so, loudly, because the old warning fired on exactly
        # the opposite condition and this arrangement went unremarked.
        puts(2, "wsysd: vk WARNING the GPU frame is device-local and NOT")
        puts(2, " host-cached -- every present reads it back across PCIe;")
        puts(2, " expect ~88 ms/frame. Set HAMNIX_VK_FRAME_MEM=cached.\n")
    if vk_hostcached == 0 and vk_devlocal == 0:
        puts(2, "wsysd: vk WARNING the GPU frame is neither device-local nor")
        puts(2, " host-cached -- uncached host memory, ~10 ms/frame to read\n")


# ---- the five op hooks lib/vk/vk_2d.ad calls ------------------------------
# Each returns 0 if the device recorded the op. A non-zero return means vk_2d
# must run its own CPU loop over the same pixels, so the device is synced
# first: the frame is host-mapped, so that costs one fence and no transfer.
# THE DEVICE REFUSED AN OP, AND ON THE SCANOUT PATH THAT MEANS A LOST DRAWING.
#
# When a hook returns non-zero, vk_2d runs its own CPU loop over the surface it
# was pointed at. Normally that surface IS the composite, so the fallback is
# correct and invisible. On the SCANOUT path it is not: rast_target() hands the
# router a host array precisely because the composite has no CPU address, so a
# CPU fallback writes pixels into memory the display will never read. The
# drawing is silently dropped.
#
# "It has not happened yet" is not a detector, and a path that can silently
# drop drawing is what produces bug reports nobody can reproduce. So every
# refusal is counted, and on the scanout path the FIRST one says so loudly and
# names the consequence. The count is reported by the bench lines whether or
# not it is zero -- a zero that is never printed cannot be distinguished from a
# counter nobody wired up.
vk_refused:      uint64 = 0
vk_refused_said: int32 = 0


def _rt_refused() -> int32:
    vk_refused = vk_refused + 1
    if vk_scanout != 0 and vk_refused_said == 0:
        vk_refused_said = 1
        puts(2, "wsysd: WARNING the device refused an op on the SCANOUT path;")
        puts(2, " vk_2d's CPU fallback writes a host array the display never")
        puts(2, " reads, so that drawing is LOST. This frame is incomplete.\n")
    return -1


def _rt_fill(op: int32, x: int64, y: int64, w: int64, h: int64,
             rgba: uint32) -> int32:
    if vk_linux_fill_rect(op, cast[int32](x), cast[int32](y),
                          cast[int32](w), cast[int32](h), rgba) != 0:
        vk_linux_frame_sync()
        return _rt_refused()
    return 0


def _rt_roundrect(x: int64, y: int64, w: int64, h: int64, rad: int64,
                  corners: int32, rgba: uint32) -> int32:
    if vk_linux_roundrect(cast[int32](x), cast[int32](y), cast[int32](w),
                          cast[int32](h), cast[int32](rad), corners,
                          rgba) != 0:
        vk_linux_frame_sync()
        return _rt_refused()
    return 0


def _rt_line(x1: int64, y1: int64, x2: int64, y2: int64, thick: int64,
             rgba: uint32) -> int32:
    if vk_linux_line(cast[int32](x1), cast[int32](y1), cast[int32](x2),
                     cast[int32](y2), cast[int32](thick), rgba) != 0:
        vk_linux_frame_sync()
        return _rt_refused()
    return 0


def _rt_blit(src_base: uint64, src_w: uint64, src_h: uint64,
             dx: int64, dy: int64, dw: int64, dh: int64,
             sx: int64, sy: int64, sw: int64, sh: int64) -> int32:
    if vk_linux_blit(src_base, cast[int32](src_w), cast[int32](src_h),
                     cast[int32](dx), cast[int32](dy), cast[int32](dw),
                     cast[int32](dh), cast[int32](sx), cast[int32](sy),
                     cast[int32](sw), cast[int32](sh)) != 0:
        vk_linux_frame_sync()
        return _rt_refused()
    return 0


def _rt_cov(cov_base: uint64, cov_w: int64, cov_h: int64,
            dx: int64, dy: int64, rgba: uint32) -> int32:
    if vk_linux_glyph(cov_base, cast[int32](cov_w), cast[int32](cov_h),
                      cast[int32](dx), cast[int32](dy), rgba) != 0:
        vk_linux_frame_sync()
        return _rt_refused()
    return 0


# Open the device frame and point vk_2d at it. Returns 1 if the following
# rasterize will run on the device. w/h MUST be the surface bound at
# comp_base, which is the screen -- that exactness is what makes the router's
# "is this op aimed at the GPU frame?" test a three-integer compare.
# Open/close a device frame, counting nesting so the outermost owner submits.
# Returns 0 on success.
def vkc_begin() -> int32:
    if vk_frame_depth > 0:
        vk_frame_depth = vk_frame_depth + 1
        return 0
    if vk_linux_frame_begin() != 0:
        return -1
    vk_frame_depth = 1
    return 0


def vkc_end() -> int32:
    if vk_frame_depth <= 0:
        return 0
    vk_frame_depth = vk_frame_depth - 1
    if vk_frame_depth > 0:
        return 0
    return vk_linux_frame_end()


def vk_route_begin(w: int32, h: int32) -> int32:
    if vk_armed == 0:
        return 0
    if vkc_begin() != 0:
        return 0
    if vk2d_set_router(rast_target(), cast[uint64](w), cast[uint64](h),
                       cast[uint64](_rt_fill), cast[uint64](_rt_roundrect),
                       cast[uint64](_rt_line), cast[uint64](_rt_blit),
                       cast[uint64](_rt_cov)) != 0:
        vkc_end()
        return 0
    return 1


# Close it. Returns 0 if every op of the frame executed on the device; on -1
# the caller must re-render this frame in software, and the backend disarms
# itself for good rather than produce a second half-drawn frame.
def vk_route_end() -> int32:
    vk2d_clear_router()
    if vkc_end() != 0:
        vk_armed = 0
        vk_set_backend(VK_BACKEND_SW)
        puts(2, "wsysd: vk backend FAILED mid-frame; back to software\n")
        return -1
    # Only the OUTERMOST close is a submitted frame. Counting here while
    # nested inside paint_frame's device frame counted every routed window as
    # a frame too, and gpu_frames ran at twice the real rate.
    if vk_frame_depth == 0:
        vk_frames_gpu = vk_frames_gpu + 1
    return 0


TITLEBAR_H: int32 = 22


# One row of a window's v2 backbuffer, read straight out of the shared surface
# as RGBA8888.
BBROW_CAP: uint64 = 7680                # 1920 * 4
bbrow: Array[7680, uint8]

def paint_backbuffer(i: uint64) -> int32:
    wid: int32 = win_id[i]
    w: int32 = win_w[i]
    h: int32 = win_h[i]
    winpath(wid, "backbuffer")
    fd: int32 = sys_open(cast[Ptr[char]](&pathbuf[0]))
    if fd < 0:
        return 0
    ox: int32 = win_x[i]
    oy: int32 = win_y[i]
    y: int32 = 0
    rowbytes: uint64 = cast[uint64](w) * 4
    # THE ROW BUFFER IS 1920 PIXELS AND SO IS THE BACKBUFFER, BUT THE WINDOW
    # TABLE IS NOT. `geometry` accepts any positive width, so a window can be
    # 2048 wide in the table while user/linux-wsys.c's bb_fit has cut its
    # pixels to BB_W. This loop used to read `rowbytes` bytes -- correctly
    # capped -- and then walk x from 0 to the WINDOW's width, indexing
    # bbrow[x*4] up to 512 bytes PAST THE END of a 7680-byte array and painting
    # whatever was there over the desktop. An out-of-bounds read that reaches
    # the screen. `cols` is what was actually read, and the loop stops there;
    # the window's own limit is announced by the server that chose it
    # (user/wsyswl.ad), so this does not say it a second time per frame.
    if rowbytes > BBROW_CAP:
        rowbytes = BBROW_CAP
    cols: int32 = cast[int32](rowbytes / 4)
    while y < h:
        got: uint64 = 0
        while got < rowbytes:
            k: int64 = sys_read(fd, &bbrow[got], rowbytes - got)
            if k <= 0:
                break
            got = got + cast[uint64](k)
        if got < rowbytes:
            break
        x: int32 = 0
        while x < cols:
            o: uint64 = cast[uint64](x) * 4
            r: uint32 = cast[uint32](bbrow[o])
            g: uint32 = cast[uint32](bbrow[o + 1])
            b: uint32 = cast[uint32](bbrow[o + 2])
            put_px(ox + x, oy + y, (r << 16) | (g << 8) | b)
            x = x + 1
        y = y + 1
    sys_close(fd)
    if y == 0:
        return 0
    return 1


# Lift the just-rasterized window image out of hamui_host and into the screen
# composite at (ox,oy).
#
# THIS IS THE FRAME'S BIGGEST LINE ITEM and it was, until now, the single most
# expensive thing the compositor did: 3.2 ms of a measured 5.3 ms frame at
# 1280x800, five times the cost of the vk2d rasterization that produced the
# pixels. The old shape was
#
#     put_px(ox + k, oy + j, hamui_host_pixel(k, j))
#
# per pixel -- a call to read one pixel and re-pack it as 0x00RRGGBB, a call to
# write it that re-clipped against the screen, and four byte stores. Now:
#
#   * the destination rectangle is clipped ONCE, before the loop;
#   * hamui_host renders in BGRA byte order (vk2d_set_bgra -- the same order
#     the virtio-gpu scanout path already asked for), which is /dev/fb's
#     XRGB8888 byte layout, so no channel shuffle is left to do;
#   * the row is copied as 32-bit words, source word straight to destination
#     word, which is what a memcpy would have been if Adder had one.
#
# The pixels are identical. The alpha/X byte differs -- vk2d leaves 0xFF where
# put_px wrote 0x00 -- and that is deliberately fine: /dev/fb's format is
# X RGB8888, the top byte is ignored by scanout, and linux-fb.c memcpys it
# through untouched. (If a future scanout ever samples it, 0xFF-opaque is the
# more correct value of the two.)
# THE SAME LIFT, ALPHA-KEYED AND SOURCE-OVER. `mode` is 0 opaque, 1 keyed,
# 2 blend -- one function rather than three, because the clipping above it is
# the fiddly part and three copies of it is three chances to clip differently.
#
# WHY EITHER EXISTS, and it is not a rendering flourish. devwsys.ad:8085 names
# hampanelscene in the comment that documents `keyed`: the panel GROWS to the
# full width of the display to host the Applications dropdown, then paints the
# bar and the menu card and leaves the rest of the grown band UNPAINTED. Blit
# that band opaquely -- which is what this compositor did -- and it is a black
# rectangle over the wallpaper and the desktop icons for as long as the menu
# is open. The machine's owner reported exactly that. The client has been
# writing `keyed 1` the whole time; nothing here was listening.
#
# `blend` is the same idea with the full 0..255 ramp instead of all-or-
# nothing, and it is what makes hamshotui's "select area" scrim DIM the
# desktop instead of covering the thing it is meant to dim with opaque black.
#
# The alpha byte is real here because hamui_host_set_clear_alpha(0) made it
# real: the clear that opens the rasterize leaves alpha 0, and every op that
# paints leaves 0xFF. The word is BGRA in memory, so alpha is the top byte.
# The cursor sprite blit in this same file is the keyed shape already, which
# is how the correctness of `mode 1` was checked -- against something that was
# already on the screen and right.
def blit_window_image_mode(ox: int32, oy: int32, w: int32, h: int32,
                           mode: int32):
    sx0: int32 = 0
    sy0: int32 = 0
    sw: int32 = w
    sh: int32 = h
    if hamui_host_width() < sw:
        sw = hamui_host_width()
    if hamui_host_height() < sh:
        sh = hamui_host_height()
    # Clip the destination to the screen, carrying the source origin with it.
    if ox < 0:
        sx0 = 0 - ox
        sw = sw - sx0
    if oy < 0:
        sy0 = 0 - oy
        sh = sh - sy0
    dx: int32 = ox + sx0
    dy: int32 = oy + sy0
    if dx + sw > scr_w:
        sw = scr_w - dx
    if dy + sh > scr_h:
        sh = scr_h - dy
    if sw <= 0 or sh <= 0:
        return
    # SITE 2 of 5. One device blit instead of sw*sh CPU word stores. The
    # source rows are contiguous in the hamui image, which is what lets the
    # whole rectangle go as a single op.
    #
    # THE THREE MODES ARE NOT ALL SOURCE-OVER, and the device blit is. mode 0
    # is an opaque copy; on a hamui image whose X byte is 0 a source-over
    # would draw NOTHING, so the alpha has to be forced. That is what
    # hamui_host_set_blit_opaque below is for -- see the flag's own comment.
    if vk_devcomp != 0:
        vk_linux_blit_native(hamui_host_row_base(0),
                             hamui_host_width(), hamui_host_height(),
                             dx, dy, sw, sh, sx0, sy0, sw, sh)
        return
    dst: Ptr[uint32] = comp_words()
    j: int32 = 0
    while j < sh:
        sbase: uint64 = hamui_host_row_base(sy0 + j)
        if sbase == 0:
            return
        src: Ptr[uint32] = cast[Ptr[uint32]](sbase)
        sofs: uint64 = cast[uint64](sx0)
        dofs: uint64 = cast[uint64](dy + j) * cast[uint64](scr_w) + cast[uint64](dx)
        k: int32 = 0
        if mode == 0:
            while k < sw:
                dst[dofs] = src[sofs]
                sofs = sofs + 1
                dofs = dofs + 1
                k = k + 1
        elif mode == 1:
            while k < sw:
                sp: uint32 = src[sofs]
                if (sp >> 24) != 0:
                    dst[dofs] = sp
                sofs = sofs + 1
                dofs = dofs + 1
                k = k + 1
        else:
            while k < sw:
                sp2: uint32 = src[sofs]
                a: uint32 = sp2 >> 24
                if a == 255:
                    dst[dofs] = sp2
                elif a != 0:
                    dp: uint32 = dst[dofs]
                    ia: uint32 = 255 - a
                    sb: uint32 = sp2 & 255
                    sg: uint32 = (sp2 >> 8) & 255
                    sr: uint32 = (sp2 >> 16) & 255
                    db: uint32 = dp & 255
                    dg: uint32 = (dp >> 8) & 255
                    dr: uint32 = (dp >> 16) & 255
                    ob: uint32 = (sb * a + db * ia) / 255
                    og: uint32 = (sg * a + dg * ia) / 255
                    orr: uint32 = (sr * a + dr * ia) / 255
                    # X byte 0xFF, like both other modes: the file's own note
                    # above says 0xFF-opaque is the more correct value of the
                    # two if a future scanout ever samples it, and a composite
                    # whose alpha byte depends on which window painted last is
                    # the kind of inconsistency that is free to avoid.
                    dst[dofs] = 4278190080 | (orr << 16) | (og << 8) | ob
                sofs = sofs + 1
                dofs = dofs + 1
                k = k + 1
        j = j + 1


def blit_window_image(ox: int32, oy: int32, w: int32, h: int32):
    blit_window_image_mode(ox, oy, w, h, 0)


# ====================================================================
# NAMED IMAGES — the compositor half of the draw/ctl 'I' verb.
# ====================================================================
# In Hamnix the compositor IS devwsys, so the named-image store and the scene
# rasterizer share an address space and `image x y w h NAME` is a table lookup.
# Here the compositor is this program and the store is a shared segment behind
# /dev/wsys, so the pixels have to be READ -- through files, like everything
# else, which is what makes wsysd an ordinary program:
#
#   /dev/wsys/<wid>/draw/images        "<name> <w> <h> <serial>\n" per image
#   /dev/wsys/<wid>/draw/image/<name>  raw RGBA8888, w*h*4 bytes
#
# CACHED ON THE SERIAL, and that is what makes it affordable. A 256x256 image
# is 256 KiB and lib/hamvideocore.ad re-uploads its "frame" every tick; copying
# every image of every window every frame would cost more than the rasterizer.
# The serial is bumped by the device on every store, so a window whose pictures
# have not changed costs ONE small text read per frame and no pixel copy.
#
# SIXTEEN SLOTS, matching the device's cap exactly, so this cache can never be
# the thing that refuses -- if the store accepted an image, there is room here
# for it. What CAN still refuse is lib/hamui_host.ad's per-window registry,
# which is eight; that refusal is reported by name rather than dropped.
WSYSD_IMG_SLOTS: uint64 = 16
WSYSD_IMG_NAME:  uint64 = 32
WSYSD_IMG_BYTES: uint64 = 262144         # 256*256*4, the device's ceiling
imgc_used:   Array[16, int32]
imgc_wid:    Array[16, int32]
imgc_w:      Array[16, int32]
imgc_h:      Array[16, int32]
imgc_serial: Array[16, int32]
imgc_name:   Array[512, uint8]           # 16 * 32, NUL-terminated
imgc_px:     Array[4194304, uint8]       # 16 * 256 KiB
imglist:     Array[2048, uint8]          # the draw/images listing


def imgpath(wid: int32, name: Ptr[uint8], ns: uint64, ne: uint64):
    # "/dev/wsys/<wid>/draw/image/<name>\0" into pathbuf.
    winpath(wid, "draw/image/")
    i: uint64 = 0
    while pathbuf[i] != 0:
        i = i + 1
    k: uint64 = ns
    while k < ne and i < 127:
        pathbuf[i] = name[k]
        i = i + 1
        k = k + 1
    pathbuf[i] = 0


def _imgc_eq(slot: uint64, buf: Ptr[uint8], ns: uint64, ne: uint64) -> int32:
    nb: uint64 = slot * WSYSD_IMG_NAME
    k: uint64 = ns
    j: uint64 = nb
    while k < ne:
        if imgc_name[j] == 0 or imgc_name[j] != buf[k]:
            return 0
        k = k + 1
        j = j + 1
    if imgc_name[j] != 0:
        return 0
    return 1


def _imgc_find(wid: int32, buf: Ptr[uint8], ns: uint64, ne: uint64) -> int32:
    s: uint64 = 0
    while s < WSYSD_IMG_SLOTS:
        if imgc_used[s] != 0 and imgc_wid[s] == wid:
            if _imgc_eq(s, buf, ns, ne) == 1:
                return cast[int32](s)
        s = s + 1
    return -1


# Read <wid>/draw/image/<name> into cache slot `u`. 1 on a WHOLE image, 0 if
# the read came up short -- a short image is not blitted, because half a
# picture stretched over the whole rect is a worse answer than the complaint.
def _imgc_fill(u: uint64, wid: int32, buf: Ptr[uint8], ns: uint64, ne: uint64,
               w: int32, h: int32) -> int32:
    want: uint64 = cast[uint64](w) * cast[uint64](h) * 4
    if want == 0 or want > WSYSD_IMG_BYTES:
        return 0
    imgpath(wid, buf, ns, ne)
    fd: int32 = sys_open(cast[Ptr[char]](&pathbuf[0]))
    if fd < 0:
        return 0
    base: uint64 = u * WSYSD_IMG_BYTES
    got: uint64 = 0
    while got < want:
        k: int64 = sys_read(fd, &imgc_px[base + got], want - got)
        if k <= 0:
            got = want + 1                       # short: mark and stop
        else:
            got = got + cast[uint64](k)
    sys_close(fd)
    if got != want:
        return 0
    return 1


# Register every image window `wid` owns into lib/hamui_host.ad's registry,
# refreshing the cache for any whose serial moved. Called immediately before
# the rasterize, and it CLEARS first: the device store is keyed by (wid, name)
# so two windows may each own a "frame", and carrying window A's registration
# into window B would draw A's picture in B.
def load_window_images(wid: int32):
    hamui_host_clear_images()
    winpath(wid, "draw/images")
    n: int64 = slurp(cast[Ptr[char]](&pathbuf[0]), &imglist[0], 2048)
    if n <= 0:
        return
    end: uint64 = cast[uint64](n)
    p: uint64 = 0
    while p < end:
        ns: uint64 = p
        while p < end and imglist[p] != 32 and imglist[p] != 10:
            p = p + 1
        ne: uint64 = p
        iw: int32 = 0
        ih: int32 = 0
        isr: int32 = 0
        f: int32 = 0
        while f < 3:
            while p < end and imglist[p] == 32:
                p = p + 1
            v: int32 = 0
            got: int32 = 0
            while p < end and imglist[p] >= 48 and imglist[p] <= 57:
                v = v * 10 + cast[int32](imglist[p]) - 48
                got = 1
                p = p + 1
            if got == 0:
                v = -1
            if f == 0:
                iw = v
            if f == 1:
                ih = v
            if f == 2:
                isr = v
            f = f + 1
        while p < end and imglist[p] != 10:
            p = p + 1
        p = p + 1
        if ns < ne and iw > 0 and ih > 0:
            slot: int32 = _imgc_find(wid, &imglist[0], ns, ne)
            if slot < 0:
                s2: uint64 = 0
                while s2 < WSYSD_IMG_SLOTS and slot < 0:
                    if imgc_used[s2] == 0:
                        slot = cast[int32](s2)
                    s2 = s2 + 1
                if slot >= 0:
                    u2: uint64 = cast[uint64](slot)
                    nb: uint64 = u2 * WSYSD_IMG_NAME
                    k2: uint64 = ns
                    q: uint64 = 0
                    while k2 < ne and q < WSYSD_IMG_NAME - 1:
                        imgc_name[nb + q] = imglist[k2]
                        k2 = k2 + 1
                        q = q + 1
                    imgc_name[nb + q] = 0
                    imgc_wid[u2] = wid
                    imgc_used[u2] = 1
                    imgc_serial[u2] = -1         # forces the fill below
            if slot >= 0:
                u: uint64 = cast[uint64](slot)
                if imgc_serial[u] != isr or imgc_w[u] != iw or imgc_h[u] != ih:
                    if _imgc_fill(u, wid, &imglist[0], ns, ne, iw, ih) != 0:
                        imgc_w[u] = iw
                        imgc_h[u] = ih
                        imgc_serial[u] = isr
                    else:
                        imgc_w[u] = 0
                        imgc_h[u] = 0
                        imgc_serial[u] = -1
                if imgc_w[u] > 0:
                    # The registry takes a CALLER-OWNED pointer, which is what
                    # lets the rasterizer read straight out of this cache with
                    # no second copy. It stays valid until the next call here,
                    # and the rasterize happens in between.
                    if hamui_host_register_image(&imgc_name[u * WSYSD_IMG_NAME],
                                                 imgc_w[u], imgc_h[u],
                                                 &imgc_px[u * WSYSD_IMG_BYTES]) == 0:
                        puts(2, "wsysd: image registry full, not drawing ")
                        puts(2, &imgc_name[u * WSYSD_IMG_NAME])
                        puts(2, "\n")


# Drop every cache slot owned by wid. A wid is reused, and a recycled window
# must never inherit a dead one's pictures -- the device frees its own store on
# teardown for the same reason.
def forget_window_images(wid: int32):
    s: uint64 = 0
    while s < WSYSD_IMG_SLOTS:
        if imgc_used[s] != 0 and imgc_wid[s] == wid:
            imgc_used[s] = 0
            imgc_wid[s] = 0
            imgc_w[s] = 0
            imgc_h[s] = 0
            imgc_serial[s] = -1
            imgc_name[s * WSYSD_IMG_NAME] = 0
        s = s + 1


# ONE LINE PER (window, name), EVER. The defect this whole path exists to fix
# was a scene op that drew nothing and said nothing; the opposite failure is a
# message every frame, which filled the initramfs tmpfs and silenced the guest
# console inside two minutes the last time this file printed per-frame. So the
# complaint is remembered and never repeated.
IMGWARN_SLOTS: uint64 = 16
imgwarn_wid:  Array[16, int32]
imgwarn_name: Array[512, uint8]
imgwarn_n:    uint64 = 0


# A WINDOW THAT PAINTS LESS THAN IT OWNS SAYS SO, ONCE, BY NAME.
#
# lib/hamui_host.ad measures per-row coverage of every rasterize; this is the
# one line that turns the measurement into a sentence. Both of the real
# defects that motivated it -- hamimgscene's 640x480 window holding a 320x260
# picture, and the panel's Applications dropdown painting a 136 px menu column
# into a window the full width of the display -- reached the framebuffer as a
# large black rectangle with every gate in the tree green: the display list
# was right, the ops all drew, every layer returned success. The detection
# mechanism was a human's eye, and that is not a mechanism.
#
# NOT FOR A KEYED OR BLENDED WINDOW. Those two are the case where painting
# less than you own is the CORRECT and requested behaviour -- it is the whole
# point of the verb -- so reporting them would be a warning that is always
# wrong, which is how a warning stops being read.
covwarn_wid: Array[64, int32]
covwarn_n:   uint64 = 0


def report_uncovered(wid: int32, pres: int32):
    if pres != 0:
        return
    if hamui_host_uncovered_rows() == 0:
        return
    s: uint64 = 0
    while s < covwarn_n:
        if covwarn_wid[s] == wid:
            return
        s = s + 1
    if covwarn_n >= 64:
        return
    covwarn_wid[covwarn_n] = wid
    covwarn_n = covwarn_n + 1
    puts(2, "wsysd: window ")
    putd(2, wid)
    puts(2, " paints ")
    putd(2, hamui_host_covered_w())
    puts(2, "x")
    putd(2, hamui_host_covered_h())
    puts(2, " of its ")
    putd(2, hamui_host_width())
    puts(2, "x")
    putd(2, hamui_host_height())
    puts(2, " window -- ")
    putd(2, hamui_host_uncovered_rows())
    puts(2, " rows reach the screen as the compositor's clear colour.\n")
    puts(2, "wsysd: either the scene should cover its window, or the window\n")
    puts(2, "wsysd: should be the size of the scene, or it wants `keyed 1`.\n")


def report_image_misses(wid: int32):
    if hamui_host_image_misses() == 0:
        return
    c: uint64 = hamui_host_image_miss_count()
    k: uint64 = 0
    while k < c:
        nm: Ptr[uint8] = hamui_host_image_miss_name(k)
        seen: int32 = 0
        s: uint64 = 0
        while s < imgwarn_n:
            if imgwarn_wid[s] == wid:
                nb: uint64 = s * WSYSD_IMG_NAME
                j: uint64 = 0
                mt: int32 = 1
                while nm[j] != 0 and mt == 1:
                    if imgwarn_name[nb + j] != nm[j]:
                        mt = 0
                    j = j + 1
                if mt == 1 and imgwarn_name[nb + j] == 0:
                    seen = 1
            s = s + 1
        if seen == 0 and imgwarn_n < IMGWARN_SLOTS:
            nb2: uint64 = imgwarn_n * WSYSD_IMG_NAME
            j2: uint64 = 0
            while nm[j2] != 0 and j2 < WSYSD_IMG_NAME - 1:
                imgwarn_name[nb2 + j2] = nm[j2]
                j2 = j2 + 1
            imgwarn_name[nb2 + j2] = 0
            imgwarn_wid[imgwarn_n] = wid
            imgwarn_n = imgwarn_n + 1
            puts(2, "wsysd: window ")
            putd(2, wid)
            puts(2, " scene names image '")
            puts(2, nm)
            puts(2, "' that it never uploaded -- nothing drawn there. ")
            puts(2, "Upload it with the 'I' verb on draw/ctl before the commit that names it.\n")
        k = k + 1


def paint_window(i: uint64) -> int32:
    wid: int32 = win_id[i]
    if win_vis[i] == 0:
        return 0
    w: int32 = win_w[i]
    h: int32 = win_h[i]
    if w <= 0 or h <= 0:
        return 0

    winpath(wid, "scene")
    ts0: uint64 = 0
    if bench_on != 0:
        ts0 = now_us()
    n: int64 = slurp(cast[Ptr[char]](&pathbuf[0]), &scenebuf[0], SCENEBUF_CAP)
    if bench_on != 0:
        t_scene = t_scene + (now_us() - ts0)
    if n < 0:
        return 0

    ox: int32 = win_x[i]
    oy: int32 = win_y[i]
    if win_dec[i] != 0:
        # Server-side decoration: a title bar above the client area. The
        # window's own coordinates address the CLIENT area, so the frame is
        # drawn above it -- a client never has to know it is decorated.
        top: uint32 = 4210752                            # 0x404040
        if wid == focus_wid:
            top = 5601245                                # 0x5577DD
        fill_rect(ox - 1, oy - TITLEBAR_H, w + 2, TITLEBAR_H, top)
        fill_rect(ox - 1, oy, 1, h, top)
        fill_rect(ox + w, oy, 1, h, top)
        fill_rect(ox - 1, oy + h, w + 2, 1, top)
        draw_close_box(ox, oy, w)
        # LAST, so the name is over the bar and never under the close box --
        # and before the client's own scene is loaded into hamscene_buf below,
        # which is the only ordering constraint: the title borrows that buffer
        # for one line and this window's display list is still in scenebuf.
        title_draw(i, ox, oy, w)

    # A v2 window renders its OWN pixels and submits them as blits. The scene
    # grammar is a text display list capped at 16 KiB: it can express a widget
    # tree and cannot express a photograph, so anything that is not a hamui
    # app -- a browser, a video, an X server bridged in -- arrives this way.
    # Nothing to rasterize; blit the backbuffer. The decoration above is
    # already drawn, so a v2 window is framed and raised like any other.
    if win_proto[i] == 2:
        tb0: uint64 = 0
        if bench_on != 0:
            tb0 = now_us()
        ok2: int32 = paint_backbuffer(i)
        if bench_on != 0:
            t_bb = t_bb + (now_us() - tb0)
        if ok2 != 0:
            return 1

    if n == 0:
        # A mapped window that has not committed a frame yet: paint the client
        # area so the decoration does not frame the desktop.
        fill_rect(ox, oy, w, h, 1842204)                 # 0x1C1C1C
        return 1

    # The window's named images, refreshed and registered before anything is
    # rasterized: `image x y w h NAME` in the display list below resolves
    # against exactly what this puts in the registry, and nothing else.
    load_window_images(wid)

    tr0: uint64 = 0
    if bench_on != 0:
        tr0 = now_us()
    hamscene_load(&scenebuf[0], cast[uint64](n))
    # A window that IS the screen -- the session backdrop -- gets rasterized
    # straight into the composite. Nothing is copied afterwards, and the opaque
    # clear that opens every rasterize doubles as the desktop clear. The guard
    # is exact and deliberately narrow: vk2d has no pitch, so the window's rows
    # must be the screen's rows (see hamui_host's host_ext_base note).
    direct: int32 = 0
    gpu: int32 = 0
    # A KEYED OR BLENDED WINDOW CANNOT TAKE THE DIRECT PATH. Rasterizing
    # straight into the composite means the window's clear IS the desktop
    # clear, which is precisely what a window that wants to show what is
    # behind it must not do -- and it is the full-screen case, which is
    # hamshotui's scrim exactly.
    # SCENE WINDOWS ONLY, and that is a real limit rather than an oversight
    # nobody noticed: a protocol-2 window has already returned above through
    # paint_backbuffer, which blits its shared surface opaquely. All three
    # clients that need these verbs -- hampanelscene's dropdown, hamappmenu's
    # fly-out band, hamshotui's scrim -- are v1 scene clients, so the case is
    # covered; a v2 client asking for `keyed` would be silently opaque, which
    # is why it is written down here.
    pres: int32 = 0
    if win_keyed[i] != 0:
        pres = 1
    if win_blend[i] != 0:
        pres = 2
    if pres != 0:
        # The clear that opens the rasterize leaves alpha 0, so every pixel no
        # op paints can be skipped or composited instead of blitted as black.
        # It is one-shot in hamui_host and re-armed per window per frame.
        hamui_host_set_clear_alpha(0)
    if pres == 0 and ox == 0 and oy == 0 and w == scr_w and h == scr_h \
            and win_dec[i] == 0:
        # Arm the device BEFORE begin_into: _host_begin_common's opening
        # full-image clear is itself a vk2d fill, and it is the single
        # largest op in the frame, so leaving it on the CPU would hand the
        # device the cheap half of the work.
        gpu = vk_route_begin(w, h)
        direct = hamui_host_begin_into(rast_target(), w, h)
        if direct == 0 and gpu != 0:
            vk_route_end()
            gpu = 0
    if direct == 0:
        hamui_host_begin(w, h)
    hamui_host_rasterize()
    if gpu != 0:
        if vk_route_end() != 0:
            # The device dropped the frame. It has disarmed itself; redo this
            # window in software so the screen is never half-painted.
            hamui_host_begin_into(rast_target(), w, h)
            hamui_host_rasterize()
    if bench_on != 0:
        t_rast = t_rast + (now_us() - tr0)
    report_image_misses(wid)
    # NOT FOR A v2 WINDOW, for the same reason keyed and blended are exempt.
    # report_uncovered measures coverage of the RASTERIZED SCENE, and a v2
    # window's content does not come from its scene: paint_backbuffer()
    # composites its backbuffer and returns above, before the scene is ever
    # rasterized. Reaching here with proto 2 means the backbuffer was not
    # ready THIS frame (the hand-up is on a clock and lands a moment later),
    # so the scene is empty by construction and measuring it says nothing
    # about the window. MEASURED before exempting it: the warning fired on
    # every run, deterministically, naming a browser window that was putting
    # 468,480 pixels of page on the screen -- a warning that is always wrong
    # for the one client a person looks at, which is how a warning stops
    # being read. tests/linux/de_browser_paints.sh holds this.
    if win_proto[i] != 2:
        report_uncovered(wid, pres)

    if direct != 0:
        return 1
    tc0: uint64 = 0
    if bench_on != 0:
        tc0 = now_us()
    blit_window_image_mode(ox, oy, w, h, pres)
    if bench_on != 0:
        t_copy = t_copy + (now_us() - tc0)
    return 1


# Push composite rows [y0,y1) to /dev/fb.
#
# The whole screen is 4 MiB; on this host that memcpy into the scanout mapping
# measures ~0.26 ms, which is 20% of a frame once the rasterizer and the
# copy-out have been dealt with. Rows are what /dev/fb's dirty-rect derivation
# works in (user/linux-fb.c turns a byte range into an exact row range), so a
# partial present is both cheaper HERE and a smaller flush THERE.
def present_rows(y0: int32, y1: int32):
    # SITE 5 of 5, and the one the whole exercise was for. On the scanout path
    # the pixels are ALREADY where the display reads them: the CRTC and the
    # compute shader address the same VRAM. There is nothing to copy, nothing
    # to write to /dev/fb -- which would return EOPNOTSUPP anyway -- and no
    # flip, because there is a single buffer.
    #
    # This is the 66,602 us that started the investigation, and 155 us after
    # the placement fix, becoming zero.
    if vk_scanout != 0:
        return
    a: int32 = y0
    b: int32 = y1
    if a < 0:
        a = 0
    if b > scr_h:
        b = scr_h
    if b <= a:
        return
    fd: int32 = sys_open_write(cast[Ptr[char]]("/dev/fb"))
    if fd < 0:
        puts(2, "wsysd: cannot open /dev/fb for writing\n")
        return
    rowbytes: uint64 = cast[uint64](scr_w) * 4
    off: uint64 = cast[uint64](a) * rowbytes
    total: uint64 = cast[uint64](b) * rowbytes
    if off != 0:
        if sys_lseek(fd, cast[int64](off), 0) < 0:
            # No seek on this /dev/fb: fall back to the whole screen rather
            # than write the rows to the wrong place.
            off = 0
    tw0: uint64 = 0
    wbase: uint64 = off
    if bench_on != 0:
        tw0 = now_us()
    while off < total:
        k: int64 = sys_write(fd, cast[Ptr[uint8]](comp_base + off), total - off)
        if k <= 0:
            break
        off = off + cast[uint64](k)
    if bench_on != 0:
        t_pres_w = t_pres_w + (now_us() - tw0)
        b_pres_w = b_pres_w + (off - wbase)
        n_pres_w = n_pres_w + 1
    sys_close(fd)
    fb_flip()


# Publish the rows just written, tear-free.
#
# WHY EVERY PRESENT AND NOT ONLY THE FULL ONES. A page flip shows the whole
# back buffer, so flipping after a PARTIAL write would be wrong if the back
# buffer's other rows were stale. user/linux-fb.c makes sure they are not: it
# keeps the back buffer equal to what is on screen by copying back, after each
# flip, exactly the bytes that flip published. A cursor-only frame therefore
# writes its two bands into a buffer that is otherwise the displayed frame,
# and flipping it is correct.
#
# The alternative -- flip only on full frames, write cursor motion straight
# into the scanned-out buffer -- was rejected because it leaves the single
# most frequent update a desktop does (the pointer, on every mouse event) as
# the one thing that still tears, which is most of what one would notice.
#
# On fbdev, on the offscreen HAMFB_FILE framebuffer, and on any DRM device
# that would not give us a second buffer, `flip` is a no-op: the write already
# reached the screen on the way in.
def fb_flip():
    if fbctl_fd < 0:
        if fbctl_tried != 0:
            return
        fbctl_tried = 1
        fbctl_fd = sys_open_write(cast[Ptr[char]]("/dev/fbctl"))
        if fbctl_fd < 0:
            return
    sys_write(fbctl_fd, cast[Ptr[uint8]]("flip\n"), 5)


def present():
    present_rows(0, scr_h)


# ====================================================================
# THE CURSOR, AND WHY IT GETS ITS OWN PATH
# ====================================================================
# The cursor is composited, so moving the mouse one pixel changes the screen
# and the frame gate fires. Before this, that meant the FULL frame: clear the
# desktop, re-read and re-rasterize every window's scene, copy every window
# into the composite, write 4 MiB to /dev/fb. Measured, that is the whole
# per-frame cost -- paid for a 12x17 sprite moving one pixel, and paid on
# every single mouse event, which is the most frequent thing a desktop does.
#
# So the cursor keeps a SAVE-UNDER: the 12x17 patch of composite it covered
# before it was stamped. When nothing but the pointer moved, restoring that
# patch returns the composite to exactly the state the last full repaint left
# it in -- no window has to be touched -- and only the two small rectangles
# (old position, new position) need to reach the screen.
#
# The correctness condition is that the composite must be otherwise unchanged
# between unstamp and stamp, which is why the window-set signature is checked
# SEPARATELY from the pointer position: any change to a window forces the full
# path and re-establishes the save-under from scratch.
cur_save: Array[204, uint32]            # CURSOR_W * CURSOR_H
cur_saved: int32 = 0                    # is cur_save valid?
cur_save_x: int32 = 0
cur_save_y: int32 = 0


# SITE 4 of 5. The save-under READS the composite, which device compositing
# forbids outright. It is not converted to a device op -- it is DROPPED: with
# the composite on the device a full repaint costs ~3.1 ms (measured), so the
# whole reason the save-under exists (a full frame was too expensive to pay
# for one moved pointer) no longer holds. In device-compositing mode every
# frame is a full frame; cursor_only_frame() is never taken. See main().
def cursor_save_under(x: int32, y: int32):
    if vk_devcomp != 0:
        return
    src: Ptr[uint32] = comp_words()
    r: int32 = 0
    while r < CURSOR_H:
        sy: int32 = y + r
        c: int32 = 0
        while c < CURSOR_W:
            sx: int32 = x + c
            v: uint32 = 0
            if sx >= 0 and sy >= 0 and sx < scr_w and sy < scr_h:
                v = src[cast[uint64](sy) * cast[uint64](scr_w)
                        + cast[uint64](sx)]
            cur_save[cast[uint64](r * CURSOR_W + c)] = v
            c = c + 1
        r = r + 1
    cur_save_x = x
    cur_save_y = y
    cur_saved = 1


def cursor_restore_under():
    if vk_devcomp != 0:
        return
    if cur_saved == 0:
        return
    dst: Ptr[uint32] = comp_words()
    r: int32 = 0
    while r < CURSOR_H:
        sy: int32 = cur_save_y + r
        c: int32 = 0
        while c < CURSOR_W:
            sx: int32 = cur_save_x + c
            if sx >= 0 and sy >= 0 and sx < scr_w and sy < scr_h:
                dst[cast[uint64](sy) * cast[uint64](scr_w)
                    + cast[uint64](sx)] = \
                    cur_save[cast[uint64](r * CURSOR_W + c)]
            c = c + 1
        r = r + 1
    cur_saved = 0


# Move the cursor without repainting anything else. Presents only the rows the
# two sprite positions touch. Returns the number of rows presented.
def cursor_only_frame() -> int32:
    oldy: int32 = cur_save_y
    if cur_saved == 0:
        oldy = ptr_y
    cursor_restore_under()
    cursor_save_under(ptr_x, ptr_y)
    paint_cursor()
    y0: int32 = oldy
    y1: int32 = oldy + CURSOR_H
    if ptr_y < y0:
        y0 = ptr_y
    if ptr_y + CURSOR_H > y1:
        y1 = ptr_y + CURSOR_H
    present_rows(y0, y1)
    return y1 - y0



# One line per bench_live_every FULL frames, to stderr, then reset. Every
# figure is microseconds PER FULL FRAME over that window.
def bench_live_dump():
    d: uint64 = cast[uint64](bench_live_n)
    if d == 0:
        return
    bench_live_seq = bench_live_seq + 1
    puts(2, "benchlive: seq ")
    putd(2, bench_live_seq)
    puts(2, " frames ")
    putd(2, bench_live_n)
    puts(2, " windows ")
    putd(2, cast[int32](n_win))
    puts(2, " | clear ")
    putd(2, cast[int32](t_clear / d))
    puts(2, " scene ")
    putd(2, cast[int32](t_scene / d))
    puts(2, " rast ")
    putd(2, cast[int32](t_rast / d))
    puts(2, " copy ")
    putd(2, cast[int32](t_copy / d))
    puts(2, " backbuf ")
    putd(2, cast[int32](t_bb / d))
    puts(2, " cursor ")
    putd(2, cast[int32](t_cur / d))
    puts(2, " present ")
    putd(2, cast[int32](t_pres / d))
    puts(2, " writeback ")
    if n_pres_w > 0:
        putd(2, cast[int32](t_pres_w / n_pres_w))
    else:
        putd(2, 0)
    puts(2, " | gpu_frames ")
    putd(2, vk_frames_gpu)
    puts(2, " refused ")
    putd(2, cast[int32](vk_refused))
    puts(2, " capped ")
    putd(2, cast[int32](n_capped))
    if t_loop_n > 0:
        puts(2, " | iters ")
        putd(2, cast[int32](t_loop_n))
        puts(2, " scan_us ")
        putd(2, cast[int32](t_scan / t_loop_n))
        puts(2, " pub_us ")
        putd(2, cast[int32](t_pub / t_loop_n))
    t_scan = 0
    t_pub = 0
    t_loop_n = 0
    # EXACT RATE, not one derived by dividing a dump count by a wall clock the
    # caller guessed at. My first scanout rate was computed that way and was
    # wrong by more than 3x, because startup time landed inside the divisor.
    tnow: uint64 = now_us()
    if bench_live_t0 > 0:
        dt: uint64 = tnow - bench_live_t0
        puts(2, " | dt_us ")
        putd(2, cast[int32](dt))
        puts(2, " fps ")
        if dt > 0:
            putd(2, cast[int32](d * 1000000 / dt))
    bench_live_t0 = tnow
    # INPUT -> FRAME SUBMITTED, from inside the compositor, so it can be
    # measured on the scanout path where no framebuffer file exists.
    if lat_n > 0:
        k: uint64 = 0
        while k < lat_n:
            lat_sort[k] = lat_ring[k]
            k = k + 1
        a: uint64 = 1
        while a < lat_n:
            v: uint32 = lat_sort[a]
            b: int64 = cast[int64](a) - 1
            while b >= 0 and lat_sort[cast[uint64](b)] > v:
                lat_sort[cast[uint64](b) + 1] = lat_sort[cast[uint64](b)]
                b = b - 1
            lat_sort[cast[uint64](b) + 1] = v
            a = a + 1
        puts(2, " | lat_n ")
        putd(2, cast[int32](lat_n))
        puts(2, " p50_us ")
        putd(2, cast[int32](lat_sort[lat_n / 2]))
        puts(2, " p95_us ")
        putd(2, cast[int32](lat_sort[(lat_n * 95) / 100]))
        puts(2, " max_us ")
        putd(2, cast[int32](lat_sort[lat_n - 1]))
    lat_n = 0 
    puts(2, " submit_us ")
    putd(2, cast[int32](vk_linux_last_submit_us()))
    puts(2, "\n")
    t_clear = 0
    t_scene = 0
    t_rast = 0
    t_copy = 0
    t_bb = 0
    t_cur = 0
    t_pres = 0
    t_pres_w = 0
    b_pres_w = 0
    n_pres_w = 0
    bench_live_n = 0


def bench_live_tick():
    if bench_live_every <= 0:
        return
    bench_live_n = bench_live_n + 1
    if bench_live_n >= bench_live_every:
        bench_live_dump()


def paint_frame():
    t0: uint64 = 0
    # With device compositing the WHOLE frame is one device frame: clear,
    # every window and the cursor accumulate into one op list and one submit.
    # Opening it here rather than per-site is what keeps the submit count at
    # one -- paint_window's own vk_route_begin nests inside it (vkc_begin).
    if vk_devcomp != 0:
        if vkc_begin() != 0:
            # No composite to fall back to: the CPU cannot draw this frame.
            # Say so and stop, rather than present a stale or half-drawn
            # screen. Process death is also the console recovery on the
            # scanout path -- see user/linux-fb.c.
            puts(2, "wsysd: FATAL device frame would not open and there is no")
            puts(2, " CPU composite to fall back to (device compositing)\n")
            sys_exit(1)
    if bench_on != 0:
        t0 = now_us()
    clear_desktop()
    if bench_on != 0:
        t_clear = t_clear + (now_us() - t0)
    i: uint64 = 0
    while i < n_win:
        paint_window(i)
        i = i + 1
    if bench_on != 0:
        t0 = now_us()
    # The save-under is taken from the freshly composed, cursor-free screen --
    # that is what makes the incremental path above sound.
    cur_saved = 0
    cursor_save_under(ptr_x, ptr_y)
    paint_cursor()
    if bench_on != 0:
        t_cur = t_cur + (now_us() - t0)
    # Close the device frame BEFORE present: present reads the composite (or,
    # on the scanout path, flips), and either way the device's writes have to
    # have landed first. vkc_end() is the submit and the fence wait.
    if vk_devcomp != 0:
        if vkc_end() != 0:
            puts(2, "wsysd: FATAL the device dropped a frame and there is no")
            puts(2, " CPU composite to redraw it into (device compositing)\n")
            sys_exit(1)
        vk_frames_gpu = vk_frames_gpu + 1
    if bench_on != 0:
        t0 = now_us()
    present()
    if bench_on != 0:
        t_pres = t_pres + (now_us() - t0)


# ====================================================================
# input
# ====================================================================
def route_key(code: int32):
    # The compositor gates the keyboard: only the FOCUSED window's ring gets
    # the byte. That is devwsys.ad's wsys_route_key_byte, and it is why an
    # unfocused app cannot read what the user types.
    if focus_wid < 2:
        return
    winpath(focus_wid, "keys")
    i: uint64 = 0
    ctlbuf[0] = 100                                      # 'd', a press
    ctlbuf[1] = 32
    i = emit_int(&ctlbuf[0], 2, code)
    ctlbuf[i] = 10
    ctlbuf[i + 1] = 0
    write_path(cast[Ptr[char]](&pathbuf[0]), &ctlbuf[0])


# THE ROUTED POINTER GOES ON THE **EVENT** RING. THAT IS THE CANONICAL ONE.
#
# THE DEFECT THIS FIXES. `deliver_pointer` used to write the routed line to
# `/dev/wsys/<wid>/pointer` and to nothing else. `lib/hamui.ad` reads that
# file, so every ordinary hamUI application was fine -- but the two programs a
# person actually points at, `user/hampanelscene.ad` (the panel, the
# Applications menu, the taskbar) and `user/hamdesktop.ad` (the wallpaper and
# the icons), read `/dev/wsys/<wid>/event`, and NOTHING in this port ever
# wrote a pointer line to an event ring. Measured with a window whose owner
# drained neither ring: after a full evdev click `pointer` held its line and
# `event` was EMPTY. The DE chrome could not be clicked with a mouse at all.
# Every gate that drives the chrome (tests/linux/distro_menu.sh,
# tests/linux/de_appmenu_band.sh) wrote the event ring BY HAND as host owner,
# which is exactly why none of them noticed.
#
# WHICH RING IS CANONICAL, and why it is this one. Hamnix answers it: its
# router (`~/Hamnix/sys/src/9/port/devwsys.ad`, `_wsys_route_common` ->
# `_wsys_evt_emit_pointer`, line 12384) pushes the window-local pointer line
# onto the EVENT ring and only there. The pointer ring still exists in devwsys
# but nothing routes into it -- `~/Hamnix/user/hamappmenu.ad:415` says so in
# as many words: "read the MODERN per-window /event ring, not the legacy
# /pointer ... the old userland compositor is retired, so /pointer is now
# DEAD". Matching Hamnix's shape is this line's default and there is no reason
# to deviate: the event ring is also the only one that can carry the 'f'
# focus and 'r' resize lines a chrome program needs interleaved with pointer
# lines IN ORDER, and it is the ring every scene client in user/ already
# drains. So `event` is canonical.
#
# `pointer` is still written, unchanged, because on THIS line it is not dead:
# `lib/hamui.ad` reads it (`_h_poll_pointer`) and every hamUI application in
# user/ inherits that. Retiring it is Hamnix's migration, not this fix's, and
# doing it here would break every hamUI window in the image to fix the chrome.
#
# THE LINE SHAPE ON THE EVENT RING IS HAMNIX'S, NOT THIS PORT'S. devwsys emits
# `m <x> <y> <buttons> <dz>\n` for motion, press, release AND scroll alike --
# the TYPE byte is always 'm' and the button STATE lives in the bitmap, which
# is what `hampanelscene`'s edge detector is written against (it derives a
# press from `bv & (bv ^ prev_bv)`). Forwarding this port's d/u/s type bytes
# would be a second protocol that no client in the tree parses.
def route_pointer_event(wid: int32, lx: int32, ly: int32,
                        btn: int32, dz: int32):
    if wid < 2:
        return
    winpath(wid, "event")
    ctlbuf[0] = 109                                      # 'm', always
    ctlbuf[1] = 32
    i: uint64 = emit_int(&ctlbuf[0], 2, lx)
    ctlbuf[i] = 32
    i = emit_int(&ctlbuf[0], i + 1, ly)
    ctlbuf[i] = 32
    i = emit_int(&ctlbuf[0], i + 1, btn)
    ctlbuf[i] = 32
    i = emit_int(&ctlbuf[0], i + 1, dz)
    ctlbuf[i] = 10
    ctlbuf[i + 1] = 0
    write_path(cast[Ptr[char]](&pathbuf[0]), &ctlbuf[0])


# --- FOCUS IS AN EVENT, NOT JUST A VARIABLE ---------------------------
#
# THE DEFECT THIS FIXES. `focus_wid` was a private variable of this
# compositor. It decided which window got keys and which titlebar was drawn
# active, and it was NEVER TOLD TO ANYONE. Hamnix's devwsys pushes `f in\n` /
# `f out\n` onto the per-window EVENT ring on every focus change
# (`_wsys_set_focus` -> `_wsys_evt_emit_focus`,
# `~/Hamnix/sys/src/9/port/devwsys.ad:12399`); this port emitted no `f` line
# at all. The visible consequence, in the first ten seconds of using the
# desktop: `user/hampanelscene.ad` ALREADY parses `f out` and closes its
# Applications dropdown on it (`_drain_events`, the `102 32` branch) -- so the
# dismiss-by-clicking-away path was fully written on the client side and had
# nothing to trigger it. An open menu could only be closed by hitting the same
# button a second time. Clicking the wallpaper, or any other window, left it
# hanging over the desktop.
#
# THE LINE SHAPE IS HAMNIX'S, byte for byte: `f in\n` when a window GAINS
# focus, `f out\n` when it LOSES it. No wid on the line -- the ring is already
# per-window, so the recipient is the addressee. Same ring as the `m` pointer
# lines, which is the whole point: a client reading one file sees focus and
# pointer IN ORDER against each other.
#
# THE ORDER THIS GUARANTEES, and how. `pump_input` -> `deliver_pointer` ->
# `set_focus` all run on wsysd's single thread, and every write here is a
# synchronous open/write/close on /dev/wsys. So for one focus change from A
# to B, in this exact order and with no interleaving possible:
#     1. `f out` is written to A's ring and has RETURNED,
#     2. `focus_wid` becomes B,
#     3. `f in` is written to B's ring,
#     4. only THEN does the caller emit the `m <x> <y> <buttons> <dz>` line
#        for the very press that moved the focus (deliver_pointer sets focus
#        before it routes, exactly as devwsys's router does -- focus first,
#        `_wsys_evt_emit_pointer` after).
# A client therefore never sees the press that raised it before the `f in`
# that explains it, and the losing window's `f out` is never delivered after
# the gaining window has already been told it won. Matching devwsys's
# ordering is the default here and there is no reason to deviate.
#
# WHAT "FOCUS MOVED AWAY" MEANS, in the three cases that differ:
#   * CLICK ON THE WALLPAPER. hamdesktop's backdrop is a real window with a
#     real wid, so this is an ordinary focus change: the panel gets `f out`,
#     the desktop gets `f in`, the dropdown closes.
#   * CLICK ON ANOTHER WINDOW. Identical mechanism; the only difference is
#     which wid gains.
#   * CLICK ON THE MENU'S OWN PARENT (the Applications button). In this port
#     the dropdown is NOT a separate override-redirect window -- the panel
#     GROWS ITS OWN WINDOW to host the card (`_toggle_appmenu`, and the
#     window-height change is what tests/linux/de_mouse_chrome.sh measures).
#     So the click lands on the already-focused window, `set_focus` sees
#     `wid == focus_wid` and returns having emitted NOTHING, and the press is
#     routed as a plain `m` line to the panel's own toggle. That is what keeps
#     the click-the-button-again dismiss working: a spurious `f out`/`f in`
#     pair here would close the menu on the focus line and then re-open it on
#     the press, or vice versa, depending on which the panel processed last.
#     The equality gate is load-bearing, not an optimisation.
# A press on bare backdrop with NO window under it drops focus to 0: the
# loser gets `f out` and nobody gains, which is devwsys's `_wsys_set_focus(0)`
# on `pressed == 1 and target == 0`.
def route_focus_event(wid: int32, gained: int32):
    # "f in\n" / "f out\n" on /dev/wsys/<wid>/event. wid 0 is "nobody" and
    # wid 1 is the root/foreground, neither of which has a client ring.
    if wid < 2:
        return
    winpath(wid, "event")
    ctlbuf[0] = 102                                      # 'f'
    ctlbuf[1] = 32
    i: uint64 = 2
    if gained != 0:
        ctlbuf[2] = 105                                  # 'i'
        ctlbuf[3] = 110                                  # 'n'
        i = 4
    else:
        ctlbuf[2] = 111                                  # 'o'
        ctlbuf[3] = 117                                  # 'u'
        ctlbuf[4] = 116                                  # 't'
        i = 5
    ctlbuf[i] = 10
    ctlbuf[i + 1] = 0
    write_path(cast[Ptr[char]](&pathbuf[0]), &ctlbuf[0])


def set_focus(wid: int32):
    # The ONE place focus_wid changes. See the comment above for the order
    # this guarantees and why the no-change early return is load-bearing.
    if wid == focus_wid:
        return
    old: int32 = focus_wid
    # Only tell a window it lost focus if it is still THERE. A window that was
    # destroyed while focused (the close box, a client exit) has no ring to
    # write to, and pick_focus reassigns focus straight afterwards.
    if old >= 2 and win_index(old) >= 0:
        route_focus_event(old, 0)
    focus_wid = wid
    if wid >= 2:
        route_focus_event(wid, 1)


def route_pointer(wid: int32, kind: uint8, lx: int32, ly: int32,
                  btn: int32, dz: int32):
    # "<type> <x> <y> <buttons> <dz>\n" with x,y already mapped to WINDOW-LOCAL
    # pixels. lib/hamui.ad sets its cursor straight from these, with no delta
    # accumulation and no clamp, precisely because the compositor did the
    # routing -- so getting the mapping right here is the whole contract.
    if wid < 2:
        return
    winpath(wid, "pointer")
    ctlbuf[0] = kind
    ctlbuf[1] = 32
    i: uint64 = emit_int(&ctlbuf[0], 2, lx)
    ctlbuf[i] = 32
    i = emit_int(&ctlbuf[0], i + 1, ly)
    ctlbuf[i] = 32
    i = emit_int(&ctlbuf[0], i + 1, btn)
    ctlbuf[i] = 32
    i = emit_int(&ctlbuf[0], i + 1, dz)
    ctlbuf[i] = 10
    ctlbuf[i + 1] = 0
    write_path(cast[Ptr[char]](&pathbuf[0]), &ctlbuf[0])


# --- the close button -------------------------------------------------
#
# A WINDOW YOU CANNOT CLOSE IS NOT A WINDOW ON A DESKTOP. There was no close
# button here at all, for a defensible reason: the only thing this compositor
# could have done with a click was write `close <wid>` on the global ctl,
# which DESTROYS THE WINDOW RECORD and leaves the program running -- an
# invisible xterm holding a shell, a browser you cannot see and cannot quit.
# That is worse than no button.
#
# So the device grew a second verb. `delete <wid>` asks the window's OWNER to
# close it if the owner said it wanted to be asked (`wmdelete 1` on the
# window's ctl), and destroys it exactly as `close` does if it did not. For a
# bridged X client user/wsyswl.ad turns that request into WM_DELETE_WINDOW;
# for a native Wayland toplevel, into xdg_toplevel.close. A scene app that
# has never heard of any of this is closed the way it always was.
#
# The geometry is computed in ONE place and used by both the painter and the
# hit test, because a close button drawn somewhere other than where it is
# clickable is the kind of defect that takes a day and looks like a driver.
CLOSE_SZ: int32 = 14
cb_x: int32 = 0
cb_y: int32 = 0


def close_box_at(ox: int32, oy: int32, w: int32):
    cb_x = ox + w - CLOSE_SZ - 3
    cb_y = oy - TITLEBAR_H + (TITLEBAR_H - CLOSE_SZ) / 2


def draw_close_box(ox: int32, oy: int32, w: int32):
    # Not on a window too narrow to hold one: half a close button over the
    # left edge of a 20-pixel window is a smear, not a control.
    if w < CLOSE_SZ * 3:
        return
    close_box_at(ox, oy, w)
    fill_rect(cb_x, cb_y, CLOSE_SZ, CLOSE_SZ, 13391163)  # 0xCC553B
    # The cross, two diagonals, one pixel at a time. Fourteen rows of two
    # single-pixel spans per decorated window per frame -- the fill_rect above
    # already costs more than this does.
    k: int32 = 3
    while k < CLOSE_SZ - 3:
        fill_rect(cb_x + k, cb_y + k, 1, 1, 16777215)
        fill_rect(cb_x + CLOSE_SZ - 1 - k, cb_y + k, 1, 1, 16777215)
        k = k + 1


# ====================================================================
# THE TITLE ON THE TITLE BAR
# ====================================================================
# Left inset of the text from the window's left edge, and the gap kept clear
# between the end of the text and the close box. TITLE_TOP is where the 16px
# text cell sits in the 22px bar; the `glyphs` verb is CELL-anchored (its
# baseline is y+12, lib/hamui_host.ad:_draw_text), which is the same
# anchoring every hamUI app's own text uses, so the title sits on the bar
# exactly the way a label sits in a window.
TITLE_PAD:  int32 = 5
TITLE_GAP:  int32 = 5
TITLE_TOP:  int32 = 3

# The widest run of text window `i` is allowed to put on its bar, in pixels.
# THIS IS THE CLIP, and it is computed from the SAME numbers draw_close_box
# uses -- close_box_at() is called here rather than the arithmetic repeated,
# because a title that runs under the close button and a close button drawn
# where the title is are the same bug with two spellings.
def title_avail_w(ox: int32, oy: int32, w: int32) -> int32:
    right: int32 = ox + w - 3
    if w >= CLOSE_SZ * 3:
        close_box_at(ox, oy, w)
        right = cb_x - TITLE_GAP
    return right - (ox + TITLE_PAD)


# Build the run to draw into titlebuf and return its length, or 0 for nothing.
#
# WHAT A HOSTILE TITLE CANNOT DO, and this is the whole of it:
#
#  * IT CANNOT INJECT A DRAW OP. The run goes through hamscene_glyphs(), whose
#    _hs_emit_str maps `"` and newline to a space, so no byte of it can leave
#    the quoted token and become a `fill` or an `image` verb. That is the
#    library's guarantee, not this function's; this function ALSO maps every
#    byte outside printable ASCII to '.', so a run of control bytes is shown
#    as dots rather than fed to a glyph rasterizer as a codepoint.
#  * IT CANNOT BE WIDER THAN THE BAR. Measured with htb_text_width(), which
#    sums the SAME per-glyph advances lib/hamui_host.ad's _blit_glyph_prop
#    draws with (lib/hamtextbox.ad exists to be the one place that owns that
#    sum), and ellipsised down until it fits.
#  * AND IF THAT MEASUREMENT WERE WRONG IT STILL COULD NOT OVERRUN, because
#    title_draw() rasterizes into a surface exactly `avail` pixels wide and
#    blits exactly that surface. The measurement decides where the text is
#    CUT; the surface decides where the ink can REACH. Two independent
#    bounds, because one of them is arithmetic and arithmetic is what gets
#    this wrong.
#
# What a hostile title CAN do is put 63 bytes of its choosing, in the chrome's
# own colour, on another client's title bar -- it can lie about which window
# is which. That is not fixable here: it needs a per-uid window-table mapping
# or an RPC compositor (user/linux-wsys.c names the same limit for the scene
# and the key ring). Sanitizing bytes does not make a 0666 table trustworthy
# and this comment is not pretending it does.
def title_build(i: uint64, avail: int32) -> uint64:
    src: uint64 = i * WSYSD_TITLE_CAP
    n: uint64 = 0
    while n < WSYSD_TITLE_CAP - 1 and win_title[src + n] != 0:
        c: uint8 = win_title[src + n]
        if c < 32 or c > 126:
            c = 46                             # '.' -- shown, never obeyed
        titlebuf[n] = c
        n = n + 1
    titlebuf[n] = 0
    if n == 0:
        return 0
    if htb_text_width(&titlebuf[0], n) <= avail:
        return n
    # Too wide: ellipsise. Drop bytes off the end until the run PLUS the three
    # dots fits. If not even the dots fit, draw nothing -- three dots jammed
    # against a close button say less than an empty bar does.
    ew: int32 = htb_text_width(cast[Ptr[uint8]]("..."), 3)
    if ew > avail:
        return 0
    keep: uint64 = n
    while keep > 0 and htb_text_width(&titlebuf[0], keep) + ew > avail:
        keep = keep - 1
    titlebuf[keep] = 46
    titlebuf[keep + 1] = 46
    titlebuf[keep + 2] = 46
    titlebuf[keep + 3] = 0
    return keep + 3


# Paint window `i`'s name on its title bar.
#
# HOW, and deliberately NOT with a font of its own. The text is a one-line
# hamscene display list (`glyphs x y "..." #RRGGBB`, built by the same
# lib/hamscene.ad builders every DE client uses) rasterized by the same
# lib/hamui_host.ad this compositor already rasterizes every window with --
# which means the same DejaVu Sans face at the same 14px through the same
# anti-aliased TrueType path, so the name on the bar is the same text the app
# draws inside it. There is no second font system in this file and there must
# not be one.
#
# The surface is TITLE-BAR SIZED and presented BLENDED, not opaque: the clear
# that opens the rasterize leaves alpha 0 (hamui_host_set_clear_alpha), each
# glyph leaves its own anti-aliased COVERAGE in the alpha byte, and
# blit_window_image_mode(mode 2) source-overs that onto the bar -- so the bar
# colour painted a moment ago shows between the letters instead of being
# replaced by a black box, and the soft edge of each letter blends against the
# bar instead of against nothing.
#
# IT WAS `keyed` (mode 1) AND IT WAS A BLACK BOX ANYWAY, which is the whole
# lesson of this function. Two things were wrong under one symptom:
#
#   * the glyph stamp forced alpha 255 across each glyph's BOUNDING BOX, cov==0
#     cells included (lib/vk/vk_2d.ad's vk2d_raster_cov_mask fast path, whose
#     comment states the assumption it is making: "same value the composite
#     target holds" -- true of every target but a keyed one). Every unpainted
#     cell inside a letter's box was therefore declared PAINTED, and painted
#     black, so `keyed` correctly blitted a black box. The clear was
#     transparent, the key was honoured, the ink was #f0f0f5 to the byte, and
#     the answer was still black. Fixed in vk2d_raster_cov_mask_over.
#   * and `keyed` is the wrong present for text even once alpha is honest:
#     all-or-nothing writes a 1/255-coverage edge pixel as FULL-strength ink.
#     Anti-aliased text needs the ramp, which is mode 2.
#
# The panel's dropdown and the cursor sprite still use the keyed present; they
# are hard-edged fills, which is what mode 1 is for.
#
# ON hamui_host_uncovered_rows(). It is not the instrument for this layer and
# saying so is more useful than a green number: it unions the destination
# rects of the FILL and BLIT helpers only (lib/hamui_host.ad's _host_cov_add
# call sites), and glyph ink is stamped through vk2d_raster_cov_mask, which is
# not one of them. It would report every row of the title surface uncovered no
# matter what was drawn -- which is also why report_uncovered() below exempts
# keyed presents: a keyed surface is SUPPOSED to be mostly unpainted. The
# clip is proven on framebuffer pixels instead, in tests/linux/wsys_title.sh.
def title_draw(i: uint64, ox: int32, oy: int32, w: int32):
    avail: int32 = title_avail_w(ox, oy, w)
    if avail < 8:
        return
    n: uint64 = title_build(i, avail)
    if n == 0:
        return
    hamscene_begin()
    hamscene_glyphs(0, TITLE_TOP, &titlebuf[0], "#F0F0F5")
    hamui_host_set_clear_alpha(0)
    hamui_host_begin(avail, TITLEBAR_H)
    hamui_host_rasterize()
    blit_window_image_mode(ox + TITLE_PAD, oy - TITLEBAR_H, avail,
                           TITLEBAR_H, 2)


# 1 = (x, y) in screen coordinates is inside window i's close button.
def close_box_hit(i: uint64, x: int32, y: int32) -> int32:
    if win_dec[i] == 0:
        return 0
    if win_w[i] < CLOSE_SZ * 3:
        return 0
    close_box_at(win_x[i], win_y[i], win_w[i])
    if x < cb_x or x >= cb_x + CLOSE_SZ:
        return 0
    if y < cb_y or y >= cb_y + CLOSE_SZ:
        return 0
    return 1


def delete_window(wid: int32):
    i: uint64 = 0
    p: Ptr[uint8] = "delete "
    k: uint64 = 0
    while p[k] != 0:
        ctlbuf[i] = p[k]
        i = i + 1
        k = k + 1
    i = emit_int(&ctlbuf[0], i, wid)
    ctlbuf[i] = 10
    ctlbuf[i + 1] = 0
    write_path(cast[Ptr[char]]("/dev/wsys/ctl"), &ctlbuf[0])


# The topmost visible window under (x, y), or 0. Walks the z-sorted list
# backwards, so the window the user sees on top is the one that gets the click.
def window_at(x: int32, y: int32) -> int32:
    i: uint64 = n_win
    while i > 0:
        i = i - 1
        if win_vis[i] == 0:
            continue
        top: int32 = win_y[i]
        if win_dec[i] != 0:
            top = top - TITLEBAR_H
        if x >= win_x[i] and x < win_x[i] + win_w[i]:
            if y >= top and y < win_y[i] + win_h[i]:
                return win_id[i]
    return 0


def win_index(wid: int32) -> int64:
    i: uint64 = 0
    while i < n_win:
        if win_id[i] == wid:
            return cast[int64](i)
        i = i + 1
    return -1


def raise_window(wid: int32):
    i: uint64 = 0
    p: Ptr[uint8] = "raise "
    k: uint64 = 0
    while p[k] != 0:
        ctlbuf[i] = p[k]
        i = i + 1
        k = k + 1
    i = emit_int(&ctlbuf[0], i, wid)
    ctlbuf[i] = 10
    ctlbuf[i + 1] = 0
    write_path(cast[Ptr[char]]("/dev/wsys/ctl"), &ctlbuf[0])


def deliver_pointer():
    # Route the current pointer state to whichever window is under it. Motion
    # goes out only when something actually changed, so a still mouse costs
    # nothing.
    if ptr_moved == 0 and ptr_edge == 0 and ptr_dz == 0:
        return
    wid: int32 = window_at(ptr_x, ptr_y)
    if wid < 2:
        # A PRESS ON BARE BACKDROP -- no window under the cursor at all --
        # drops focus to "nobody", so whatever held it gets `f out` and can
        # self-dismiss. devwsys does exactly this (`if pressed == 1 and
        # target == 0: _wsys_set_focus(0)`). Without it, a click on a part of
        # the screen no window covers left an open dropdown hanging.
        if ptr_edge > 0:
            set_focus(0)
        ptr_moved = 0
        ptr_edge = 0
        ptr_dz = 0
        return
    idx: int64 = win_index(wid)
    if idx < 0:
        return
    i: uint64 = cast[uint64](idx)
    lx: int32 = ptr_x - win_x[i]
    ly: int32 = ptr_y - win_y[i]
    kind: uint8 = 109                                    # 'm' motion
    if ptr_edge > 0:
        kind = 100                                       # 'd' button down
        # THE CLOSE BUTTON, before anything else a press does. It is part of
        # the DECORATION, which is this compositor's and not the client's, so
        # the press is consumed here and never routed: a window must not
        # receive a click on the button that is closing it.
        if close_box_hit(i, ptr_x, ptr_y) != 0:
            delete_window(wid)
            n_ptr = n_ptr + 1
            ptr_moved = 0
            ptr_edge = 0
            ptr_dz = 0
            return
        # A press is also what raises and focuses a window -- click-to-focus,
        # the behaviour every one of these apps was written against.
        if wid != focus_wid:
            raise_window(wid)
            # set_focus, not `focus_wid = wid`: the window that is losing
            # focus has to be TOLD. It emits `f out` to the loser and `f in`
            # to wid, both BEFORE the route_pointer_event below puts this
            # press's `m` line on wid's ring -- the same order devwsys uses.
            set_focus(wid)
    elif ptr_edge < 0:
        kind = 117                                       # 'u' button up
    elif ptr_dz != 0:
        kind = 115                                       # 's' scroll
    route_pointer(wid, kind, lx, ly, ptr_btn, ptr_dz)
    # ...and the CANONICAL ring, which is what the panel and the desktop read.
    # See route_pointer_event: without this line the DE chrome is inert under a
    # real mouse.
    route_pointer_event(wid, lx, ly, ptr_btn, ptr_dz)
    n_ptr = n_ptr + 1
    ptr_moved = 0
    ptr_edge = 0
    ptr_dz = 0


# --- the evdev keymap -------------------------------------------------
def kset(code: uint64, plain: uint8, shifted: uint8):
    kmap[code] = plain
    kshift[code] = shifted


def keymap_init():
    # Row by row, the way a US keyboard is laid out. Codes are Linux KEY_*.
    kset(1, 27, 27)                                      # ESC
    row: Ptr[uint8] = "1234567890-="
    srow: Ptr[uint8] = "!@#$%^&*()_+"
    i: uint64 = 0
    while i < 12:
        kset(2 + i, row[i], srow[i])
        i = i + 1
    kset(14, 8, 8)                                       # BACKSPACE
    kset(15, 9, 9)                                       # TAB
    q: Ptr[uint8] = "qwertyuiop[]"
    qs: Ptr[uint8] = "QWERTYUIOP{}"
    i = 0
    while i < 12:
        kset(16 + i, q[i], qs[i])
        i = i + 1
    kset(28, 10, 10)                                     # ENTER
    a: Ptr[uint8] = "asdfghjkl"
    au: Ptr[uint8] = "ASDFGHJKL"
    i = 0
    while i < 9:
        kset(30 + i, a[i], au[i])
        i = i + 1
    # The three that follow are spelled out rather than put in a literal: the
    # shifted row would need an escaped double quote, and Adder string literals
    # do not carry one.
    kset(39, 59, 58)                                     # ;  :
    kset(40, 39, 34)                                     # '  "
    kset(41, 96, 126)                                    # `  ~
    kset(43, 92, 124)                                    # \ |
    z: Ptr[uint8] = "zxcvbnm,./"
    zs: Ptr[uint8] = "ZXCVBNM<>?"
    i = 0
    while i < 10:
        kset(44 + i, z[i], zs[i])
        i = i + 1
    kset(57, 32, 32)                                     # SPACE
    kset(111, 127, 127)                                  # DELETE


def route_arrow(final: uint8):
    # hamui's key dispatch reads arrows as the three bytes of an ESC sequence,
    # because that is what they were when input came off a serial console.
    # Nothing downstream had to change when the compositor took over routing.
    route_key(27)
    route_key(91)
    route_key(cast[int32](final))


def handle_key(code: int32, value: int32):
    # value: 0 = release, 1 = press, 2 = autorepeat.
    if code == 42 or code == 54:
        if value == 0:
            shift_down = 0
        else:
            shift_down = 1
        return
    if code == 29 or code == 97:
        if value == 0:
            ctrl_down = 0
        else:
            ctrl_down = 1
        return
    if value == 0:
        return
    if code == 103:
        route_arrow(65)                                  # up    -> ESC [ A
        return
    if code == 108:
        route_arrow(66)                                  # down
        return
    if code == 106:
        route_arrow(67)                                  # right
        return
    if code == 105:
        route_arrow(68)                                  # left
        return
    if code < 0 or code >= 128:
        return
    ch: uint8 = kmap[code]
    if shift_down != 0:
        ch = kshift[code]
    if ch == 0:
        return
    n_keys = n_keys + 1
    if ctrl_down != 0 and ch >= 97 and ch <= 122:
        ch = ch - 96                                     # ^A .. ^Z
    route_key(cast[int32](ch))


def handle_button(code: int32, value: int32):
    bit: int32 = 0
    if code == 272:
        bit = 1                                          # BTN_LEFT
    elif code == 273:
        bit = 2                                          # BTN_RIGHT
    elif code == 274:
        bit = 4                                          # BTN_MIDDLE
    if bit == 0:
        return
    if value != 0:
        ptr_btn = ptr_btn | bit
        ptr_edge = 1
    else:
        ptr_btn = ptr_btn & (0 - 1 - bit)
        ptr_edge = -1


def open_input_path(path: Ptr[char]) -> int32:
    if n_input >= MAX_INPUT:
        return -1
    fd: int32 = sys_open(path)
    if fd < 0:
        return -1
    in_fd[n_input] = fd
    n_input = n_input + 1
    return fd


def open_inputs():
    # HAMWSYSD_INPUT NAMES THE ONLY INPUT DEVICE, and it exists for the same
    # reason HAMFB_FILE does: an offscreen compositor with no pointer cannot be
    # asked anything a pointer does, and "does the close button close the
    # window" is exactly that question. It is not a private protocol -- what is
    # read from it is evdev, byte for byte, the same 24-byte struct input_event
    # the real nodes deliver, dispatched by the same loop below. A test that
    # invented its own event format would be testing its own invention.
    #
    # And it REPLACES the scan rather than adding to it: an offscreen run on a
    # development host must not open that host's real keyboard and mouse.
    ip: Ptr[uint8] = getenv(cast[Ptr[char]]("HAMWSYSD_INPUT"))
    if cast[uint64](ip) != 0 and ip[0] != 0:
        k: uint64 = 0
        while ip[k] != 0 and k < 255:
            inpath[k] = ip[k]
            k = k + 1
        inpath[k] = 0
        open_input_path(cast[Ptr[char]](&inpath[0]))
        puts(1, "wsysd: input from ")
        puts(1, &inpath[0])
        puts(1, " only\n")
        return
    # Every evdev node, because which one is the mouse and which the keyboard
    # depends on enumeration order and on whether the machine is a VM. Reading
    # them all and dispatching on the event TYPE is both simpler and right.
    i: int32 = 0
    while i < 16 and n_input < MAX_INPUT:
        j: uint64 = 0
        p: Ptr[uint8] = "/dev/input/event"
        k: uint64 = 0
        while p[k] != 0:
            pathbuf[j] = p[k]
            j = j + 1
            k = k + 1
        j = emit_int(&pathbuf[0], j, i)
        pathbuf[j] = 0
        open_input_path(cast[Ptr[char]](&pathbuf[0]))
        i = i + 1
    puts(1, "wsysd: ")
    putd(1, cast[int32](n_input))
    puts(1, " input devices\n")


def le16(b: Ptr[uint8], at: uint64) -> int32:
    return cast[int32](b[at]) | (cast[int32](b[at + 1]) << 8)


def le32(b: Ptr[uint8], at: uint64) -> int32:
    return cast[int32](b[at]) | (cast[int32](b[at + 1]) << 8) \
         | (cast[int32](b[at + 2]) << 16) | (cast[int32](b[at + 3]) << 24)


# CLOCK_REALTIME, because that is the clock evdev stamps events with by
# default. now_us() is CLOCK_MONOTONIC and mixing the two produces a number
# that is not a duration at all.
def now_us_real() -> uint64:
    ts_scratch[0] = 0
    ts_scratch[1] = 0
    if sys_clock_gettime(0, &ts_scratch[0]) != 0:
        return 0
    return ts_scratch[0] * 1000000 + ts_scratch[1] / 1000


def lat_mark_input(ev_us: uint64):
    # THE EVENT'S OWN TIMESTAMP, not the moment we got round to reading it.
    #
    # The first version stamped now_us() here, and its selftest caught it: with
    # the compositor SIGSTOPped for 120 ms the reported max was 9.5 ms, because
    # a stopped process is not reading input, so the clock only started once it
    # RESUMED. It measured how long wsysd took AFTER noticing, which is exactly
    # the latency a user does not care about, and it hid every stall.
    #
    # First input since the last present starts the clock; later events in the
    # same batch ride the same frame and must not restart it, or a burst would
    # measure only its last event and flatter the result.
    if lat_pending == 0 and ev_us > 0:
        lat_pending = ev_us


def lat_record():
    if lat_pending == 0:
        return
    tnow: uint64 = now_us_real()
    if tnow <= lat_pending:
        lat_pending = 0
        return
    dt: uint64 = tnow - lat_pending
    lat_pending = 0
    if lat_n < LAT_CAP:
        lat_ring[lat_n] = cast[uint32](dt)
        lat_n = lat_n + 1


def pump_input():
    d: uint64 = 0
    while d < n_input:
        n: int64 = sys_read_nb(in_fd[d], &evbuf[0], 2400)
        # Same unsigned-compare trap as pump_keyboard: a negative n must never
        # reach the cast. An evdev node with no event pending returns EAGAIN
        # on every single poll, so this is the common case, not the rare one.
        if n <= 0:
            d = d + 1
            continue
        # struct input_event begins with a timeval: tv_sec then tv_usec, both
        # 64-bit on this ABI. That is the event's own arrival time.
        evs: Ptr[uint64] = cast[Ptr[uint64]](&evbuf[0])
        lat_mark_input(evs[0] * 1000000 + evs[1])
        i: uint64 = 0
        while i + 24 <= cast[uint64](n):
            # struct input_event: 16 bytes of timeval, then type, code, value.
            etype: int32 = le16(&evbuf[0], i + 16)
            ecode: int32 = le16(&evbuf[0], i + 18)
            eval_: int32 = le32(&evbuf[0], i + 20)
            if etype == 1:                               # EV_KEY
                if ecode >= 272 and ecode <= 274:
                    # A BUTTON EDGE FLUSHES THE ONE BEFORE IT. This loop
                    # drains every record the node has pending, and the frame
                    # loop only calls deliver_pointer() once afterwards -- so
                    # a press and its release read in the SAME pass used to
                    # collapse into a single 'u' with buttons 0, and the
                    # press was never delivered at all. Measured: seven evdev
                    # records written in one go (move, down, up) left the
                    # window's ring holding exactly `u 80 110 0 0`. A client
                    # that derives a click from the button BITMAP -- which is
                    # what hampanelscene does, and what devwsys's shape asks
                    # of it -- can never see that click. devwsys routes each
                    # event as it arrives; this is that, at the granularity
                    # this poll loop has.
                    if ptr_edge != 0:
                        deliver_pointer()
                    handle_button(ecode, eval_)
                else:
                    # A KEY FLUSHES A PENDING BUTTON EDGE, for the same reason
                    # a button edge flushes the one before it, and for one
                    # more: deliver_pointer is the ONLY thing that moves focus
                    # (click-to-focus; see pick_focus), and route_key drops
                    # anything that arrives while focus_wid < 2.
                    #
                    # This loop drains every record the node has pending in a
                    # single pass, so a click and the keystrokes typed straight
                    # after it are routinely in the SAME pass. Without this
                    # flush the press is still sitting in ptr_edge when the key
                    # is routed, focus is still whatever it was before the
                    # click, and the keystrokes go to the old window or to
                    # nobody. devwsys has the right order by construction --
                    # it routes each event as it arrives; this is that, at the
                    # granularity this poll loop has.
                    if ptr_edge != 0:
                        deliver_pointer()
                    handle_key(ecode, eval_)
            elif etype == 2:                             # EV_REL
                if ecode == 0:
                    ptr_x = ptr_x + eval_
                    ptr_moved = 1
                elif ecode == 1:
                    ptr_y = ptr_y + eval_
                    ptr_moved = 1
                elif ecode == 8:                         # REL_WHEEL
                    ptr_dz = ptr_dz + eval_
            elif etype == 3:                             # EV_ABS (tablet)
                # virtio-tablet and usb-tablet report 0..32767 across the
                # screen, which is the range QEMU advertises for both.
                if ecode == 0:
                    ptr_x = cast[int32]((cast[int64](eval_)
                                         * cast[int64](scr_w)) / 32768)
                    ptr_moved = 1
                elif ecode == 1:
                    ptr_y = cast[int32]((cast[int64](eval_)
                                         * cast[int64](scr_h)) / 32768)
                    ptr_moved = 1
            i = i + 24
        d = d + 1
    if ptr_x < 0:
        ptr_x = 0
    if ptr_y < 0:
        ptr_y = 0
    if ptr_x >= scr_w:
        ptr_x = scr_w - 1
    if ptr_y >= scr_h:
        ptr_y = scr_h - 1


def pump_keyboard():
    # Keys can also arrive on stdin -- a serial console has no evdev node at
    # all, and that is the only keyboard a headless boot has.
    n: int64 = sys_read_nb(0, &inbuf[0], 256)
    # A NEGATIVE return is an error (EAGAIN on a non-blocking tty with nothing
    # typed, EIO on a hung-up console), and it MUST be filtered before the
    # unsigned compare below: cast[uint64](-1) is 18446744073709551615, so the
    # loop then walked the whole address space one byte at a time and the
    # compositor died with SIGSEGV the moment stdin had no byte ready. This is
    # how wsysd crashed on every host run that did not redirect stdin.
    if n <= 0:
        return
    i: uint64 = 0
    while i < cast[uint64](n):
        route_key(cast[int32](inbuf[i]))
        i = i + 1


# --- building the wait set ------------------------------------------
# AN FD GOES IN THE WAIT SET ONLY IF IT IS PROVED IT CAN PARK ON IT, and the
# proof is run against the real sys_waitfds rather than reasoned about from
# the path name. The failure being guarded is specific and this tree has paid
# for it twice at one remove: poll(2) reports SOME descriptors readable
# always, whatever is or is not pending -- /dev/null does (every offscreen
# gate runs `wsysd </dev/null`, so stdin is exactly this), and so does a
# regular file that has been read to its end. Putting one of those in the set
# does not make the compositor faster; it makes the park return instantly,
# for ever, and the loop becomes a busy spin that burns a core AND reports a
# flattering latency while doing it.
#
# So: drain every input source, then ask for a ZERO-timeout wait on the one
# fd. A drained fd that still answers "ready" is answering about itself and
# not about any input, and it is left out. Three consecutive rounds are
# required before an fd is written off, because a genuine event arriving in
# the microseconds between the drain and the probe would otherwise disable a
# real device permanently; a 125 Hz mouse cannot be ready on three
# back-to-back probes, and the cost of being wrong in this direction is only
# the old 16 ms tick.
def fd_is_waitable(fd: int32) -> int32:
    t: int32 = 0
    while t < 3:
        pump_input()
        pump_keyboard()
        probefd[0] = fd
        if sys_waitfds(&probefd[0], 1, 0) <= 0:
            return 1
        t = t + 1
    return 0


wake_fd: int32 = -1
# The epoll fd standing for the mediator's listening socket AND every live
# client connection. One fd, because build_waitset runs once and the set of
# clients does not. -1 unless HAMWSYS_SERVER=1.
srv_fd: int32 = -1

# ====================================================================
# THE PRESENT CAP: do not draw faster than the screen can show
# ====================================================================
# Wake-on-client removed the pacing, and the frame rate went where the work
# allowed: a drag measured 434 fps on the software path and 910 on scanout,
# burning 99.9% of a core to render frames at a display that shows 60. That is
# not a win, it is a power bug with a flattering number attached, and it is the
# one thing standing between this loop and being a sensible default.
#
# frame_us comes from hamfb_frame_us() -- the mode ACTUALLY SET, not a
# constant, so a 144 Hz panel paces at 144 Hz and there is only ever one notion
# of frame time in the system. It is 0, meaning uncapped, offscreen under
# HAMFB_FILE (so every gate keeps measuring the compositor rather than a rate
# limiter, and the banked fps numbers stay comparable), on fbdev, and whenever
# the mode carries no usable timing.
frame_us:     int32 = 0
last_paint_us: uint64 = 0
paint_defer:  int32 = 0        # a frame is owed and was held back
n_capped:     uint64 = 0       # frames the cap coalesced away


# May we present now? The rule is deliberately NOT "wait for the next frame
# boundary": it is "only hold back a frame that would land inside the SAME
# frame interval as the last one".
#
# THE FIRST PRESENT AFTER A QUIET PERIOD IS NEVER DELAYED, and that is the
# whole design constraint rather than a nicety. A click, a keystroke, the first
# pixel of a drag -- these arrive after the compositor has been idle, so
# now - last_paint is large, and this returns 1 immediately. Adding even one
# frame time to those would undo the 0.28 ms input-to-pixel result on exactly
# the interactions people notice, to save power that an idle desktop was not
# spending anyway. Only the SECOND and subsequent frames of a continuous
# animation are ever held, which is precisely where the wasted 850 fps was.
def present_due() -> int32:
    if frame_us <= 0:
        return 1
    now: uint64 = now_us()
    if now < last_paint_us:
        return 1
    if now - last_paint_us >= cast[uint64](frame_us):
        return 1
    return 0


# How long the loop may park. Normally the fallback; but when a frame is owed,
# only until the frame boundary that lets it out -- otherwise a held frame
# would sit unpainted until the next input or client poke, and a drag that
# stopped moving would leave the screen one frame stale.
def wait_ms_now() -> int64:
    if paint_defer == 0 or frame_us <= 0:
        return WAIT_FALLBACK_MS
    now: uint64 = now_us()
    if now < last_paint_us:
        return 0
    d: uint64 = now - last_paint_us
    if d >= cast[uint64](frame_us):
        return 0
    left: int64 = cast[int64]((cast[uint64](frame_us) - d) / 1000) + 1
    if left > WAIT_FALLBACK_MS:
        return WAIT_FALLBACK_MS
    return left


def build_waitset():
    n_wait = 0
    nlie: int32 = 0
    # THE CLIENT WAKE, first in the set because it is the one that was missing.
    # Input fds cover a hand on a mouse; they do not cover a window MOVING,
    # which is a client writing <wid>/ctl and no kernel state changing at all.
    # Measured, that gap left client-driven repaint riding the fallback tick,
    # which was 85% of a drag frame's period. This is an ordinary pollable
    # socket, so the set stays on sys_waitfds' single uncapped poll(2) arm --
    # a /dev/wsys ring here would force a FUTEX_WAIT that no evdev fd can wake.
    wake_fd = hamwsys_wake_listen()
    if wake_fd >= 0 and n_wait < WAITSET_CAP:
        waitset[n_wait] = wake_fd
        n_wait = n_wait + 1
    # THE MEDIATOR, SECOND, AND DELIBERATELY NOT FIRST.
    #
    # waitset[0] is the client wake and ONLY the client wake -- the deferred
    # paint at the bottom of the loop passes waitset[1..] precisely so that a
    # publish cannot wake a frame that is already owed, while input still can.
    # A request to the server is NOT in that category: a blocking request
    # (newwindow, a version negotiation, a read) has a client stopped waiting
    # for it, and deferring it to the frame boundary would put up to a frame
    # of latency on every one. So it goes at index 1, inside the slice that is
    # always polled, and hamwsys_srv_service() runs on every iteration.
    #
    # This is inert with HAMWSYS_SERVER unset: listen() returns -1 before it
    # touches a socket or the segment, and the set is exactly what it was.
    srv_fd = hamwsys_srv_listen()
    if srv_fd >= 0 and n_wait < WAITSET_CAP:
        waitset[n_wait] = srv_fd
        n_wait = n_wait + 1
    d: uint64 = 0
    while d < n_input:
        if n_wait < WAITSET_CAP and fd_is_waitable(in_fd[d]) != 0:
            waitset[n_wait] = in_fd[d]
            n_wait = n_wait + 1
        else:
            nlie = nlie + 1
        d = d + 1
    # stdin last: a serial console has no evdev node at all and is the only
    # keyboard a headless boot has (pump_keyboard). Under `</dev/null` the
    # probe above rejects it, which is the common case for the gates.
    if n_wait < WAITSET_CAP and fd_is_waitable(0) != 0:
        waitset[n_wait] = 0
        n_wait = n_wait + 1
    else:
        nlie = nlie + 1
    puts(1, "wsysd: wait set ")
    putd(1, cast[int32](n_wait))
    puts(1, " fds wake this loop, ")
    putd(1, nlie)
    if wake_fd >= 0:
        puts(1, " (one of them is the client wake)")
    puts(1, " always-ready and excluded; fallback tick ")
    putd(1, cast[int32](WAIT_FALLBACK_MS))
    puts(1, " ms\n")
    if n_wait == 0:
        puts(1, "wsysd: NOTHING can wake this loop -- it is the 16 ms tick\n")


# --- the cursor -----------------------------------------------------
# THE AUTHENTIC left_ptr, built the way devwsys.ad builds it.
#
# This is the third shape in this file and the first correct one, so it is
# worth recording how the wrong ones happened. First I invented an arrow.
# Then I found _kcursor_init_sprite() in the frozen kernel's fb_cdev.ad -- a
# 12x12 triangle, no tail -- and matched it exactly. But that sprite is the
# KERNEL OVERLAY's FALLBACK, used when the compositor is too old for the CURS
# command. What the desktop actually draws is _wsys_cursor_set_scene() in
# devwsys.ad, and its own comment calls it "an authentic left_ptr arrow ...
# sharp point top-left, solid head, pointed foot, and a tail trailing off the
# lower-RIGHT shoulder". A user coming from the Adder kernel sees THAT.
#
# It is generated rather than transcribed, from the same two span tables, so
# it is the same shape by construction instead of by my eye:
#
#   SPAN A -- the head and the left foot, always at col 0.
#     rows 0..10 : run = row + 1      the arrowhead triangle, 1..11 wide
#     rows 11,12,13 : 3, 2, 1         the foot, narrowing to a point
#     rows 14,15 : nothing            tail only
#   SPAN B -- the tail shaft, rows 11..15 only.
#     runs    3, 3, 3, 2, 2
#     offsets 5, 5, 6, 6, 7           slanting down-RIGHT at ~0.5px per row
#
# The offsets are deliberately gentle. devwsys records why: a full 1px-per-row
# step ran the tail nearly parallel to the head's hypotenuse, "so it read as a
# continuation of the triangle rather than a distinct stem". The NOTCH of
# background between the col-0 foot and the tail is what makes them read as
# two limbs.
#
# Every span is OUTLINED: a dark silhouette on its row and the row below, one
# column wider on the right, then the white body inset 1px from the left --
# so head, foot and tail each carry a border on all sides and stay readable on
# any backdrop. Row 0 is the exception and must be: the tip is not inset, so
# its single white pixel lands exactly on the hotspot, which is also the point
# the router hit-tests.
CURSOR_W: int32 = 12
CURSOR_H: int32 = 17
cursor_bits: Array[204, uint8]          # CURSOR_W * CURSOR_H

CUR_WHITE: uint32 = 15790320            # 0xf0f0f0
CUR_DARK:  uint32 = 2105376             # 0x202020


def cur_a_run(row: int32) -> int32:
    if row <= 10:
        return row + 1
    if row == 11:
        return 3
    if row == 12:
        return 2
    if row == 13:
        return 1
    return 0


# THREE DEVIATIONS FROM devwsys's TABLES, all from looking at the rendered
# result rather than at the source. They are listed here so nobody
# "corrects" them back by diffing against the frozen tree:
#
#   1. the tail sits one column further LEFT (offsets 4,4,5,5,6 rather than
#      5,5,6,6,7), so it tucks closer under the head's shoulder;
#   2. the tail's lowest white pixel moves UP a row. Row 15 now carries only
#      the dark outline (run 1 leaves no white body) and row 14 carries a
#      2px white tip instead of 1 -- the old shape ended in a lone white
#      pixel hanging one row below the rest of the stem;
#   3. row 0's white tip pixel is gone -- see cursor_init.
def cur_b_run(row: int32) -> int32:
    if row == 11 or row == 12 or row == 13 or row == 14:
        return 3
    if row == 15:
        return 1                        # outline only: no white body
    return 0


def cur_b_off(row: int32) -> int32:
    if row == 11 or row == 12:
        return 4
    if row == 13 or row == 14:
        return 5
    if row == 15:
        return 6
    return 0


def cur_put(x: int32, y: int32, v: uint8):
    if x < 0 or y < 0 or x >= CURSOR_W or y >= CURSOR_H:
        return
    cursor_bits[cast[uint64](y * CURSOR_W + x)] = v


# One outlined span: the dark silhouette on this row and the next, run+1 wide,
# then the white body. `is_tip` suppresses the left inset so row 0's white
# pixel sits on the hotspot.
def cur_span(off: int32, run: int32, row: int32, is_tip: int32):
    if run <= 0:
        return
    i: int32 = 0
    while i < run + 1:
        cur_put(off + i, row, 2)
        cur_put(off + i, row + 1, 2)
        i = i + 1
    wstart: int32 = off
    wlen: int32 = run
    if is_tip == 0:
        wstart = wstart + 1
        wlen = wlen - 1
    i = 0
    while i < wlen:
        cur_put(wstart + i, row, 1)
        i = i + 1


def cursor_init():
    i: uint64 = 0
    while i < 204:
        cursor_bits[i] = 0
        i = i + 1
    r: int32 = 0
    while r < 16:
        # Deviation 3: row 0 is drawn INSET like every other row, so the very
        # top-left pixel is the dark outline rather than a lone white one.
        # devwsys leaves it white on purpose -- "so its 1px white point lands
        # exactly on the (sx,sy) hotspot" -- and the hotspot is unaffected
        # either way, since the hotspot is a COORDINATE and the tip pixel is
        # still at it. What changes is only that the point reads as a point
        # rather than as a white speck.
        cur_span(0, cur_a_run(r), r, 0)
        cur_span(cur_b_off(r), cur_b_run(r), r, 0)
        r = r + 1


# SITE 3 of 5. The cursor as a SPRITE, so device compositing costs one blit
# rather than 204 single-pixel fills -- an op each would be more ops than the
# rest of the frame put together. Built once, in the same 0xAARRGGBB the hamui
# images use, with alpha 0 where the sprite is transparent so the ordinary
# source-over blit does the right thing.
cursor_sprite: Array[204, uint32]
cursor_sprite_ready: int32 = 0


def cursor_sprite_build():
    r: int32 = 0
    while r < CURSOR_H:
        c: int32 = 0
        while c < CURSOR_W:
            i: uint64 = cast[uint64](r * CURSOR_W + c)
            v: uint8 = cursor_bits[i]
            if v == 1:
                cursor_sprite[i] = 4278190080 + CUR_WHITE      # 0xFF000000 |
            elif v == 2:
                cursor_sprite[i] = 4278190080 + CUR_DARK
            else:
                cursor_sprite[i] = 0                            # transparent
            c = c + 1
        r = r + 1
    cursor_sprite_ready = 1


def paint_cursor():
    if vk_devcomp != 0:
        if cursor_sprite_ready == 0:
            cursor_sprite_build()
        vk_linux_blit_native(cast[uint64](&cursor_sprite[0]),
                             CURSOR_W, CURSOR_H,
                             ptr_x, ptr_y, CURSOR_W, CURSOR_H,
                             0, 0, CURSOR_W, CURSOR_H)
        return
    r: int32 = 0
    while r < CURSOR_H:
        c: int32 = 0
        while c < CURSOR_W:
            v: uint8 = cursor_bits[cast[uint64](r * CURSOR_W + c)]
            if v == 1:
                put_px(ptr_x + c, ptr_y + r, CUR_WHITE)
            elif v == 2:
                put_px(ptr_x + c, ptr_y + r, CUR_DARK)
            c = c + 1
        r = r + 1


# Publish what the compositor thinks is going on, as a file. A desktop that
# is not behaving has to be diagnosable from inside the running system, and
# `cat /dev/wsys/wsysd/state` is how -- the same way every other thing here is
# a file. It also survives a session whose stdout went somewhere unhelpful.
def publish_state():
    i: uint64 = 0
    p: Ptr[uint8] = "focus "
    k: uint64 = 0
    while p[k] != 0:
        ctlbuf[i] = p[k]
        i = i + 1
        k = k + 1
    i = emit_int(&ctlbuf[0], i, focus_wid)
    q: Ptr[uint8] = " windows "
    k = 0
    while q[k] != 0:
        ctlbuf[i] = q[k]
        i = i + 1
        k = k + 1
    i = emit_int(&ctlbuf[0], i, cast[int32](n_win))
    r: Ptr[uint8] = " inputs "
    k = 0
    while r[k] != 0:
        ctlbuf[i] = r[k]
        i = i + 1
        k = k + 1
    i = emit_int(&ctlbuf[0], i, cast[int32](n_input))
    t: Ptr[uint8] = " keys "
    k = 0
    while t[k] != 0:
        ctlbuf[i] = t[k]
        i = i + 1
        k = k + 1
    i = emit_int(&ctlbuf[0], i, n_keys)
    u: Ptr[uint8] = " pointer "
    k = 0
    while u[k] != 0:
        ctlbuf[i] = u[k]
        i = i + 1
        k = k + 1
    i = emit_int(&ctlbuf[0], i, n_ptr)
    v: Ptr[uint8] = " frames "
    k = 0
    while v[k] != 0:
        ctlbuf[i] = v[k]
        i = i + 1
        k = k + 1
    i = emit_int(&ctlbuf[0], i, n_frames)
    # How many of those frames were served by the cheap cursor-only path. On a
    # session where someone is using the mouse this should be the large
    # majority; if it is 0 while the pointer is moving, the save-under is being
    # invalidated by something and every mouse move is costing a full repaint.
    w2: Ptr[uint8] = " curframes "
    k = 0
    while w2[k] != 0:
        ctlbuf[i] = w2[k]
        i = i + 1
        k = k + 1
    i = emit_int(&ctlbuf[0], i, n_curframes)
    ctlbuf[i] = 10
    ctlbuf[i + 1] = 0
    write_path(cast[Ptr[char]]("/dev/wsys/wsysd/state"), &ctlbuf[0])


def pick_focus():
    # A NEWLY MAPPED window takes focus. Without this the desktop backdrop --
    # the first decorated window to exist -- kept focus for the whole session,
    # so a terminal launched from the menu received nothing the user typed:
    # not even the local echo appeared, which made it look like the keyboard
    # was dead rather than like focus was wrong.
    i: uint64 = 0
    while i < n_win:
        if win_id[i] > highest_wid:
            highest_wid = win_id[i]
            if win_vis[i] != 0 and win_dec[i] != 0 and win_z[i] < 100:
                # A NEW window taking focus is a focus CHANGE like any other:
                # the previously focused window gets `f out`. That is what
                # makes launching a terminal from the Applications menu
                # dismiss the menu, instead of leaving the card floating over
                # the window it just opened.
                set_focus(win_id[i])
        i = i + 1

    # Otherwise focus is CLICK-driven (deliver_pointer sets it), so all that
    # is left is the case where the focused window went away.
    if focus_wid >= 2 and win_index(focus_wid) >= 0:
        return
    best: int32 = 0
    bestz: int32 = -1
    i: uint64 = 0
    while i < n_win:
        if win_vis[i] != 0 and win_dec[i] != 0 and win_z[i] < 100:
            if win_z[i] >= bestz:
                bestz = win_z[i]
                best = win_id[i]
        i = i + 1
    # The focused window went away. Its ring is gone with it (set_focus skips
    # a loser that win_index can no longer find), so this only ever emits the
    # `f in` to whoever inherits.
    set_focus(best)


# ====================================================================
# `wsysd -bench N` — paint N frames back to back and print the breakdown.
#
# It deliberately bypasses the frame_signature gate: the gate is what makes an
# IDLE desktop cheap, and what we need to know is what a frame costs when the
# desktop is NOT idle (dragging a window, a terminal echoing keys, a video).
# Times are microseconds per frame, averaged over N.
def run_bench(n: int32):
    bench_on = 1
    scan_windows()
    pick_focus()
    # One warm frame first: the first rasterize pays for font loading and for
    # first-touch of the demand-zero BSS images, neither of which recurs.
    paint_frame()
    t_clear = 0
    t_scene = 0
    t_rast = 0
    t_copy = 0
    t_bb = 0
    t_cur = 0
    t_pres = 0
    t_pres_w = 0
    b_pres_w = 0
    n_pres_w = 0
    t0: uint64 = now_us()
    f: int32 = 0
    while f < n:
        paint_frame()
        f = f + 1
    total: uint64 = now_us() - t0
    d: uint64 = cast[uint64](n)
    puts(1, "bench: frames ")
    putd(1, n)
    puts(1, " windows ")
    putd(1, cast[int32](n_win))
    puts(1, " screen ")
    putd(1, scr_w)
    puts(1, "x")
    putd(1, scr_h)
    puts(1, "\n")
    puts(1, "bench: us/frame total ")
    putd(1, cast[int32](total / d))
    puts(1, " clear ")
    putd(1, cast[int32](t_clear / d))
    puts(1, " scene ")
    putd(1, cast[int32](t_scene / d))
    puts(1, " rast ")
    putd(1, cast[int32](t_rast / d))
    puts(1, " copy ")
    putd(1, cast[int32](t_copy / d))
    puts(1, " backbuf ")
    putd(1, cast[int32](t_bb / d))
    puts(1, " cursor ")
    putd(1, cast[int32](t_cur / d))
    puts(1, " present ")
    putd(1, cast[int32](t_pres / d))
    puts(1, "\n")
    # THE READBACK, ON ITS OWN. `writeback` is the sys_write loop only; the
    # remainder of `present` is open/lseek/close/flip. MB/s is computed from
    # the bytes that loop actually moved, so it is directly comparable with a
    # memcpy out of the same mapping -- which is how the placement table in
    # user/linux-vk.c was measured.
    puts(1, "bench: writeback us/frame ")
    if n_pres_w > 0:
        putd(1, cast[int32](t_pres_w / n_pres_w))
    else:
        putd(1, 0)
    puts(1, " (")
    if t_pres > 0:
        putd(1, cast[int32](t_pres_w * 100 / t_pres))
    else:
        putd(1, 0)
    puts(1, "% of present) bytes/frame ")
    if n_pres_w > 0:
        putd(1, cast[int32](b_pres_w / n_pres_w))
    else:
        putd(1, 0)
    puts(1, " MB/s ")
    if t_pres_w > 0:
        putd(1, cast[int32](b_pres_w / t_pres_w))
    else:
        putd(1, 0)
    puts(1, "\n")
    puts(1, "bench: fps ")
    if total > 0:
        putd(1, cast[int32](d * 1000000 / total))
    puts(1, "\n")

    # What the device actually did, per frame. These are the numbers to
    # optimise against, because they are DEVICE-INDEPENDENT: an op is an op
    # and a dispatch is a dispatch whether the ICD is llvmpipe or an RTX.
    # `ops` is every 2D primitive handed to the backend; `dispatch` is how
    # many times the queue was told to go; `batched` is how many of those ops
    # rode inside a multi-entry OP_BATCH instead of costing a round of their
    # own. ops/dispatch is the whole game.
    puts(1, "bench: vk gpu_frames ")
    putd(1, vk_frames_gpu)
    puts(1, " zero_copy ")
    putd(1, vk_zero_copy)
    puts(1, " device_local ")
    putd(1, vk_devlocal)
    # The placement is in the bench line because it is the single largest term
    # in `present` and a sweep that cannot see it cannot explain its own graph.
    puts(1, " host_cached ")
    putd(1, vk_hostcached)
    # Printed even when zero: a counter nobody wired up and a counter that is
    # genuinely zero look identical if the line is conditional.
    puts(1, " refused_ops ")
    putd(1, cast[int32](vk_refused))
    puts(1, "\n")
    if vk_frames_gpu > 0:
        g: uint64 = cast[uint64](vk_frames_gpu)
        puts(1, "bench: vk ops/frame ")
        putd(1, cast[int32](vk_linux_ops() / g))
        puts(1, " dispatch/frame ")
        putd(1, cast[int32](vk_linux_dispatches() / g))
        puts(1, " batched/frame ")
        putd(1, cast[int32](vk_linux_batched_ops() / g))
        puts(1, " barriers/frame ")
        putd(1, vk_linux_barriers())
        puts(1, " submit_us ")
        putd(1, cast[int32](vk_linux_last_submit_us()))
        puts(1, "\n")

    # The second arm: what a MOUSE MOVE costs. This is the frame a desktop
    # serves most often, and before the save-under it was the same full frame
    # as above.
    tc: uint64 = now_us()
    f = 0
    while f < n:
        ptr_x = ptr_x + 1
        if ptr_x > scr_w - 20:
            ptr_x = 4
        ptr_y = ptr_y + 1
        if ptr_y > scr_h - 20:
            ptr_y = 4
        if vk_devcomp != 0:
            # There is no cursor-only frame with device compositing: the
            # save-under it depends on reads the composite. Measure the frame
            # that IS taken, so the number is not a fiction.
            paint_frame()
        else:
            cursor_only_frame()
        f = f + 1
    ctot: uint64 = now_us() - tc
    puts(1, "bench: cursor-only us/frame ")
    putd(1, cast[int32](ctot / d))
    puts(1, " fps ")
    if ctot > 0:
        putd(1, cast[int32](d * 1000000 / ctot))
    puts(1, "\n")


def is_bench_flag(s: Ptr[uint8]) -> int32:
    f: Ptr[uint8] = "-bench"
    k: uint64 = 0
    while f[k] != 0:
        if s[k] != f[k]:
            return 0
        k = k + 1
    if s[k] != 0:
        return 0
    return 1


def main(argc: int32, argv: Ptr[uint64]) -> int32:
    # FIRST LINE OF main, AND THE ORDER IS FORCED. This process is about to
    # become a CLIENT of its own device -- announce_screen() below opens
    # /dev/wsys, and so does every frame after it. The client side of the
    # transport dials from hamwsys_open, so without this wsysd would connect
    # to itself on its first open and then block waiting for a reply from the
    # loop it has not entered yet. This takes no syscall and reads nothing;
    # it only says "I am the server", so it is safe this early.
    hamwsys_srv_claim()
    puts(1, "wsysd: scene compositor starting\n")
    # SCANOUT IS DECIDED BEFORE THE GEOMETRY IS READ, and the order is forced.
    # Reading /dev/fb's geometry initialises the framebuffer, which on a real
    # display means creating a dumb buffer and taking DRM master -- after
    # which there is no attaching a GPU buffer to anything. So the mode is
    # probed (no master), the GPU frame is allocated to fit it, and the
    # display is attached to that; only then does /dev/fb exist at all.
    if vk_arm_scanout() == 0:
        if read_screen() != 0:
            return 1
    puts(1, "wsysd: screen ")
    putd(1, scr_w)
    puts(1, "x")
    putd(1, scr_h)
    puts(1, " (composite buffer ")
    putd(1, COMP_W)
    puts(1, "x")
    putd(1, COMP_H)
    puts(1, ")\n")
    # A STALE FAULT IS WORSE THAN NO FAULT. screen_fault() leaves a file behind
    # for lib/hamscreen.ad to quote; a compositor that has just got PAST that
    # check must remove it, or the next unrelated failure gets explained by
    # last week's refusal. This is the only place that can know it is stale.
    sys_unlink(cast[Ptr[char]]("/tmp/hamnix-wsysd.fault"))
    announce_screen()
    # After announce_screen, because this reads /dev/wsys and the device is
    # only worth asking once this process is serving it.
    check_maxsurface()

    # Take the text console. /dev/fbctl `suspend` is Hamnix's verb for it; on
    # Linux it is KDSETMODE KD_GRAPHICS (user/linux-fb.c). Without it the
    # kernel console redraws over the composited screen.
    write_path(cast[Ptr[char]]("/dev/fbctl"), cast[Ptr[uint8]]("suspend\n"))

    # Rasterize in the screen's byte order. /dev/fb is XRGB8888 little-endian
    # (bytes B,G,R,X) and vk2d already knows how to store BGRA -- so the window
    # image comes out of the rasterizer in the composite's own format and the
    # copy-out is a straight word copy with no channel shuffle. This has to be
    # set before the first hamui_host_begin().
    hamui_host_set_bgra(1)

    # Choose the rasterization backend and, if it is the GPU, bind the
    # composite to the GPU frame. After this line comp_base is the only thing
    # that differs between the two configurations. Skipped entirely when
    # scanout already armed: it would reallocate the frame as a host-mapped
    # one and hand the display's buffer back to the allocator.
    if vk_scanout == 0:
        vk_arm()

    # THE DISPLAY'S FRAME TIME, read after the framebuffer exists -- which is
    # after vk_arm_scanout() or read_screen(), because both establish the mode
    # this is derived from. 0 here means uncapped and says why.
    frame_us = hamfb_frame_us()
    # An A/B switch, because the cap's whole justification is a POWER number
    # and a power number needs the uncapped arm to compare against on the same
    # hardware in the same run. It also gives a machine whose mode timing is
    # wrong a way out without a rebuild.
    if env_flag(cast[Ptr[char]]("HAMNIX_WSYSD_NOCAP")) == 1:
        frame_us = 0
        puts(1, "wsysd: present cap disabled by HAMNIX_WSYSD_NOCAP\n")
    # FORCE a cap where there would be none. This exists so the claim that
    # matters most -- that the cap never delays the first present after a
    # quiet period -- can be TESTED by the ordinary offscreen latency harness,
    # which is uncapped by design and therefore could not otherwise exercise
    # the rule at all. Without this the rule would only ever be argued.
    fcap: int32 = env_int(cast[Ptr[char]]("HAMNIX_WSYSD_CAP_US"))
    if fcap > 0:
        frame_us = fcap
        puts(1, "wsysd: present cap FORCED to ")
        putd(1, frame_us)
        puts(1, " us/frame by HAMNIX_WSYSD_CAP_US\n")
    puts(1, "wsysd: present cap ")
    if frame_us > 0:
        putd(1, 1000000 / frame_us)
        puts(1, " Hz (")
        putd(1, frame_us)
        puts(1, " us/frame, from the mode actually set)\n")
    else:
        puts(1, "OFF -- offscreen, fbdev, or no usable mode timing\n")

    # The live phase breakdown. Off unless asked for; see bench_live_dump.
    bench_live_every = env_int(cast[Ptr[char]]("HAMNIX_WSYSD_BENCH_LIVE"))
    if bench_live_every > 0:
        bench_on = 1
        puts(2, "benchlive: on, dumping every ")
        putd(2, bench_live_every)
        puts(2, " full frames\n")

    keymap_init()
    cursor_init()
    # Named input sources override the scan. That is how the input decode is
    # tested (a file of evdev records is byte-identical to what the device
    # delivers), and it is also what a machine with an odd device layout
    # needs -- `wsysd /dev/input/by-path/...` is a legitimate way to run it.
    if argc > 1 and is_bench_flag(cast[Ptr[uint8]](argv[1])) != 0:
        nb: int32 = 30
        if argc > 2:
            bp: uint64 = 0
            v: int32 = take_int(cast[Ptr[uint8]](argv[2]), &bp, 12)
            if v > 0:
                nb = v
        ptr_x = scr_w / 2
        ptr_y = scr_h / 2
        run_bench(nb)
        return 0

    if argc > 1:
        a: int32 = 1
        while a < argc:
            open_input_path(cast[Ptr[char]](argv[cast[uint64](a)]))
            a = a + 1
        puts(1, "wsysd: ")
        putd(1, cast[int32](n_input))
        puts(1, " input devices (named)\n")
    else:
        open_inputs()
    ptr_x = scr_w / 2
    ptr_y = scr_h / 2
    # THE WINDOW TABLE MUST EXIST BEFORE ANYTHING DRAINS INPUT, AND
    # build_waitset() DRAINS INPUT.
    #
    # This is the same defect the main loop below already names -- "draining
    # first meant the very first keystroke after launch was delivered against
    # an empty window table and silently dropped" -- and the fix there (scan
    # BEFORE pump) did not reach the one drain that happens OUTSIDE the loop.
    # `fd_is_waitable` calls `pump_input()` and `pump_keyboard()` up to three
    # times per fd, on purpose: an evdev node with events already pending polls
    # ready no matter what, so the probe has to reach quiescence before it can
    # tell "wakes this loop" from "always ready". That drain runs here, before
    # the first scan_windows(), so n_win is 0 and focus_wid is 0.
    #
    # A POINTER SURVIVES THAT AND A KEYSTROKE DOES NOT, which is why the
    # symptom looked like a transport bug and was not. Pointer motion and
    # button edges are ACCUMULATED STATE (ptr_x/ptr_y/ptr_edge) that
    # deliver_pointer routes later, when the table is up; a key is routed
    # IMMEDIATELY by route_key, whose first line is `if focus_wid < 2: return`.
    # So every keystroke pending on the device at startup was decoded, counted
    # in n_keys, and thrown away.
    #
    # MEASURED, with a debug line in route_key and another around this call:
    # `route_key 97 0` printed BETWEEN the entry to build_waitset and the wait
    # set's own message, and the matching `set_focus 0 -> 2` came afterwards,
    # from the first loop iteration. tests/linux/input_probe.sh feeds wsysd a
    # FILE of evdev records, so the probe swallowed the entire file and the key
    # half of that gate had never once passed.
    scan_windows()
    pick_focus()
    build_waitset()

    idle: uint64 = 0
    while 1 == 1:
        # The window set is refreshed BEFORE input is drained, not after. It
        # has to be: routing a key needs to know which window has focus, and
        # routing a click needs the geometry to hit-test against. Draining
        # first meant the very first keystroke after launch was delivered
        # against an empty window table and silently dropped.
        tl0: uint64 = 0
        if bench_on != 0:
            tl0 = now_us()
        # Drain the client wake BEFORE reading the segment. A datagram left
        # unread stays readable, so poll would return instantly for ever and
        # the park would become a spin -- the exact idle regression this
        # mechanism is most likely to cause. Draining first also means a change
        # published while we were awake is not lost: the bytes are discarded,
        # but scan_windows() below re-reads the segment either way, and the
        # frame_signature() gate decides whether it was worth a repaint.
        hamwsys_wake_drain()
        # SERVICE THE MEDIATOR ON EVERY WAKE, INCLUDING WAKES IT DID NOT
        # CAUSE. An unread packet stays readable, so an epoll fd left
        # unserviced in the wait set turns this park into a spin -- the exact
        # trap hamwsys_wake_drain() above exists for, and the one that once
        # measured 100.06% of a core on an idle desktop. It is also why this
        # is here and not inside a branch on which fd woke us: sys_waitfds
        # does not tell us, and guessing would be a dropped request.
        #
        # Before scan_windows(), like the drain: a request that mutates the
        # window table (stage 2) must be visible to the scan in the SAME
        # iteration, or a client's move would be a frame late.
        # Returns 0 immediately with HAMWSYS_SERVER unset.
        hamwsys_srv_service()
        scan_windows()
        pick_focus()
        if bench_on != 0:
            t_scan = t_scan + (now_us() - tl0)
            t_loop_n = t_loop_n + 1
        pump_input()
        pump_keyboard()
        deliver_pointer()
        sig: uint64 = frame_signature()
        csig: uint64 = cursor_signature()
        if sig != last_sig and present_due() != 0:
            last_sig = sig
            last_csig = csig
            last_paint_us = now_us()
            paint_defer = 0
            paint_frame()
            lat_record()
            n_frames = n_frames + 1
            idle = 0
            bench_live_tick()
        elif sig != last_sig:
            # Held back, NOT dropped: last_sig is deliberately left stale so
            # this same change repaints on the next eligible iteration, with
            # whatever the client has published by then. Coalescing several
            # updates into one frame is the point -- the screen cannot show
            # them separately.
            paint_defer = 1
            n_capped = n_capped + 1
        elif csig != last_csig and vk_devcomp == 0 and present_due() != 0:
            last_paint_us = now_us()
            paint_defer = 0
            # Only the pointer moved: restore what the cursor covered, stamp it
            # at the new place, and push just those rows. No window is read,
            # rasterized or copied.
            last_csig = csig
            cursor_only_frame()
            lat_record()
            # A CURSOR-ONLY FRAME IS STILL A PRESENTED FRAME. Counting only
            # full frames meant that under pointer motion -- the case the
            # latency number exists to measure -- the dump almost never fired,
            # the sample ring was reset before it was ever printed, and a
            # deliberate 120 ms stall did not appear in the output at all.
            bench_live_tick()
            n_frames = n_frames + 1
            n_curframes = n_curframes + 1
        elif csig != last_csig and vk_devcomp == 0:
            paint_defer = 1
            n_capped = n_capped + 1
            idle = 0
        else:
            # NOTHING IS PENDING, SO NOTHING IS OWED. Clearing paint_defer here
            # is not tidiness; without it the flag latches. A cursor that moved
            # and moved back inside one frame interval takes the defer branch
            # and then finds csig == last_csig on the next iteration, so no
            # paint branch ever runs to clear it -- and wait_ms_now() returns 0
            # once the interval has lapsed with a frame still "owed", which is
            # poll(2) with a zero timeout, i.e. a spin at 100% of a core with
            # an idle desktop on screen. It survived only because paint_defer
            # was otherwise always cleared by the paint it implied. It now also
            # decides whether the client wake is in the park set below, so a
            # latched flag would silently disconnect client-driven repaint for
            # the rest of the process's life.
            paint_defer = 0
            idle = idle + 1
        if bench_on != 0:
            tl0 = now_us()
        publish_state()
        if bench_on != 0:
            t_pub = t_pub + (now_us() - tl0)
        # PARK UNTIL INPUT ARRIVES, or until the fallback tick lapses. The
        # timeout is what still catches a client repaint (nothing under
        # /dev/wsys can wake this set -- see the wait-set note at the top of
        # the file); the fds are what make a keystroke or a mouse move a wake
        # rather than a wait for the next tick. n_wait is 0 only if every fd
        # was rejected as always-ready, and then this is the old plain sleep,
        # which is the right thing to degrade to.
        #
        # WHILE A FRAME IS OWED, PARK WITHOUT THE CLIENT WAKE -- and this is
        # where the cap's missing saving is.
        #
        # MEASURED, BOTH ARMS ON THE DISPLAY IN ONE SESSION: capping the paint
        # did NOT cap the wake. 908 fps -> 57 fps, but 920 wakes/s -> 861, a 6%
        # fall against a 94% fall in painting. CPU fell 5.1x where the frame
        # rate fell 15.8x, and the gap is this loop waking ~860 times a second
        # to drain, rescan (scan_us 29) and re-park WITHOUT PAINTING. A forced
        # 30 Hz arm confirmed the residue is not the paint: halving the paint
        # again saved 0.5 points of 7.0. See docs/vk_scanout_path.md §3e.
        #
        # The wake is CLIENT-driven, not a tick -- an idle desktop costs 0.6%,
        # so if it were a tick idle would cost the same 5.2 points. A dragging
        # client commits far faster than the refresh and every commit pokes the
        # wake socket. Once a frame is already owed, those pokes carry NO NEW
        # INSTRUCTION: the repaint is already scheduled, scan_windows() at the
        # boundary will read whatever the client has published by then, and
        # last_sig is deliberately left stale so the change cannot be lost.
        # So we sleep the remainder instead of being told 850 more times.
        #
        # THIS DEFERS THE RESCAN AND THE REPUBLISH. IT DOES NOT DEFER INPUT.
        # waitset[0] is the client wake and ONLY the client wake (build_waitset
        # puts it there first); waitset[1..] is every evdev fd plus stdin. It
        # is the tail that is passed here, so a keystroke or a mouse move still
        # wakes this loop instantly with a frame owed, still runs pump_input()
        # and deliver_pointer(), and still publishes -- which is what the
        # 0.28 ms input-to-pixel result depends on, and it is why the slice
        # starts at 1 rather than the set being emptied.
        #
        # Nothing goes stale: wait_ms_now() already returns the time left to
        # the frame boundary whenever paint_defer is set, so the owed frame is
        # painted on time even if the client falls silent immediately after
        # publishing. And nothing backs up: wake_poke() is MSG_DONTWAIT and
        # ignores failure, so pokes that arrive while we are not listening are
        # dropped by the kernel rather than queued -- which is correct, because
        # one poke and a thousand mean the same thing, "re-read the segment".
        if paint_defer != 0 and wake_fd >= 0 and n_wait > 1:
            sys_waitfds(&waitset[1], n_wait - 1, wait_ms_now())
        else:
            sys_waitfds(&waitset[0], n_wait, wait_ms_now())
    return 0

# user/wsysd.ad — the hamnix-linux scene compositor.
#
# WHAT THIS IS
# ============
# In Hamnix the compositor is IN THE KERNEL: sys/src/9/port/devwsys.ad both
# holds the window table and z-blits every window's rasterized scene to the
# framebuffer. On Linux the window table stays "kernel-side" (shared memory
# behind /dev/wsys — user/linux-wsys.c) but the RASTERIZER moves out here,
# into an ordinary Adder program. That is the shape the north star asks for:
# the boot process and the userland are Adder; the Linux kernel is only the
# thing underneath.
#
# It needs no private syscall. Everything it does, any program could do:
#
#   read  /dev/fb              -> "W H PITCH BPP PIXFMT\n", the screen
#   write /dev/wsys/ctl        -> "screen W H", so clients can size themselves
#   read  /dev/wsys            -> the wid set (a directory listing)
#   read  /dev/wsys/<wid>/ctl  -> "<wid> <x> <y> <w> <h> <z> <dec> <vis>
#                                  <proto> <gen>", the window's state
#   read  /dev/wsys/<wid>/scene-> the display list, published whole by `commit`
#   write /dev/wsys/<wid>/keys -> route a key to the focused window
#   write /dev/fb              -> present
#
# THE RASTERIZER IS NOT NEW CODE
# ------------------------------
# lib/hamui_host.ad already parses the lib/hamscene.ad display-list grammar
# and draws it with the vk 2D primitive ops — it was written as the HOST sink
# so a GUI app's render could be looked at without booting. It is pure Adder
# with no syscalls, so it links here unchanged. The compositor asks it to
# rasterize each window into its RGBA image, then blits that image into the
# screen composite at the window's position, in z order.
#
# WHY A COMPOSITE BUFFER AND NOT DIRECT-TO-FB
# -------------------------------------------
# Windows overlap. Painting them straight to /dev/fb in z order would show
# each one being drawn (and would flush the display once per window). We
# compose off-screen and write the screen once per frame, which is both
# atomic to the eye and one flush.
#
# ADDER QUIRKS HONOURED: big buffers are top-level BSS arrays, no adjacent
# string-literal concatenation, string literals are passed at the call site.

from lib.hamscene import hamscene_load
from lib.hamui_host import hamui_host_begin, hamui_host_rasterize, \
    hamui_host_pixel

extern def sys_write(fd: int32, buf: Ptr[uint8], count: uint64) -> int64
extern def sys_read(fd: int32, buf: Ptr[uint8], count: uint64) -> int64
extern def sys_read_nb(fd: int32, buf: Ptr[uint8], count: uint64) -> int64
extern def sys_open(path: Ptr[char]) -> int32
extern def sys_open_write(path: Ptr[char]) -> int32
extern def sys_close(fd: int32) -> int32
extern def sys_lseek(fd: int32, offset: int64, whence: int32) -> int64
extern def sys_waitfds(fds: Ptr[int32], nfds: uint64, timeout_ms: int64) -> int64
extern def sys_get_jiffies() -> uint64
extern def sys_exit(code: uint64)

# --- screen -----------------------------------------------------------
MAX_PIXELS: uint64 = 2073600           # 1920x1080
composite:  Array[8294400, uint8]      # MAX_PIXELS * 4, BGRX as /dev/fb wants
scr_w: int32 = 0
scr_h: int32 = 0
scr_pitch: int32 = 0

# --- the window set ---------------------------------------------------
MAX_WIN: uint64 = 32
win_id:  Array[32, int32]
win_x:   Array[32, int32]
win_y:   Array[32, int32]
win_w:   Array[32, int32]
win_h:   Array[32, int32]
win_z:   Array[32, int32]
win_dec: Array[32, int32]
win_vis: Array[32, int32]
win_gen: Array[32, int32]
win_bbgen: Array[32, int32]
win_proto: Array[32, int32]
n_win:   uint64 = 0

# --- scratch ----------------------------------------------------------
pathbuf:  Array[128, uint8]
dirbuf:   Array[1024, uint8]
ctlbuf:   Array[256, uint8]
scenebuf: Array[16384, uint8]
numbuf:   Array[24, uint8]
inbuf:    Array[256, uint8]
waitset:  Array[4, int32]

fb_fd: int32 = -1
focus_wid: int32 = 0
last_sig: uint64 = 0                   # change signature of the last frame
highest_wid: int32 = 0                 # the newest window we have seen
n_frames: int32 = 0
n_keys:   int32 = 0
n_ptr:    int32 = 0
verbose: int32 = 0

# --- input ------------------------------------------------------------
# One fd per /dev/input/eventN we could open. evdev hands us 24-byte records
# (struct input_event: 16 bytes of timeval, then u16 type, u16 code, s32
# value) and we decode them here rather than teaching the userland about
# Linux input -- exactly the split devwsys.ad has, where the kernel turns
# scancodes into the bytes a window's /keys ring carries.
MAX_INPUT: uint64 = 12
in_fd:   Array[12, int32]
n_input: uint64 = 0
evbuf:   Array[2400, uint8]            # 100 events per read

ptr_x: int32 = 0
ptr_y: int32 = 0
ptr_btn: int32 = 0
ptr_dz: int32 = 0
ptr_moved: int32 = 0
ptr_edge: int32 = 0                    # a button changed state this poll
cursor_dirty: int32 = 1

# Keycode -> ASCII, unshifted and shifted. Indexed by the evdev KEY_* code.
# This is the table atkbd_process_byte owns in the Hamnix kernel; on Linux the
# kernel stops at the keycode, so the translation lives here.
kmap:   Array[128, uint8]
kshift: Array[128, uint8]
shift_down: int32 = 0
ctrl_down:  int32 = 0


# ====================================================================
# tiny helpers
# ====================================================================
def slen(s: Ptr[uint8]) -> uint64:
    n: uint64 = 0
    while s[n] != 0:
        n = n + 1
    return n


def puts(fd: int32, s: Ptr[uint8]):
    sys_write(fd, s, slen(s))


def putd(fd: int32, v: int32):
    if v < 0:
        puts(fd, "-")
        putd(fd, 0 - v)
        return
    n: uint64 = 0
    x: int32 = v
    if x == 0:
        numbuf[0] = 48
        n = 1
    while x > 0:
        numbuf[n] = cast[uint8](48 + x % 10)
        x = x / 10
        n = n + 1
    i: uint64 = n
    while i > 0:
        i = i - 1
        sys_write(fd, &numbuf[i], 1)


def emit_int(buf: Ptr[uint8], at: uint64, v: int32) -> uint64:
    i: uint64 = at
    if v < 0:
        buf[i] = 45
        i = i + 1
        return emit_int(buf, i, 0 - v)
    d: Array[12, uint8]
    n: uint64 = 0
    x: int32 = v
    if x == 0:
        d[0] = 48
        n = 1
    while x > 0:
        d[n] = cast[uint8](48 + x % 10)
        x = x / 10
        n = n + 1
    while n > 0:
        n = n - 1
        buf[i] = d[n]
        i = i + 1
    return i


# Parse the next signed decimal from buf[*p..n); returns -2147483647 when
# there is no number left (a value no field here ever takes).
NOVAL: int32 = -2147483647

def take_int(buf: Ptr[uint8], p: Ptr[uint64], n: uint64) -> int32:
    i: uint64 = p[0]
    while i < n and (buf[i] == 32 or buf[i] == 9):
        i = i + 1
    neg: int32 = 0
    if i < n and buf[i] == 45:
        neg = 1
        i = i + 1
    if i >= n or buf[i] < 48 or buf[i] > 57:
        p[0] = i
        return NOVAL
    v: int32 = 0
    while i < n and buf[i] >= 48 and buf[i] <= 57:
        v = v * 10 + cast[int32](buf[i]) - 48
        i = i + 1
    p[0] = i
    if neg != 0:
        return 0 - v
    return v


def winpath(wid: int32, leaf: Ptr[uint8]):
    i: uint64 = 0
    p: Ptr[uint8] = "/dev/wsys/"
    k: uint64 = 0
    while p[k] != 0:
        pathbuf[i] = p[k]
        i = i + 1
        k = k + 1
    i = emit_int(&pathbuf[0], i, wid)
    pathbuf[i] = 47
    i = i + 1
    k = 0
    while leaf[k] != 0:
        pathbuf[i] = leaf[k]
        i = i + 1
        k = k + 1
    pathbuf[i] = 0


def slurp(path: Ptr[char], out: Ptr[uint8], cap: uint64) -> int64:
    fd: int32 = sys_open(path)
    if fd < 0:
        return -1
    total: uint64 = 0
    while total < cap - 1:
        k: int64 = sys_read(fd, &out[total], cap - 1 - total)
        if k <= 0:
            break
        total = total + cast[uint64](k)
    sys_close(fd)
    out[total] = 0
    return cast[int64](total)


def write_path(path: Ptr[char], data: Ptr[uint8]) -> int32:
    fd: int32 = sys_open_write(path)
    if fd < 0:
        return -1
    sys_write(fd, data, slen(data))
    sys_close(fd)
    return 0


# ====================================================================
# the screen
# ====================================================================
def read_screen() -> int32:
    # "/dev/fb" answers "W H PITCH BPP PIXFMT\n" to a read. Opening it FOR
    # WRITING is what suspends the text console (user/linux-fb.c), so the
    # geometry read is a separate, read-only open — exactly as hamUId does it.
    n: int64 = slurp(cast[Ptr[char]]("/dev/fb"), &ctlbuf[0], 256)
    if n <= 0:
        puts(2, "wsysd: cannot read /dev/fb geometry\n")
        return -1
    pos: Array[1, uint64]
    pos[0] = 0
    scr_w = take_int(&ctlbuf[0], &pos[0], cast[uint64](n))
    scr_h = take_int(&ctlbuf[0], &pos[0], cast[uint64](n))
    scr_pitch = take_int(&ctlbuf[0], &pos[0], cast[uint64](n))
    if scr_w <= 0 or scr_h <= 0:
        puts(2, "wsysd: /dev/fb geometry is not sane\n")
        return -1
    if cast[uint64](scr_w) * cast[uint64](scr_h) > MAX_PIXELS:
        puts(2, "wsysd: screen larger than the composite buffer\n")
        return -1
    return 0


def announce_screen():
    i: uint64 = 0
    p: Ptr[uint8] = "screen "
    k: uint64 = 0
    while p[k] != 0:
        ctlbuf[i] = p[k]
        i = i + 1
        k = k + 1
    i = emit_int(&ctlbuf[0], i, scr_w)
    ctlbuf[i] = 32
    i = i + 1
    i = emit_int(&ctlbuf[0], i, scr_h)
    ctlbuf[i] = 10
    i = i + 1
    ctlbuf[i] = 0
    write_path(cast[Ptr[char]]("/dev/wsys/ctl"), &ctlbuf[0])


# ====================================================================
# the window set
# ====================================================================
def load_window(wid: int32) -> int32:
    winpath(wid, "ctl")
    n: int64 = slurp(cast[Ptr[char]](&pathbuf[0]), &ctlbuf[0], 256)
    if n <= 0:
        return 0
    pos: Array[1, uint64]
    pos[0] = 0
    cap: uint64 = cast[uint64](n)
    id: int32 = take_int(&ctlbuf[0], &pos[0], cap)
    if id != wid:
        return 0
    i: uint64 = n_win
    win_id[i]  = id
    win_x[i]   = take_int(&ctlbuf[0], &pos[0], cap)
    win_y[i]   = take_int(&ctlbuf[0], &pos[0], cap)
    win_w[i]   = take_int(&ctlbuf[0], &pos[0], cap)
    win_h[i]   = take_int(&ctlbuf[0], &pos[0], cap)
    win_z[i]   = take_int(&ctlbuf[0], &pos[0], cap)
    win_dec[i] = take_int(&ctlbuf[0], &pos[0], cap)
    win_vis[i] = take_int(&ctlbuf[0], &pos[0], cap)
    win_proto[i] = take_int(&ctlbuf[0], &pos[0], cap)
    win_gen[i]   = take_int(&ctlbuf[0], &pos[0], cap)
    win_bbgen[i] = take_int(&ctlbuf[0], &pos[0], cap)
    n_win = n_win + 1
    return 1


def scan_windows():
    # /dev/wsys is a directory: a packed "NAME\n" stream of the fixed leaves
    # plus one line per live wid. The numeric lines are the windows.
    n_win = 0
    n: int64 = slurp(cast[Ptr[char]]("/dev/wsys"), &dirbuf[0], 1024)
    if n <= 0:
        return
    i: uint64 = 0
    cap: uint64 = cast[uint64](n)
    while i < cap and n_win < MAX_WIN:
        if dirbuf[i] >= 48 and dirbuf[i] <= 57:
            pos: Array[1, uint64]
            pos[0] = i
            wid: int32 = take_int(&dirbuf[0], &pos[0], cap)
            i = pos[0]
            if wid > 0:
                load_window(wid)
        while i < cap and dirbuf[i] != 10:
            i = i + 1
        if i < cap:
            i = i + 1
    # z-order ascending (insertion sort; 32 windows at most, and the set
    # changes rarely).
    a: uint64 = 1
    while a < n_win:
        b: uint64 = a
        while b > 0 and win_z[b - 1] > win_z[b]:
            t: int32 = win_z[b - 1]
            win_z[b - 1] = win_z[b]
            win_z[b] = t
            t = win_id[b - 1]
            win_id[b - 1] = win_id[b]
            win_id[b] = t
            t = win_x[b - 1]
            win_x[b - 1] = win_x[b]
            win_x[b] = t
            t = win_y[b - 1]
            win_y[b - 1] = win_y[b]
            win_y[b] = t
            t = win_w[b - 1]
            win_w[b - 1] = win_w[b]
            win_w[b] = t
            t = win_h[b - 1]
            win_h[b - 1] = win_h[b]
            win_h[b] = t
            t = win_dec[b - 1]
            win_dec[b - 1] = win_dec[b]
            win_dec[b] = t
            t = win_vis[b - 1]
            win_vis[b - 1] = win_vis[b]
            win_vis[b] = t
            t = win_gen[b - 1]
            win_gen[b - 1] = win_gen[b]
            win_gen[b] = t
            t = win_bbgen[b - 1]
            win_bbgen[b - 1] = win_bbgen[b]
            win_bbgen[b] = t
            t = win_proto[b - 1]
            win_proto[b - 1] = win_proto[b]
            win_proto[b] = t
            b = b - 1
        a = a + 1


def frame_signature() -> uint64:
    # FNV-1a over everything that can change what the screen looks like. The
    # scene GENERATION is in here, so a window that repainted without moving
    # still forces a frame -- and a desktop where nothing happened costs one
    # directory read, not a rasterization.
    h: uint64 = 14695981039346656037
    i: uint64 = 0
    while i < n_win:
        vals: Array[10, int32]
        vals[0] = win_id[i]
        vals[1] = win_x[i]
        vals[2] = win_y[i]
        vals[3] = win_w[i]
        vals[4] = win_h[i]
        vals[5] = win_z[i]
        vals[6] = win_dec[i]
        vals[7] = win_vis[i]
        vals[8] = win_gen[i]
        vals[9] = win_bbgen[i]
        k: uint64 = 0
        while k < 10:
            h = h ^ cast[uint64](cast[uint32](vals[k]))
            h = h * 1099511628211
            k = k + 1
        i = i + 1
    h = h ^ cast[uint64](n_win)
    h = h * 1099511628211
    # The cursor is composited, so moving it IS a change to the screen.
    h = h ^ cast[uint64](cast[uint32](ptr_x))
    h = h * 1099511628211
    h = h ^ cast[uint64](cast[uint32](ptr_y))
    h = h * 1099511628211
    return h


# ====================================================================
# painting
# ====================================================================
def put_px(x: int32, y: int32, rgb: uint32):
    if x < 0 or y < 0 or x >= scr_w or y >= scr_h:
        return
    o: uint64 = (cast[uint64](y) * cast[uint64](scr_w)
                 + cast[uint64](x)) * 4
    # /dev/fb is XRGB8888 little-endian: the bytes in memory are B, G, R, X.
    composite[o]     = cast[uint8](rgb & 255)
    composite[o + 1] = cast[uint8]((rgb >> 8) & 255)
    composite[o + 2] = cast[uint8]((rgb >> 16) & 255)
    composite[o + 3] = 0


def fill_rect(x: int32, y: int32, w: int32, h: int32, rgb: uint32):
    j: int32 = 0
    while j < h:
        i: int32 = 0
        while i < w:
            put_px(x + i, y + j, rgb)
            i = i + 1
        j = j + 1


def clear_desktop():
    # A flat slate blue, so an empty desktop is obviously the compositor's and
    # not a stale text console.
    fill_rect(0, 0, scr_w, scr_h, 2110280)              # 0x203348


TITLEBAR_H: int32 = 22


# One row of a window's v2 backbuffer, read straight out of the shared surface
# as RGBA8888.
BBROW_CAP: uint64 = 7680                # 1920 * 4
bbrow: Array[7680, uint8]

def paint_backbuffer(i: uint64) -> int32:
    wid: int32 = win_id[i]
    w: int32 = win_w[i]
    h: int32 = win_h[i]
    winpath(wid, "backbuffer")
    fd: int32 = sys_open(cast[Ptr[char]](&pathbuf[0]))
    if fd < 0:
        return 0
    ox: int32 = win_x[i]
    oy: int32 = win_y[i]
    y: int32 = 0
    rowbytes: uint64 = cast[uint64](w) * 4
    if rowbytes > BBROW_CAP:
        rowbytes = BBROW_CAP
    while y < h:
        got: uint64 = 0
        while got < rowbytes:
            k: int64 = sys_read(fd, &bbrow[got], rowbytes - got)
            if k <= 0:
                break
            got = got + cast[uint64](k)
        if got < rowbytes:
            break
        x: int32 = 0
        while x < w:
            o: uint64 = cast[uint64](x) * 4
            r: uint32 = cast[uint32](bbrow[o])
            g: uint32 = cast[uint32](bbrow[o + 1])
            b: uint32 = cast[uint32](bbrow[o + 2])
            put_px(ox + x, oy + y, (r << 16) | (g << 8) | b)
            x = x + 1
        y = y + 1
    sys_close(fd)
    if y == 0:
        return 0
    return 1


def paint_window(i: uint64) -> int32:
    wid: int32 = win_id[i]
    if win_vis[i] == 0:
        return 0
    w: int32 = win_w[i]
    h: int32 = win_h[i]
    if w <= 0 or h <= 0:
        return 0

    winpath(wid, "scene")
    n: int64 = slurp(cast[Ptr[char]](&pathbuf[0]), &scenebuf[0], 16384)
    if n < 0:
        return 0

    ox: int32 = win_x[i]
    oy: int32 = win_y[i]
    if win_dec[i] != 0:
        # Server-side decoration: a title bar above the client area. The
        # window's own coordinates address the CLIENT area, so the frame is
        # drawn above it -- a client never has to know it is decorated.
        top: uint32 = 4210752                            # 0x404040
        if wid == focus_wid:
            top = 5601245                                # 0x5577DD
        fill_rect(ox - 1, oy - TITLEBAR_H, w + 2, TITLEBAR_H, top)
        fill_rect(ox - 1, oy, 1, h, top)
        fill_rect(ox + w, oy, 1, h, top)
        fill_rect(ox - 1, oy + h, w + 2, 1, top)

    # A v2 window renders its OWN pixels and submits them as blits. The scene
    # grammar is a text display list capped at 16 KiB: it can express a widget
    # tree and cannot express a photograph, so anything that is not a hamui
    # app -- a browser, a video, an X server bridged in -- arrives this way.
    # Nothing to rasterize; blit the backbuffer. The decoration above is
    # already drawn, so a v2 window is framed and raised like any other.
    if win_proto[i] == 2:
        if paint_backbuffer(i) != 0:
            return 1

    if n == 0:
        # A mapped window that has not committed a frame yet: paint the client
        # area so the decoration does not frame the desktop.
        fill_rect(ox, oy, w, h, 1842204)                 # 0x1C1C1C
        return 1

    hamscene_load(&scenebuf[0], cast[uint64](n))
    hamui_host_begin(w, h)
    hamui_host_rasterize()

    j: int32 = 0
    while j < h:
        k: int32 = 0
        while k < w:
            put_px(ox + k, oy + j, hamui_host_pixel(k, j))
            k = k + 1
        j = j + 1
    return 1


def present():
    fd: int32 = sys_open_write(cast[Ptr[char]]("/dev/fb"))
    if fd < 0:
        puts(2, "wsysd: cannot open /dev/fb for writing\n")
        return
    total: uint64 = cast[uint64](scr_w) * cast[uint64](scr_h) * 4
    off: uint64 = 0
    while off < total:
        k: int64 = sys_write(fd, &composite[off], total - off)
        if k <= 0:
            break
        off = off + cast[uint64](k)
    sys_close(fd)


def paint_frame():
    clear_desktop()
    i: uint64 = 0
    while i < n_win:
        paint_window(i)
        i = i + 1
    paint_cursor()
    present()


# ====================================================================
# input
# ====================================================================
def route_key(code: int32):
    # The compositor gates the keyboard: only the FOCUSED window's ring gets
    # the byte. That is devwsys.ad's wsys_route_key_byte, and it is why an
    # unfocused app cannot read what the user types.
    if focus_wid < 2:
        return
    winpath(focus_wid, "keys")
    i: uint64 = 0
    ctlbuf[0] = 100                                      # 'd', a press
    ctlbuf[1] = 32
    i = emit_int(&ctlbuf[0], 2, code)
    ctlbuf[i] = 10
    ctlbuf[i + 1] = 0
    write_path(cast[Ptr[char]](&pathbuf[0]), &ctlbuf[0])


def route_pointer(wid: int32, kind: uint8, lx: int32, ly: int32,
                  btn: int32, dz: int32):
    # "<type> <x> <y> <buttons> <dz>\n" with x,y already mapped to WINDOW-LOCAL
    # pixels. lib/hamui.ad sets its cursor straight from these, with no delta
    # accumulation and no clamp, precisely because the compositor did the
    # routing -- so getting the mapping right here is the whole contract.
    if wid < 2:
        return
    winpath(wid, "pointer")
    ctlbuf[0] = kind
    ctlbuf[1] = 32
    i: uint64 = emit_int(&ctlbuf[0], 2, lx)
    ctlbuf[i] = 32
    i = emit_int(&ctlbuf[0], i + 1, ly)
    ctlbuf[i] = 32
    i = emit_int(&ctlbuf[0], i + 1, btn)
    ctlbuf[i] = 32
    i = emit_int(&ctlbuf[0], i + 1, dz)
    ctlbuf[i] = 10
    ctlbuf[i + 1] = 0
    write_path(cast[Ptr[char]](&pathbuf[0]), &ctlbuf[0])


# The topmost visible window under (x, y), or 0. Walks the z-sorted list
# backwards, so the window the user sees on top is the one that gets the click.
def window_at(x: int32, y: int32) -> int32:
    i: uint64 = n_win
    while i > 0:
        i = i - 1
        if win_vis[i] == 0:
            continue
        top: int32 = win_y[i]
        if win_dec[i] != 0:
            top = top - TITLEBAR_H
        if x >= win_x[i] and x < win_x[i] + win_w[i]:
            if y >= top and y < win_y[i] + win_h[i]:
                return win_id[i]
    return 0


def win_index(wid: int32) -> int64:
    i: uint64 = 0
    while i < n_win:
        if win_id[i] == wid:
            return cast[int64](i)
        i = i + 1
    return -1


def raise_window(wid: int32):
    i: uint64 = 0
    p: Ptr[uint8] = "raise "
    k: uint64 = 0
    while p[k] != 0:
        ctlbuf[i] = p[k]
        i = i + 1
        k = k + 1
    i = emit_int(&ctlbuf[0], i, wid)
    ctlbuf[i] = 10
    ctlbuf[i + 1] = 0
    write_path(cast[Ptr[char]]("/dev/wsys/ctl"), &ctlbuf[0])


def deliver_pointer():
    # Route the current pointer state to whichever window is under it. Motion
    # goes out only when something actually changed, so a still mouse costs
    # nothing.
    if ptr_moved == 0 and ptr_edge == 0 and ptr_dz == 0:
        return
    wid: int32 = window_at(ptr_x, ptr_y)
    if wid < 2:
        ptr_moved = 0
        ptr_edge = 0
        ptr_dz = 0
        return
    idx: int64 = win_index(wid)
    if idx < 0:
        return
    i: uint64 = cast[uint64](idx)
    lx: int32 = ptr_x - win_x[i]
    ly: int32 = ptr_y - win_y[i]
    kind: uint8 = 109                                    # 'm' motion
    if ptr_edge > 0:
        kind = 100                                       # 'd' button down
        # A press is also what raises and focuses a window -- click-to-focus,
        # the behaviour every one of these apps was written against.
        if wid != focus_wid:
            raise_window(wid)
            focus_wid = wid
    elif ptr_edge < 0:
        kind = 117                                       # 'u' button up
    elif ptr_dz != 0:
        kind = 115                                       # 's' scroll
    route_pointer(wid, kind, lx, ly, ptr_btn, ptr_dz)
    n_ptr = n_ptr + 1
    ptr_moved = 0
    ptr_edge = 0
    ptr_dz = 0


# --- the evdev keymap -------------------------------------------------
def kset(code: uint64, plain: uint8, shifted: uint8):
    kmap[code] = plain
    kshift[code] = shifted


def keymap_init():
    # Row by row, the way a US keyboard is laid out. Codes are Linux KEY_*.
    kset(1, 27, 27)                                      # ESC
    row: Ptr[uint8] = "1234567890-="
    srow: Ptr[uint8] = "!@#$%^&*()_+"
    i: uint64 = 0
    while i < 12:
        kset(2 + i, row[i], srow[i])
        i = i + 1
    kset(14, 8, 8)                                       # BACKSPACE
    kset(15, 9, 9)                                       # TAB
    q: Ptr[uint8] = "qwertyuiop[]"
    qs: Ptr[uint8] = "QWERTYUIOP{}"
    i = 0
    while i < 12:
        kset(16 + i, q[i], qs[i])
        i = i + 1
    kset(28, 10, 10)                                     # ENTER
    a: Ptr[uint8] = "asdfghjkl"
    au: Ptr[uint8] = "ASDFGHJKL"
    i = 0
    while i < 9:
        kset(30 + i, a[i], au[i])
        i = i + 1
    # The three that follow are spelled out rather than put in a literal: the
    # shifted row would need an escaped double quote, and Adder string literals
    # do not carry one.
    kset(39, 59, 58)                                     # ;  :
    kset(40, 39, 34)                                     # '  "
    kset(41, 96, 126)                                    # `  ~
    kset(43, 92, 124)                                    # \ |
    z: Ptr[uint8] = "zxcvbnm,./"
    zs: Ptr[uint8] = "ZXCVBNM<>?"
    i = 0
    while i < 10:
        kset(44 + i, z[i], zs[i])
        i = i + 1
    kset(57, 32, 32)                                     # SPACE
    kset(111, 127, 127)                                  # DELETE


def route_arrow(final: uint8):
    # hamui's key dispatch reads arrows as the three bytes of an ESC sequence,
    # because that is what they were when input came off a serial console.
    # Nothing downstream had to change when the compositor took over routing.
    route_key(27)
    route_key(91)
    route_key(cast[int32](final))


def handle_key(code: int32, value: int32):
    # value: 0 = release, 1 = press, 2 = autorepeat.
    if code == 42 or code == 54:
        if value == 0:
            shift_down = 0
        else:
            shift_down = 1
        return
    if code == 29 or code == 97:
        if value == 0:
            ctrl_down = 0
        else:
            ctrl_down = 1
        return
    if value == 0:
        return
    if code == 103:
        route_arrow(65)                                  # up    -> ESC [ A
        return
    if code == 108:
        route_arrow(66)                                  # down
        return
    if code == 106:
        route_arrow(67)                                  # right
        return
    if code == 105:
        route_arrow(68)                                  # left
        return
    if code < 0 or code >= 128:
        return
    ch: uint8 = kmap[code]
    if shift_down != 0:
        ch = kshift[code]
    if ch == 0:
        return
    n_keys = n_keys + 1
    if ctrl_down != 0 and ch >= 97 and ch <= 122:
        ch = ch - 96                                     # ^A .. ^Z
    route_key(cast[int32](ch))


def handle_button(code: int32, value: int32):
    bit: int32 = 0
    if code == 272:
        bit = 1                                          # BTN_LEFT
    elif code == 273:
        bit = 2                                          # BTN_RIGHT
    elif code == 274:
        bit = 4                                          # BTN_MIDDLE
    if bit == 0:
        return
    if value != 0:
        ptr_btn = ptr_btn | bit
        ptr_edge = 1
    else:
        ptr_btn = ptr_btn & (0 - 1 - bit)
        ptr_edge = -1


def open_input_path(path: Ptr[char]) -> int32:
    if n_input >= MAX_INPUT:
        return -1
    fd: int32 = sys_open(path)
    if fd < 0:
        return -1
    in_fd[n_input] = fd
    n_input = n_input + 1
    return fd


def open_inputs():
    # Every evdev node, because which one is the mouse and which the keyboard
    # depends on enumeration order and on whether the machine is a VM. Reading
    # them all and dispatching on the event TYPE is both simpler and right.
    i: int32 = 0
    while i < 16 and n_input < MAX_INPUT:
        j: uint64 = 0
        p: Ptr[uint8] = "/dev/input/event"
        k: uint64 = 0
        while p[k] != 0:
            pathbuf[j] = p[k]
            j = j + 1
            k = k + 1
        j = emit_int(&pathbuf[0], j, i)
        pathbuf[j] = 0
        open_input_path(cast[Ptr[char]](&pathbuf[0]))
        i = i + 1
    puts(1, "wsysd: ")
    putd(1, cast[int32](n_input))
    puts(1, " input devices\n")


def le16(b: Ptr[uint8], at: uint64) -> int32:
    return cast[int32](b[at]) | (cast[int32](b[at + 1]) << 8)


def le32(b: Ptr[uint8], at: uint64) -> int32:
    return cast[int32](b[at]) | (cast[int32](b[at + 1]) << 8) \
         | (cast[int32](b[at + 2]) << 16) | (cast[int32](b[at + 3]) << 24)


def pump_input():
    d: uint64 = 0
    while d < n_input:
        n: int64 = sys_read_nb(in_fd[d], &evbuf[0], 2400)
        i: uint64 = 0
        while i + 24 <= cast[uint64](n):
            # struct input_event: 16 bytes of timeval, then type, code, value.
            etype: int32 = le16(&evbuf[0], i + 16)
            ecode: int32 = le16(&evbuf[0], i + 18)
            eval_: int32 = le32(&evbuf[0], i + 20)
            if etype == 1:                               # EV_KEY
                if ecode >= 272 and ecode <= 274:
                    handle_button(ecode, eval_)
                else:
                    handle_key(ecode, eval_)
            elif etype == 2:                             # EV_REL
                if ecode == 0:
                    ptr_x = ptr_x + eval_
                    ptr_moved = 1
                elif ecode == 1:
                    ptr_y = ptr_y + eval_
                    ptr_moved = 1
                elif ecode == 8:                         # REL_WHEEL
                    ptr_dz = ptr_dz + eval_
            elif etype == 3:                             # EV_ABS (tablet)
                # virtio-tablet and usb-tablet report 0..32767 across the
                # screen, which is the range QEMU advertises for both.
                if ecode == 0:
                    ptr_x = cast[int32]((cast[int64](eval_)
                                         * cast[int64](scr_w)) / 32768)
                    ptr_moved = 1
                elif ecode == 1:
                    ptr_y = cast[int32]((cast[int64](eval_)
                                         * cast[int64](scr_h)) / 32768)
                    ptr_moved = 1
            i = i + 24
        d = d + 1
    if ptr_x < 0:
        ptr_x = 0
    if ptr_y < 0:
        ptr_y = 0
    if ptr_x >= scr_w:
        ptr_x = scr_w - 1
    if ptr_y >= scr_h:
        ptr_y = scr_h - 1


def pump_keyboard():
    # Keys can also arrive on stdin -- a serial console has no evdev node at
    # all, and that is the only keyboard a headless boot has.
    n: int64 = sys_read_nb(0, &inbuf[0], 256)
    i: uint64 = 0
    while i < cast[uint64](n):
        route_key(cast[int32](inbuf[i]))
        i = i + 1


# --- the cursor -----------------------------------------------------
# THE AUTHENTIC left_ptr, built the way devwsys.ad builds it.
#
# This is the third shape in this file and the first correct one, so it is
# worth recording how the wrong ones happened. First I invented an arrow.
# Then I found _kcursor_init_sprite() in the frozen kernel's fb_cdev.ad -- a
# 12x12 triangle, no tail -- and matched it exactly. But that sprite is the
# KERNEL OVERLAY's FALLBACK, used when the compositor is too old for the CURS
# command. What the desktop actually draws is _wsys_cursor_set_scene() in
# devwsys.ad, and its own comment calls it "an authentic left_ptr arrow ...
# sharp point top-left, solid head, pointed foot, and a tail trailing off the
# lower-RIGHT shoulder". A user coming from the Adder kernel sees THAT.
#
# It is generated rather than transcribed, from the same two span tables, so
# it is the same shape by construction instead of by my eye:
#
#   SPAN A -- the head and the left foot, always at col 0.
#     rows 0..10 : run = row + 1      the arrowhead triangle, 1..11 wide
#     rows 11,12,13 : 3, 2, 1         the foot, narrowing to a point
#     rows 14,15 : nothing            tail only
#   SPAN B -- the tail shaft, rows 11..15 only.
#     runs    3, 3, 3, 2, 2
#     offsets 5, 5, 6, 6, 7           slanting down-RIGHT at ~0.5px per row
#
# The offsets are deliberately gentle. devwsys records why: a full 1px-per-row
# step ran the tail nearly parallel to the head's hypotenuse, "so it read as a
# continuation of the triangle rather than a distinct stem". The NOTCH of
# background between the col-0 foot and the tail is what makes them read as
# two limbs.
#
# Every span is OUTLINED: a dark silhouette on its row and the row below, one
# column wider on the right, then the white body inset 1px from the left --
# so head, foot and tail each carry a border on all sides and stay readable on
# any backdrop. Row 0 is the exception and must be: the tip is not inset, so
# its single white pixel lands exactly on the hotspot, which is also the point
# the router hit-tests.
CURSOR_W: int32 = 12
CURSOR_H: int32 = 17
cursor_bits: Array[204, uint8]          # CURSOR_W * CURSOR_H

CUR_WHITE: uint32 = 15790320            # 0xf0f0f0
CUR_DARK:  uint32 = 2105376             # 0x202020


def cur_a_run(row: int32) -> int32:
    if row <= 10:
        return row + 1
    if row == 11:
        return 3
    if row == 12:
        return 2
    if row == 13:
        return 1
    return 0


def cur_b_run(row: int32) -> int32:
    if row == 11 or row == 12 or row == 13:
        return 3
    if row == 14 or row == 15:
        return 2
    return 0


def cur_b_off(row: int32) -> int32:
    if row == 11 or row == 12:
        return 5
    if row == 13 or row == 14:
        return 6
    if row == 15:
        return 7
    return 0


def cur_put(x: int32, y: int32, v: uint8):
    if x < 0 or y < 0 or x >= CURSOR_W or y >= CURSOR_H:
        return
    cursor_bits[cast[uint64](y * CURSOR_W + x)] = v


# One outlined span: the dark silhouette on this row and the next, run+1 wide,
# then the white body. `is_tip` suppresses the left inset so row 0's white
# pixel sits on the hotspot.
def cur_span(off: int32, run: int32, row: int32, is_tip: int32):
    if run <= 0:
        return
    i: int32 = 0
    while i < run + 1:
        cur_put(off + i, row, 2)
        cur_put(off + i, row + 1, 2)
        i = i + 1
    wstart: int32 = off
    wlen: int32 = run
    if is_tip == 0:
        wstart = wstart + 1
        wlen = wlen - 1
    i = 0
    while i < wlen:
        cur_put(wstart + i, row, 1)
        i = i + 1


def cursor_init():
    i: uint64 = 0
    while i < 204:
        cursor_bits[i] = 0
        i = i + 1
    r: int32 = 0
    while r < 16:
        tip: int32 = 0
        if r == 0:
            tip = 1
        cur_span(0, cur_a_run(r), r, tip)
        cur_span(cur_b_off(r), cur_b_run(r), r, 0)
        r = r + 1


def paint_cursor():
    r: int32 = 0
    while r < CURSOR_H:
        c: int32 = 0
        while c < CURSOR_W:
            v: uint8 = cursor_bits[cast[uint64](r * CURSOR_W + c)]
            if v == 1:
                put_px(ptr_x + c, ptr_y + r, CUR_WHITE)
            elif v == 2:
                put_px(ptr_x + c, ptr_y + r, CUR_DARK)
            c = c + 1
        r = r + 1


# Publish what the compositor thinks is going on, as a file. A desktop that
# is not behaving has to be diagnosable from inside the running system, and
# `cat /dev/wsys/wsysd/state` is how -- the same way every other thing here is
# a file. It also survives a session whose stdout went somewhere unhelpful.
def publish_state():
    i: uint64 = 0
    p: Ptr[uint8] = "focus "
    k: uint64 = 0
    while p[k] != 0:
        ctlbuf[i] = p[k]
        i = i + 1
        k = k + 1
    i = emit_int(&ctlbuf[0], i, focus_wid)
    q: Ptr[uint8] = " windows "
    k = 0
    while q[k] != 0:
        ctlbuf[i] = q[k]
        i = i + 1
        k = k + 1
    i = emit_int(&ctlbuf[0], i, cast[int32](n_win))
    r: Ptr[uint8] = " inputs "
    k = 0
    while r[k] != 0:
        ctlbuf[i] = r[k]
        i = i + 1
        k = k + 1
    i = emit_int(&ctlbuf[0], i, cast[int32](n_input))
    t: Ptr[uint8] = " keys "
    k = 0
    while t[k] != 0:
        ctlbuf[i] = t[k]
        i = i + 1
        k = k + 1
    i = emit_int(&ctlbuf[0], i, n_keys)
    u: Ptr[uint8] = " pointer "
    k = 0
    while u[k] != 0:
        ctlbuf[i] = u[k]
        i = i + 1
        k = k + 1
    i = emit_int(&ctlbuf[0], i, n_ptr)
    v: Ptr[uint8] = " frames "
    k = 0
    while v[k] != 0:
        ctlbuf[i] = v[k]
        i = i + 1
        k = k + 1
    i = emit_int(&ctlbuf[0], i, n_frames)
    ctlbuf[i] = 10
    ctlbuf[i + 1] = 0
    write_path(cast[Ptr[char]]("/dev/wsys/wsysd/state"), &ctlbuf[0])


def pick_focus():
    # A NEWLY MAPPED window takes focus. Without this the desktop backdrop --
    # the first decorated window to exist -- kept focus for the whole session,
    # so a terminal launched from the menu received nothing the user typed:
    # not even the local echo appeared, which made it look like the keyboard
    # was dead rather than like focus was wrong.
    i: uint64 = 0
    while i < n_win:
        if win_id[i] > highest_wid:
            highest_wid = win_id[i]
            if win_vis[i] != 0 and win_dec[i] != 0 and win_z[i] < 100:
                focus_wid = win_id[i]
        i = i + 1

    # Otherwise focus is CLICK-driven (deliver_pointer sets it), so all that
    # is left is the case where the focused window went away.
    if focus_wid >= 2 and win_index(focus_wid) >= 0:
        return
    best: int32 = 0
    bestz: int32 = -1
    i: uint64 = 0
    while i < n_win:
        if win_vis[i] != 0 and win_dec[i] != 0 and win_z[i] < 100:
            if win_z[i] >= bestz:
                bestz = win_z[i]
                best = win_id[i]
        i = i + 1
    focus_wid = best


# ====================================================================
def main(argc: int32, argv: Ptr[uint64]) -> int32:
    puts(1, "wsysd: scene compositor starting\n")
    if read_screen() != 0:
        return 1
    puts(1, "wsysd: screen ")
    putd(1, scr_w)
    puts(1, "x")
    putd(1, scr_h)
    puts(1, "\n")
    announce_screen()

    # Take the text console. /dev/fbctl `suspend` is Hamnix's verb for it; on
    # Linux it is KDSETMODE KD_GRAPHICS (user/linux-fb.c). Without it the
    # kernel console redraws over the composited screen.
    write_path(cast[Ptr[char]]("/dev/fbctl"), cast[Ptr[uint8]]("suspend\n"))

    keymap_init()
    cursor_init()
    # Named input sources override the scan. That is how the input decode is
    # tested (a file of evdev records is byte-identical to what the device
    # delivers), and it is also what a machine with an odd device layout
    # needs -- `wsysd /dev/input/by-path/...` is a legitimate way to run it.
    if argc > 1:
        a: int32 = 1
        while a < argc:
            open_input_path(cast[Ptr[char]](argv[cast[uint64](a)]))
            a = a + 1
        puts(1, "wsysd: ")
        putd(1, cast[int32](n_input))
        puts(1, " input devices (named)\n")
    else:
        open_inputs()
    ptr_x = scr_w / 2
    ptr_y = scr_h / 2

    idle: uint64 = 0
    while 1 == 1:
        # The window set is refreshed BEFORE input is drained, not after. It
        # has to be: routing a key needs to know which window has focus, and
        # routing a click needs the geometry to hit-test against. Draining
        # first meant the very first keystroke after launch was delivered
        # against an empty window table and silently dropped.
        scan_windows()
        pick_focus()
        pump_input()
        pump_keyboard()
        deliver_pointer()
        sig: uint64 = frame_signature()
        if sig != last_sig:
            last_sig = sig
            paint_frame()
            n_frames = n_frames + 1
            idle = 0
        else:
            idle = idle + 1
        publish_state()
        # Sleep to the next frame. nfds=0 makes this a plain timed wait --
        # the compositor must not spin, or an idle desktop costs a core.
        sys_waitfds(&waitset[0], 0, 16)
    return 0

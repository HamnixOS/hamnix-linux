# user/tail.ad
#
# Hamnix `tail`: print the last N lines (default 10) of each FILE, or
# of stdin when no FILE is given. `-N` sets the count; `-` names
# stdin. With several FILEs the GNU `==> NAME <==` banner is printed
# so the output stays attributable.
#
# THE FILE OPERAND IS NEW, AND ITS ABSENCE WAS A HANG. `tail` took no
# operand at all: it looked at argv[1] only to see whether it began
# with '-', then read STDIN regardless. So `tail /lib/modules/<rel>/
# modules.dep` on a console blocked forever on the terminal -- what
# HANDOFF.md recorded as "tail FILE wedges the shell" -- and in a
# script, where stdin is already at EOF, it printed NOTHING and
# exited 0, which is the same defect wearing a success. It never said
# it could not do that. This is byte-for-byte the bug `head` had and
# had already been fixed for (see user/head.ad's header); `tail` was
# never given the same treatment. Gated by tests/linux/tail_file.sh.
#
# HOW THE LAST N LINES ARE FOUND. Reading is forward-only -- there is
# no backwards-seek loop to get stuck at offset 0 -- into a fixed
# WINDOW-byte ring that keeps the TRAILING bytes of the stream. When
# the input is seekable and longer than the window we lseek to
# `size - WINDOW` first, so a gigabyte log costs one seek and one
# window, not a gigabyte of reads. A pipe (and procfs, which reports
# size 0 while being readable) takes the streaming path, where the
# ring wrapping is what discards the head.
#
# The old code slurped the FIRST 8 KiB of the input and tailed that,
# so on any file bigger than 8 KiB it printed the wrong lines and
# said nothing about it.
#
# WHEN THE ANSWER CANNOT BE GIVEN IT IS NOT FAKED. If the requested
# lines do not fit in the window (one enormous line, say), the
# leading fragment is dropped rather than printed as if it were a
# whole line, a message naming the file goes to stderr, and the exit
# status is 1. A short answer that looks complete is the failure this
# project exists to beat.

extern def sys_read(fd: int32, buf: Ptr[uint8], count: uint64) -> int64
extern def sys_write(fd: int32, buf: Ptr[uint8], count: uint64) -> int64
extern def sys_open(path: Ptr[char]) -> int32
extern def sys_close(fd: int32) -> int32
extern def sys_lseek(fd: int32, offset: int64, whence: int32) -> int64

from lib.perror import perror

WINDOW:   uint64 = 65536
SEEK_SET: int32 = 0
SEEK_END: int32 = 2

# Buffers must be top-level BSS, not frame locals.
win: Array[65536, uint8]      # the ring holding the trailing bytes
lin: Array[65536, uint8]      # the ring rotated back into reading order


def strlen_u8(s: Ptr[uint8]) -> uint64:
    n: uint64 = 0
    while s[n] != 0:
        n = n + 1
    return n


def write_str(fd: int32, s: Ptr[uint8]):
    sys_write(fd, s, strlen_u8(s))


def parse_int(s: Ptr[uint8]) -> int32:
    n: int32 = 0
    i: uint64 = 0
    if s[0] == 0:
        return -1
    while s[i] != 0:
        c: uint8 = s[i]
        if c < 48 or c > 57:
            return -1
        n = n * 10 + cast[int32](c - 48)
        i = i + 1
    return n


# Emit the last `limit` lines of buf[0..n). `truncated` says the
# window does not start at the beginning of the input, so buf[0] may
# be the middle of a line. Returns 0, or 1 if fewer than `limit`
# whole lines were available because the window was too small.
def emit_last(buf: Ptr[uint8], n: uint64, limit: int32, truncated: int32) -> int32:
    if n == 0:
        return 0
    if limit <= 0:
        return 0
    want: uint64 = cast[uint64](limit)

    # A newline at the very end terminates the last line; it is not a
    # separator in front of another one, so it is not counted.
    scan_end: uint64 = n
    if buf[n - 1] == 10:
        scan_end = n - 1

    # Walk BACKWARDS counting separators. `i` is strictly decreasing
    # and the guard is `i > 0`, so this cannot run off the bottom or
    # wrap an unsigned counter -- the two shapes that hang.
    count: uint64 = 0
    start: uint64 = 0
    found: int32 = 0
    i: uint64 = scan_end
    while i > 0:
        i = i - 1
        if buf[i] == 10:
            count = count + 1
            if count >= want:
                start = i + 1
                found = 1
                break

    short: int32 = 0
    if found == 0 and truncated != 0:
        # We reached the front of the window without finding `limit`
        # line breaks, and the window is not the front of the input:
        # buf[0..] is a fragment of a line whose beginning we threw
        # away. Print whole lines only, and say so.
        short = 1
        j: uint64 = 0
        start = n
        while j < n:
            if buf[j] == 10:
                start = j + 1
                break
            j = j + 1

    if start < n:
        sys_write(1, cast[Ptr[uint8]](cast[uint64](buf) + start), n - start)
    return short


# Read the trailing window of `fd` and print its last `limit` lines.
# Returns 0 on a complete answer, 1 on a short one.
def tail_fd(fd: int32, limit: int32) -> int32:
    truncated: int32 = 0

    # Seekable and longer than the window? Skip straight to the tail.
    # A size of 0 from lseek is NOT taken as "empty": procfs reports
    # 0 for files that read back kilobytes, and believing it would
    # print nothing and call that success.
    sz: int64 = sys_lseek(fd, 0, SEEK_END)
    if sz > 0:
        if cast[uint64](sz) > WINDOW:
            sys_lseek(fd, sz - cast[int64](WINDOW), SEEK_SET)
            truncated = 1
        else:
            sys_lseek(fd, 0, SEEK_SET)

    wpos: uint64 = 0
    wrapped: int32 = 0
    while True:
        n: int64 = sys_read(fd, &win[wpos], WINDOW - wpos)
        if n <= 0:
            break
        wpos = wpos + cast[uint64](n)
        if wpos >= WINDOW:
            wpos = 0
            wrapped = 1
    if wrapped != 0:
        truncated = 1

    if wrapped == 0:
        return emit_last(&win[0], wpos, limit, truncated)

    # The ring wrapped: the oldest byte lives at wpos. Rotate it back
    # into reading order before scanning, so no line index ever has
    # to think about the seam.
    k: uint64 = 0
    src: uint64 = wpos
    while k < WINDOW:
        lin[k] = win[src]
        src = src + 1
        if src >= WINDOW:
            src = 0
        k = k + 1
    return emit_last(&lin[0], WINDOW, limit, truncated)


def short_note(pu: Ptr[uint8]):
    write_str(2, "tail: ")
    write_str(2, pu)
    write_str(2, ": the requested lines do not fit in the 65536-byte window")
    write_str(2, " -- printed only the whole lines that did\n")


def main(argc: int32, argv: Ptr[uint64]) -> int32:
    limit: int32 = 10
    first_file: int32 = 1
    if argc >= 2:
        arg: Ptr[uint8] = cast[Ptr[uint8]](argv[1])
        if arg[0] == 45 and arg[1] != 0:            # "-N" (not bare "-")
            v: int32 = parse_int(cast[Ptr[uint8]](
                cast[uint64](arg) + 1))
            if v < 0:
                write_str(2, "tail: bad -N\n")
                return 1
            limit = v
            first_file = 2

    if first_file >= argc:
        if tail_fd(0, limit) != 0:
            short_note("-")
            return 1
        return 0

    many: int32 = 0
    if argc - first_file > 1:
        many = 1
    rc: int32 = 0
    ai: int32 = first_file
    printed: int32 = 0
    while ai < argc:
        path: Ptr[char] = cast[Ptr[char]](argv[cast[uint64](ai)])
        pu: Ptr[uint8] = cast[Ptr[uint8]](path)
        fd: int32 = 0
        opened: int32 = 0
        if pu[0] == 45 and pu[1] == 0:              # "-" == stdin
            fd = 0
        else:
            fd = sys_open(path)
            opened = 1
        if fd < 0:
            write_str(2, "tail: cannot open ")
            write_str(2, pu)
            write_str(2, ": ")
            perror(cast[Ptr[uint8]](0))
            rc = 1
        else:
            if many != 0:
                if printed != 0:
                    write_str(1, "\n")
                write_str(1, "==> ")
                write_str(1, pu)
                write_str(1, " <==\n")
            if tail_fd(fd, limit) != 0:
                short_note(pu)
                rc = 1
            printed = 1
            if opened != 0:
                sys_close(fd)
        ai = ai + 1
    return rc

# user/lsmod.ad
#
# `lsmod` — what is actually in the kernel right now.
#
# THIS FILE USED TO LIE. Verbatim, it was:
#
#     write_str(1, "Module                  Size  Used by\n")
#     write_str(1, "kmod_hello              0     0\n")
#
# — a hard-coded row for a demo module that was not loaded, printed on every
# machine, exiting 0. Its header called that "exercising the column layout".
# On the Hamnix kernel there was at least an excuse (no /proc/modules); on this
# line the file is right there, and a program whose whole job is to say what is
# loaded answering with a fixed string is the project's worst bug shape: the
# gap answers something success-shaped instead of the truth. It is also the
# tool anyone reaches for to CHECK a modprobe, so a fabricated row would have
# certified a modprobe that loaded nothing.
#
# So: open /proc/modules and drain it to stdout. That is the whole program.
#
# /proc/modules is already the lsmod format minus the header — one line per
# module, "name size refcount used_by state address" — so the header is the
# only thing added. If the file cannot be opened, say so on stderr and exit
# non-zero. There is no answer to fall back to: "no modules" and "I could not
# look" are different facts and only one of them is ever true here.

extern def sys_write(fd: int32, buf: Ptr[uint8], count: uint64) -> int64
extern def sys_read(fd: int32, buf: Ptr[uint8], count: uint64) -> int64
extern def sys_open(path: Ptr[char]) -> int32
extern def sys_close(fd: int32) -> int32

buf: Array[4096, uint8]


def strlen_u8(s: Ptr[uint8]) -> uint64:
    n: uint64 = 0
    while s[n] != 0:
        n = n + 1
    return n


def write_str(fd: int32, s: Ptr[uint8]):
    sys_write(fd, s, strlen_u8(s))


def main() -> int32:
    fd: int32 = sys_open("/proc/modules")
    if fd < 0:
        write_str(2, "lsmod: cannot open /proc/modules\n")
        return 1
    write_str(1, "Module                  Size  Used by\n")
    while 1 == 1:
        n: int64 = sys_read(fd, &buf[0], 4096)
        if n <= 0:
            break
        sys_write(1, &buf[0], cast[uint64](n))
    sys_close(fd)
    return 0

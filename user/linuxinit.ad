# user/linuxinit.ad — PID 1 for the Linux line.
#
# Hamnix's init/main.ad is the KERNEL's start_kernel(), not a userspace init,
# and it stays behind with Hamnix 1.0 — the Linux kernel does that job here.
# What that leaves missing is the small piece between "the kernel has mounted
# nothing" and "hamsh can run /etc/rc.boot": on Hamnix the kernel itself posts
# the #c / #p / #s file servers before ELF-loading /init, so the very first
# shell already has a namespace. Linux hands us an empty one.
#
# So this is deliberately thin. It brings up exactly the device servers
# /etc/rc.boot assumes are already there, then execs the real init — which is
# hamsh, exactly as on Hamnix (etc/inittab's last line is `/bin/hamsh`). Every
# policy decision stays in the rc scripts where it is readable and editable.
#
# Note it mounts through sys_bind with the SAME `#X` letters the rc scripts
# use, not through a Linux-specific mount call. That is the point: the Plan 9
# namespace vocabulary is the interface, and on this line `bind '#p' /proc`
# performs a real mount(2). Keeping that seam is what lets the boot scripts
# port unchanged.
#
# Adder notes: buffers must be top-level BSS arrays rather than frame locals,
# and adjacent string-literal concatenation is unsupported.

extern def sys_write(fd: int32, buf: Ptr[uint8], count: uint64) -> int64
extern def sys_bind(newp: Ptr[char], oldp: Ptr[char], flag: int32) -> int32
extern def sys_mkdir(path: Ptr[char]) -> int32
extern def sys_execve_env(path: Ptr[char], argv: Ptr[uint64],
                          envp: Ptr[uint64]) -> int32
extern def sys_waitpid_nb_raw(pid: int32, flags: int64) -> int64
extern def sys_errstr(buf: Ptr[uint8], nbuf: uint64) -> int32
extern def sys_rfork(flags: int32) -> int32
extern def sys_exit(code: uint64)
extern def sys_open(path: Ptr[char]) -> int32
extern def sys_close(fd: int32) -> int32
extern def sys_read(fd: int32, buf: Ptr[uint8], count: uint64) -> int64
extern def sys_init_module(path: Ptr[char], params: Ptr[char]) -> int32
extern def sys_open_write(path: Ptr[char]) -> int32
# The tree's portable park: nfds == 0 means "wait timeout_ms and nothing
# else", off the runqueue on both kernels. user/sleep.ad's header explains
# why it is spelled this way rather than as a spin.
extern def sys_waitfds(fds: Ptr[int32], nfds: uint64, timeout_ms: int64) -> int64

# Never dereferenced at nfds == 0; a top-level BSS array because Adder wants
# one.
park_fds: Array[1, int32]

RFPROC: int32 = 1

# argv/envp vectors for the exec, and a scratch buffer for messages.
init_argv: Array[4, uint64]
init_envp: Array[8, uint64]
errbuf:    Array[128, uint8]
modlist:   Array[8192, uint8]
modpath:   Array[512, uint8]
ptbuf:     Array[64, uint8]


def write_cstr(fd: int32, s: Ptr[uint8]):
    n: uint64 = 0
    while s[n] != 0:
        n = n + 1
    sys_write(fd, s, n)


# WHY EVERY LINE BELOW IS ALSO WRITTEN TO /dev/kmsg.
#
# PID 1's stdout is /dev/console, and /dev/console is the LAST `console=` on
# the kernel command line -- ttyS0 on this image, a serial port that a laptop
# does not display and mostly does not have. So on a real machine every word
# this program has ever printed went into a wire that was not there, and a boot
# that got all the way to hamsh looked exactly like one that died in the EFI
# stub: a blinking cursor. That is what happened on the owner's laptop, and it
# was read as "the boot failed" when nothing had yet been shown to fail.
#
# /dev/kmsg is the other end of printk, and printk goes to EVERY registered
# console -- the serial port, the framebuffer console, and the `earlycon=efifb`
# boot console that is the only thing printing before fbcon exists. So these
# lines reach a physical screen.
#
# ONE write() PER MESSAGE. /dev/kmsg is record-oriented: each write is one log
# record, and only the FIRST bytes of a record may carry the `<N>` priority. A
# message assembled with several writes becomes several records, of which all
# but the first are at the default priority and are therefore invisible at
# loglevel=4 -- exactly the failure this whole file is here to stop. Hence the
# buffer and kflush rather than a sequence of write_cstr calls.
kmsg_fd: int32 = -1
kbuf:    Array[512, uint8]
klen:    uint64 = 0


def kadd(s: Ptr[uint8]):
    i: uint64 = 0
    while s[i] != 0 and klen < 511:
        kbuf[klen] = s[i]
        klen = klen + 1
        i = i + 1
    kbuf[klen] = 0


def kflush():
    if kmsg_fd >= 0 and klen > 0:
        sys_write(kmsg_fd, &kbuf[0], klen)
    klen = 0


def open_kmsg():
    # Called the moment /dev exists. Before that there is nothing to open, and
    # the lines printed before it are still on the console.
    kmsg_fd = sys_open_write(cast[Ptr[char]]("/dev/kmsg"))


def say(msg: Ptr[uint8]):
    # kmsg FIRST. Both copies land on the serial console -- printk writes there
    # too -- and a printk emitted in the middle of this program's own write(2)
    # cuts the line in half, which is how a gate that greps for a marker stops
    # finding it. The printk copy is emitted atomically from the write below,
    # so doing it first leaves the plain line intact behind it.
    klen = 0
    # <6> is KERN_INFO: shown at the loglevel=7 this image boots with, and
    # kept out of the way of anyone who deliberately asked for a quiet boot.
    kadd("<6>linuxinit: ")
    kadd(msg)
    kadd("\n")
    kflush()
    write_cstr(1, "linuxinit: ")
    write_cstr(1, msg)
    write_cstr(1, "\n")


def sayerr(msg: Ptr[uint8]):
    # A say() that survives a quiet command line. <6> is dropped at the
    # loglevel=4 an operator may have asked for; <3> is not, and the lines that
    # go through here are the ones a person MUST see or be misled.
    klen = 0
    kadd("<3>linuxinit: ")
    kadd(msg)
    kadd("\n")
    kflush()
    write_cstr(2, "linuxinit: ")
    write_cstr(2, msg)
    write_cstr(2, "\n")


def warn(what: Ptr[uint8]):
    # A failed bind is not fatal on its own — a developer boot may already have
    # /proc mounted by the initramfs, and /tmp is a convenience. Report the
    # reason and carry on; the rc scripts fail loudly if something they need is
    # genuinely absent.
    n: int32 = sys_errstr(&errbuf[0], 128)
    klen = 0
    # <3> is KERN_ERR: a fault is shown even at the default loglevel=4, which
    # suppresses everything less urgent. A boot that goes wrong says so on the
    # screen whatever command line it was built with. kmsg first, for the
    # interleaving reason given on say().
    kadd("<3>linuxinit: warning: ")
    kadd(what)
    kadd(": ")
    if n > 0:
        kadd(&errbuf[0])
    kadd("\n")
    kflush()
    write_cstr(2, "linuxinit: warning: ")
    write_cstr(2, what)
    write_cstr(2, ": ")
    if n > 0:
        write_cstr(2, &errbuf[0])
    write_cstr(2, "\n")


def bind_or_warn(dst: Ptr[char], src: Ptr[char]):
    sys_mkdir(dst)
    if sys_bind(dst, src, 0) != 0:
        warn(cast[Ptr[uint8]](dst))


def load_modules():
    # /etc/modules is one module PATH per line, already in dependency order,
    # blank lines and '#' comments skipped. Same idea as Debian's /etc/modules,
    # except the paths are absolute because there is no modprobe here to
    # resolve names -- scripts/hamlinux_image.sh resolves the dependency order
    # at image-build time, where a real modprobe is available.
    fd: int32 = sys_open(cast[Ptr[char]]("/etc/modules"))
    if fd < 0:
        return                                    # no modules is a valid image
    n: int64 = sys_read(fd, &modlist[0], 8192)
    sys_close(fd)
    if n <= 0:
        return
    total: uint64 = cast[uint64](n)
    i: uint64 = 0
    loaded: int32 = 0
    while i < total:
        # Collect one line into modpath.
        j: uint64 = 0
        while i < total and modlist[i] != 10:
            if j < 511:
                modpath[j] = modlist[i]
                j = j + 1
            i = i + 1
        i = i + 1                                 # step over the newline
        modpath[j] = 0
        if j == 0:
            continue
        if modpath[0] == 35:                      # '#'
            continue
        if sys_init_module(cast[Ptr[char]](&modpath[0]),
                           cast[Ptr[char]]("")) == 0:
            loaded = loaded + 1
        else:
            warn(&modpath[0])
    write_cstr(1, "linuxinit: loaded ")
    put_dec(cast[uint64](loaded))
    write_cstr(1, " kernel modules\n")


def put_dec(v: uint64):
    d: Array[24, uint8]
    if v == 0:
        write_cstr(1, "0")
        return
    k: uint64 = 24
    while v > 0:
        k = k - 1
        d[k] = cast[uint8](48 + cast[uint32](v % 10))
        v = v / 10
    sys_write(1, &d[k], 24 - k)


cmdline_buf: Array[2048, uint8]

def cmdline_has_root() -> int32:
    # 1 if the kernel command line carries a `root=` with anything after it.
    #
    # It used to insist on `root=/dev/...`, because nothing here could resolve
    # anything else -- so an image whose command line said `root=PARTUUID=...`
    # (the only kind that can be true on a machine this image has never seen)
    # was read as "no root at all" and booted the initramfs in silence.
    # user/linux-syscalls.c:sysroot_device resolves PARTUUID= and UUID= now,
    # and says so by name when it cannot, which is the answer this test used to
    # avoid needing.
    fd: int32 = sys_open(cast[Ptr[char]]("/proc/cmdline"))
    if fd < 0:
        return 0
    n: int64 = sys_read(fd, &cmdline_buf[0], 2047)
    sys_close(fd)
    if n <= 0:
        return 0
    cmdline_buf[n] = 0
    i: uint64 = 0
    cap: uint64 = cast[uint64](n)
    while i + 10 < cap:
        if cmdline_buf[i] == 114 and cmdline_buf[i+1] == 111 \
                and cmdline_buf[i+2] == 111 and cmdline_buf[i+3] == 116 \
                and cmdline_buf[i+4] == 61:                  # "root="
            if i == 0 or cmdline_buf[i-1] == 32:
                # A value, not just the word. `root=` with nothing after it is
                # not a root.
                if cmdline_buf[i+5] != 32 and cmdline_buf[i+5] != 10 \
                        and cmdline_buf[i+5] != 0:
                    return 1
        i = i + 1
    return 0


def ptrace_is_unrestricted():
    # Said once, in one place, so every way of failing to set the knob reports
    # the same consequence in the same words.
    write_cstr(2, "linuxinit: WARNING: ANY process may PTRACE_ATTACH another of the SAME UID and read its memory directly.\n")
    write_cstr(2, "linuxinit: WARNING: on this boot the window system's keystroke channel is bypassable that way -- see THE KEYSTROKE CHANNEL in user/linux-wsys.c.\n")


def set_ptrace_scope():
    # THE ONE THING NO USERLAND MECHANISM CAN DO FOR ITSELF.
    #
    # user/linux-wsys.c moved a window's keystrokes out of the shared segment
    # and into a per-window abstract socket, so a same-uid process can no longer
    # read what is typed into another window by mapping a file. None of that
    # survives ptrace: a process that can PTRACE_ATTACH another of the SAME UID
    # reads its memory directly, keystrokes and pixels and all, and there is no
    # arrangement of file modes, sockets or descriptors underneath it that can
    # prevent it. /etc/rc.de-user drops the terminal, the browser and a
    # malicious download to uid 1001 TOGETHER, which is exactly that case.
    #
    # Linux's answer is the Yama LSM. ptrace_scope 1 -- Debian's and Ubuntu's
    # default, and therefore not a novel policy -- says a process may only be
    # attached by one of its own ANCESTORS. A debugger still debugs anything it
    # launches itself (`gdb ./prog`, `strace prog`), which is how debugging is
    # done nine times in ten; what stops working is attaching to a process
    # somebody else started, and PR_SET_PTRACER exists for the tenth.
    #
    # IT IS SET HERE, IN PID 1, and not in an rc script, for one reason: it must
    # be true BEFORE the first process a person did not start comes up. This
    # runs immediately after `bind '#p' /proc`, which is the earliest instant
    # /proc/sys exists at all.
    #
    # AND IT IS READ BACK. A sysctl write that is accepted and does not take is
    # precisely the success-shaped answer NORTH_STAR.md forbids -- and this one
    # has TWO ways to be silently absent, a kernel built without Yama and a
    # kernel booted with `lsm=` omitting it. Both leave the path absent, so the
    # open fails; a kernel that accepts the write and ignores it would leave the
    # read-back wrong. Every one of those cases says so, by name, on stderr, and
    # says what it costs. A boot with no Yama is still a boot -- the desktop
    # works -- so this warns rather than refusing to come up; what it must never
    # do is stay quiet and let the window system claim a confidentiality
    # boundary the kernel is not enforcing.
    # ABSENT AND UNWRITABLE ARE DIFFERENT FAULTS and are reported as different
    # faults. The first draft of this said "no Yama LSM on this kernel" for
    # both, and the very first run of it -- as an ordinary user on a host that
    # HAS Yama -- printed that sentence about a kernel where the file was
    # sitting right there and only the write was refused. A diagnostic that
    # names the wrong cause is the same failure as one that says nothing.
    probe: int32 = sys_open(
        cast[Ptr[char]]("/proc/sys/kernel/yama/ptrace_scope"))
    if probe < 0:
        write_cstr(2, "linuxinit: WARNING: /proc/sys/kernel/yama/ptrace_scope does not exist: ")
        pn: int32 = sys_errstr(&errbuf[0], 128)
        if pn > 0:
            write_cstr(2, &errbuf[0])
        write_cstr(2, "\n")
        write_cstr(2, "linuxinit: WARNING: this kernel has no Yama LSM (not built in, or not in the boot `lsm=` list).\n")
        ptrace_is_unrestricted()
        return
    sys_close(probe)

    fd: int32 = sys_open_write(
        cast[Ptr[char]]("/proc/sys/kernel/yama/ptrace_scope"))
    if fd < 0:
        write_cstr(2, "linuxinit: WARNING: Yama is present, but kernel.yama.ptrace_scope could not be opened for writing: ")
        n: int32 = sys_errstr(&errbuf[0], 128)
        if n > 0:
            write_cstr(2, &errbuf[0])
        write_cstr(2, "\n")
        ptrace_is_unrestricted()
        return
    sys_write(fd, "1\n", 2)
    sys_close(fd)

    rfd: int32 = sys_open(cast[Ptr[char]]("/proc/sys/kernel/yama/ptrace_scope"))
    if rfd < 0:
        write_cstr(2, "linuxinit: WARNING: kernel.yama.ptrace_scope was written but cannot be read back; the setting is UNVERIFIED.\n")
        return
    got: int64 = sys_read(rfd, &ptbuf[0], 63)
    sys_close(rfd)
    if got <= 0:
        write_cstr(2, "linuxinit: WARNING: kernel.yama.ptrace_scope read back empty; the setting is UNVERIFIED.\n")
        return
    ptbuf[got] = 0
    i: uint64 = 0
    while i < cast[uint64](got):
        if ptbuf[i] == 10:
            ptbuf[i] = 0
        i = i + 1
    if ptbuf[0] == 49:                            # '1'
        say("kernel.yama.ptrace_scope = 1 — a same-uid PTRACE_ATTACH by a non-ancestor is refused")
        return
    write_cstr(2, "linuxinit: WARNING: kernel.yama.ptrace_scope reads back as ")
    write_cstr(2, &ptbuf[0])
    write_cstr(2, " after writing 1: the write did not take, and same-uid ptrace is NOT restricted on this boot.\n")


def main(argc: int32, argv: Ptr[uint64]) -> int32:
    say("Hamnix on Linux — bringing up the namespace")

    # The device servers /etc/rc.boot expects to inherit. Order matters only in
    # that /dev must exist before /dev/pts.
    bind_or_warn(cast[Ptr[char]]("/proc"),    cast[Ptr[char]]("#p"))
    bind_or_warn(cast[Ptr[char]]("/sys"),     cast[Ptr[char]]("#sys"))
    bind_or_warn(cast[Ptr[char]]("/dev"),     cast[Ptr[char]]("#c"))
    # /dev exists, so the printk channel does. Everything from here is on the
    # screen of a machine with no serial port -- including the banner above,
    # repeated once so that "PID 1 is running" is visible even to someone who
    # only ever sees the framebuffer.
    open_kmsg()
    say("Hamnix on Linux — PID 1 is running")
    bind_or_warn(cast[Ptr[char]]("/dev/pts"), cast[Ptr[char]]("#pts"))
    bind_or_warn(cast[Ptr[char]]("/srv"),     cast[Ptr[char]]("#s"))
    bind_or_warn(cast[Ptr[char]]("/n"),       cast[Ptr[char]]("#/"))
    bind_or_warn(cast[Ptr[char]]("/tmp"),     cast[Ptr[char]]("#t"))

    # Boot policy, set at the first instant /proc/sys exists. See the comment
    # on the function: everything the window system does about same-uid
    # confidentiality rests on this one line.
    set_ptrace_scope()

    # Drivers come after /sys and /dev exist: the module init paths want both,
    # and devtmpfs is what materialises /dev/dri/card0 once virtio-gpu attaches.
    load_modules()

    # THE ROOT SWITCH.
    #
    # Everything above ran out of the initramfs, which is RAM and gone at
    # reboot. If the kernel was told which disk holds the real root, this is
    # where we move onto it -- the same job every Linux initramfs does, said
    # in the tree's own words:
    #
    #     bind '#sysroot' /
    #
    # which is exactly what Hamnix's etc/rc.boot does on the native line. The
    # device comes from the kernel's own command line (sys_bind resolves it),
    # so one image boots any machine. The mounts already made are MOVED across
    # rather than remade, so the running processes' /srv segments and the one
    # devtmpfs survive the switch.
    #
    # No root= means an initramfs-only boot, which is a legitimate way to run
    # this and what every developer boot does; there is nothing to switch to.
    if cmdline_has_root() != 0:
        if sys_bind(cast[Ptr[char]]("/"), cast[Ptr[char]]("#sysroot"), 0) != 0:
            warn(cast[Ptr[uint8]]("bind '#sysroot' /"))
            # WHAT IT COSTS, not just what failed. The machine still comes up,
            # which is deliberate -- a shell that can look at the disks and run
            # the installer is worth more than a dead screen -- but a system
            # running out of the initramfs looks exactly like an installed one
            # until the day it is rebooted and everything since the install is
            # gone. user/linux-syscalls.c:sysroot_device has just printed the
            # identifier it wanted and every partition it found instead.
            sayerr("THE ROOT PARTITION NAMED ON THE COMMAND LINE WAS NOT FOUND.")
            sayerr("this system is running FROM RAM: nothing you save will survive a reboot.")
            # AND THEN HOLD THE SCREEN, because the message above was
            # UNREADABLE until this line existed.
            #
            # MEASURED, 2026-08-14, the usb-storage boot of this image: those
            # two lines reached the framebuffer at t=1.58s and the compositor
            # took /dev/fb and painted the desktop over them before t=3s. A
            # screenshot one second later is an ordinary, correct-looking
            # desktop. So the one boot outcome a person MUST be told about was
            # on the screen for under a second and a half, and what they were
            # left looking at was a system that appears to have worked and
            # will lose everything they do on it at the next reboot -- a
            # failure wearing the shape of a success, which is worse than the
            # blinking cursor this whole console arrangement was built to fix.
            #
            # There is no shell here to ask, and on the owner's laptop there
            # is no serial cable either: the screen is the only channel, and
            # holding it is the only way to use it. Fifteen seconds is long
            # enough to read four lines and to photograph them, and it is paid
            # ONLY on the path that has already gone wrong -- a boot that
            # found its root never reaches this branch.
            sayerr("the desktop will start in 15 seconds. READ THE LINES ABOVE FIRST:")
            sayerr("  they are the difference between an installed machine and a live one.")
            sayerr("  if this is a USB boot, the stick was not seen -- try another port,")
            sayerr("  preferably a USB-2 one, and prefer a port on the machine to a hub.")
            sys_waitfds(&park_fds[0], 0, 15000)
        else:
            say("root filesystem online")

    say("namespace ready — exec /bin/hamsh /etc/rc.boot")

    # Hand off to hamsh, exactly as etc/inittab does on Hamnix. hamsh becomes
    # PID 1 itself via exec, so it inherits the reaping duty that comes with
    # it — which it can now discharge, since sys_waitpid is implemented.
    init_argv[0] = cast[uint64](cast[Ptr[char]]("/bin/hamsh"))
    init_argv[1] = cast[uint64](cast[Ptr[char]]("/etc/rc.boot"))
    init_argv[2] = 0
    init_envp[0] = cast[uint64](cast[Ptr[char]]("PATH=/bin"))
    init_envp[1] = cast[uint64](cast[Ptr[char]]("HOME=/root"))
    init_envp[2] = cast[uint64](cast[Ptr[char]]("TERM=linux"))
    init_envp[3] = 0

    sys_execve_env(cast[Ptr[char]]("/bin/hamsh"),
                   cast[Ptr[uint64]](&init_argv[0]),
                   cast[Ptr[uint64]](&init_envp[0]))

    # Only reached if the exec failed. PID 1 exiting panics the kernel, which
    # is a worse diagnostic than saying why, so report and then stop.
    warn(cast[Ptr[uint8]]("exec /bin/hamsh"))
    say("PID 1 cannot continue")
    return 1

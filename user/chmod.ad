# user/chmod.ad
#
# Hamnix `chmod MODE FILE...` — set each file's permission bits.
#
# WHY THIS EXISTS, MEASURED. docs/dev-loop.md says flatly "There is no
# `chmod` on the image", and adds that `mv` preserves "the mode wget
# wrote" so a push works anyway. THAT IS FALSE, and the false half is the
# one that matters: user/wget.ad writes its output with sys_open_write,
# which is open(O_WRONLY|O_CREAT|O_TRUNC, 0666) (user/linux-syscalls.c),
# so under the default umask the fetched file lands 0644 — NO EXECUTE BIT
# AT ALL. Measured in a running dev VM: after
# `scripts/devvm_push.sh user/sshd.ad` the guest answered
#
#   exec: `/bin/sshd' exists (mode 0644) but execve(2) answered EACCES
#
# while devvm_push.sh had already printed "done — /bin/sshd is the build
# just made". A push of any BINARY was therefore never running; the loop
# only ever looked like it worked. `cp` does not rescue it either:
# user/cp.ad copies the SOURCE's mode onto the destination, and the
# source is the 0644 file wget just wrote.
#
# MODE is octal, with or without a leading 0 (`755`, `0755`, `600`).
# Symbolic modes (`u+x`) are deliberately not supported: this is the tool
# a push chain needs, and a half-implemented symbolic parser that silently
# ignored what it could not parse would be worse than not having one.

extern def sys_write(fd: int32, buf: Ptr[uint8], count: uint64) -> int64
extern def sys_chmod(path: Ptr[char], mode: uint32) -> int32


def strlen_u8(s: Ptr[uint8]) -> uint64:
    n: uint64 = 0
    while s[n] != 0:
        n = n + 1
    return n


def write_str(fd: int32, s: Ptr[uint8]):
    sys_write(fd, s, strlen_u8(s))


# Parse an octal mode. Returns -1 on ANY malformed input rather than
# parsing a prefix and applying it: `chmod 7x5 f` must refuse, not
# quietly apply 07.
def parse_mode(s: Ptr[uint8]) -> int64:
    if s[0] == 0:
        return -1
    v: uint64 = 0
    i: uint64 = 0
    digits: int32 = 0
    while s[i] != 0:
        c: uint8 = s[i]
        if c < 48 or c > 55:
            return -1
        v = v * 8 + cast[uint64](c - 48)
        digits = digits + 1
        if digits > 6:
            return -1
        i = i + 1
    if v > 4095:
        return -1
    return cast[int64](v)


def main(argc: int32, argv: Ptr[uint64]) -> int32:
    if argc < 3:
        write_str(2, "chmod: usage: chmod MODE FILE...\n")
        return 1
    m: int64 = parse_mode(cast[Ptr[uint8]](argv[1]))
    if m < 0:
        write_str(2, "chmod: invalid mode (octal only, e.g. 755)\n")
        return 1
    mode: uint32 = cast[uint32](cast[uint64](m))
    rc: int32 = 0
    i: int32 = 2
    while i < argc:
        p: Ptr[uint8] = cast[Ptr[uint8]](argv[cast[uint64](i)])
        if sys_chmod(cast[Ptr[char]](p), mode) != 0:
            write_str(2, "chmod: cannot change mode of ")
            write_str(2, p)
            write_str(2, "\n")
            rc = 1
        i = i + 1
    return rc

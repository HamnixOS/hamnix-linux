# user/scene_raster_host.ad — HOST helper: read a hamscene display-list file
# (as dumped by hamdesktop/hampanelscene's --scene-dump hook), load it into the
# lib/hamscene buffer and rasterize it to a PPM via the same lib/hamui_host
# raster path the kernel compositor uses. QEMU-free. Used by
# scripts/test_de_scene_opt_host.sh to VIEW that the DE scene renders NON-BLANK
# under --opt (the "scene-DE-blank" regression guard).
#
#   scene_raster_host <in.dl> <out.ppm>

extern def sys_open(path: Ptr[char]) -> int32
extern def sys_open_write(path: Ptr[char]) -> int32
extern def sys_read(fd: int32, buf: Ptr[uint8], count: uint64) -> int64
extern def sys_write(fd: int32, buf: Ptr[uint8], count: uint64) -> int64
extern def sys_close(fd: int32) -> int32

from lib.hamscene import hamscene_load
from lib.hamui_host import hamui_host_begin, hamui_host_rasterize, \
    hamui_host_ppm_header, hamui_host_fb_ptr, hamui_host_fb_bytes

dlbuf: Array[16384, uint8]
ppm_hdr: Array[64, uint8]


def _slen(s: Ptr[uint8]) -> uint64:
    n: uint64 = 0
    while s[n] != 0:
        n = n + 1
    return n


def _puts(fd: int32, s: Ptr[uint8]):
    sys_write(fd, s, _slen(s))


def main(argc: int32, argv: Ptr[uint64]) -> int32:
    # Every exit below used to be a bare number with no output, so this
    # harness could fail four different ways and look identical from outside:
    # a run sweep recorded "exit 1", full stop. A harness whose whole purpose
    # is to make a blank render visible must not itself fail invisibly.
    if argc < 3:
        _puts(2, "usage: scene_raster_host <in.dl> <out.ppm>\n")
        return 2
    fd: int32 = sys_open(cast[Ptr[char]](argv[1]))
    if fd < 0:
        _puts(2, "scene_raster_host: cannot open the display list ")
        _puts(2, cast[Ptr[uint8]](argv[1]))
        _puts(2, " -- dump one with hamdesktop/hampanelscene --scene-dump\n")
        return 1
    total: uint64 = 0
    while total < 16384:
        n: int64 = sys_read(fd, cast[Ptr[uint8]](
            cast[uint64](&dlbuf[0]) + total), 16384 - total)
        if n <= 0:
            break
        total = total + cast[uint64](n)
    sys_close(fd)
    if total == 0:
        _puts(2, "scene_raster_host: the display list is EMPTY -- rasterizing it would produce a blank PPM and call it a render\n")
        return 1

    hamscene_load(&dlbuf[0], total)
    hamui_host_begin(800, 600)
    hamui_host_rasterize()

    ofd: int32 = sys_open_write(cast[Ptr[char]](argv[2]))
    if ofd < 0:
        _puts(2, "scene_raster_host: cannot create the output PPM ")
        _puts(2, cast[Ptr[uint8]](argv[2]))
        _puts(2, "\n")
        return 1
    hlen: uint64 = hamui_host_ppm_header(&ppm_hdr[0])
    sys_write(ofd, &ppm_hdr[0], hlen)
    sys_write(ofd, hamui_host_fb_ptr(), hamui_host_fb_bytes())
    sys_close(ofd)
    _puts(1, "scene_raster_host: rasterized ")
    _puts(1, cast[Ptr[uint8]](argv[1]))
    _puts(1, " -> ")
    _puts(1, cast[Ptr[uint8]](argv[2]))
    _puts(1, "\n")
    return 0

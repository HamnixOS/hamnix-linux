# user/hlinstall.ad — install hamnix-linux onto a disk, from the live system.
#
# The counterpart to scripts/hamlinux_disk.sh, which builds the same disk on a
# development host. This one runs on the machine you are installing.
#
#   hlinstall                 list the disks and stop
#   hlinstall /dev/vdb        install onto that disk, ERASING it
#
#   hlinstall --auto /dev/vdb --hostname <h> --user <u> --user-pass <p>
#             --root-pass <p> [--esp-mb <n>] [--part-mode guided|manual]
#             [--repo <url>]
#
# The flag form is what user/haminstallui.ad -- the DE's multi-page install
# wizard -- spawns, and it is why this program is also installed as
# /bin/install: the wizard was written against that name and that argv, and
# the wizard is the part worth keeping.
#
# WHAT IT MAKES
#   GPT
#   ├─ p1  ESP, FAT32, 512M   /EFI/BOOT/BOOTX64.EFI + kernel + initramfs
#   └─ p2  ext4, the rest     the Hamnix root
#
# BOOTX64.EFI is the removable-media path, which firmware runs without an NVRAM
# entry. Deliberate: an installer that writes a boot variable has to know about
# efibootmgr, secure boot and a decade of firmware bugs, and a disk that boots
# because it is plugged in works on all of them.
#
# WHERE THE TOOLS COME FROM
# -------------------------
# sgdisk, mkfs.vfat and mkfs.ext4 run INSIDE the Debian namespace.
# Partitioning a disk and making an ext4 filesystem are Linux-ecosystem jobs;
# the tree's own user/mkfs_ext4.ad is a thin wrapper around the HAMNIX kernel's
# /dev/blk ctl grammar and has no kernel to talk to here. So this reaches for
# them the way it reaches for a driver, and the boundary is the one
# docs/packages.md already draws: hpm does not try to be apt, and Hamnix does
# not reimplement e2fsprogs.
#
# Each tool runs as a CHILD that does the Plan 9 dance itself:
#
#   rfork(RFPROC|RFNAMEG)     a private namespace, so nothing leaks back
#   bind '#distro' /          enter the Debian root
#   exec the tool             it never learns any of this happened
#
# which is user/nsrun.ad's invariant -- rfork BEFORE mount -- and exactly what
# tests/linux/distro_probe.ad proves.
#
# The DEVICE NODES are shared with the namespace: `bind '#distro' /` carries
# /dev across (user/linux-syscalls.c:enter_root), so a tool inside it operates
# on the same disk this process is looking at.
#
# THE COPY IS THE EXCEPTION, and it has to be. A tool that has entered the
# Debian root cannot see the Hamnix root at all -- that is the isolation
# working -- so the one job that must see BOTH sides is done from out here,
# with the tree's own cp.

extern def sys_write(fd: int32, buf: Ptr[uint8], count: uint64) -> int64
extern def sys_read(fd: int32, buf: Ptr[uint8], count: uint64) -> int64
extern def sys_open(path: Ptr[char]) -> int32
extern def sys_open_write(path: Ptr[char]) -> int32
extern def sys_close(fd: int32) -> int32
extern def sys_mkdir(path: Ptr[char]) -> int32
extern def sys_rfork(flags: int32) -> int32
extern def sys_bind(newp: Ptr[char], oldp: Ptr[char], flag: int32) -> int32
extern def sys_execve_env(path: Ptr[char], argv: Ptr[uint64],
                          envp: Ptr[uint64]) -> int32
extern def sys_waitpid(pid: int32) -> int64
extern def sys_pipe(fds: Ptr[int32]) -> int32
extern def sys_dup2(old: int32, new_: int32) -> int32
extern def sys_exit(code: uint64)
extern def sys_errstr(buf: Ptr[uint8], nbuf: uint64) -> int32

RFPROC:  int32 = 0x001
RFFDG:   int32 = 0x004
RFNAMEG: int32 = 0x008

argbuf:  Array[8, uint64]
pipefd:  Array[2, int32]
hostname_buf: Array[64, uint8]
user_buf:     Array[64, uint8]
upass_buf:    Array[128, uint8]
rpass_buf:    Array[128, uint8]
hash_buf:     Array[256, uint8]
line_buf:     Array[512, uint8]
repo_buf:     Array[256, uint8]
esp_mb:  int32 = 512
have_host: int32 = 0
have_user: int32 = 0
have_repo: int32 = 0
envbuf:  Array[4, uint64]
p1:      Array[64, uint8]        # <disk>1
p2:      Array[64, uint8]        # <disk>2
disk:    Array[64, uint8]
a1:      Array[128, uint8]
a2:      Array[128, uint8]
a3:      Array[128, uint8]
a4:      Array[128, uint8]
listbuf: Array[2048, uint8]
errbuf:  Array[128, uint8]


def slen(s: Ptr[uint8]) -> uint64:
    n: uint64 = 0
    while s[n] != 0:
        n = n + 1
    return n


def puts(fd: int32, s: Ptr[uint8]):
    sys_write(fd, s, slen(s))


def copy_str(dst: Ptr[uint8], src: Ptr[uint8]) -> uint64:
    i: uint64 = 0
    while src[i] != 0 and i < 120:
        dst[i] = src[i]
        i = i + 1
    dst[i] = 0
    return i


def why(what: Ptr[uint8]):
    puts(2, what)
    puts(2, ": ")
    n: int32 = sys_errstr(&errbuf[0], 128)
    if n > 0:
        puts(2, &errbuf[0])
    puts(2, "\n")


# Run a program in THIS namespace -- no distro, no chroot. Used for the copy,
# because the copy has to see both roots at once.
def run_local(prog: Ptr[char], n_args: int32) -> int32:
    pid: int32 = sys_rfork(RFPROC | RFFDG)
    if pid < 0:
        why(cast[Ptr[uint8]]("rfork"))
        return -1
    if pid == 0:
        argbuf[0] = cast[uint64](prog)
        if n_args > 0:
            argbuf[1] = cast[uint64](&a1[0])
        if n_args > 1:
            argbuf[2] = cast[uint64](&a2[0])
        if n_args > 2:
            argbuf[3] = cast[uint64](&a3[0])
        if n_args > 3:
            argbuf[4] = cast[uint64](&a4[0])
        argbuf[cast[uint64](n_args) + 1] = 0
        envbuf[0] = cast[uint64](cast[Ptr[char]]("PATH=/bin"))
        envbuf[1] = 0
        sys_execve_env(prog, cast[Ptr[uint64]](&argbuf[0]),
                       cast[Ptr[uint64]](&envbuf[0]))
        sys_exit(127)
    st: int64 = sys_waitpid(pid)
    return cast[int32](st)


# Copy one top-level directory of the live root into the target.
def copy_top(name: Ptr[uint8]) -> int32:
    copy_str(&a1[0], cast[Ptr[uint8]]("-r"))
    a2[0] = 47                                    # "/<name>"
    copy_str(&a2[1], name)
    copy_str(&a3[0], cast[Ptr[uint8]]("/n/target/"))
    puts(1, "  ")
    puts(1, name)
    puts(1, "\n")
    return run_local(cast[Ptr[char]]("/bin/cp"), 3)


# Run one Debian tool inside the distro namespace. Up to four arguments; a
# NULL-terminated argv is built from them. Returns the child's exit status.
def run_in_distro(prog: Ptr[char], n_args: int32) -> int32:
    pid: int32 = sys_rfork(RFPROC | RFFDG | RFNAMEG)
    if pid < 0:
        why(cast[Ptr[uint8]]("rfork"))
        return -1
    if pid == 0:
        # The Plan 9 invariant: the namespace is private BEFORE anything is
        # bound into it, so this mount cannot be seen by anyone else.
        #
        # TWO SOURCES, AND THE SECOND ONE IS WHY AN INSTALL FROM A USB STICK
        # WORKS AT ALL. `#distro` is the full Debian medium, and on a
        # DEVELOPMENT HOST it is always there -- scripts/hamlinux_vm.sh hands
        # QEMU `-drive file=build/image/distro.ext4` on every run, so every
        # install ever driven in a VM found it. A LAPTOP BOOTED FROM A USB
        # STICK HAS NO SUCH DISK: /etc/distros resolves `#distro` to
        # LABEL=hamnix-debian, scripts/hamlinux_disk.sh writes a TWO-partition
        # medium (ESP + root) and nothing on it carries that label. So this
        # bind failed, `sgdisk` never ran, and the installer that the
        # Applications menu offers could not partition anything -- on the one
        # configuration the whole live image exists for.
        #
        # /usr/lib/instroot is the answer, and it is deliberately NOT a copy of
        # Debian. hlinstall needs exactly three programs -- sgdisk, mkfs.vfat
        # and mkfs.ext4 -- and their shared-library closure is 7.0 MB measured,
        # against 2.0 GB for the medium it is standing in for. That fits on the
        # live image; a Debian rootfs does not.
        #
        # `#distro` is tried FIRST so a machine that does have the real medium
        # keeps using it and this changes nothing about the path every existing
        # test drives.
        if sys_bind(cast[Ptr[char]]("/"), cast[Ptr[char]]("#distro"), 0) != 0:
            if sys_bind(cast[Ptr[char]]("/"),
                        cast[Ptr[char]]("/usr/lib/instroot"), 0) != 0:
                # "FAILED" is load bearing: user/haminstallui.ad scans the
                # installer's output for "FAIL" and turns the wizard red. A
                # message that did not contain it would leave the wizard
                # sitting on "installing..." forever, which is the
                # success-shaped nothing this tree exists to avoid.
                puts(2, "hlinstall: FAILED -- no partitioning tools.\n")
                puts(2, "  This medium carries neither a Debian namespace\n")
                puts(2, "  (#distro) nor /usr/lib/instroot, so sgdisk and\n")
                puts(2, "  mkfs cannot run and NOTHING HAS BEEN WRITTEN.\n")
                puts(2, "  Rebuild the medium with HAMLINUX_INSTALLER=1.\n")
                sys_exit(126)
        argbuf[0] = cast[uint64](prog)
        if n_args > 0:
            argbuf[1] = cast[uint64](&a1[0])
        if n_args > 1:
            argbuf[2] = cast[uint64](&a2[0])
        if n_args > 2:
            argbuf[3] = cast[uint64](&a3[0])
        if n_args > 3:
            argbuf[4] = cast[uint64](&a4[0])
        argbuf[cast[uint64](n_args) + 1] = 0
        envbuf[0] = cast[uint64](cast[Ptr[char]]("PATH=/usr/sbin:/usr/bin:/sbin:/bin"))
        envbuf[1] = 0
        sys_execve_env(prog, cast[Ptr[uint64]](&argbuf[0]),
                       cast[Ptr[uint64]](&envbuf[0]))
        puts(2, "hlinstall: cannot run the tool\n")
        sys_exit(127)
    st: int64 = sys_waitpid(pid)
    return cast[int32](st)


def emit_dec(buf: Ptr[uint8], at: uint64, v: int32) -> uint64:
    d: Array[12, uint8]
    n: uint64 = 0
    x: int32 = v
    i: uint64 = at
    if x == 0:
        d[0] = 48
        n = 1
    while x > 0:
        d[n] = cast[uint8](48 + x % 10)
        x = x / 10
        n = n + 1
    while n > 0:
        n = n - 1
        buf[i] = d[n]
        i = i + 1
    return i


# THE IDENTITY THE TARGET'S ROOT PARTITION MUST HAVE.
#
# This installer copies /boot/BOOTX64.EFI onto the target's ESP BYTE FOR BYTE.
# That file is a unified kernel image: the kernel, the initramfs and the KERNEL
# COMMAND LINE fused into one PE binary, and the command line says
# `root=PARTUUID=<something>` -- chosen by scripts/hamlinux_disk.sh when the
# install medium was built. Rewriting a PE section from here is not something
# this program can do.
#
# So it does the other half. scripts/hamlinux_disk.sh also writes the GUID to
# /boot/root.partuuid, and the partition created below is given exactly that
# GUID with `sgdisk --partition-guid`. The booted kernel then finds its root by
# an identifier that is true on this machine, whatever the disk is called --
# /dev/sda2 off a USB stick, /dev/nvme0n1p2 on a laptop, /dev/vdb2 in a VM.
#
# Before this, the installed disk inherited whatever random GUID sgdisk chose
# and the copied UKI went looking for the BUILD HOST's partition, which no
# installed machine has.
#
# THE COST OF DOING IT THIS WAY ROUND, said here rather than discovered later:
# the installed disk and the medium it was installed from now carry the SAME
# partition GUID, so a machine booted with the USB stick still plugged in has
# two partitions answering to one name. user/linux-syscalls.c's resolver walks
# every disk for exactly this reason and says so by name when it finds a
# second, and it mounts the first. The clean fix is for this program to choose
# a FRESH guid and rewrite the 36 bytes of it inside the copied BOOTX64.EFI --
# the string is the same length, so it is a byte replacement rather than a PE
# edit -- and that is the next piece of work here, not something this one
# quietly pretends to have done.
partuuid_buf: Array[64, uint8]


def is_hex(c: uint8) -> int32:
    if c >= 48 and c <= 57:
        return 1
    if c >= 97 and c <= 102:
        return 1
    if c >= 65 and c <= 70:
        return 1
    return 0


# 0 if /boot/root.partuuid held a canonical 8-4-4-4-12 UUID, which is now in
# partuuid_buf. Checked rather than trusted: a truncated or empty file would
# otherwise be passed to sgdisk, which would reject it AFTER the disk had been
# erased.
def read_root_partuuid() -> int32:
    fd: int32 = sys_open(cast[Ptr[char]]("/boot/root.partuuid"))
    if fd < 0:
        return -1
    n: int64 = sys_read(fd, &partuuid_buf[0], 63)
    sys_close(fd)
    if n <= 0:
        return -1
    i: uint64 = cast[uint64](n)
    while i > 0 and partuuid_buf[i - 1] <= 32:
        i = i - 1
    partuuid_buf[i] = 0
    if i != 36:
        return -1
    j: uint64 = 0
    while j < 36:
        if j == 8 or j == 13 or j == 18 or j == 23:
            if partuuid_buf[j] != 45:                 # '-'
                return -1
        else:
            if is_hex(partuuid_buf[j]) == 0:
                return -1
        j = j + 1
    return 0


def step(msg: Ptr[uint8]):
    puts(1, "\n=== ")
    puts(1, msg)
    puts(1, " ===\n")


def list_disks():
    puts(1, "disks on this machine (/sys/block):\n")
    fd: int32 = sys_open(cast[Ptr[char]]("/sys/block"))
    if fd < 0:
        why(cast[Ptr[uint8]]("open /sys/block"))
        return
    total: uint64 = 0
    while total < 2047:
        k: int64 = sys_read(fd, &listbuf[total], 2047 - total)
        if k <= 0:
            break
        total = total + cast[uint64](k)
    sys_close(fd)
    listbuf[total] = 0
    sys_write(1, &listbuf[0], total)
    puts(1, "\nusage: hlinstall /dev/<disk>   -- ERASES that disk\n")


# Copy one file with plain reads and writes. Used for the three boot files,
# which is a small enough job not to want rsync for.
def copy_file(src: Ptr[char], dst: Ptr[char]) -> int32:
    sfd: int32 = sys_open(src)
    if sfd < 0:
        return -1
    dfd: int32 = sys_open_write(dst)
    if dfd < 0:
        sys_close(sfd)
        return -1
    rc: int32 = 0
    while 1 == 1:
        n: int64 = sys_read(sfd, &listbuf[0], 2048)
        if n < 0:
            rc = -1
            break
        if n == 0:
            break
        if sys_write(dfd, &listbuf[0], cast[uint64](n)) != n:
            rc = -1
            break
    sys_close(sfd)
    sys_close(dfd)
    return rc


# THE INSTALLED MACHINE'S /etc/rc.boot IS AN INDIRECTION, NOT A COPY.
#
# It used to be a byte-for-byte copy of /etc/rc.boot.installed, and that made
# the machine's boot script and the package's boot script the same object:
# `hpm install` on an installed box replaced the running system's rc with the
# initramfs one, and the obvious repair -- letting the package stop owning
# etc/rc.boot -- left the machine with NO rc at all, because an upgrade
# removes what the old version owned. Both were measured on a real installed
# disk; docs/linux_installed_update.md §2b has them.
#
# So what goes on the disk is one line that names the real rc:
#
#     source '/etc/rc.boot.installed'
#
# Everything a release can improve now lives in /etc/rc.boot.installed, which
# hamnix-init owns and an update DELIVERS; the file the machine boots stays
# the machine's, and hpm knows not to touch it
# (user/hpm.ad:_is_machine_owned). Anything specific to this box goes below
# the source line and survives every update.
#
# The live image's own /etc/rc.boot.machine is preferred when it is there, so
# the installed file is the same bytes the package would lay down; the
# written fallback keeps an image that does not carry it installable.
def write_machine_rc_boot() -> int32:
    if copy_file(cast[Ptr[char]]("/etc/rc.boot.machine"),
                 cast[Ptr[char]]("/n/target/etc/rc.boot")) == 0:
        return 0
    fd: int32 = sys_open_write(cast[Ptr[char]]("/n/target/etc/rc.boot"))
    if fd < 0:
        return -1
    sys_write(fd, "# /etc/rc.boot -- the boot script of THIS MACHINE.\n", 51)
    sys_write(fd, "# Written by the installer; owned by no package.\n", 49)
    sys_write(fd, "# The rc a release can improve is the one it sources.\n", 54)
    sys_write(fd, "\n", 1)
    sys_write(fd, "source '/etc/rc.boot.installed'\n", 32)
    sys_close(fd)
    return 0


def streq(a: Ptr[uint8], b: Ptr[uint8]) -> int32:
    i: uint64 = 0
    while a[i] != 0 and b[i] != 0:
        if a[i] != b[i]:
            return 0
        i = i + 1
    if a[i] != b[i]:
        return 0
    return 1


def parse_int(p: Ptr[uint8]) -> int32:
    v: int32 = 0
    i: uint64 = 0
    while p[i] >= 48 and p[i] <= 57:
        v = v * 10 + cast[int32](p[i]) - 48
        i = i + 1
    return v


# Hash a password the way the target's /etc/shadow needs it. openssl lives in
# the Debian namespace; asking it is honest work, and inventing a hash format
# would produce an account nobody could log into.
def hash_password(plain: Ptr[uint8]) -> int32:
    hash_buf[0] = 0
    if sys_pipe(&pipefd[0]) != 0:
        return -1
    pid: int32 = sys_rfork(RFPROC | RFFDG | RFNAMEG)
    if pid < 0:
        return -1
    if pid == 0:
        sys_close(pipefd[0])
        sys_dup2(pipefd[1], 1)
        sys_close(pipefd[1])
        if sys_bind(cast[Ptr[char]]("/"), cast[Ptr[char]]("#distro"), 0) != 0:
            sys_exit(126)
        copy_str(&a1[0], cast[Ptr[uint8]]("passwd"))
        copy_str(&a2[0], cast[Ptr[uint8]]("-6"))
        copy_str(&a3[0], plain)
        argbuf[0] = cast[uint64](cast[Ptr[char]]("/usr/bin/openssl"))
        argbuf[1] = cast[uint64](&a1[0])
        argbuf[2] = cast[uint64](&a2[0])
        argbuf[3] = cast[uint64](&a3[0])
        argbuf[4] = 0
        envbuf[0] = cast[uint64](cast[Ptr[char]]("PATH=/usr/bin:/bin"))
        envbuf[1] = 0
        sys_execve_env(cast[Ptr[char]]("/usr/bin/openssl"),
                       cast[Ptr[uint64]](&argbuf[0]),
                       cast[Ptr[uint64]](&envbuf[0]))
        sys_exit(127)
    sys_close(pipefd[1])
    total: uint64 = 0
    while total < 250:
        k: int64 = sys_read(pipefd[0], &hash_buf[total], 250 - total)
        if k <= 0:
            break
        total = total + cast[uint64](k)
    sys_close(pipefd[0])
    sys_waitpid(pid)
    # Trim the trailing newline; a hash with one in it is not a hash.
    while total > 0 and (hash_buf[total - 1] == 10 or hash_buf[total - 1] == 13):
        total = total - 1
    hash_buf[total] = 0
    if total < 10:
        return -1
    return 0


def append_line(path: Ptr[char], line: Ptr[uint8]) -> int32:
    # Read what is there, write it back with the line appended. The tree has
    # no O_APPEND open, and a system file is small enough that this is the
    # simplest correct thing.
    fd: int32 = sys_open(path)
    total: uint64 = 0
    if fd >= 0:
        while total < 480:
            k: int64 = sys_read(fd, &line_buf[total], 480 - total)
            if k <= 0:
                break
            total = total + cast[uint64](k)
        sys_close(fd)
    out: int32 = sys_open_write(path)
    if out < 0:
        return -1
    if total > 0:
        sys_write(out, &line_buf[0], total)
        if line_buf[total - 1] != 10:
            sys_write(out, cast[Ptr[uint8]]("\n"), 1)
    sys_write(out, line, slen(line))
    sys_write(out, cast[Ptr[uint8]]("\n"), 1)
    sys_close(out)
    return 0


def write_file(path: Ptr[char], text: Ptr[uint8]) -> int32:
    fd: int32 = sys_open_write(path)
    if fd < 0:
        return -1
    sys_write(fd, text, slen(text))
    sys_close(fd)
    return 0


def has_prefix(s: Ptr[uint8], p: Ptr[uint8]) -> int32:
    i: uint64 = 0
    while p[i] != 0:
        if s[i] != p[i]:
            return 0
        i = i + 1
    return 1


# A repo URL the installed system cannot fetch from is worse than no flag at
# all: hpm would fall through to its built-in default and the operator would
# never learn their choice was discarded. So the shape is checked HERE, before
# the disk is touched -- refusing costs nothing, and refusing after mkfs costs
# the disk.
def repo_url_ok(u: Ptr[uint8]) -> int32:
    if has_prefix(u, cast[Ptr[uint8]]("http://")) != 0:
        return 1
    if has_prefix(u, cast[Ptr[uint8]]("https://")) != 0:
        return 1
    # file:// with the empty authority spelled out. `file://packages/` looks
    # like a path and is really a HOST named `packages`, so the third slash is
    # required rather than forgiven.
    if has_prefix(u, cast[Ptr[uint8]]("file:///")) != 0:
        return 1
    return 0


# Point the installed system's package manager at the repo the operator chose.
#
# /etc/hpm/repo is the file hpm already reads, and it sits at the TOP of hpm's
# base-URL precedence (user/hpm.ad::_set_repo_default), above the on-image
# file:// mirror and above the hosted default. So one line here is the whole
# job: `hpm refresh` on the installed machine goes where it was told, without
# being told again.
#
# Written AFTER the copy, because the copy brings /etc across from the live
# system and would otherwise put the live image's answer back on top.
def install_repo_config() -> int32:
    if have_repo == 0:
        return 0
    # The live /etc/hpm came across with the copy, but an image that never
    # staged it would leave nowhere to write.
    sys_mkdir(cast[Ptr[char]]("/n/target/etc/hpm"))
    i: uint64 = copy_str(&line_buf[0], &repo_buf[0])
    line_buf[i] = 10                                  # trailing newline
    line_buf[i + 1] = 0
    if write_file(cast[Ptr[char]]("/n/target/etc/hpm/repo"),
                  &line_buf[0]) != 0:
        puts(2, "hlinstall: could not write the target's /etc/hpm/repo; the "
                "installed system will use hpm's default repo.\n")
        return -1
    puts(1, "  package repo ")
    puts(1, &repo_buf[0])
    puts(1, "\n")
    return 0


# The target's identity: its name, and the person who will use it.
def configure_target() -> int32:
    if have_host != 0:
        copy_str(&line_buf[0], &hostname_buf[0])
        write_file(cast[Ptr[char]]("/n/target/etc/hostname"), &line_buf[0])
        puts(1, "  hostname ")
        puts(1, &hostname_buf[0])
        puts(1, "\n")

    if have_user == 0:
        return 0

    # uid 1000, the first regular account, with its own group.
    ph: Ptr[uint8] = cast[Ptr[uint8]]("*")
    if upass_buf[0] != 0:
        if hash_password(&upass_buf[0]) == 0:
            ph = &hash_buf[0]
        else:
            puts(2, "  WARNING: could not hash the password; the account is "
                    "created LOCKED rather than open.\n")

    i: uint64 = copy_str(&line_buf[0], &user_buf[0])
    i = i + copy_str(&line_buf[i], cast[Ptr[uint8]](":x:1000:1000::/home/"))
    i = i + copy_str(&line_buf[i], &user_buf[0])
    copy_str(&line_buf[i], cast[Ptr[uint8]](":/bin/hamsh"))
    append_line(cast[Ptr[char]]("/n/target/etc/passwd"), &line_buf[0])

    i = copy_str(&line_buf[0], &user_buf[0])
    i = i + copy_str(&line_buf[i], cast[Ptr[uint8]](":x:1000:"))
    append_line(cast[Ptr[char]]("/n/target/etc/group"), &line_buf[0])

    i = copy_str(&line_buf[0], &user_buf[0])
    line_buf[i] = 58                                  # ':'
    i = i + 1
    i = i + copy_str(&line_buf[i], ph)
    copy_str(&line_buf[i], cast[Ptr[uint8]](":20000:0:99999:7:::"))
    append_line(cast[Ptr[char]]("/n/target/etc/shadow"), &line_buf[0])

    i = copy_str(&line_buf[0], cast[Ptr[uint8]]("/n/target/home/"))
    copy_str(&line_buf[i], &user_buf[0])
    sys_mkdir(cast[Ptr[char]](&line_buf[0]))

    puts(1, "  user ")
    puts(1, &user_buf[0])
    puts(1, " (uid 1000)\n")
    return 0


def main(argc: int32, argv: Ptr[uint64]) -> int32:
    puts(1, "hamnix-linux installer\n\n")
    if argc < 2:
        list_disks()
        return 1

    # Two argument shapes: a bare disk, or the flag form the DE wizard uses.
    target: Ptr[uint8] = cast[Ptr[uint8]](argv[1])
    ai: int32 = 1
    while ai < argc:
        f: Ptr[uint8] = cast[Ptr[uint8]](argv[cast[uint64](ai)])
        if streq(f, cast[Ptr[uint8]]("--auto")) != 0 and ai + 1 < argc:
            target = cast[Ptr[uint8]](argv[cast[uint64](ai) + 1])
            ai = ai + 2
            continue
        if streq(f, cast[Ptr[uint8]]("--hostname")) != 0 and ai + 1 < argc:
            copy_str(&hostname_buf[0],
                     cast[Ptr[uint8]](argv[cast[uint64](ai) + 1]))
            have_host = 1
            ai = ai + 2
            continue
        if streq(f, cast[Ptr[uint8]]("--user")) != 0 and ai + 1 < argc:
            copy_str(&user_buf[0],
                     cast[Ptr[uint8]](argv[cast[uint64](ai) + 1]))
            have_user = 1
            ai = ai + 2
            continue
        if streq(f, cast[Ptr[uint8]]("--user-pass")) != 0 and ai + 1 < argc:
            copy_str(&upass_buf[0],
                     cast[Ptr[uint8]](argv[cast[uint64](ai) + 1]))
            ai = ai + 2
            continue
        if streq(f, cast[Ptr[uint8]]("--root-pass")) != 0 and ai + 1 < argc:
            copy_str(&rpass_buf[0],
                     cast[Ptr[uint8]](argv[cast[uint64](ai) + 1]))
            ai = ai + 2
            continue
        if streq(f, cast[Ptr[uint8]]("--esp-mb")) != 0 and ai + 1 < argc:
            esp_mb = parse_int(cast[Ptr[uint8]](argv[cast[uint64](ai) + 1]))
            if esp_mb < 64:
                esp_mb = 64
            ai = ai + 2
            continue
        if streq(f, cast[Ptr[uint8]]("--repo")) != 0 and ai + 1 < argc:
            ru: Ptr[uint8] = cast[Ptr[uint8]](argv[cast[uint64](ai) + 1])
            if repo_url_ok(ru) == 0:
                puts(2, "hlinstall: --repo must start with http://, https:// "
                        "or file:/// -- got: ")
                puts(2, ru)
                puts(2, "\n")
                return 1
            # copy_str stops at 120 bytes. A URL trimmed to a prefix is still a
            # valid-looking URL, so it would be written out and fail only on
            # the installed machine's first refresh; say so now instead.
            if slen(ru) > 120:
                puts(2, "hlinstall: --repo is longer than 120 bytes, which is "
                        "more than this installer can carry without "
                        "truncating it.\n")
                return 1
            copy_str(&repo_buf[0], ru)
            have_repo = 1
            ai = ai + 2
            continue
        # --part-mode is accepted and not yet acted on. Saying nothing beats
        # appearing to honour it: a layout the installer does not actually
        # produce would be a lie the operator only finds later.
        if streq(f, cast[Ptr[uint8]]("--part-mode")) != 0 and ai + 1 < argc:
            ai = ai + 2
            continue
        ai = ai + 1

    dn: uint64 = copy_str(&disk[0], target)
    # HOW A PARTITION OF THIS DISK IS NAMED.
    #
    # /dev/sda -> /dev/sda1. /dev/nvme0n1 -> /dev/nvme0n1p1, and so does every
    # mmcblk and every loop device: the rule Linux itself uses is that a name
    # ENDING IN A DIGIT takes a `p` before the partition number, because
    # "nvme0n11" would otherwise be unreadable. It is one rule, it is the
    # kernel's own, and it is not a guess.
    #
    # This used to REFUSE such a disk outright -- "that is not handled yet" --
    # which was honest about the code and fatal in practice: the root of nearly
    # every laptop made since 2016 is nvme0n1, so the installer declined to
    # install on the actual target of this whole line of work.
    sep: uint64 = 0
    if disk[dn - 1] >= 48 and disk[dn - 1] <= 57:
        sep = 1
    copy_str(&p1[0], &disk[0])
    if sep != 0:
        p1[dn] = 112                              # 'p'
    p1[dn + sep] = 49                             # '1'
    p1[dn + sep + 1] = 0
    copy_str(&p2[0], &disk[0])
    if sep != 0:
        p2[dn] = 112                              # 'p'
    p2[dn + sep] = 50                             # '2'
    p2[dn + sep + 1] = 0

    puts(1, "target disk: ")
    puts(1, &disk[0])
    puts(1, "\n  boot: ")
    puts(1, &p1[0])
    puts(1, "\n  root: ")
    puts(1, &p2[0])
    if have_repo != 0:
        puts(1, "\n  repo: ")
        puts(1, &repo_buf[0])
    puts(1, "\nthis ERASES the disk.\n")

    # BEFORE THE DISK IS TOUCHED. An install that erases the target and only
    # then discovers it cannot make the root findable has destroyed something
    # and produced nothing.
    if read_root_partuuid() != 0:
        puts(2, "hlinstall: /boot/root.partuuid is missing or is not a UUID.\n")
        puts(2, "hlinstall: that file carries the PARTUUID baked into "
                "/boot/BOOTX64.EFI's kernel command line, and the root "
                "partition must be created with it or the installed disk will "
                "boot looking for a partition that does not exist here.\n")
        puts(2, "hlinstall: build the medium with scripts/hamlinux_disk.sh "
                "first, then scripts/hamlinux_image.sh with "
                "HAMLINUX_INSTALLER=1.\n")
        return 1
    puts(1, "  root PARTUUID: ")
    puts(1, &partuuid_buf[0])
    puts(1, "  (from /boot/root.partuuid — what the boot image asks for)\n")

    step(cast[Ptr[uint8]]("1/5  partitioning"))
    copy_str(&a1[0], cast[Ptr[uint8]]("--zap-all"))
    copy_str(&a2[0], &disk[0])
    if run_in_distro(cast[Ptr[char]]("/usr/sbin/sgdisk"), 2) != 0:
        puts(2, "hlinstall: sgdisk --zap-all failed\n")
        return 1
    i2: uint64 = copy_str(&a1[0], cast[Ptr[uint8]]("--new=1:2048:+"))
    i2 = emit_dec(&a1[0], i2, esp_mb)
    a1[i2] = 77                                       # 'M'
    a1[i2 + 1] = 0
    copy_str(&a2[0], cast[Ptr[uint8]]("--typecode=1:ef00"))
    copy_str(&a3[0], cast[Ptr[uint8]]("--change-name=1:HAMBOOT"))
    copy_str(&a4[0], &disk[0])
    if run_in_distro(cast[Ptr[char]]("/usr/sbin/sgdisk"), 4) != 0:
        puts(2, "hlinstall: creating the ESP failed\n")
        return 1
    copy_str(&a1[0], cast[Ptr[uint8]]("--new=2:0:0"))
    copy_str(&a2[0], cast[Ptr[uint8]]("--typecode=2:8300"))
    copy_str(&a3[0], cast[Ptr[uint8]]("--change-name=2:hamnix"))
    copy_str(&a4[0], &disk[0])
    if run_in_distro(cast[Ptr[char]]("/usr/sbin/sgdisk"), 4) != 0:
        puts(2, "hlinstall: creating the root partition failed\n")
        return 1
    # A SECOND sgdisk call rather than a fifth argument to that one:
    # run_in_distro carries four. --partition-guid on an existing partition is
    # exactly the same operation it would have been at creation time.
    gi: uint64 = copy_str(&a1[0], cast[Ptr[uint8]]("--partition-guid=2:"))
    copy_str(&a1[gi], &partuuid_buf[0])
    copy_str(&a2[0], &disk[0])
    if run_in_distro(cast[Ptr[char]]("/usr/sbin/sgdisk"), 2) != 0:
        puts(2, "hlinstall: could not give the root partition the PARTUUID "
                "the boot image names; the installed disk would not find its "
                "root.\n")
        return 1
    puts(1, "  root partition GUID set to ")
    puts(1, &partuuid_buf[0])
    puts(1, "\n")

    step(cast[Ptr[uint8]]("2/5  filesystems"))
    copy_str(&a1[0], cast[Ptr[uint8]]("-F"))
    copy_str(&a2[0], cast[Ptr[uint8]]("32"))
    copy_str(&a3[0], cast[Ptr[uint8]]("-n"))
    copy_str(&a4[0], cast[Ptr[uint8]]("HAMBOOT"))
    # mkfs.vfat wants the device last; a5 would be a fifth argument, so pass
    # the device through a4 and drop the label instead. A labelled ESP is a
    # convenience, and the install must not fail for one.
    copy_str(&a3[0], &p1[0])
    if run_in_distro(cast[Ptr[char]]("/usr/sbin/mkfs.vfat"), 3) != 0:
        puts(2, "hlinstall: mkfs.vfat failed\n")
        return 1
    copy_str(&a1[0], cast[Ptr[uint8]]("-F"))
    copy_str(&a2[0], cast[Ptr[uint8]]("-L"))
    copy_str(&a3[0], cast[Ptr[uint8]]("hamnix"))
    copy_str(&a4[0], &p2[0])
    if run_in_distro(cast[Ptr[char]]("/usr/sbin/mkfs.ext4"), 4) != 0:
        puts(2, "hlinstall: mkfs.ext4 failed\n")
        return 1

    step(cast[Ptr[uint8]]("3/5  copying the system"))
    sys_mkdir(cast[Ptr[char]]("/n/target"))
    # A plain-path bind of a BLOCK DEVICE mounts its filesystem -- the same
    # verb the rc scripts use for a device server, meaning the same thing.
    if sys_bind(cast[Ptr[char]]("/n/target"), cast[Ptr[char]](&p2[0]), 0) != 0:
        why(cast[Ptr[uint8]]("bind the new root at /n/target"))
        return 1

    # THE COPY RUNS IN THIS NAMESPACE, with the tree's own cp -- not rsync
    # inside the distro. A tool that has entered the Debian root cannot see
    # the Hamnix root at all; that is the whole point of the isolation, and it
    # means the one job that must see BOTH sides cannot be done from in there.
    # (The first attempt did exactly that and rsync reported "/n/target: No
    # such file or directory", which is the isolation working.)
    #
    # A named list, not `/`: copying the root wholesale would descend into
    # /n/target and copy the target into itself.
    copy_top(cast[Ptr[uint8]]("bin"))
    copy_top(cast[Ptr[uint8]]("etc"))
    copy_top(cast[Ptr[uint8]]("lib"))
    copy_top(cast[Ptr[uint8]]("lib64"))
    copy_top(cast[Ptr[uint8]]("usr"))
    copy_top(cast[Ptr[uint8]]("var"))
    copy_top(cast[Ptr[uint8]]("root"))
    copy_top(cast[Ptr[uint8]]("home"))
    copy_top(cast[Ptr[uint8]]("boot"))

    # /init is a file, not a directory, and it is what the kernel executes.
    if copy_file(cast[Ptr[char]]("/init"),
                 cast[Ptr[char]]("/n/target/init")) != 0:
        puts(2, "hlinstall: could not copy /init\n")
        return 1

    # The mount points. They are empty on purpose: what goes in them is bound
    # at boot by the Adder PID 1, not stored on the disk.
    sys_mkdir(cast[Ptr[char]]("/n/target/proc"))
    sys_mkdir(cast[Ptr[char]]("/n/target/sys"))
    sys_mkdir(cast[Ptr[char]]("/n/target/dev"))
    sys_mkdir(cast[Ptr[char]]("/n/target/tmp"))
    sys_mkdir(cast[Ptr[char]]("/n/target/srv"))
    sys_mkdir(cast[Ptr[char]]("/n/target/n"))
    sys_mkdir(cast[Ptr[char]]("/n/target/n/distro"))
    sys_mkdir(cast[Ptr[char]]("/n/target/mnt"))

    step(cast[Ptr[uint8]]("4/5  the boot partition"))
    sys_mkdir(cast[Ptr[char]]("/n/esp"))
    if sys_bind(cast[Ptr[char]]("/n/esp"), cast[Ptr[char]](&p1[0]), 0) != 0:
        why(cast[Ptr[uint8]]("bind the ESP at /n/esp"))
        return 1
    sys_mkdir(cast[Ptr[char]]("/n/esp/EFI"))
    sys_mkdir(cast[Ptr[char]]("/n/esp/EFI/BOOT"))
    if copy_file(cast[Ptr[char]]("/boot/BOOTX64.EFI"),
                 cast[Ptr[char]]("/n/esp/EFI/BOOT/BOOTX64.EFI")) != 0:
        puts(2, "hlinstall: no /boot/BOOTX64.EFI to install.\n")
        puts(2, "hlinstall: this live image was not built with the boot "
                "files (HAMLINUX_INSTALLER=1).\n")
        return 1
    copy_file(cast[Ptr[char]]("/boot/vmlinuz"),
              cast[Ptr[char]]("/n/esp/vmlinuz"))
    copy_file(cast[Ptr[char]]("/boot/initramfs.cpio.gz"),
              cast[Ptr[char]]("/n/esp/initramfs.cpio.gz"))

    step(cast[Ptr[uint8]]("5/5  the installed system's boot rc"))
    if write_machine_rc_boot() != 0:
        puts(2, "hlinstall: could not write the installed boot rc\n")
        return 1

    step(cast[Ptr[uint8]]("6/6  identity"))
    configure_target()
    install_repo_config()

    # "install complete" IS A PROTOCOL, not a pleasantry, and this line used to
    # read "installed. remove the installation media and reboot." -- which is
    # better English and which THE WIZARD CANNOT SEE.
    #
    # user/haminstallui.ad decides that an install worked in exactly one place:
    # _emit_install_line scans the child's output for the literal "install
    # complete" and only then sets phase 2 ("Install complete - reboot to
    # disk."). If the child exits without ever printing it, _poll_log's EOF
    # branch says "installer exited without 'install complete'" and paints
    # phase 3 -- "Install FAILED - see log above."
    #
    # That string was written against user/install.ad, the HAMNIX-KERNEL
    # installer, which prints "[install] install complete on ...". On this line
    # /bin/install is a copy of THIS program (scripts/hamlinux_image.sh makes
    # it one so the wizard's argv keeps working), and nothing compared the two
    # programs' output. So the wizard reported FAILED after every SUCCESSFUL
    # install: the disk was partitioned, the filesystems made, the root copied
    # and the ESP written, and the one person who cannot check any of that --
    # somebody clicking Install Hamnix on a laptop with no shell -- was told it
    # had failed.
    #
    # It is the mirror image of this tree's defining bug (success reported over
    # nothing) and it costs the same thing: the screen and the disk disagree,
    # so the screen cannot be used. Keeping BOTH halves in one line keeps the
    # wizard honest and still tells a person at a console what to do next.
    puts(1, "\ninstall complete -- remove the installation media and reboot.\n")
    return 0

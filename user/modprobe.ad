# user/modprobe.ad
#
# Hamnix `modprobe NAME` — a native modprobe that resolves a module's
# dependency chain from `modules.dep` and loads every module in the
# computed order via SYS_INIT_MODULE (175).
#
# Where `insmod PATH.ko` loads exactly one self-contained module,
# modprobe is what you reach for when a driver depends on others
# (e.g. a wifi driver -> mac80211 -> cfg80211). It reads modules.dep,
# walks the requested module's flattened dependency list, and loads
# the deps before the target — exactly like Linux's modprobe.
#
# Usage:
#   modprobe NAME           # load NAME and its deps (no .ko / no path)
#   modprobe -v NAME        # verbose: print each module as it loads
#   modprobe -d FILE NAME   # use FILE as modules.dep (override)
#
# WHERE modules.dep COMES FROM, because for the whole of this port the
# answer was "nowhere" and that is why modprobe did not work:
#
#   scripts/hamlinux_image.sh runs the BUILD HOST's `depmod -b $ROOT
#   $KVER` over the modules it staged, so the image ships a real
#   /lib/modules/<release>/modules.dep in depmod's own format. A
#   package that installs MORE modules later (the GPU driver packages
#   in scripts/hamlinux_packages.py) appends its own lines to that same
#   file from its install hook -- the same mechanism it already uses for
#   /etc/modules, and for the same reason: a table baked at image-build
#   time is stale the moment a package installs a new .ko, and a stale
#   table would make `modprobe i915` say "not found" on a machine that
#   HAS i915 on disk.
#
# The default path is the Linux one, /lib/modules/<release>/modules.dep,
# with <release> taken from uname(2) -- the same kernel string the
# staging directory is named after. This file used to default to a
# release-LESS /lib/modules/modules.dep, a path nothing has ever
# written, so the default could only ever fail.
#
# modules.dep format (one line per module, depmod pre-flattens the
# full transitive dep set onto each line):
#
#   kernel/net/wireless/cfg80211.ko:
#   kernel/net/mac80211/mac80211.ko: kernel/net/wireless/cfg80211.ko
#   .../foo.ko: .../mac80211.ko .../cfg80211.ko
#
# The token before ':' is the module's path; tokens after ':' are its
# (already-transitive) dependencies, listed most-dependent-FIRST. The
# conventional load order is therefore: load the listed deps RIGHT-TO-
# LEFT (last-listed = leaf-most = first), then finally the target
# module itself. (Verified against the host's stock Linux 6.12
# modules.dep: e.g. `serpent-avx2: serpent-avx-x86_64 serpent_generic
# crypto_simd cryptd` — cryptd/crypto_simd are leaves and appear last,
# serpent-avx-x86_64 depends on them and appears first, so right-to-
# left satisfies the kernel.)
#
# .ko files live relative to the directory containing modules.dep
# (Linux stores them under that same /lib/modules/<release>/ tree, with
# the modules.dep paths being relative to it).
#
# We do the SYS_INIT_MODULE syscall inline (copied verbatim from
# user/insmod.ad) rather than going through user/runtime.S, which is
# shared with every other user binary.

# The module loader entry point comes from the runtime.
#
# This file used to define its own with inline assembly that reloaded the
# arguments from -8(%rbp)/-16(%rbp)/-24(%rbp) -- the native backend's frame
# layout, which does not exist on the LLVM lane, so the asm would have handed
# the kernel three garbage arguments. Linux's finit_module(2) loads from a
# PATH's descriptor, so there is no image buffer and no size cap.
extern def sys_init_module(path: Ptr[char], params: Ptr[char]) -> int32
extern def sys_open(path: Ptr[char]) -> int32
extern def sys_read(fd: int32, buf: Ptr[uint8], count: uint64) -> int64
extern def sys_close(fd: int32) -> int32
extern def sys_write(fd: int32, buf: Ptr[uint8], count: uint64) -> int64
extern def sys_uname(buf: Ptr[uint8], cap: uint64) -> int64


# --- fixed-size buffers (documented caps) ----------------------------
#
# modules.dep: up to 256 KiB of text. It was 64 KiB, and the read
#   SILENTLY STOPPED there -- a modules.dep one byte over the cap would
#   have lost its tail and reported "module not found" for every module
#   in it, which is the failure this program exists to not have. The
#   cap is still finite, so read_dep_file now reports the truncation by
#   name instead of resolving against half a table. The image's own
#   table is ~3 KiB for 36 modules; the driver packages append ~1 KiB
#   each, so 256 KiB is thousands of modules of headroom.
# .ko read buffer: 4 MiB. insmod.ad uses 1 MiB; we bump it because the
#   foundational wifi framework modules Hamnix ships (cfg80211.ko,
#   mac80211.ko) are ~2.4 MiB each — the largest .ko's in the tree.
#   Bumping this cap is a single constant change; the kernel's
#   kmod_linux_load happily takes any size it can alloc_pages for.
# Up to 256 modules tracked as "loaded this invocation" (basenames).
# Up to 32 dep tokens per modules.dep line (depmod flattens, so even a
#   deep wifi driver lists well under this many).
# Module basenames capped at 64 bytes; full paths capped at 256 bytes.
DEP_CAP:      uint64 = 262144
KO_CAP:       uint64 = 4194304
MAX_LOADED:   uint64 = 256
MAX_DEPS:     uint64 = 32
NAME_CAP:     uint64 = 64
PATH_CAP:     uint64 = 256

dep_buf:  Array[262144, uint8]           # modules.dep text
dep_len:  uint64 = 0
ko_data:  Array[4194304, uint8]          # one .ko at a time

# Directory containing modules.dep, NUL-terminated, WITH a trailing
# '/' (or empty if modules.dep had no directory component). The .ko
# relative paths from modules.dep are appended onto this.
dep_dir:     Array[256, uint8]
dep_dir_len: uint64 = 0

# Loaded-this-invocation set: a flat array of NUL-terminated basenames.
# Linear scan; MAX_LOADED is small.
loaded_names: Array[16384, uint8]        # 256 * 64
n_loaded:     uint64 = 0

# Scratch for the path we hand to sys_open.
open_path: Array[256, uint8]

# Scratch for open_path + a compression suffix. See probe_compressed().
alt_path: Array[264, uint8]

# The modules.dep path actually consulted, NUL-terminated. Every failure
# message names it: "not found" is only meaningful together with the
# table it was not found in.
dep_path_buf: Array[256, uint8]


def strlen_u8(s: Ptr[uint8]) -> uint64:
    n: uint64 = 0
    while s[n] != 0:
        n = n + 1
    return n


def write_str(fd: int32, s: Ptr[uint8]):
    sys_write(fd, s, strlen_u8(s))


def write_dec(fd: int32, v: uint64):
    if v == 0:
        sys_write(fd, "0", 1)
        return
    digits: Array[20, uint8]
    di: uint64 = 0
    while v > 0:
        digits[di] = cast[uint8]((v % 10) + 48)
        v = v / 10
        di = di + 1
    while di > 0:
        di = di - 1
        sys_write(fd, &digits[di], 1)


# Print a signed errno (the negative return from SYS_INIT_MODULE).
def write_errno(fd: int32, rc: int32):
    if rc < 0:
        sys_write(fd, "-", 1)
        write_dec(fd, cast[uint64](cast[int64](0) - cast[int64](rc)))
    else:
        write_dec(fd, cast[uint64](rc))


def slice_basename(s: Ptr[uint8], n: uint64, out: Ptr[uint8]) -> uint64:
    start: uint64 = 0
    i: uint64 = 0
    while i < n:
        if s[i] == 47:                           # '/'
            start = i + 1
        i = i + 1
    end: uint64 = n
    # Strip a trailing ".ko".
    if end - start >= 3:
        if s[end - 3] == 46 and s[end - 2] == 107 and s[end - 1] == 111:
            end = end - 3
    bl: uint64 = end - start
    if bl > NAME_CAP - 1:
        bl = NAME_CAP - 1
    j: uint64 = 0
    while j < bl:
        out[j] = s[start + j]
        j = j + 1
    out[bl] = 0
    return bl


def names_eq(a: Ptr[uint8], b: Ptr[uint8]) -> int32:
    i: uint64 = 0
    while a[i] != 0 and b[i] != 0:
        if a[i] != b[i]:
            return 0
        i = i + 1
    if a[i] == b[i]:
        return 1
    return 0


def is_loaded(name: Ptr[uint8]) -> int32:
    i: uint64 = 0
    while i < n_loaded:
        slot: Ptr[uint8] = cast[Ptr[uint8]](
            cast[uint64](&loaded_names[0]) + i * NAME_CAP)
        if names_eq(slot, name) == 1:
            return 1
        i = i + 1
    return 0


def mark_loaded(name: Ptr[uint8]):
    if n_loaded >= MAX_LOADED:
        return
    slot: Ptr[uint8] = cast[Ptr[uint8]](
        cast[uint64](&loaded_names[0]) + n_loaded * NAME_CAP)
    i: uint64 = 0
    while name[i] != 0 and i < NAME_CAP - 1:
        slot[i] = name[i]
        i = i + 1
    slot[i] = 0
    n_loaded = n_loaded + 1


# --- modules.dep load + parse ----------------------------------------

def read_dep_file(path: Ptr[char]) -> int32:
    # Slurp the whole modules.dep into dep_buf. Returns:
    #    0  success
    #   -1  open failure or empty file
    #   -2  the file is LARGER than DEP_CAP -- we hold a prefix of the
    #       table, so every lookup that misses would be a lie. Reported
    #       separately because "your table is too big for this buffer"
    #       and "your module is not in the table" are different facts
    #       and the caller must not print the second for the first.
    fd: int32 = sys_open(path)
    if fd < 0:
        return -1
    total: uint64 = 0
    while total < DEP_CAP:
        room: uint64 = DEP_CAP - total
        n: int64 = sys_read(fd,
            cast[Ptr[uint8]](cast[uint64](&dep_buf[0]) + total), room)
        if n <= 0:
            break
        total = total + cast[uint64](n)
    # If the buffer filled exactly, ask for one more byte: a file that
    # is exactly DEP_CAP long is fine, one that is longer is not, and
    # only a read past the end tells them apart.
    over: int32 = 0
    if total == DEP_CAP:
        probe: Array[1, uint8]
        if sys_read(fd, &probe[0], 1) > 0:
            over = 1
    sys_close(fd)
    dep_len = total
    if over == 1:
        return -2
    if total == 0:
        return -1
    return 0


# Build "/lib/modules/<release>/modules.dep" into `out` from uname(2)'s
# third field. sys_uname writes "<sysname> <machine> <release>\n".
# Returns the length, or 0 if the release could not be determined --
# in which case the caller must say so rather than guessing a path.
def build_default_dep_path(out: Ptr[uint8], cap: uint64) -> uint64:
    ub: Array[256, uint8]
    n: int64 = sys_uname(&ub[0], 256)
    if n <= 0:
        return 0
    ulen: uint64 = cast[uint64](n)
    # Skip the first two whitespace-separated fields.
    i: uint64 = 0
    f: uint64 = 0
    while f < 2:
        while i < ulen and ub[i] != 32:
            i = i + 1
        while i < ulen and ub[i] == 32:
            i = i + 1
        f = f + 1
    if i >= ulen:
        return 0
    rs: uint64 = i
    while i < ulen and ub[i] != 32 and ub[i] != 10 and ub[i] != 0:
        i = i + 1
    rl: uint64 = i - rs
    if rl == 0:
        return 0
    prefix: Ptr[uint8] = "/lib/modules/"
    suffix: Ptr[uint8] = "/modules.dep"
    o: uint64 = 0
    k: uint64 = 0
    while prefix[k] != 0 and o < cap - 1:
        out[o] = prefix[k]
        o = o + 1
        k = k + 1
    k = 0
    while k < rl and o < cap - 1:
        out[o] = ub[rs + k]
        o = o + 1
        k = k + 1
    k = 0
    while suffix[k] != 0 and o < cap - 1:
        out[o] = suffix[k]
        o = o + 1
        k = k + 1
    out[o] = 0
    return o


# Record the directory component of the modules.dep path (everything up
# to and including the last '/') into dep_dir. .ko relative paths are
# appended onto this. If `path` has no '/', dep_dir is empty.
def set_dep_dir(path: Ptr[char]):
    p: Ptr[uint8] = cast[Ptr[uint8]](path)
    plen: uint64 = strlen_u8(p)
    last_slash: uint64 = 0
    has_slash: int32 = 0
    i: uint64 = 0
    while i < plen:
        if p[i] == 47:
            last_slash = i
            has_slash = 1
        i = i + 1
    if has_slash == 0:
        dep_dir[0] = 0
        dep_dir_len = 0
        return
    keep: uint64 = last_slash + 1                # include the '/'
    if keep > PATH_CAP - 1:
        keep = PATH_CAP - 1
    j: uint64 = 0
    while j < keep:
        dep_dir[j] = p[j]
        j = j + 1
    dep_dir[keep] = 0
    dep_dir_len = keep


# Find the modules.dep line whose module path basename matches `name`.
# A line is "<path>: <dep> <dep> ...". We match by basename (NAME_CAP
# normalized, ".ko" stripped). Returns the byte offset of the line
# start, or -1 if not found.
def find_line(name: Ptr[uint8]) -> int64:
    line_bn: Array[64, uint8]
    pos: uint64 = 0
    while pos < dep_len:
        # Line start.
        ls: uint64 = pos
        # Find end of line.
        le: uint64 = pos
        while le < dep_len and dep_buf[le] != 10:
            le = le + 1
        # Advance pos for next iteration.
        pos = le + 1
        # Skip blank / comment lines.
        if ls >= le:
            continue
        if dep_buf[ls] == 35:                    # '#'
            continue
        # Find the ':' within the line.
        colon: uint64 = ls
        while colon < le and dep_buf[colon] != 58:
            colon = colon + 1
        if colon >= le:
            continue                             # no ':' — malformed
        # Module path slice is [ls, colon). Basename it and compare.
        bl: uint64 = slice_basename(
            cast[Ptr[uint8]](cast[uint64](&dep_buf[0]) + ls),
            colon - ls, &line_bn[0])
        if names_eq(&line_bn[0], name) == 1:
            return cast[int64](ls)
    return -1


# --- .ko open + init -------------------------------------------------

# Build dep_dir + relative-path into open_path (NUL-terminated).
def build_open_path(rel: Ptr[uint8], rel_len: uint64):
    i: uint64 = 0
    while i < dep_dir_len and i < PATH_CAP - 1:
        open_path[i] = dep_dir[i]
        i = i + 1
    j: uint64 = 0
    while j < rel_len and (i + j) < PATH_CAP - 1:
        open_path[i + j] = rel[j]
        j = j + 1
    open_path[i + j] = 0


# Is open_path + `suffix` present? Used only to explain a failed open:
# a .ko that is on disk COMPRESSED is a different problem from a .ko
# that is not on disk at all, and the fix is different too.
def probe_compressed(suffix: Ptr[uint8]) -> int32:
    i: uint64 = 0
    while open_path[i] != 0 and i < 255:
        alt_path[i] = open_path[i]
        i = i + 1
    k: uint64 = 0
    while suffix[k] != 0 and (i + k) < 263:
        alt_path[i + k] = suffix[k]
        k = k + 1
    alt_path[i + k] = 0
    fd: int32 = sys_open(cast[Ptr[char]](&alt_path[0]))
    if fd < 0:
        return 0
    sys_close(fd)
    return 1


# Load one module given its relative .ko path slice [rel, rel+rel_len)
# from modules.dep. The path is joined onto dep_dir, the file slurped,
# and SYS_INIT_MODULE invoked. Tracks the basename in the loaded set.
# verbose: print as we load. Returns:
#    1  loaded OK (or skipped: already loaded this invocation)
#   -1  hard init failure (a genuine dependency failure — fatal)
# An "already loaded"-style errno from the kernel (EEXIST = -17) is
# treated as BENIGN: a previous command loaded it; we print a note and
# return 1 rather than aborting the stack.
def load_one(rel: Ptr[uint8], rel_len: uint64, verbose: int32) -> int32:
    bn: Array[64, uint8]
    slice_basename(rel, rel_len, &bn[0])

    if is_loaded(&bn[0]) == 1:
        if verbose != 0:
            write_str(1, "modprobe: already loaded this run: ")
            write_str(1, &bn[0])
            write_str(1, "\n")
        return 1

    build_open_path(rel, rel_len)
    fd: int32 = sys_open(cast[Ptr[char]](&open_path[0]))
    if fd < 0:
        write_str(2, "modprobe: cannot open ")
        write_str(2, &open_path[0])
        write_str(2, "\n")
        # THE COMPRESSED CASE, which is not hypothetical here: the GPU
        # driver packages ship any module over 4 MiB gzipped (i915.ko is
        # ~9.9 MiB and hpm unpacks in a 4 MiB / 8 MiB RAM buffer), and
        # their install hook runs `gzip -d` to leave the .ko beside it.
        # If that hook did not run, the .ko.gz is on disk and the .ko is
        # not -- and "cannot open" alone would send someone looking for
        # a missing package rather than a failed hook. Name it.
        if probe_compressed(".gz") == 1:
            write_str(2, "modprobe: but ")
            write_str(2, &alt_path[0])
            write_str(2, " exists -- the module is still COMPRESSED.\n")
            write_str(2, "modprobe: finit_module cannot take it; its package's install hook\n")
            write_str(2, "modprobe: (`gzip -d`) did not run or did not finish.\n")
        elif probe_compressed(".xz") == 1:
            write_str(2, "modprobe: but ")
            write_str(2, &alt_path[0])
            write_str(2, " exists -- the module is still COMPRESSED.\n")
            write_str(2, "modprobe: finit_module cannot take it; decompress it in place.\n")
        return -1

    # finit_module(2) loads from the DESCRIPTOR, so there is no image buffer
    # to fill and no size cap to trip over -- the old KO_CAP checks are gone
    # because the limit is.
    sys_close(fd)

    if verbose != 0:
        write_str(1, "modprobe: loading ")
        write_str(1, &bn[0])
        write_str(1, "\n")

    rc: int32 = sys_init_module(cast[Ptr[char]](&open_path[0]),
                                cast[Ptr[char]](""))
    if rc < 0:
        # EEXIST (-17): the kernel already has this module loaded from a
        # previous command. Benign — note and continue (mark loaded so
        # the rest of the stack treats it as satisfied).
        if rc == -17:
            write_str(1, "modprobe: already loaded (kernel): ")
            write_str(1, &bn[0])
            write_str(1, "\n")
            mark_loaded(&bn[0])
            return 1
        # Any other error on a real dependency is fatal.
        write_str(2, "modprobe: init_module failed for ")
        write_str(2, &bn[0])
        write_str(2, " (errno=")
        write_errno(2, rc)
        write_str(2, ")\n")
        return -1

    mark_loaded(&bn[0])
    if verbose != 0:
        # rc is the kernel module slot id (>= 1) on success. Reported so
        # the load is verifiable from userland even where the kernel's
        # own kmod_linux printk doesn't surface on this serial console
        # (boot-time loads log; userland-syscall-context loads may not).
        write_str(1, "modprobe: loaded ")
        write_str(1, &bn[0])
        write_str(1, " (slot ")
        write_dec(1, cast[uint64](rc))
        write_str(1, ")\n")
    return 1


# --- dependency-ordered load -----------------------------------------

# Resolve and load `name` and all its dependencies. Uses the flattened
# dep list from `name`'s modules.dep line: load the listed deps RIGHT-
# TO-LEFT (leaf-most first), then the target last. Each module is
# deduped by basename through the loaded set, so a dep named by several
# entries loads once.
#
# Returns 0 on success, 1 if `name` has no modules.dep line, -1 on a
# fatal load failure.
def load_with_deps(name: Ptr[uint8], verbose: int32) -> int32:
    off: int64 = find_line(name)
    if off < 0:
        # Exit non-zero and say WHICH table was consulted. The stale
        # case is the likely one and is worth naming: a module that
        # arrived by `hpm install` after the image was built is on disk
        # but only in the table if its package's install hook appended
        # its lines. Silence here would look exactly like "there is no
        # such driver", which is a different and much worse answer.
        write_str(2, "modprobe: module not found in ")
        write_str(2, &dep_path_buf[0])
        write_str(2, ": ")
        write_str(2, name)
        write_str(2, "\n")
        write_str(2, "modprobe: nothing was loaded. If this module arrived with a package,\n")
        write_str(2, "modprobe: that package's install hook did not append its dependency\n")
        write_str(2, "modprobe: lines to the table above.\n")
        return 1

    ls: uint64 = cast[uint64](off)
    le: uint64 = ls
    while le < dep_len and dep_buf[le] != 10:
        le = le + 1
    # Locate ':'.
    colon: uint64 = ls
    while colon < le and dep_buf[colon] != 58:
        colon = colon + 1

    # Collect the dep tokens (offset + length) after the colon.
    dep_off: Array[32, uint64]
    dep_ln:  Array[32, uint64]
    n_dep: uint64 = 0
    c: uint64 = colon + 1
    while c < le and n_dep < MAX_DEPS:
        # Skip whitespace.
        while c < le and (dep_buf[c] == 32 or dep_buf[c] == 9):
            c = c + 1
        if c >= le:
            break
        ts: uint64 = c
        while c < le and dep_buf[c] != 32 and dep_buf[c] != 9:
            c = c + 1
        if c > ts:
            dep_off[n_dep] = ts
            dep_ln[n_dep] = c - ts
            n_dep = n_dep + 1

    # Load deps RIGHT-TO-LEFT (last-listed = leaf-most = first).
    k: uint64 = n_dep
    while k > 0:
        k = k - 1
        rc: int32 = load_one(
            cast[Ptr[uint8]](cast[uint64](&dep_buf[0]) + dep_off[k]),
            dep_ln[k], verbose)
        if rc < 0:
            return -1

    # Finally, load the target module itself (its path is [ls, colon)).
    rc2: int32 = load_one(
        cast[Ptr[uint8]](cast[uint64](&dep_buf[0]) + ls),
        colon - ls, verbose)
    if rc2 < 0:
        return -1
    return 0


def main(argc: int32, argv: Ptr[uint64]) -> int32:
    dep_path: Ptr[char] = cast[Ptr[char]](0)
    verbose: int32 = 0
    name: Ptr[char] = cast[Ptr[char]](0)

    # Parse args: -v, -d FILE, then the module NAME.
    i: int32 = 1
    while i < argc:
        a: Ptr[uint8] = cast[Ptr[uint8]](argv[cast[uint64](i)])
        if a[0] == 45 and a[1] == 118 and a[2] == 0:           # "-v"
            verbose = 1
            i = i + 1
        elif a[0] == 45 and a[1] == 100 and a[2] == 0:         # "-d"
            if i + 1 >= argc:
                write_str(2, "modprobe: -d requires a path\n")
                return 1
            dep_path = cast[Ptr[char]](argv[cast[uint64](i + 1)])
            i = i + 2
        else:
            name = cast[Ptr[char]](argv[cast[uint64](i)])
            i = i + 1

    if cast[uint64](name) == 0:
        write_str(2, "modprobe: usage: modprobe [-v] [-d FILE] NAME\n")
        return 1

    # Resolve the table's path once, into dep_path_buf, so every message
    # below can name the exact file it consulted.
    if cast[uint64](dep_path) != 0:
        i2: uint64 = 0
        pp: Ptr[uint8] = cast[Ptr[uint8]](dep_path)
        while pp[i2] != 0 and i2 < PATH_CAP - 1:
            dep_path_buf[i2] = pp[i2]
            i2 = i2 + 1
        dep_path_buf[i2] = 0
    else:
        if build_default_dep_path(&dep_path_buf[0], PATH_CAP) == 0:
            write_str(2, "modprobe: uname(2) gave no kernel release, so the default\n")
            write_str(2, "modprobe: /lib/modules/<release>/modules.dep cannot be named.\n")
            write_str(2, "modprobe: pass -d FILE. Nothing was loaded.\n")
            return 1

    rcd: int32 = read_dep_file(cast[Ptr[char]](&dep_path_buf[0]))
    if rcd == -2:
        write_str(2, "modprobe: ")
        write_str(2, &dep_path_buf[0])
        write_str(2, " is larger than this modprobe's ")
        write_dec(2, DEP_CAP)
        write_str(2, "-byte buffer.\n")
        write_str(2, "modprobe: resolving against a PREFIX of the table would report\n")
        write_str(2, "modprobe: 'not found' for modules that are in it, so nothing was\n")
        write_str(2, "modprobe: loaded. Raise DEP_CAP in user/modprobe.ad.\n")
        return 1
    if rcd != 0:
        write_str(2, "modprobe: cannot read modules.dep at ")
        write_str(2, &dep_path_buf[0])
        write_str(2, "\n")
        write_str(2, "modprobe: no module can be resolved by name without it. It is\n")
        write_str(2, "modprobe: written by `depmod` at image build time (see\n")
        write_str(2, "modprobe: scripts/hamlinux_image.sh). insmod <path>.ko still works,\n")
        write_str(2, "modprobe: but it will not load dependencies.\n")
        return 1
    set_dep_dir(cast[Ptr[char]](&dep_path_buf[0]))

    rc: int32 = load_with_deps(cast[Ptr[uint8]](name), verbose)
    if rc < 0:
        return 1
    if rc == 1:
        # Module not found in modules.dep.
        return 1
    return 0

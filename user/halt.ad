# user/halt.ad — halt the machine (CPU stopped, power left on).
#
# Plan-9-shape: open /dev/reboot and write the verb "halt". The kernel
# cdev funnels into arch/x86/kernel/power.ad's power_action(): flush
# filesystems, then `cli; hlt` the CPU forever. Unlike poweroff this
# leaves the machine powered; the only way out is a hardware reset.
# The write never returns on success.

#
# THE BANNER USED TO BE PRINTED BEFORE THE SYSCALL, AND THAT HUNG THE MACHINE.
# =========================================================================
# MEASURED (HANDOFF.md, tests/linux/installed_documents.sh): once the
# compositor is presenting, a write to the console stops returning. The write
# is a write(2) on /dev/console (user/linux-syscalls.c:sys_write takes the
# plain write(2) branch for fd 1), and a program blocked in there is blocked
# in the KERNEL -- not in a poll, not in a signal-interruptible sleep, and not
# in anything O_NONBLOCK reaches. NOTHING THIS PROGRAM CAN DO RESCUES A
# CONSOLE WRITE IT HAS ALREADY ISSUED. Three graphical boots in a row sat past
# a 300 s deadline on the banner; `poweroff > /dev/null` powered the same
# machine off every time.
#
# So the announcement is GONE FROM THE PATH THAT LEADS TO THE SYSCALL, rather
# than made non-blocking, because "non-blocking" is not something this program
# can promise about that device. What is left on fd 1 and fd 2 is only ever
# reached when the machine is NOT going down -- the open failed, or the verb
# did not take -- and on those paths blocking costs nothing that was not
# already lost.
#
# WHAT THIS COSTS, stated rather than discovered: a working power-off no
# longer prints a line of its own. The kernel still prints its own shutdown
# banner, and the machine going away is the observable event. A gate that
# wants to know the verb was requested must assert THE MACHINE POWERED OFF,
# which is the thing it actually cares about -- see
# tests/linux/poweroff_graphical.sh, which asserts exactly that on a machine
# whose compositor is presenting, and whose negative control puts the banner
# back and watches the same machine hang.
#
# user/hamctl.ad:_act_power and user/hamsessui.ad:_power -- the desktop's own
# Shut Down button -- already had this shape and are untouched.

extern def sys_open(path: Ptr[char]) -> int32
extern def sys_write(fd: int32, buf: Ptr[uint8], count: uint64) -> int64
extern def sys_close(fd: int32) -> int32
extern def sys_exit(code: uint64)


def main(argc: int32, argv: Ptr[uint64]) -> int32:
    fd: int32 = sys_open("/dev/reboot")
    if fd < 0:
        sys_write(2, "halt: cannot open /dev/reboot\n", 30)
        sys_exit(1)
        return 1
    sys_write(fd, "halt\n", 5)
    sys_close(fd)
    sys_write(2, "halt: halt did not take\n", 24)
    sys_exit(1)
    return 1

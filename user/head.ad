# user/head.ad
#
# Minimal Hamnix `head`. Writes the first N lines (default 10) of each
# FILE, or of stdin when no FILE is given. The -N flag is parsed as
# `-<digits>`; anything else is an error. Composes with pipes:
#
#   /cat /mnt/HELLO.TXT | /head -1
#   head -3 /etc/rc.boot
#
# THE FILE OPERAND IS NEW. `head` took no operand at all: `head -3
# /etc/rc.boot` silently ignored the name and BLOCKED ON STDIN
# forever, which on a console reads as a hang and in a boot script
# wedges the boot. It never said it could not do that. Found by
# tests/linux/installed_update.sh; recorded in
# docs/linux_installed_update.md §3. With several FILEs the GNU
# "==> NAME <==" banner is printed, so the output is still
# attributable.

extern def sys_read(fd: int32, buf: Ptr[uint8], count: uint64) -> int64
extern def sys_write(fd: int32, buf: Ptr[uint8], count: uint64) -> int64
extern def sys_open(path: Ptr[char]) -> int32
extern def sys_close(fd: int32) -> int32

buf: Array[256, uint8]


def strlen_u8(s: Ptr[uint8]) -> uint64:
    n: uint64 = 0
    while s[n] != 0:
        n = n + 1
    return n


def write_str(fd: int32, s: Ptr[uint8]):
    sys_write(fd, s, strlen_u8(s))


def parse_int(s: Ptr[uint8]) -> int32:
    n: int32 = 0
    i: uint64 = 0
    if s[0] == 0:
        return -1
    while s[i] != 0:
        c: uint8 = s[i]
        if c < 48 or c > 57:
            return -1
        n = n * 10 + cast[int32](c - 48)
        i = i + 1
    return n


def head_fd(fd: int32, limit: int32):
    count: int32 = 0
    while count < limit:
        n: int64 = sys_read(fd, &buf[0], 256)
        if n <= 0:
            return
        # Scan the chunk for newlines but write in WHOLE spans. A
        # one-syscall-per-byte loop wastes time and amplifies the
        # interleaving with kernel exit-log printks. Walk forward
        # bumping `cut`; when we hit the Nth newline write
        # buf[0..cut] in one shot and return. If we exhaust the
        # chunk without hitting the limit, flush it all and read
        # more.
        cut: uint64 = 0
        i: uint64 = 0
        nu: uint64 = cast[uint64](n)
        done: int32 = 0
        while i < nu:
            if buf[i] == 10:
                count = count + 1
                if count >= limit:
                    cut = i + 1
                    done = 1
                    break
            i = i + 1
        if done != 0:
            sys_write(1, &buf[0], cut)
            return
        sys_write(1, &buf[0], nu)


def main(argc: int32, argv: Ptr[uint64]) -> int32:
    limit: int32 = 10
    first_file: int32 = 1
    if argc >= 2:
        arg: Ptr[uint8] = cast[Ptr[uint8]](argv[1])
        if arg[0] == 45 and arg[1] != 0:            # "-N" (not bare "-")
            v: int32 = parse_int(cast[Ptr[uint8]](
                cast[uint64](arg) + 1))
            if v < 0:
                write_str(2, "head: bad -N\n")
                return 1
            limit = v
            first_file = 2

    if first_file >= argc:
        head_fd(0, limit)
        return 0

    many: int32 = 0
    if argc - first_file > 1:
        many = 1
    rc: int32 = 0
    ai: int32 = first_file
    printed: int32 = 0
    while ai < argc:
        path: Ptr[char] = cast[Ptr[char]](argv[ai])
        pu: Ptr[uint8] = cast[Ptr[uint8]](path)
        fd: int32 = 0
        opened: int32 = 0
        if pu[0] == 45 and pu[1] == 0:              # "-" == stdin
            fd = 0
        else:
            fd = sys_open(path)
            opened = 1
        if fd < 0:
            write_str(2, "head: cannot open ")
            write_str(2, pu)
            write_str(2, "\n")
            rc = 1
        else:
            if many != 0:
                if printed != 0:
                    write_str(1, "\n")
                write_str(1, "==> ")
                write_str(1, pu)
                write_str(1, " <==\n")
            head_fd(fd, limit)
            printed = 1
            if opened != 0:
                sys_close(fd)
        ai = ai + 1
    return rc

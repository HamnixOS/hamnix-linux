# user/arecord.ad
#
# Hamnix `arecord`: capture PCM from the native audio device to a file.
#
#   arecord <file>            # 1 s, 48 kHz / 2ch / s16le
#   arecord <file> <ms>       # capture for <ms> milliseconds
#
# The mirror image of user/aplay.ad, and the only client of /dev/audioin on
# this line. It is a thin Plan 9 client: it sets rate/channels/format by
# echoing text verbs to /dev/audioctl, then reads sample bytes from
# /dev/audioin and writes them to a file. NO ioctls — just file reads and
# writes.
#
# /dev/audioin is a STREAM and it is non-blocking, exactly as Hamnix's
# drivers/audio/audio_cdev.ad serves it: a read of an empty ring answers 0,
# which means "nothing captured yet", NOT end of file. So this loops on the
# clock rather than on the read result -- a client that stopped at the first
# zero (which is what `cat /dev/audioin` does) would record nothing and
# report that the capture device had no data, which is the wrong answer
# stated confidently.
#
# On exit it prints one line a gate can grep for: the byte count it actually
# got. At 48 kHz stereo s16le that should be 192 bytes per millisecond, and
# the number is the measurement -- it says whether frames really flowed.

extern def sys_open(path: Ptr[char]) -> int32
extern def sys_open_write(path: Ptr[char]) -> int32
extern def sys_read(fd: int32, buf: Ptr[uint8], count: uint64) -> int64
extern def sys_write(fd: int32, buf: Ptr[uint8], count: uint64) -> int64
extern def sys_close(fd: int32) -> int32
extern def sys_get_jiffies() -> uint64


def strlen_u8(s: Ptr[uint8]) -> uint64:
    n: uint64 = 0
    while s[n] != 0:
        n = n + 1
    return n


def write_str(fd: int32, s: Ptr[uint8]):
    sys_write(fd, s, strlen_u8(s))


def u64_to_dec(value: uint64, out: Ptr[uint8]) -> uint64:
    if value == 0:
        out[0] = 48
        out[1] = 0
        return 1
    digits: Array[24, uint8]
    n: uint64 = 0
    v: uint64 = value
    while v != 0:
        digits[n] = cast[uint8](v % 10) + 48
        v = v / 10
        n = n + 1
    written: uint64 = n
    i: uint64 = 0
    while n > 0:
        n = n - 1
        out[i] = digits[n]
        i = i + 1
    out[written] = 0
    return written


def parse_dec(s: Ptr[uint8]) -> uint64:
    n: uint64 = 0
    i: uint64 = 0
    while s[i] >= 48 and s[i] <= 57:
        n = n * 10 + cast[uint64](s[i] - 48)
        i = i + 1
    return n


# Send a ctl verb line: "<verb> <value>\n".
def ctl_verb(ctlfd: int32, verb: Ptr[uint8], value: uint64):
    line: Array[48, uint8]
    p: uint64 = 0
    j: uint64 = 0
    while verb[j] != 0:
        line[p] = verb[j]
        p = p + 1
        j = j + 1
    line[p] = 32                     # space
    p = p + 1
    p = p + u64_to_dec(value, &line[p])
    line[p] = 10                     # newline
    p = p + 1
    sys_write(ctlfd, &line[0], p)


cap_chunk: Array[16384, uint8]
summary: Array[128, uint8]


def main(argc: int32, argv: Ptr[uint64]) -> int32:
    rate: uint64 = 48000
    channels: uint64 = 2
    dur_ms: uint64 = 1000

    if argc < 2:
        write_str(2, "usage: arecord <file> [ms]\n")
        return 2
    if argc >= 3:
        dur_ms = parse_dec(cast[Ptr[uint8]](argv[2]))
        if dur_ms == 0:
            dur_ms = 1000

    outfd: int32 = sys_open_write(cast[Ptr[char]](argv[1]))
    if outfd < 0:
        write_str(2, "arecord: cannot create the output file\n")
        return 1

    ctlfd: int32 = sys_open_write("/dev/audioctl")
    if ctlfd < 0:
        write_str(2, "arecord: cannot open /dev/audioctl (no audio device?)\n")
        sys_close(outfd)
        return 1
    ctl_verb(ctlfd, "rate", rate)
    ctl_verb(ctlfd, "channels", channels)
    write_str(ctlfd, "format s16le\n")

    infd: int32 = sys_open("/dev/audioin")
    if infd < 0:
        write_str(2, "arecord: cannot open /dev/audioin (no capture stream?)\n")
        sys_close(ctlfd)
        sys_close(outfd)
        return 1

    # Loop on the CLOCK, not on the read result: a 0 means "not yet".
    # sys_get_jiffies is 100 Hz, i.e. 10 ms a tick.
    total: uint64 = 0
    wait_jiffies: uint64 = (dur_ms + 9) / 10
    start_j: uint64 = sys_get_jiffies()
    while sys_get_jiffies() - start_j < wait_jiffies:
        n: int64 = sys_read(infd, &cap_chunk[0], 16384)
        if n > 0:
            sys_write(outfd, &cap_chunk[0], cast[uint64](n))
            total = total + cast[uint64](n)

    sys_close(infd)
    sys_close(ctlfd)
    sys_close(outfd)

    p: uint64 = 0
    pre: Ptr[uint8] = "[arecord] captured "
    k: uint64 = 0
    while pre[k] != 0:
        summary[p] = pre[k]
        p = p + 1
        k = k + 1
    p = p + u64_to_dec(total, &summary[p])
    mid: Ptr[uint8] = " bytes in "
    k = 0
    while mid[k] != 0:
        summary[p] = mid[k]
        p = p + 1
        k = k + 1
    p = p + u64_to_dec(dur_ms, &summary[p])
    tail: Ptr[uint8] = " ms\n"
    k = 0
    while tail[k] != 0:
        summary[p] = tail[k]
        p = p + 1
        k = k + 1
    sys_write(1, &summary[0], p)
    consfd: int32 = sys_open_write("/dev/cons")
    if consfd >= 0:
        sys_write(consfd, &summary[0], p)
        sys_close(consfd)
    if total == 0:
        return 1
    return 0

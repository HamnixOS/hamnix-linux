# user/sleep.ad
#
# `sleep N` — PARK for N seconds against the 100Hz jiffies counter.
#
# THIS USED TO BE A BUSY-WAIT, and it was the single largest consumer of
# CPU on an idle machine. The comment that stood here said "there's no
# nanosleep yet, so we spin in user mode reading sys_get_jiffies", and
# then a later fix added a sys_yield() to the spin so peers would not be
# starved. Both are true statements about a spin and neither makes it stop
# being one: the task stays STATE_READY for the whole duration and holds a
# core.
#
# What it cost, measured. With the desktop up and nothing else running, a
# text-only boot whose entire workload was PID 1 executing `sleep`, the
# host's QEMU vCPU thread sat at 95.2% — with `ps` inside the guest showing
# every process at 0:00, because the spinner is a short-lived child that
# exists only between the two samples. It is what remained after the
# window-system park was fixed (see sys_waitfds in user/linux-syscalls.c),
# and it is why every rc script's `sleep 4` costs a core for four seconds.
#
# sys_waitfds with nfds == 0 is this tree's portable sleep — lib/hamscreen.ad
# and user/dhcpc.ad already spell it exactly this way — and it parks the task
# OFF the runqueue on both kernels. The jiffies DEADLINE stays, so a short or
# spurious wake cannot end the sleep early: the park is the mechanism, the
# tick count is still the contract.

extern def sys_write(fd: int32, buf: Ptr[uint8], count: uint64) -> int64
extern def sys_get_jiffies() -> uint64
extern def sys_waitfds(fds: Ptr[int32], nfds: uint64, timeout_ms: int64) -> int64


# A top-level BSS array, not a frame local: adder requires it, and
# sys_waitfds never dereferences it at nfds == 0.
park_fds: Array[1, int32]


def strlen_u8(s: Ptr[uint8]) -> uint64:
    n: uint64 = 0
    while s[n] != 0:
        n = n + 1
    return n


def write_str(fd: int32, s: Ptr[uint8]):
    sys_write(fd, s, strlen_u8(s))


def parse_int(s: Ptr[uint8]) -> int64:
    n: int64 = 0
    i: uint64 = 0
    if s[0] == 0:
        return -1
    while s[i] != 0:
        c: uint8 = s[i]
        if c < 48 or c > 57:
            return -1
        n = n * 10 + cast[int64](c - 48)
        i = i + 1
    return n


def main(argc: int32, argv: Ptr[uint64]) -> int32:
    if argc < 2:
        write_str(2, "sleep: usage: sleep SECONDS\n")
        return 1
    secs: int64 = parse_int(cast[Ptr[uint8]](argv[1]))
    if secs < 0:
        write_str(2, "sleep: bad SECONDS\n")
        return 1
    # 100Hz tick → ticks = seconds * 100. Capture start once and
    # compare deltas so the loop is robust against jiffies overflow
    # within the run window.
    start: uint64 = sys_get_jiffies()
    target: uint64 = cast[uint64](secs) * 100
    while True:
        done: uint64 = sys_get_jiffies() - start
        if done >= target:
            break
        # Park for what is LEFT, in milliseconds. 10 ms per jiffy at 100 Hz.
        # A woken-early park just re-measures and parks again, so the
        # deadline above remains the only thing that ends the sleep — the
        # DE launch chain that this used to starve is now not competing for
        # the CPU at all rather than politely taking turns for it.
        left: int64 = cast[int64](target - done) * 10
        sys_waitfds(&park_fds[0], 0, left)
    return 0

# user/rmmod.ad
#
# Hamnix `rmmod NAME`. Mirrors busybox rmmod at minimal scope.
#
# L1 deviation: the kernel's L1 loader doesn't yet index modules by
# name, so the slot id is what SYS_DELETE_MODULE actually wants. We
# accept either a numeric slot ("rmmod 1") or a string that we
# atoi-decode. Once L2 lands the /proc/modules name table, this is
# trivial to grow into a real name-lookup.

extern def sys_write(fd: int32, buf: Ptr[uint8], count: uint64) -> int64
extern def sys_delete_module(name: Ptr[char], flags: int32) -> int32


def strlen_u8(s: Ptr[uint8]) -> uint64:
    n: uint64 = 0
    while s[n] != 0:
        n = n + 1
    return n


def write_str(fd: int32, s: Ptr[uint8]):
    sys_write(fd, s, strlen_u8(s))


def parse_uint(s: Ptr[uint8]) -> int32:
    # Tiny decimal atoi. Returns -1 on the first non-digit byte; a
    # negative result lets main() distinguish "bad input" from a
    # legitimate slot 0 (which is the reserved-unused slot in the
    # loader anyway).
    n: int32 = 0
    i: uint64 = 0
    if s[0] == 0:
        return -1
    while s[i] != 0:
        c: uint8 = s[i]
        if c < 48 or c > 57:
            return -1
        n = n * 10 + cast[int32](c - 48)
        i = i + 1
    return n


def main(argc: int32, argv: Ptr[uint64]) -> int32:
    if argc < 2:
        write_str(2, "rmmod: usage: rmmod NAME\n")
        return 1
    # BY NAME, not by slot id.
    #
    # This file used to carry the native backend's inline assembly -- args
    # reloaded from -8(%rbp) and a raw `syscall` -- which under the LLVM lane
    # reads a frame that does not exist, so rmmod SEGFAULTED on every valid
    # argument. insmod and modprobe had the same assembly taken out; this one
    # was missed, and nothing noticed because a crash in rmmod looks like a
    # kernel refusing to unload.
    #
    # The argument changed with it. Hamnix's SYS_DELETE_MODULE takes a SLOT ID
    # in the name position, which this passed by casting an integer to a
    # pointer. Linux's delete_module(2) reads that pointer as a STRING, so the
    # old convention would have had the kernel dereference the number 7.
    rc: int32 = sys_delete_module(cast[Ptr[char]](argv[1]), 0)
    if rc < 0:
        write_str(2, "rmmod: cannot unload ")
        write_str(2, cast[Ptr[uint8]](argv[1]))
        write_str(2, "\n")
        return 1
    return 0

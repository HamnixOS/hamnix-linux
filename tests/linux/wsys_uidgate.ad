# tests/linux/wsys_uidgate.ad — the probe behind tests/linux/wsys_uidgate.sh.
#
# It answers two questions about /dev/wsys and reports the SYSCALL RETURN for
# each, which is the whole point: the hole this probe exists to measure was
# invisible precisely because a refused chrome write and an accepted one both
# looked like "nothing printed, exit 0".  Every line here ends in a number
# that came back from the kernel.
#
#   wsys_uidgate chrome <path> <text>
#       open <path> for writing and write "<text>\n".  Prints
#           chrome open=<fd> write=<rc>
#       rc < 0 is the refusal (-1 in the Adder ABI, EPERM underneath).
#
#   wsys_uidgate read <path>
#       open <path> for READING and print what comes back, on one line with
#       newlines shown as '|'.  Prints
#           read open=<fd> n=<rc> [<bytes>]
#       Added for tests/linux/wsys_bypass.sh, which needs the PROTOCOL's view
#       of state a bypasser wrote directly into the mapping -- and needs to
#       show that a non-owner can still READ the chrome segment it renders
#       from, which is the half of the split that must not regress.  Purely
#       additive: no line above changed, and wsys_uidgate.sh is untouched.
#
#   wsys_uidgate client [hold]
#       do what an ORDINARY unprivileged client does and nothing more:
#       self-serve a window with `newwindow`, read the wid back, then title
#       it, write a one-line scene and commit it.  Prints
#           client newwindow=<rc> wid=<n> title=<rc> scene=<rc> commit=<rc>
#       This is the half that must KEEP working after the gate lands -- an
#       unprivileged session that cannot map and draw its own window is a
#       blind session, which is worse than the hole.

extern def sys_write(fd: int32, buf: Ptr[uint8], count: uint64) -> int64
extern def sys_read(fd: int32, buf: Ptr[uint8], count: uint64) -> int64
extern def sys_open(path: Ptr[char]) -> int32
extern def sys_open_write(path: Ptr[char]) -> int32
extern def sys_close(fd: int32) -> int32
extern def sys_waitfds(fds: Ptr[int32], nfds: uint64, timeout_ms: int64) -> int64

wbuf: Array[1024, uint8]        # the bytes handed to sys_write
rbuf: Array[256, uint8]         # the ctl read-back
pbuf: Array[128, uint8]         # a built "/dev/wsys/<wid>/<leaf>" path
dbuf: Array[32, uint8]          # decimal scratch


def slen(s: Ptr[uint8]) -> uint64:
    n: uint64 = 0
    while s[n] != 0:
        n = n + 1
    return n


def puts(s: Ptr[uint8]):
    sys_write(1, s, slen(s))


def puti(v: int64):
    neg: int32 = 0
    x: uint64 = 0
    if v < 0:
        neg = 1
        x = cast[uint64](0 - v)
    else:
        x = cast[uint64](v)
    n: uint64 = 0
    if x == 0:
        dbuf[0] = 48
        n = 1
    else:
        while x > 0:
            dbuf[n] = cast[uint8](48 + (x % 10))
            n = n + 1
            x = x / 10
        # reverse in place
        i: uint64 = 0
        j: uint64 = n - 1
        while i < j:
            t: uint8 = dbuf[i]
            dbuf[i] = dbuf[j]
            dbuf[j] = t
            i = i + 1
            j = j - 1
    if neg != 0:
        m: uint64 = 45
        sys_write(1, cast[Ptr[uint8]]("-"), 1)
    sys_write(1, &dbuf[0], n)


def streq(a: Ptr[uint8], b: Ptr[uint8]) -> int32:
    i: uint64 = 0
    while True:
        if a[i] != b[i]:
            return 0
        if a[i] == 0:
            return 1
        i = i + 1
    return 0


# Copy s into wbuf, append '\n', return the total length.
def stage(s: Ptr[uint8]) -> uint64:
    n: uint64 = slen(s)
    if n > 1022:
        n = 1022
    i: uint64 = 0
    while i < n:
        wbuf[i] = s[i]
        i = i + 1
    wbuf[n] = 10
    return n + 1


# Write "<text>\n" to <path>.  Returns the write's rc, or the open's rc when
# the open itself was refused (both are negative, and the caller prints both).
def poke(path: Ptr[char], text: Ptr[uint8]) -> int64:
    fd: int32 = sys_open_write(path)
    puts(" open=")
    puti(cast[int64](fd))
    if fd < 0:
        return cast[int64](fd)
    n: uint64 = stage(text)
    rc: int64 = sys_write(fd, &wbuf[0], n)
    sys_close(fd)
    return rc


# Build "/dev/wsys/<wid>/<leaf>" into pbuf.
def winpath(wid: int64, leaf: Ptr[uint8]):
    pre: Ptr[uint8] = "/dev/wsys/"
    n: uint64 = 0
    i: uint64 = 0
    pl: uint64 = slen(pre)
    while i < pl:
        pbuf[n] = pre[i]
        n = n + 1
        i = i + 1
    x: uint64 = cast[uint64](wid)
    d: Array[16, uint8]
    k: uint64 = 0
    if x == 0:
        d[0] = 48
        k = 1
    while x > 0:
        d[k] = cast[uint8](48 + (x % 10))
        k = k + 1
        x = x / 10
    while k > 0:
        k = k - 1
        pbuf[n] = d[k]
        n = n + 1
    pbuf[n] = 47
    n = n + 1
    j: uint64 = 0
    ll: uint64 = slen(leaf)
    while j < ll:
        pbuf[n] = leaf[j]
        n = n + 1
        j = j + 1
    pbuf[n] = 0


def do_read(path: Ptr[char]) -> int32:
    puts("read")
    fd: int32 = sys_open(path)
    puts(" open=")
    puti(cast[int64](fd))
    if fd < 0:
        puts("\n")
        return 1
    n: int64 = sys_read(fd, &rbuf[0], 255)
    sys_close(fd)
    puts(" n=")
    puti(n)
    if n > 0:
        puts(" [")
        i: uint64 = 0
        while i < cast[uint64](n):
            # One line out, so a newline in the payload becomes '|'.
            if rbuf[i] == 10:
                rbuf[i] = 124
            i = i + 1
        sys_write(1, &rbuf[0], cast[uint64](n))
        puts("]")
    puts("\n")
    if n < 0:
        return 1
    return 0


def hold_open(wid: int64, flag: Ptr[char]):
    # STAY ALIVE, holding the window.  A window whose owner has exited is not a
    # window -- user/linux-wsys.c reaps one whose pid is gone, as devwsys does
    # when the dying process's fid closes -- so a caller that needs the window
    # to still BE there when a later step reads the table has to keep a process
    # on it.  tests/linux/wsys_bypass.sh is that caller: its bypass and its
    # read-back are separate processes from the client that made the window.
    #
    # AND IT IS ALSO THE WITNESS FOR ITS OWN KEYSTROKES, which it did not used
    # to be.  A window's keystrokes are now delivered to whoever holds its
    # channel -- see THE KEYSTROKE CHANNEL in user/linux-wsys.c -- and the only
    # process that can hold a window's channel is its OWNER.  So "the victim
    # still receives what was typed at it" cannot be asked of a third process
    # any more: it has to be asked of the victim, which is what this drain is.
    # That is a strictly more truthful witness than the one it replaces, where
    # a separate root process read the victim's ring and reported on its behalf.
    # AND IT DOES NOT DRAIN UNTIL IT IS TOLD TO, which is not a convenience.
    # A drain is destructive: it moves the ring's r past the bytes.  With the
    # holder draining every 100 ms, the keylogger attack this gate exists to
    # measure has nothing left to read by the time it runs -- so the gate went
    # GREEN WITH THE CHANGE REVERTED, reporting "the keystrokes are not there"
    # about a hole that was wide open, because the witness had eaten the
    # evidence.  It waits for <flag> to exist, and wsys_bypass.sh creates that
    # file only after every attack has been driven.
    ws: Array[4, int32]
    kfd: int32 = -1
    if wid >= 2:
        winpath(wid, cast[Ptr[uint8]]("keys"))
        kfd = sys_open(cast[Ptr[char]](&pbuf[0]))
        puts(" keysopen=")
        puti(cast[int64](kfd))
        puts("\n")
    j: int32 = 0
    while j < 600:
        drain: int32 = 1
        if flag != cast[Ptr[char]](0):
            ffd: int32 = sys_open(flag)
            if ffd < 0:
                drain = 0
            else:
                sys_close(ffd)
        if kfd >= 0 and drain == 0:
            sys_waitfds(&ws[0], 0, 100)
        elif kfd >= 0:
            ws[0] = kfd
            sys_waitfds(&ws[0], 1, 100)
            n: int64 = sys_read(kfd, &rbuf[0], 255)
            if n > 0:
                puts("keysgot [")
                i: uint64 = 0
                while i < cast[uint64](n):
                    if rbuf[i] == 10:
                        rbuf[i] = 124
                    i = i + 1
                sys_write(1, &rbuf[0], cast[uint64](n))
                puts("]\n")
        else:
            sys_waitfds(&ws[0], 0, 100)
        j = j + 1


# Store an int32 little-endian into wbuf at offset o.
def put_le32(o: uint64, v: int32):
    u: uint32 = cast[uint32](v)
    wbuf[o]     = cast[uint8](u & 255)
    wbuf[o + 1] = cast[uint8]((u >> 8) & 255)
    wbuf[o + 2] = cast[uint8]((u >> 16) & 255)
    wbuf[o + 3] = cast[uint8]((u >> 24) & 255)


# BLIT DISTINCTIVE PIXELS INTO THE WINDOW'S v2 BACKBUFFER, then publish them.
#
# This is what a browser (or any v2 client) does: it renders its own surface
# and hands the compositor the pixels through /dev/wsys/<wid>/draw/ctl.  The
# gate uses it to put a KNOWN byte string on the screen of a real window so a
# separate same-uid process can try to recover it -- see wsys_bypass bbscrape.
# The needle is copied verbatim into the RGBA pixels (fmt=1 is a straight byte
# copy in bb_blit), so the exact bytes typed here are the exact bytes that end
# up in the backbuffer store.
def blit_secret(wid: int64, needle: Ptr[uint8]):
    # A small opaque surface, 32x6 RGBA8888 = 768 payload bytes.
    ww: int32 = 32
    hh: int32 = 6
    # The window's geometry has to match, or bb_blit clips to the old size.
    winpath(wid, cast[Ptr[uint8]]("ctl"))
    g: Ptr[uint8] = "geometry 0 0 32 6"
    poke(cast[Ptr[char]](&pbuf[0]), g)
    puts(" geom")

    winpath(wid, cast[Ptr[uint8]]("draw/ctl"))
    fd: int32 = sys_open_write(cast[Ptr[char]](&pbuf[0]))
    puts(" draw=")
    puti(cast[int64](fd))
    if fd < 0:
        return

    # 'B' x0 y0 x1 y1 fmt <pixels>
    wbuf[0] = 66                      # 'B'
    put_le32(1, 0)
    put_le32(5, 0)
    put_le32(9, ww)
    put_le32(13, hh)
    wbuf[17] = 1                      # fmt = RGBA8888, a straight byte copy
    npx: uint64 = cast[uint64](ww) * cast[uint64](hh) * 4
    nl: uint64 = slen(needle)
    if nl == 0:
        nl = 1
    i: uint64 = 0
    while i < npx:
        wbuf[18 + i] = needle[i % nl]
        i = i + 1
    sys_write(fd, &wbuf[0], 18 + npx)

    # 'D' x0 y0 x1 y1 -- publish (flip the page the compositor reads).
    wbuf[0] = 68                      # 'D'
    put_le32(1, 0)
    put_le32(5, 0)
    put_le32(9, ww)
    put_le32(13, hh)
    sys_write(fd, &wbuf[0], 17)
    sys_close(fd)
    puts(" blit=1")


# Create a VISIBLE v2 window and blit a solid colour that fills it, then hold.
# Used by an end-to-end check that the compositor still paints v2 backbuffers
# out of the per-window memfd: the caller reads the framebuffer and looks for
# these bytes.  The colour is RGBA (0x11,0x22,0x33,0xFF) -- distinct bytes, so
# a channel swap in the composite is still recognisable.
def do_fillwin(w: int32, h: int32) -> int32:
    ctl: Ptr[char] = "/dev/wsys/ctl"
    puts("fillwin")
    poke(ctl, cast[Ptr[uint8]]("newwindow"))
    wid: int64 = -1
    rfd: int32 = sys_open(ctl)
    if rfd >= 0:
        k: int64 = sys_read(rfd, &rbuf[0], 255)
        sys_close(rfd)
        v: int64 = 0
        seen: int32 = 0
        i: uint64 = 0
        while i < cast[uint64](k):
            c: uint8 = rbuf[i]
            if c >= 48 and c <= 57:
                v = v * 10 + cast[int64](c - 48)
                seen = 1
            elif seen != 0:
                break
            i = i + 1
        if seen != 0:
            wid = v
    puts(" wid=")
    puti(wid)
    if wid < 2:
        puts("\n")
        return 1
    winpath(wid, cast[Ptr[uint8]]("ctl"))
    poke(cast[Ptr[char]](&pbuf[0]), cast[Ptr[uint8]]("geometry 0 0 200 120"))
    winpath(wid, cast[Ptr[uint8]]("ctl"))
    poke(cast[Ptr[char]](&pbuf[0]), cast[Ptr[uint8]]("visible 1"))
    # NO SCENE, NO COMMIT -- and that is the point.  This is the shape of a REAL
    # v2 client (a browser, a video, a rootless X toplevel): it renders its own
    # surface and submits blits, and never writes a display list at all, so its
    # scene_gen stays 0 for ever.  A window that committed a scene here would
    # paint through the v1 hand-up and would NOT test the thing that matters.
    winpath(wid, cast[Ptr[uint8]]("draw/ctl"))
    fd: int32 = sys_open_write(cast[Ptr[char]](&pbuf[0]))
    puts(" draw=")
    puti(cast[int64](fd))
    if fd < 0:
        return 1
    wbuf[0] = 66
    put_le32(1, 0)
    put_le32(5, 0)
    put_le32(9, w)
    put_le32(13, h)
    wbuf[17] = 1
    npx: uint64 = cast[uint64](w) * cast[uint64](h)          # PIXELS, not bytes
    i2: uint64 = 0
    while i2 < npx:
        wbuf[18 + i2 * 4]     = 17
        wbuf[18 + i2 * 4 + 1] = 34
        wbuf[18 + i2 * 4 + 2] = 51
        wbuf[18 + i2 * 4 + 3] = 255
        i2 = i2 + 1
    sys_write(fd, &wbuf[0], 18 + npx * 4)
    wbuf[0] = 68
    put_le32(1, 0)
    put_le32(5, 0)
    put_le32(9, w)
    put_le32(13, h)
    sys_write(fd, &wbuf[0], 17)
    sys_close(fd)
    puts(" fill=1\n")
    # STAY ALIVE so the window is not reaped.  sys_waitfds parks and calls
    # hamwsys_tick, which drives the backbuffer hand-up -- so a plain sleep loop
    # is enough to hand our pixels up to the compositor.
    ws: Array[4, int32]
    j: int32 = 0
    while j < 60:
        sys_waitfds(&ws[0], 0, 100)
        j = j + 1
    return 0


# THE hamui v2 NEGOTIATION, byte for byte as lib/hamui.ad performs it.
#
# hamui_set_protocol_v2_dims() opens /dev/wsys/<wid>/wctl and writes
# "version 2\n" (lib/hamui.ad, _h_build_wsys_path(win_wid, "wctl")).  This mode
# does exactly that and then asks the WINDOW SYSTEM what it made of it:
#
#   wctlrc=   the write's return -- hamui treats >= 0 as success and sets
#             h_v2_active = 1, believing it is a v2 client from then on
#   proto=    field 9 of <wid>/ctl -- what the window system actually thinks
#   pool=     /dev/wsys/pool -- whether a backbuffer slot was ever claimed
#
# The three together are what tell a real negotiation from a write that
# succeeded into a buffer nobody reads.  A gate asserting only on wctlrc would
# pass today, which is the whole point of printing the other two.
def do_wctlv2() -> int32:
    ctl: Ptr[char] = "/dev/wsys/ctl"
    puts("wctlv2")
    poke(ctl, cast[Ptr[uint8]]("newwindow"))
    wid: int64 = -1
    rfd: int32 = sys_open(ctl)
    if rfd >= 0:
        k: int64 = sys_read(rfd, &rbuf[0], 255)
        sys_close(rfd)
        v: int64 = 0
        seen: int32 = 0
        i: uint64 = 0
        while i < cast[uint64](k):
            c: uint8 = rbuf[i]
            if c >= 48 and c <= 57:
                v = v * 10 + cast[int64](c - 48)
                seen = 1
            elif seen != 0:
                break
            i = i + 1
        if seen != 0:
            wid = v
    puts(" wid=")
    puti(wid)
    if wid < 2:
        puts("\n")
        return 1
    winpath(wid, cast[Ptr[uint8]]("ctl"))
    poke(cast[Ptr[char]](&pbuf[0]), cast[Ptr[uint8]]("geometry 0 0 64 32"))
    winpath(wid, cast[Ptr[uint8]]("ctl"))
    poke(cast[Ptr[char]](&pbuf[0]), cast[Ptr[uint8]]("visible 1"))

    # THE NEGOTIATION ITSELF -- the one line hamui writes.
    winpath(wid, cast[Ptr[uint8]]("wctl"))
    rc: int64 = poke(cast[Ptr[char]](&pbuf[0]), cast[Ptr[uint8]]("version 2"))
    puts(" wctlrc=")
    puti(rc)

    # WHAT THE WINDOW SYSTEM ACTUALLY DID, read back through the protocol.
    winpath(wid, cast[Ptr[uint8]]("ctl"))
    cfd: int32 = sys_open(cast[Ptr[char]](&pbuf[0]))
    if cfd >= 0:
        n2: int64 = sys_read(cfd, &rbuf[0], 255)
        sys_close(cfd)
        if n2 > 0:
            puts(" ctl=[")
            j: uint64 = 0
            while j < cast[uint64](n2):
                if rbuf[j] == 10:
                    rbuf[j] = 124
                j = j + 1
            sys_write(1, &rbuf[0], cast[uint64](n2))
            puts("]")
    pfd: int32 = sys_open(cast[Ptr[char]]("/dev/wsys/pool"))
    if pfd >= 0:
        n3: int64 = sys_read(pfd, &rbuf[0], 255)
        sys_close(pfd)
        if n3 > 0:
            puts(" pool=[")
            j2: uint64 = 0
            while j2 < cast[uint64](n3):
                if rbuf[j2] == 10:
                    rbuf[j2] = 124
                j2 = j2 + 1
            sys_write(1, &rbuf[0], cast[uint64](n3))
            puts("]")
    puts("\n")
    return 0


def do_client(hold: int32, hold_flag: Ptr[char], needle: Ptr[uint8]) -> int32:
    ctl: Ptr[char] = "/dev/wsys/ctl"
    puts("client")
    nw: Ptr[uint8] = "newwindow"
    rc: int64 = poke(ctl, nw)
    puts(" newwindow=")
    puti(rc)

    # Read the assigned wid back, exactly as lib/hamui.ad does (a SECOND open).
    wid: int64 = -1
    rfd: int32 = sys_open(ctl)
    if rfd >= 0:
        k: int64 = sys_read(rfd, &rbuf[0], 255)
        sys_close(rfd)
        if k > 0:
            v: int64 = 0
            seen: int32 = 0
            i: uint64 = 0
            while i < cast[uint64](k):
                c: uint8 = rbuf[i]
                if c >= 48 and c <= 57:
                    v = v * 10 + cast[int64](c - 48)
                    seen = 1
                else:
                    if seen != 0:
                        break
                i = i + 1
            if seen != 0:
                wid = v
    puts(" wid=")
    puti(wid)
    if wid < 2:
        puts("\n")
        return 1

    t: Ptr[uint8] = "title uidgate probe"
    winpath(wid, cast[Ptr[uint8]]("ctl"))
    puts(" title")
    r1: int64 = poke(cast[Ptr[char]](&pbuf[0]), t)
    puts("=")
    puti(r1)

    sc: Ptr[uint8] = "rect 0 0 40 20 0x334455"
    winpath(wid, cast[Ptr[uint8]]("scene"))
    puts(" scene")
    r2: int64 = poke(cast[Ptr[char]](&pbuf[0]), sc)
    puts("=")
    puti(r2)

    cm: Ptr[uint8] = "commit"
    winpath(wid, cast[Ptr[uint8]]("ctl"))
    puts(" commit")
    r3: int64 = poke(cast[Ptr[char]](&pbuf[0]), cm)
    puts("=")
    puti(r3)
    puts("\n")
    if r1 < 0 or r2 < 0 or r3 < 0:
        return 1
    # With a needle, ALSO render a v2 backbuffer with known pixels -- this is
    # the browser-shaped window whose contents the backbuffer scrape targets.
    if needle != cast[Ptr[uint8]](0):
        blit_secret(wid, needle)
        puts("\n")
    if hold != 0:
        hold_open(wid, hold_flag)
    return 0


def main(argc: int32, argv: Ptr[uint64]) -> int32:
    if argc < 2:
        puts("usage: wsys_uidgate chrome <path> <text> | client [hold] | read <path>\n")
        return 2
    cmd: Ptr[uint8] = cast[Ptr[uint8]](argv[1])
    cl: Ptr[uint8] = "client"
    ch: Ptr[uint8] = "chrome"
    rd: Ptr[uint8] = "read"
    if streq(cmd, rd) == 1:
        if argc < 3:
            puts("usage: wsys_uidgate read <path>\n")
            return 2
        return do_read(cast[Ptr[char]](argv[2]))
    if streq(cmd, cl) == 1:
        h: int32 = 0
        if argc > 2:
            h = 1
        # client hold [drain-flag-path]: with a flag path, the holder keeps its
        # keys fd open but reads NOTHING until that file exists.  See hold_open.
        fl: Ptr[char] = cast[Ptr[char]](0)
        if argc > 3:
            fl = cast[Ptr[char]](argv[3])
        # client hold [drain-flag] [blit-needle]: with a needle, the window also
        # renders a v2 backbuffer whose pixels are that needle, verbatim.
        nd: Ptr[uint8] = cast[Ptr[uint8]](0)
        if argc > 4:
            nd = cast[Ptr[uint8]](argv[4])
        return do_client(h, fl, nd)
    fw: Ptr[uint8] = "fillwin"
    if streq(cmd, fw) == 1:
        return do_fillwin(16, 8)
    wv: Ptr[uint8] = "wctlv2"
    if streq(cmd, wv) == 1:
        return do_wctlv2()
    if streq(cmd, ch) == 1:
        if argc < 4:
            puts("usage: wsys_uidgate chrome <path> <text>\n")
            return 2
        puts("chrome")
        rc: int64 = poke(cast[Ptr[char]](argv[2]), cast[Ptr[uint8]](argv[3]))
        puts(" write=")
        puti(rc)
        puts("\n")
        if rc < 0:
            return 1
        return 0
    puts("wsys_uidgate: unknown command\n")
    return 2

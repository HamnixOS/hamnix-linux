# tests/linux/spawn_probe.ad — proof-of-life for process creation and reaping.
#
# HANDOFF.md §4.1a listed sys_rfork and sys_execve_env as "genuinely
# implemented". They were `return -1` stubs in user/linux-runtime.S. That
# matters more than a miscount: §8's suggested step 2 is "add sys_waitpid and
# sys_tcsetpgrp, get hamsh running", and reaping a child is useless while the
# call that CREATES the child fails. This program exercises the whole
# spawn -> exec -> reap round trip, which is the part hamsh actually needs.
#
# Each check prints `ok <name>` or `FAIL <name>`; main returns the failure
# count, so a stubbed entry point cannot pass by linking.

extern def sys_write(fd: int32, buf: Ptr[uint8], count: uint64) -> int64
extern def sys_read(fd: int32, buf: Ptr[uint8], count: uint64) -> int64
extern def sys_close(fd: int32) -> int32
extern def sys_exit(code: uint64)
extern def sys_rfork(flags: int32) -> int32
extern def sys_execve_env(path: Ptr[char], argv: Ptr[uint64],
                          envp: Ptr[uint64]) -> int32
extern def sys_waitpid(pid: int32) -> int64
extern def sys_waitpid_jc(pid: int32, status: Ptr[int64]) -> int64
extern def sys_getpid() -> int32
extern def sys_pipe(fds: Ptr[int32]) -> int32
extern def sys_dup2(old: int32, new_: int32) -> int32
extern def sys_yield()

RFPROC: int32 = 1

# Buffers must be top-level BSS arrays.
argv_buf: Array[4, uint64]
envp_buf: Array[2, uint64]
pipefd:   Array[2, int32]
stat_w:   Array[1, int64]
outbuf:   Array[256, uint8]

failures: int32 = 0


def write_cstr(fd: int32, s: Ptr[uint8]):
    n: uint64 = 0
    while s[n] != 0:
        n = n + 1
    sys_write(fd, s, n)


def report(name: Ptr[uint8], good: int32):
    if good != 0:
        write_cstr(1, "ok   ")
    else:
        write_cstr(1, "FAIL ")
        failures = failures + 1
    write_cstr(1, name)
    write_cstr(1, "\n")


def check_rfork_exit_code() -> int32:
    # The child exits 42; the parent must reap exactly 42. A -1 stub fails at
    # the fork; a fork that works but a waitpid that does not returns garbage.
    pid: int32 = sys_rfork(RFPROC)
    if pid < 0:
        return 0
    if pid == 0:
        sys_exit(42)                          # child: never returns
    code: int64 = sys_waitpid(pid)
    if code != 42:
        return 0
    return 1


def check_rfork_distinct_pid() -> int32:
    # The child must be a genuinely different process, not the parent
    # continuing. It reports its own pid down a pipe; the parent checks it
    # differs from its own and matches the pid fork returned.
    if sys_pipe(&pipefd[0]) != 0:
        return 0
    parent_pid: int32 = sys_getpid()
    pid: int32 = sys_rfork(RFPROC)
    if pid < 0:
        return 0
    if pid == 0:
        # Child: write our pid as one byte (pids here are small enough only
        # modulo 251, so send the low byte and compare the same way).
        mine: int32 = sys_getpid()
        outbuf[0] = cast[uint8](mine & 0xFF)
        sys_write(pipefd[1], &outbuf[0], 1)
        sys_exit(0)
    sys_close(pipefd[1])
    outbuf[0] = 0
    got: int64 = sys_read(pipefd[0], &outbuf[0], 1)
    sys_close(pipefd[0])
    sys_waitpid(pid)
    if got != 1:
        return 0
    if cast[int32](outbuf[0]) != (pid & 0xFF):
        return 0
    if pid == parent_pid:
        return 0
    return 1


def check_execve_env() -> int32:
    # Spawn /bin/echo through execve and capture its stdout over a pipe. This
    # is the whole hamsh spawn path in miniature: fork, rewire fd 1, exec,
    # reap. Nothing but a working execve produces "hamnix\n" here.
    if sys_pipe(&pipefd[0]) != 0:
        return 0
    pid: int32 = sys_rfork(RFPROC)
    if pid < 0:
        return 0
    if pid == 0:
        sys_close(pipefd[0])
        sys_dup2(pipefd[1], 1)
        sys_close(pipefd[1])
        argv_buf[0] = cast[uint64](cast[Ptr[char]]("/bin/echo"))
        argv_buf[1] = cast[uint64](cast[Ptr[char]]("hamnix"))
        argv_buf[2] = 0
        envp_buf[0] = 0
        sys_execve_env(cast[Ptr[char]]("/bin/echo"),
                       cast[Ptr[uint64]](&argv_buf[0]),
                       cast[Ptr[uint64]](&envp_buf[0]))
        sys_exit(127)                         # only reached if exec failed
    sys_close(pipefd[1])
    n: int64 = sys_read(pipefd[0], &outbuf[0], 255)
    sys_close(pipefd[0])
    code: int64 = sys_waitpid(pid)
    if code != 0:
        return 0
    if n != 7:                                # "hamnix\n"
        return 0
    if outbuf[0] != 104:                      # 'h'
        return 0
    if outbuf[5] != 120:                      # 'x'
        return 0
    if outbuf[6] != 10:                       # '\n'
        return 0
    return 1


def check_waitpid_jc() -> int32:
    # The job-control poll must be NON-BLOCKING and must report the exit code
    # in the high byte of the status word (user/hamsh.ad:11477). Poll until the
    # child is seen to exit; a blocking implementation would still return the
    # right answer, so also require that the very first poll of a live child
    # can return 0 without hanging the test.
    pid: int32 = sys_rfork(RFPROC)
    if pid < 0:
        return 0
    if pid == 0:
        sys_exit(7)
    spins: int32 = 0
    while spins < 100000:
        stat_w[0] = 0
        r: int64 = sys_waitpid_jc(pid, &stat_w[0])
        if r < 0:
            return 0
        if r > 0:
            kind: int64 = stat_w[0] & 0xFF
            if kind != 1:                     # WAITJC_EXITED
                return 0
            if ((stat_w[0] >> 8) & 0xFF) != 7:
                return 0
            return 1
        spins = spins + 1
        sys_yield()
    return 0                                  # never reported the exit


def main(argc: int32, argv: Ptr[uint64]) -> int32:
    write_cstr(1, "spawn_probe: fork / exec / reap round trip\n")
    report("sys_rfork exit code",   check_rfork_exit_code())
    report("sys_rfork distinct pid", check_rfork_distinct_pid())
    report("sys_execve_env",        check_execve_env())
    report("sys_waitpid_jc",        check_waitpid_jc())
    if failures == 0:
        write_cstr(1, "ALL PASS\n")
    else:
        write_cstr(1, "SOME FAILED\n")
    return failures

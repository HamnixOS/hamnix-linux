# tests/linux/input_reader.ad — drain a window's event rings and check what
# the compositor routed into them.
#
# Driven by tests/linux/input_probe.sh, which feeds wsysd a file of real evdev
# records. Argument 1 is the wid. The exit code is the failure count.
#
# The assertions are the contract lib/hamui.ad relies on:
#   * a pointer line is "<type> <x> <y> <buttons> <dz>", and x,y are WINDOW-
#     LOCAL -- the toolkit sets its cursor straight from them with no delta
#     accumulation, so a screen coordinate leaking through here would put
#     every click in the wrong place;
#   * a press is type 'd' with the button bitmap set;
#   * a keystroke reaches the ring as an ASCII byte, not a Linux keycode.

extern def sys_write(fd: int32, buf: Ptr[uint8], count: uint64) -> int64
extern def sys_read_nb(fd: int32, buf: Ptr[uint8], count: uint64) -> int64
extern def sys_open(path: Ptr[char]) -> int32
extern def sys_close(fd: int32) -> int32

pathbuf: Array[128, uint8]
buf:     Array[1024, uint8]
numbuf:  Array[24, uint8]
failures: int32 = 0


def slen(s: Ptr[uint8]) -> uint64:
    n: uint64 = 0
    while s[n] != 0:
        n = n + 1
    return n


def puts(fd: int32, s: Ptr[uint8]):
    sys_write(fd, s, slen(s))


def putd(fd: int32, v: int32):
    n: uint64 = 0
    x: int32 = v
    if x == 0:
        numbuf[0] = 48
        n = 1
    while x > 0:
        numbuf[n] = cast[uint8](48 + x % 10)
        x = x / 10
        n = n + 1
    i: uint64 = n
    while i > 0:
        i = i - 1
        sys_write(fd, &numbuf[i], 1)


def emit_int(b: Ptr[uint8], at: uint64, v: int32) -> uint64:
    d: Array[12, uint8]
    n: uint64 = 0
    x: int32 = v
    i: uint64 = at
    if x == 0:
        d[0] = 48
        n = 1
    while x > 0:
        d[n] = cast[uint8](48 + x % 10)
        x = x / 10
        n = n + 1
    while n > 0:
        n = n - 1
        b[i] = d[n]
        i = i + 1
    return i


def winpath(wid: int32, leaf: Ptr[uint8]):
    i: uint64 = 0
    p: Ptr[uint8] = "/dev/wsys/"
    k: uint64 = 0
    while p[k] != 0:
        pathbuf[i] = p[k]
        i = i + 1
        k = k + 1
    i = emit_int(&pathbuf[0], i, wid)
    pathbuf[i] = 47
    i = i + 1
    k = 0
    while leaf[k] != 0:
        pathbuf[i] = leaf[k]
        i = i + 1
        k = k + 1
    pathbuf[i] = 0


def drain(wid: int32, leaf: Ptr[uint8]) -> int64:
    winpath(wid, leaf)
    fd: int32 = sys_open(cast[Ptr[char]](&pathbuf[0]))
    if fd < 0:
        return -1
    total: uint64 = 0
    while total < 1023:
        k: int64 = sys_read_nb(fd, &buf[total], 1023 - total)
        if k <= 0:
            break
        total = total + cast[uint64](k)
    sys_close(fd)
    buf[total] = 0
    return cast[int64](total)


def contains(hay: Ptr[uint8], needle: Ptr[uint8]) -> int32:
    hn: uint64 = slen(hay)
    nn: uint64 = slen(needle)
    if nn == 0 or nn > hn:
        return 0
    i: uint64 = 0
    while i + nn <= hn:
        j: uint64 = 0
        while j < nn and hay[i + j] == needle[j]:
            j = j + 1
        if j == nn:
            return 1
        i = i + 1
    return 0


def report(name: Ptr[uint8], good: int32):
    if good != 0:
        puts(1, "ok   ")
    else:
        puts(1, "FAIL ")
        failures = failures + 1
    puts(1, name)
    puts(1, "\n")


def main(argc: int32, argv: Ptr[uint64]) -> int32:
    wid: int32 = 2
    if argc > 1:
        p: Ptr[uint8] = cast[Ptr[uint8]](argv[1])
        v: int32 = 0
        i: uint64 = 0
        while p[i] >= 48 and p[i] <= 57:
            v = v * 10 + cast[int32](p[i]) - 48
            i = i + 1
        if v > 0:
            wid = v

    puts(1, "input_probe: what the compositor routed to wid ")
    putd(1, wid)
    puts(1, "\n")

    n: int64 = drain(wid, "pointer")
    if n <= 0:
        report("pointer events reached the window", 0)
    else:
        puts(1, "       pointer: ")
        puts(1, &buf[0])
        # (150,110) on screen, window origin (100,60) -> local (50,50), and
        # the press must carry button bit 0.
        report("pointer is window-local (50 50)",
               contains(&buf[0], cast[Ptr[uint8]]("50 50")))
        report("left press arrived as 'd ... 1'",
               contains(&buf[0], cast[Ptr[uint8]]("d 50 50 1")))

    # THE KEYS RING IS NOT ASKED FOR HERE, and that is the finding rather than
    # an omission.  This process does not own wid 2 -- tests/linux/wsys_client.ad
    # does -- and a window's keystrokes now go to whoever holds its channel, so
    # this drain would be a keylogger if it worked.  It does not: the open is
    # refused by name.  input_probe.sh asks the OWNER instead, out of its log.

    if failures == 0:
        puts(1, "ALL PASS\n")
    else:
        puts(1, "SOME FAILED\n")
    return failures

# tests/linux/wsys_poke.ad — write one line to a /dev/wsys file, or read one.
#
#   wsys_poke <path> <text>    write "<text>\n"
#   wsys_poke <path>           read it and print what came back
#   wsys_poke -t <path>        OPEN FOR WRITING AND CLOSE WITHOUT WRITING
#
# `-t` is `> file` with no body, and it exists because nothing else in the tree
# could reach that path: /dev/wsys is served inside hamnix processes, so a host
# shell's `: > /dev/wsys/post` gets ENOENT from the real filesystem and proves
# nothing. It is the only way to test that opening a sink for writing still
# EMPTIES it -- which stopped being automatic when the truncate moved out of
# hamwsys_open and into hamwsys_close (see SINK STAGING in user/linux-wsys.h).
#
# Small on purpose: it is the thing that lets a shell script drive the window
# system the way a DE component would, so a test can say "a launch request was
# made" without standing up a panel and clicking a menu.

extern def sys_write(fd: int32, buf: Ptr[uint8], count: uint64) -> int64
extern def sys_read(fd: int32, buf: Ptr[uint8], count: uint64) -> int64
extern def sys_open(path: Ptr[char]) -> int32
extern def sys_open_write(path: Ptr[char]) -> int32
extern def sys_close(fd: int32) -> int32

buf: Array[2048, uint8]


def slen(s: Ptr[uint8]) -> uint64:
    n: uint64 = 0
    while s[n] != 0:
        n = n + 1
    return n


def puts(fd: int32, s: Ptr[uint8]):
    sys_write(fd, s, slen(s))


def main(argc: int32, argv: Ptr[uint64]) -> int32:
    if argc < 2:
        puts(2, "usage: wsys_poke <path> [text] | wsys_poke -new | wsys_poke -t <path>\n")
        return 2
    path: Ptr[char] = cast[Ptr[char]](argv[1])
    # `-t <path>`: the truncating open, with no write at all.
    if path[0] == 45 and path[1] == 116:                 # "-t"
        if argc < 3:
            puts(2, "usage: wsys_poke -t <path>\n")
            return 2
        tfd: int32 = sys_open_write(cast[Ptr[char]](argv[2]))
        if tfd < 0:
            puts(2, "wsys_poke: cannot open for writing\n")
            return 1
        sys_close(tfd)
        return 0
    # `-new` PRINTS THE WID OF A WINDOW IT JUST CREATED, and it has to be ONE
    # process because the second half of the newwindow handshake is remembered
    # PER PROCESS (user/linux-wsys.c's last_new -- deliberately, so two clients
    # racing on the global ctl cannot be handed each other's window). A script
    # that wrote `newwindow` with one wsys_poke and read the ctl back with
    # another got whatever the READING process had last created, which is
    # nothing, and the window it had just made was orphaned.
    if path[0] == 45 and path[1] == 110:                 # "-n"
        wfd: int32 = sys_open_write(cast[Ptr[char]]("/dev/wsys/ctl"))
        if wfd < 0:
            puts(2, "wsys_poke: cannot open /dev/wsys/ctl for writing\n")
            return 1
        sys_write(wfd, cast[Ptr[uint8]]("newwindow\n"), 10)
        sys_close(wfd)
        rfd: int32 = sys_open(cast[Ptr[char]]("/dev/wsys/ctl"))
        if rfd < 0:
            puts(2, "wsys_poke: cannot read /dev/wsys/ctl back\n")
            return 1
        got: int64 = sys_read(rfd, &buf[0], 32)
        sys_close(rfd)
        if got <= 0:
            puts(2, "wsys_poke: newwindow answered nothing\n")
            return 1
        sys_write(1, &buf[0], cast[uint64](got))
        return 0
    if argc >= 3:
        s: Ptr[uint8] = cast[Ptr[uint8]](argv[2])
        fd: int32 = sys_open_write(path)
        if fd < 0:
            puts(2, "wsys_poke: cannot open for writing\n")
            return 1
        n: uint64 = slen(s)
        i: uint64 = 0
        while i < n and i < 2047:
            buf[i] = s[i]
            i = i + 1
        buf[i] = 10
        sys_write(fd, &buf[0], i + 1)
        sys_close(fd)
        return 0
    fd2: int32 = sys_open(path)
    if fd2 < 0:
        puts(2, "wsys_poke: cannot open for reading\n")
        return 1
    total: uint64 = 0
    while total < 2047:
        k: int64 = sys_read(fd2, &buf[total], 2047 - total)
        if k <= 0:
            break
        total = total + cast[uint64](k)
    sys_close(fd2)
    buf[total] = 0
    puts(1, &buf[0])
    if total == 0 or buf[total - 1] != 10:
        puts(1, "\n")
    return 0

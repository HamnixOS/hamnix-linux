# tests/linux/hello.ad — the end-to-end case for on-box compilation.
#
# This is the program someone types after booting hamnix-linux:
#
#     ac hello.ad -o hello
#     ./hello
#     hello from adder, compiled on hamnix-linux
#
# It is deliberately the smallest thing that proves the whole lane: it calls
# sys_write, so it does not link merely against the SSA prelude -- it needs the
# real Linux syscall runtime (user/linux-runtime.S + user/linux-syscalls.c),
# which is exactly the part `ac` has to build or find on the box.

extern def sys_write(fd: int32, buf: Ptr[uint8], count: uint64) -> int64


def slen(s: Ptr[uint8]) -> uint64:
    n: uint64 = 0
    while s[n] != 0:
        n = n + 1
    return n


def puts(fd: int32, s: Ptr[uint8]):
    sys_write(fd, s, slen(s))


def main() -> int32:
    puts(1, "hello from adder, compiled on hamnix-linux\n")
    return 0

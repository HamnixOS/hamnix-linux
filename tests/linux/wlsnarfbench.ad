# tests/linux/wlsnarfbench.ad — what does one lib/wlsnarf.ad poll COST?
#
# The wake-rate question has a clean answer for user/xsnarfd.ad and a boring
# one for the compositor: user/wsyswl.ad's loop runs at 16 ms for the input
# rings whatever the clipboard does, so converting lib/wlsnarf.ad to the serial
# saves NO WAKE AT ALL. What it can save is the WORK inside the wake, and that
# is a number, not an argument -- so here it is measured instead of claimed.
#
#     wlsnarfbench <bytes> <iterations>
#
# Fills the clipboard with <bytes> and then calls wlsn_poll() <iterations>
# times with nobody writing, which is the idle case and the only one that
# happens for hours at a time. Prints
#
#     bench <bytes> <iters> <ms> <ns_per_poll>
#
# Run it against this build and against one with the serial reverted and the
# difference is the whole of the compositor-side win. If that difference is
# small at the clipboard sizes people actually have, THAT IS THE ANSWER and it
# belongs in the file next to the code rather than being quietly not measured.

from lib.wlsnarf import wlsn_poll, wlsn_put

extern def sys_write(fd: int32, buf: Ptr[uint8], count: uint64) -> int64
extern def sys_clock_gettime(clockid: int32, tp: Ptr[uint64]) -> int64

CLOCK_MONOTONIC: int32 = 1

wb_fill: Array[65600, uint8]
wb_ts:   Array[4, uint64]
wb_dec:  Array[24, uint8]


def wb_puts(s: Ptr[uint8]):
    n: uint64 = 0
    while s[n] != 0:
        n = n + 1
    sys_write(1, s, n)


def wb_putd(v: uint64):
    n: uint64 = 0
    if v == 0:
        sys_write(1, "0", 1)
        return
    while v > 0:
        wb_dec[n] = cast[uint8](48 + (v % 10))
        v = v / 10
        n = n + 1
    while n > 0:
        n = n - 1
        sys_write(1, &wb_dec[n], 1)


def wb_now_ns() -> uint64:
    if sys_clock_gettime(CLOCK_MONOTONIC, &wb_ts[0]) != 0:
        return 0
    return wb_ts[0] * 1000000000 + wb_ts[1]


def wb_atoi(s: Ptr[uint8]) -> uint64:
    v: uint64 = 0
    i: uint64 = 0
    while s[i] >= 48 and s[i] <= 57:
        v = v * 10 + cast[uint64](s[i]) - 48
        i = i + 1
    return v


def main(argc: int32, argv: Ptr[uint64]) -> int32:
    nbytes: uint64 = 65536
    iters:  uint64 = 4000
    if argc > 1:
        nbytes = wb_atoi(cast[Ptr[uint8]](argv[1]))
    if argc > 2:
        iters = wb_atoi(cast[Ptr[uint8]](argv[2]))
    if nbytes > 65536:
        nbytes = 65536

    i: uint64 = 0
    while i < nbytes:
        wb_fill[i] = cast[uint8](65 + (i % 26))
        i = i + 1
    if wlsn_put(&wb_fill[0], nbytes) == 0:
        wb_puts("bench NODEVICE\n")
        return 1
    # Prime, so the first poll's cache fill is not counted as steady state.
    wlsn_poll()

    t0: uint64 = wb_now_ns()
    k: uint64 = 0
    while k < iters:
        wlsn_poll()
        k = k + 1
    t1: uint64 = wb_now_ns()

    wb_puts("bench ")
    wb_putd(nbytes)
    wb_puts(" ")
    wb_putd(iters)
    wb_puts(" ")
    wb_putd((t1 - t0) / 1000000)
    wb_puts(" ")
    wb_putd((t1 - t0) / iters)
    wb_puts("\n")
    return 0

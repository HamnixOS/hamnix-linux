# tests/linux/net_probe.ad — /net, the Plan 9 network file tree.
#
# It drives the tree the way user/net9.ad does, and it deliberately exercises
# the case HANDOFF.md §3 named as the one that decides the whole design:
#
#   "user/httpd.ad accepts a connection and hands it to a SEPARATE PROCESS,
#    user/httpd_worker.ad, which opens /net/tcp/<conn>/data by NUMBER. A shim
#    library holding per-process socket state cannot express this."
#
# So the last check announces a port, forks, has the CHILD connect, accepts in
# the parent, and then hands the connection NUMBER to a grandchild-shaped
# reader that opens /net/tcp/<n>/data by name and reads the bytes. If a
# connection number does not mean the same thing in two processes, that fails.
#
# Everything is loopback; nothing here needs the outside world.
#
# The exit code is the failure count.

extern def sys_write(fd: int32, buf: Ptr[uint8], count: uint64) -> int64
extern def sys_read(fd: int32, buf: Ptr[uint8], count: uint64) -> int64
extern def sys_open(path: Ptr[char]) -> int32
extern def sys_open_write(path: Ptr[char]) -> int32
extern def sys_close(fd: int32) -> int32
extern def sys_rfork(flags: int32) -> int32
extern def sys_waitpid(pid: int32) -> int64
extern def sys_exit(code: uint64)
extern def sys_errstr(buf: Ptr[uint8], nbuf: uint64) -> int32
extern def sys_waitfds(fds: Ptr[int32], nfds: uint64, timeout_ms: int64) -> int64

RFPROC:  int32 = 0x001
RFFDG:   int32 = 0x004

pathbuf: Array[128, uint8]
cmdbuf:  Array[320, uint8]
rbuf:    Array[1024, uint8]
errbuf:  Array[128, uint8]
numbuf:  Array[24, uint8]
waitset: Array[4, int32]

failures: int32 = 0
PORT: int32 = 17771


def slen(s: Ptr[uint8]) -> uint64:
    n: uint64 = 0
    while s[n] != 0:
        n = n + 1
    return n


def puts(fd: int32, s: Ptr[uint8]):
    sys_write(fd, s, slen(s))


def putd(fd: int32, v: int32):
    if v < 0:
        puts(fd, "-")
        putd(fd, 0 - v)
        return
    n: uint64 = 0
    x: int32 = v
    if x == 0:
        numbuf[0] = 48
        n = 1
    while x > 0:
        numbuf[n] = cast[uint8](48 + x % 10)
        x = x / 10
        n = n + 1
    i: uint64 = n
    while i > 0:
        i = i - 1
        sys_write(fd, &numbuf[i], 1)


def report(name: Ptr[uint8], good: int32):
    if good != 0:
        puts(1, "ok   ")
    else:
        puts(1, "FAIL ")
        failures = failures + 1
    puts(1, name)
    puts(1, "\n")


def why(what: Ptr[uint8]):
    puts(1, "       ")
    puts(1, what)
    puts(1, ": ")
    n: int32 = sys_errstr(&errbuf[0], 128)
    if n > 0:
        puts(1, &errbuf[0])
    puts(1, "\n")


def emit_int(buf: Ptr[uint8], at: uint64, v: int32) -> uint64:
    i: uint64 = at
    d: Array[12, uint8]
    n: uint64 = 0
    x: int32 = v
    if x == 0:
        d[0] = 48
        n = 1
    while x > 0:
        d[n] = cast[uint8](48 + x % 10)
        x = x / 10
        n = n + 1
    while n > 0:
        n = n - 1
        buf[i] = d[n]
        i = i + 1
    return i


def connpath(conn: int32, leaf: Ptr[uint8]):
    i: uint64 = 0
    p: Ptr[uint8] = "/net/tcp/"
    k: uint64 = 0
    while p[k] != 0:
        pathbuf[i] = p[k]
        i = i + 1
        k = k + 1
    i = emit_int(&pathbuf[0], i, conn)
    pathbuf[i] = 47
    i = i + 1
    k = 0
    while leaf[k] != 0:
        pathbuf[i] = leaf[k]
        i = i + 1
        k = k + 1
    pathbuf[i] = 0


def read_num(fd: int32) -> int32:
    n: int64 = sys_read(fd, &rbuf[0], 32)
    if n <= 0:
        return -1
    v: int32 = 0
    got: int32 = 0
    i: uint64 = 0
    while i < cast[uint64](n) and rbuf[i] >= 48 and rbuf[i] <= 57:
        v = v * 10 + cast[int32](rbuf[i]) - 48
        got = 1
        i = i + 1
    if got == 0:
        return -1
    return v


def clone_conn() -> int32:
    fd: int32 = sys_open("/net/tcp/clone")
    if fd < 0:
        why(cast[Ptr[uint8]]("open /net/tcp/clone"))
        return -1
    c: int32 = read_num(fd)
    sys_close(fd)
    return c


def ctl_write(conn: int32, cmd: Ptr[uint8]) -> int32:
    connpath(conn, "ctl")
    fd: int32 = sys_open_write(cast[Ptr[char]](&pathbuf[0]))
    if fd < 0:
        return -1
    n: int64 = sys_write(fd, cmd, slen(cmd))
    sys_close(fd)
    if n < 0:
        return -1
    return 0


def build_connect(port: int32):
    i: uint64 = 0
    p: Ptr[uint8] = "connect 127.0.0.1!"
    k: uint64 = 0
    while p[k] != 0:
        cmdbuf[i] = p[k]
        i = i + 1
        k = k + 1
    i = emit_int(&cmdbuf[0], i, port)
    cmdbuf[i] = 0


def build_announce(port: int32):
    i: uint64 = 0
    p: Ptr[uint8] = "announce "
    k: uint64 = 0
    while p[k] != 0:
        cmdbuf[i] = p[k]
        i = i + 1
        k = k + 1
    i = emit_int(&cmdbuf[0], i, port)
    cmdbuf[i] = 0


def check_clone() -> int32:
    c: int32 = clone_conn()
    if c < 0:
        return 0
    puts(1, "       clone gave connection ")
    putd(1, c)
    puts(1, "\n")
    # A fresh connection reports itself Closed until a ctl verb moves it.
    connpath(c, "status")
    fd: int32 = sys_open(cast[Ptr[char]](&pathbuf[0]))
    if fd < 0:
        why(cast[Ptr[uint8]]("open status"))
        return 0
    n: int64 = sys_read(fd, &rbuf[0], 128)
    sys_close(fd)
    if n <= 0:
        return 0
    rbuf[n] = 0
    if rbuf[0] != 67:                          # 'C' of Closed
        puts(1, "       status said: ")
        puts(1, &rbuf[0])
        return 0
    ctl_write(c, cast[Ptr[uint8]]("hangup"))
    return 1


srv_conn: int32 = -1

def check_announce_accept_across_processes() -> int32:
    # THE CASE THAT DECIDED THE DESIGN. Announce here, connect from a child,
    # accept here, and read the child's bytes from a SECOND child that only
    # ever learns the connection NUMBER.
    srv_conn = clone_conn()
    if srv_conn < 0:
        return 0
    build_announce(PORT)
    if ctl_write(srv_conn, &cmdbuf[0]) != 0:
        why(cast[Ptr[uint8]]("announce"))
        return 0

    kid: int32 = sys_rfork(RFPROC | RFFDG)
    if kid < 0:
        why(cast[Ptr[uint8]]("rfork (client)"))
        return 0
    if kid == 0:
        cc: int32 = clone_conn()
        if cc < 0:
            sys_exit(1)
        build_connect(PORT)
        if ctl_write(cc, &cmdbuf[0]) != 0:
            sys_exit(2)
        connpath(cc, "data")
        dfd: int32 = sys_open_write(cast[Ptr[char]](&pathbuf[0]))
        if dfd < 0:
            sys_exit(3)
        sys_write(dfd, cast[Ptr[uint8]]("PLAN9-OVER-LINUX\n"), 17)
        # Hold the connection open long enough for the reader to see it; the
        # data fd is the only reference, and closing it tears the TCP down.
        waitset[0] = dfd
        sys_waitfds(&waitset[0], 0, 1500)
        sys_close(dfd)
        sys_exit(0)

    # Parent: accept. The answer is the NEW connection's number, read back off
    # the same ctl file we wrote `accept` to.
    connpath(srv_conn, "ctl")
    afd: int32 = sys_open_write(cast[Ptr[char]](&pathbuf[0]))
    if afd < 0:
        why(cast[Ptr[uint8]]("open ctl for accept"))
        return 0
    sys_write(afd, cast[Ptr[uint8]]("accept"), 6)
    newc: int32 = read_num(afd)
    sys_close(afd)
    if newc < 0:
        why(cast[Ptr[uint8]]("accept"))
        return 0
    puts(1, "       accepted as connection ")
    putd(1, newc)
    puts(1, "\n")

    # A SECOND process reads it, knowing only the number.
    rd: int32 = sys_rfork(RFPROC | RFFDG)
    if rd < 0:
        return 0
    if rd == 0:
        connpath(newc, "data")
        dfd2: int32 = sys_open(cast[Ptr[char]](&pathbuf[0]))
        if dfd2 < 0:
            sys_exit(10)
        n2: int64 = sys_read(dfd2, &rbuf[0], 128)
        if n2 <= 0:
            sys_exit(11)
        rbuf[n2] = 0
        puts(1, "       second process read: ")
        puts(1, &rbuf[0])
        if rbuf[0] == 80 and rbuf[1] == 76:          # "PL"
            sys_exit(0)
        sys_exit(12)
    st: int64 = sys_waitpid(rd)
    sys_waitpid(kid)
    ctl_write(srv_conn, cast[Ptr[uint8]]("hangup"))
    if st != 0:
        puts(1, "       reader exited ")
        putd(1, cast[int32](st))
        puts(1, "\n")
        return 0
    return 1


def main(argc: int32, argv: Ptr[uint64]) -> int32:
    puts(1, "net_probe: /net, the network file tree\n")
    report("clone mints a connection", check_clone())
    report("a connection number crosses processes",
           check_announce_accept_across_processes())
    if failures == 0:
        puts(1, "ALL PASS\n")
    else:
        puts(1, "SOME FAILED\n")
    return failures

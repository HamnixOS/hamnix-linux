# tests/linux/authprobe.ad — drive /dev/auth the way user/login.ad does.
extern def sys_write(fd: int32, buf: Ptr[uint8], count: uint64) -> int64
extern def sys_read(fd: int32, buf: Ptr[uint8], count: uint64) -> int64
extern def sys_open(path: Ptr[char]) -> int32
extern def sys_close(fd: int32) -> int32

buf: Array[128, uint8]

def slen(s: Ptr[uint8]) -> uint64:
    n: uint64 = 0
    while s[n] != 0:
        n = n + 1
    return n

def puts(fd: int32, s: Ptr[uint8]):
    sys_write(fd, s, slen(s))

def main(argc: int32, argv: Ptr[uint64]) -> int32:
    good: int32 = 0
    if argc > 1:
        p: Ptr[uint8] = cast[Ptr[uint8]](argv[1])
        if p[0] == 103:
            good = 1
    fd: int32 = sys_open("/dev/auth")
    if fd < 0:
        puts(1, "cannot open /dev/auth\n")
        return 1
    sys_write(fd, cast[Ptr[uint8]]("user live\n"), 10)
    if good != 0:
        sys_write(fd, cast[Ptr[uint8]]("pass hamnix\n"), 12)
    else:
        sys_write(fd, cast[Ptr[uint8]]("pass wrong\n"), 11)
    n: int64 = sys_read(fd, &buf[0], 64)
    sys_close(fd)
    if n <= 0:
        puts(1, "no answer\n")
        return 1
    buf[n] = 0
    puts(1, &buf[0])
    return 0

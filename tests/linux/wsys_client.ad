# tests/linux/wsys_client.ad — a minimal hamUI scene client.
#
# It does exactly what lib/hamui.ad does when an app maps a window, but with
# the display list written by hand so the test asserts on known pixel values
# rather than on whatever the toolkit's theme happens to be today:
#
#   newwindow -> geometry/decorate/z/title -> scene -> commit
#
# Then it stays alive (a window whose owner has exited is not a window), so
# the compositor has something to composite. Argument 1 is how many jiffies
# to live for; 0 means "map and exit", which is what the shared-state test
# wants.

from lib.hamscene import hamscene_begin, hamscene_fill, hamscene_glyphs, \
    hamscene_bufptr, hamscene_length

extern def sys_write(fd: int32, buf: Ptr[uint8], count: uint64) -> int64
extern def sys_read(fd: int32, buf: Ptr[uint8], count: uint64) -> int64
extern def sys_open(path: Ptr[char]) -> int32
extern def sys_open_write(path: Ptr[char]) -> int32
extern def sys_close(fd: int32) -> int32
extern def sys_get_jiffies() -> uint64
extern def sys_waitfds(fds: Ptr[int32], nfds: uint64, timeout_ms: int64) -> int64

pathbuf: Array[128, uint8]
rbuf:    Array[64, uint8]
numbuf:  Array[24, uint8]
waitset: Array[4, int32]
my_wid:  int32 = 0


def slen(s: Ptr[uint8]) -> uint64:
    n: uint64 = 0
    while s[n] != 0:
        n = n + 1
    return n


def puts(fd: int32, s: Ptr[uint8]):
    sys_write(fd, s, slen(s))


def putd(fd: int32, v: int32):
    n: uint64 = 0
    x: int32 = v
    if x == 0:
        numbuf[0] = 48
        n = 1
    while x > 0:
        numbuf[n] = cast[uint8](48 + x % 10)
        x = x / 10
        n = n + 1
    i: uint64 = n
    while i > 0:
        i = i - 1
        sys_write(fd, &numbuf[i], 1)


def emit_int(buf: Ptr[uint8], at: uint64, v: int32) -> uint64:
    d: Array[12, uint8]
    n: uint64 = 0
    x: int32 = v
    i: uint64 = at
    if x == 0:
        d[0] = 48
        n = 1
    while x > 0:
        d[n] = cast[uint8](48 + x % 10)
        x = x / 10
        n = n + 1
    while n > 0:
        n = n - 1
        buf[i] = d[n]
        i = i + 1
    return i


def winpath(wid: int32, leaf: Ptr[uint8]):
    i: uint64 = 0
    p: Ptr[uint8] = "/dev/wsys/"
    k: uint64 = 0
    while p[k] != 0:
        pathbuf[i] = p[k]
        i = i + 1
        k = k + 1
    i = emit_int(&pathbuf[0], i, wid)
    pathbuf[i] = 47
    i = i + 1
    k = 0
    while leaf[k] != 0:
        pathbuf[i] = leaf[k]
        i = i + 1
        k = k + 1
    pathbuf[i] = 0


def write_path(path: Ptr[char], data: Ptr[uint8]) -> int32:
    fd: int32 = sys_open_write(path)
    if fd < 0:
        return -1
    sys_write(fd, data, slen(data))
    sys_close(fd)
    return 0


def win_ctl(verb: Ptr[uint8]):
    winpath(my_wid, "ctl")
    write_path(cast[Ptr[char]](&pathbuf[0]), verb)


def alloc_window() -> int32:
    if write_path(cast[Ptr[char]]("/dev/wsys/ctl"),
                  cast[Ptr[uint8]]("newwindow\n")) != 0:
        return -1
    fd: int32 = sys_open(cast[Ptr[char]]("/dev/wsys/ctl"))
    if fd < 0:
        return -1
    n: int64 = sys_read(fd, &rbuf[0], 32)
    sys_close(fd)
    if n <= 0:
        return -1
    v: int32 = 0
    i: uint64 = 0
    while i < cast[uint64](n) and rbuf[i] >= 48 and rbuf[i] <= 57:
        v = v * 10 + cast[int32](rbuf[i]) - 48
        i = i + 1
    if v < 2:
        return -1
    return v


def commit_scene():
    # A display list with three unmistakable flat colours, so a test can name
    # the exact pixel it expects at an exact coordinate.
    hamscene_begin()
    hamscene_fill(0, 0, 320, 200, "#112233")
    hamscene_fill(10, 10, 40, 40, "#FF0000")
    hamscene_fill(60, 10, 40, 40, "#00FF00")
    hamscene_glyphs(10, 80, "hamnix", "#FFFFFF")

    winpath(my_wid, "scene")
    fd: int32 = sys_open_write(cast[Ptr[char]](&pathbuf[0]))
    if fd < 0:
        puts(2, "wsys_client: cannot open the scene\n")
        return
    sys_write(fd, hamscene_bufptr(), hamscene_length())
    sys_close(fd)
    win_ctl(cast[Ptr[uint8]]("commit\n"))


def main(argc: int32, argv: Ptr[uint64]) -> int32:
    my_wid = alloc_window()
    if my_wid < 2:
        puts(2, "wsys_client: no window\n")
        return 1
    win_ctl(cast[Ptr[uint8]]("geometry 100 60 320 200\n"))
    win_ctl(cast[Ptr[uint8]]("decorate 1\n"))
    win_ctl(cast[Ptr[uint8]]("z 6\n"))
    win_ctl(cast[Ptr[uint8]]("title probeclient\n"))
    commit_scene()
    puts(1, "wsys_client: mapped wid ")
    putd(1, my_wid)
    puts(1, "\n")

    # Stay alive so the compositor has a window to draw. An EMPTY loop would
    # be deleted by the optimiser at -O2 (measured, and it cost two black
    # screenshots) -- the wait is what makes this loop real.
    live: int32 = 0
    if argc > 1:
        live = 300
    j: int32 = 0
    while j < live:
        sys_waitfds(&waitset[0], 0, 100)
        j = j + 1
    return 0

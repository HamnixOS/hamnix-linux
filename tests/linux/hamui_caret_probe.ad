# tests/linux/hamui_caret_probe.ad — a REAL hamui client whose only job is to
# put an ENTRY and a TEXTVIEW on screen at coordinates the gate knows, so the
# toolkit's caret placement can be measured in pixels offscreen.
#
# WHY THIS EXISTS. Until now nothing in this tree could look at what
# lib/hamui.ad actually PAINTS. tests/linux/*.sh could drive the compositor,
# the desktop and the terminal offscreen, but the toolkit that roughly forty
# programs link had no pixel harness at all -- which is how an `index * 8`
# monospace caret survived in it long after the `glyphs` primitive became
# proportional (lib/hamtextbox.ad's header, task #303).
#
# It is deliberately NOT a new rendering path: it calls hamui_entry(),
# hamui_textview() and hamui_run() exactly the way user/hamui_demo.ad and the
# other clients do. If the caret is wrong here it is wrong in all of them.
#
# LAYOUT (window-relative; the window's own origin comes from
# /dev/wsys/<wid>/ctl, never from a constant in the gate):
#   ENTRY     at (PROBE_EX, PROBE_EY) sized PROBE_EW x PROBE_EH
#   TEXTVIEW  at (PROBE_TX, PROBE_TY) sized PROBE_TW x PROBE_TH
# The gate reads these numbers OUT OF THIS FILE rather than keeping its own
# copies, so the two can never drift apart.
#
# The entry is made WIDE (560 px) on purpose: the drift under test is about
# 1.1 px per character, so it only becomes unarguable at 30+ characters, and
# hamui_demo's 160 px entry cannot hold that many.

from lib.hamui import (
    hamui_init, hamui_fixed, hamui_entry, hamui_textview, hamui_add,
    hamui_window, hamui_render, hamui_step, hamui_set_size,
    hamui_fixed_place, hamui_set_spacing, hamui_entry_text
)

extern def sys_write(fd: int32, buf: Ptr[uint8], count: uint64) -> int64
extern def sys_yield() -> int32

# ---- probe geometry (the gate greps these) -------------------------------
PROBE_EX: int32 = 20
PROBE_EY: int32 = 40
PROBE_EW: int32 = 560
PROBE_EH: int32 = 24
PROBE_TX: int32 = 20
PROBE_TY: int32 = 120
PROBE_TW: int32 = 560
PROBE_TH: int32 = 120


def _p_strlen(s: Ptr[uint8]) -> uint64:
    n: uint64 = 0
    while s[n] != 0:
        n = n + 1
    return n


def _p_puts(fd: int32, s: Ptr[uint8]):
    sys_write(fd, s, _p_strlen(s))


def main(argc: int32, argv: Ptr[uint64]) -> int32:
    hamui_init()

    root: int32 = hamui_fixed()
    hamui_set_spacing(root, 0, 0)

    ent: int32 = hamui_entry()
    hamui_set_size(ent, PROBE_EW, PROBE_EH)
    hamui_fixed_place(ent, PROBE_EX, PROBE_EY)
    hamui_add(root, ent)

    tv: int32 = hamui_textview()
    hamui_set_size(tv, PROBE_TW, PROBE_TH)
    hamui_fixed_place(tv, PROBE_TX, PROBE_TY)
    hamui_add(root, tv)

    wid: int32 = hamui_window(root)
    if wid < 0:
        _p_puts(2, "hamui_caret_probe: could not allocate a window\n")
        return 1

    hamui_render()
    _p_puts(1, "HAMUI_PROBE ready\n")

    # Interactive: the gate clicks to focus and types over evdev, then reads
    # the framebuffer. Echo the entry text whenever it changes so the gate can
    # prove the keystrokes ARRIVED before it believes any pixel measurement --
    # an empty entry would otherwise score as "caret at the text end".
    last: Array[256, uint8]
    last[0] = 0
    while True:
        hamui_step()
        t: Ptr[uint8] = hamui_entry_text(ent)
        n: uint64 = _p_strlen(t)
        same: int32 = 1
        i: uint64 = 0
        while i <= n:
            if last[i] != t[i]:
                same = 0
            i = i + 1
        if same == 0:
            i = 0
            while i <= n and i < 255:
                last[i] = t[i]
                i = i + 1
            last[255] = 0
            _p_puts(1, "HAMUI_PROBE text=")
            _p_puts(1, t)
            _p_puts(1, "\n")
        sys_yield()

    return 0

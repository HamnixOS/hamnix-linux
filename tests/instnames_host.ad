# tests/instnames_host.ad — HOST unit test for lib/instnames.ad, the list of
# account names an install must refuse.
#
# It RUNS the functions both front ends call (user/hlinstall.ad's --user parse
# and user/haminstallui.ad's _page_ready), rather than reading their source, so
# the answer here is the answer a machine gets. Built for the x86_64-linux
# Adder target; runs on the dev host, no QEMU.
#
# TEST shim only: no syscalls except write(2) to fd 1.

extern def sys_write(fd: int32, buf: Ptr[uint8], count: uint64) -> int64

from lib.instnames import in_name_is_reserved, in_name_ok, in_slen, in_streq, \
    IN_NAME_MAX


obuf: Array[512, uint8]
obuf_n: uint64 = 0

def _o_ch(c: uint8):
    if obuf_n < 511:
        obuf[obuf_n] = c
        obuf_n = obuf_n + 1

def _o_str(s: Ptr[uint8]):
    i: uint64 = 0
    while s[i] != 0:
        _o_ch(s[i])
        i = i + 1

def _o_flush():
    if obuf_n > 0:
        sys_write(1, &obuf[0], obuf_n)
        obuf_n = 0

def _o_dec(v: uint64):
    if v == 0:
        _o_ch(48)
        return
    digs: Array[24, uint8]
    n: uint64 = 0
    while v > 0:
        digs[n] = cast[uint8](v % 10) + 48
        v = v / 10
        n = n + 1
    while n > 0:
        n = n - 1
        _o_ch(digs[n])


# NAME <name> reserved=<0|1> ok=<0|1>
def _case(n: Ptr[uint8]):
    _o_str(cast[Ptr[uint8]]("NAME "))
    _o_str(n)
    _o_str(cast[Ptr[uint8]](" reserved="))
    _o_dec(cast[uint64](in_name_is_reserved(n)))
    _o_str(cast[Ptr[uint8]](" ok="))
    _o_dec(cast[uint64](in_name_ok(n)))
    _o_ch(10)
    _o_flush()


# A name of exactly `n` bytes, built at run time so the length rule is
# exercised against a real string and not a literal somebody counted by eye.
longbuf: Array[256, uint8]


def _long_case(tag: Ptr[uint8], n: uint64):
    i: uint64 = 0
    while i < n and i < 255:
        longbuf[i] = 97                                # 'a'
        i = i + 1
    longbuf[i] = 0
    _o_str(tag)
    _o_str(cast[Ptr[uint8]](" len="))
    _o_dec(in_slen(&longbuf[0]))
    _o_str(cast[Ptr[uint8]](" ok="))
    _o_dec(cast[uint64](in_name_ok(&longbuf[0])))
    _o_ch(10)
    _o_flush()


def main(argc: int32, argv: Ptr[uint64]) -> int32:
    # THE FOUR SYSTEM ACCOUNTS THE IMAGE SHIPS, plus `root`.
    _case(cast[Ptr[uint8]]("hostowner"))
    _case(cast[Ptr[uint8]]("sshd"))
    _case(cast[Ptr[uint8]]("hamsh-svc"))
    _case(cast[Ptr[uint8]]("nobody"))
    _case(cast[Ptr[uint8]]("root"))
    # ORDINARY NAMES MUST STILL PASS. A rule that refuses everything is not a
    # rule, and this is the control for the five above.
    _case(cast[Ptr[uint8]]("dave"))
    _case(cast[Ptr[uint8]]("hamdocusr"))
    _case(cast[Ptr[uint8]]("live"))
    # NEAR MISSES: the match is exact, so a name that merely contains or
    # extends a reserved one is a perfectly good account name.
    _case(cast[Ptr[uint8]]("hostowners"))
    _case(cast[Ptr[uint8]]("myroot"))
    _case(cast[Ptr[uint8]]("hostowne"))
    # THE EMPTY NAME. The wizard's old rule was "the field is not empty" and
    # nothing else; this keeps that half of it.
    _case(cast[Ptr[uint8]](""))
    # THE LENGTH RULE, which is the copy_str overrun: user_buf is 64 bytes and
    # the old copy stopped at 120 SOURCE bytes, so 65 characters overran the
    # adjacent global.
    _long_case(cast[Ptr[uint8]]("LEN63"), 63)
    _long_case(cast[Ptr[uint8]]("LEN64"), 64)
    _long_case(cast[Ptr[uint8]]("LEN65"), 65)
    _long_case(cast[Ptr[uint8]]("LEN120"), 120)
    _o_str(cast[Ptr[uint8]]("IN_NAME_MAX="))
    _o_dec(IN_NAME_MAX)
    _o_ch(10)
    _o_str(cast[Ptr[uint8]]("INSTNAMES_HOST_DONE\n"))
    _o_flush()
    return 0

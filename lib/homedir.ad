# lib/homedir.ad
#
# SHARED "where is THIS session's home directory?" resolver.
#
# WHY THIS EXISTS. Every DE client that wants the user's files (the file
# manager's start dir, the desktop's ~/Desktop icon source, ...) has to answer
# the same question, and each one that answered it privately got it wrong in
# the same way: they hardcoded `/home/live`. `live` is the LIVE IMAGE's user
# (uid 1001); an INSTALLED system names its regular user whatever the wizard
# collected, so on a real install every one of those clients silently pointed
# at a directory that does not exist. That is the "/home/<username>/Desktop
# does not reflect the GUI desktop" report: the desktop was watching
# /home/live/Desktop, a path the installed user could never write to.
#
# RESOLUTION ORDER (the order that is correct for BOTH the live image and an
# installed system):
#   1. $HOME from /env/HOME, if it is absolute and LONGER than the bare "/".
#      DE clients are spawned by the COMPOSITOR, not by hamsh, so they inherit
#      an ambient env whose HOME is the "/" placeholder — a bare "/" is NOT a
#      home and must not be treated as one (it turns "$HOME/Desktop" into
#      "/Desktop" and the icon grid into a ROOT listing).
#   2. /etc/passwd field 6 of the line whose uid field (field 3) equals
#      sys_getuid(). This is the step that makes an installed system work:
#      the session runs as the wizard's account, so its real home comes back.
#   3. /home/live — the live image's user, as a last resort.
#
# The resolver does NOT check that the directory exists: callers decide
# whether a missing home is fatal, and some (hamdesktop) CREATE the subtree
# they need. It never returns an empty or relative path — the return is 0
# ("unresolvable") or a NUL-terminated absolute path.

extern def sys_open(path: Ptr[char]) -> int32
extern def sys_read(fd: int32, buf: Ptr[uint8], count: uint64) -> int64
extern def sys_close(fd: int32) -> int32
extern def sys_getuid() -> uint32

hd_pw_scratch: Array[4096, uint8]


# Read /env/HOME into `out` (NUL-terminated, trailing whitespace stripped).
# Returns the length, 0 if unreadable/empty.
def hd_env_home(out: Ptr[uint8], cap: uint64) -> uint64:
    if cap < 2:
        return 0
    fd: int32 = sys_open(cast[Ptr[char]]("/env/HOME"))
    if fd < 0:
        return 0
    n: int64 = sys_read(fd, out, cap - 1)
    sys_close(fd)
    if n <= 0:
        return 0
    ln: uint64 = cast[uint64](n)
    while ln > 0 and (out[ln - 1] == 0 or out[ln - 1] == 10 or \
                      out[ln - 1] == 13 or out[ln - 1] == 32):
        ln = ln - 1
    out[ln] = 0
    return ln


# PURE passwd(5) parse: field 6 (home) of the line whose field 3 (uid) equals
# `uid`. No I/O — the caller supplies the file bytes, so this is directly
# host-unit-testable against a synthetic table (tests/homedir_host.ad), which
# is the only way to gate the INSTALLED-system case (a uid that is not the
# live image's 1001) without performing a full install.
# Returns the length written to `out` (0 = no match / home not absolute /
# home does not fit in `cap`).
def hd_parse_passwd_home(buf: Ptr[uint8], blen: uint64, uid: uint64,
                         out: Ptr[uint8], cap: uint64) -> uint64:
    p: uint64 = 0
    while p < blen:
        q: uint64 = p
        while q < blen and buf[q] != 10:
            q = q + 1
        # name:passwd:uid:gid:gecos:home:shell
        f: uint64 = 0
        fs: uint64 = p
        uid_val: uint64 = 0
        have_uid: int32 = 0
        home_s: uint64 = 0
        home_e: uint64 = 0
        i: uint64 = p
        while i <= q:
            if i == q or buf[i] == 58:                     # ':' or EOL
                if f == 2:
                    v: uint64 = 0
                    k: uint64 = fs
                    ok: int32 = 1
                    while k < i:
                        if buf[k] < 48 or buf[k] > 57:
                            ok = 0
                        else:
                            v = v * 10 + cast[uint64](buf[k] - 48)
                        k = k + 1
                    if ok != 0 and i > fs:
                        uid_val = v
                        have_uid = 1
                elif f == 5:
                    home_s = fs
                    home_e = i
                f = f + 1
                fs = i + 1
            i = i + 1
        if have_uid != 0 and uid_val == uid \
                and home_e > home_s + 1 and buf[home_s] == 47:
            hl: uint64 = home_e - home_s
            if hl + 1 < cap:
                j: uint64 = 0
                while j < hl:
                    out[j] = buf[home_s + j]
                    j = j + 1
                out[hl] = 0
                return hl
        p = q
        if p < blen and buf[p] == 10:
            p = p + 1
    return 0


# Field 6 of the /etc/passwd line whose uid field matches sys_getuid().
# Returns the length written (0 = no match / unreadable / not absolute).
def hd_home_from_passwd(out: Ptr[uint8], cap: uint64) -> uint64:
    uid: uint32 = sys_getuid()
    fd: int32 = sys_open(cast[Ptr[char]]("/etc/passwd"))
    if fd < 0:
        return 0
    n: int64 = sys_read(fd, &hd_pw_scratch[0], 4095)
    sys_close(fd)
    if n <= 0:
        return 0
    return hd_parse_passwd_home(&hd_pw_scratch[0], cast[uint64](n),
                                cast[uint64](uid), out, cap)


# PURE: the `idx`-th (0-based, file order) passwd line whose uid is >= minuid
# and whose home is absolute — i.e. enumerate the REGULAR user accounts.
#
# WHY A DESKTOP NEEDS THIS. The running uid is NOT always the desktop's user.
# The scene DE is spawned down the boot path and runs as the hostowner
# identity (uid 1) even though the session belongs to a regular account
# (`live` on the live image, the wizard's account on an installed one) —
# measured on a real boot: resolving strictly by sys_getuid() pointed the
# desktop at /home/hostowner/Desktop and emptied the icon grid. So a client
# that wants "the desktop user's home" enumerates the regular accounts and
# picks the one whose home is really there.
# Returns the length written (0 = no such entry / does not fit).
def hd_parse_regular_home(buf: Ptr[uint8], blen: uint64, minuid: uint64,
                          idx: uint64, out: Ptr[uint8], cap: uint64) -> uint64:
    seen: uint64 = 0
    p: uint64 = 0
    while p < blen:
        q: uint64 = p
        while q < blen and buf[q] != 10:
            q = q + 1
        f: uint64 = 0
        fs: uint64 = p
        uid_val: uint64 = 0
        have_uid: int32 = 0
        home_s: uint64 = 0
        home_e: uint64 = 0
        i: uint64 = p
        while i <= q:
            if i == q or buf[i] == 58:
                if f == 2:
                    v: uint64 = 0
                    k: uint64 = fs
                    ok: int32 = 1
                    while k < i:
                        if buf[k] < 48 or buf[k] > 57:
                            ok = 0
                        else:
                            v = v * 10 + cast[uint64](buf[k] - 48)
                        k = k + 1
                    if ok != 0 and i > fs:
                        uid_val = v
                        have_uid = 1
                elif f == 5:
                    home_s = fs
                    home_e = i
                f = f + 1
                fs = i + 1
            i = i + 1
        if have_uid != 0 and uid_val >= minuid \
                and home_e > home_s + 1 and buf[home_s] == 47:
            if seen == idx:
                hl: uint64 = home_e - home_s
                if hl + 1 < cap:
                    j: uint64 = 0
                    while j < hl:
                        out[j] = buf[home_s + j]
                        j = j + 1
                    out[hl] = 0
                    return hl
                return 0
            seen = seen + 1
        p = q
        if p < blen and buf[p] == 10:
            p = p + 1
    return 0


# The `idx`-th regular account's home, read from /etc/passwd.
HD_REGULAR_MIN_UID: uint64 = 1000
def hd_regular_home(idx: uint64, out: Ptr[uint8], cap: uint64) -> uint64:
    fd: int32 = sys_open(cast[Ptr[char]]("/etc/passwd"))
    if fd < 0:
        return 0
    n: int64 = sys_read(fd, &hd_pw_scratch[0], 4095)
    sys_close(fd)
    if n <= 0:
        return 0
    return hd_parse_regular_home(&hd_pw_scratch[0], cast[uint64](n),
                                 HD_REGULAR_MIN_UID, idx, out, cap)


# The full chain: $HOME -> /etc/passwd(uid) -> /home/live.
# Returns the length written, 0 only if `cap` is too small for even the
# fallback.
def hd_resolve_home(out: Ptr[uint8], cap: uint64) -> uint64:
    hl: uint64 = hd_env_home(out, cap)
    if hl > 1 and out[0] == 47:
        return hl
    pl: uint64 = hd_home_from_passwd(out, cap)
    if pl > 1:
        return pl
    return hd_fallback_home(out, cap)


def hd_fallback_home(out: Ptr[uint8], cap: uint64) -> uint64:
    fb: Ptr[uint8] = cast[Ptr[uint8]]("/home/live")
    k: uint64 = 0
    while fb[k] != 0 and k + 1 < cap:
        out[k] = fb[k]
        k = k + 1
    if k == 0:
        return 0
    out[k] = 0
    return k


# Does this path open? Used only as an EXISTS test for a directory.
def hd_dir_exists(p: Ptr[uint8]) -> int32:
    fd: int32 = sys_open(cast[Ptr[char]](p))
    if fd < 0:
        return 0
    sys_close(fd)
    return 1


# THE SESSION USER'S HOME — NOT THE RUNNING UID'S, WHICH IS A DIFFERENT
# QUESTION AND WAS THE WRONG ANSWER.
#
# MEASURED, on a real installed machine, 2026-08-18: the desktop icon column
# spawns a launcher with lib/p9.ad's spawn_detached() straight out of
# user/hamdesktop.ad (`_run_action`) -- so a double-clicked Word Processor is a
# CHILD OF THE SYSTEM CHROME and runs as ROOT, with the chrome's ambient
# environment, NOT through /etc/rc.de-user and NOT as uid 1001. hd_resolve_home()
# asks sys_getuid() and would get 0, find no uid-0 line in /etc/passwd, and fall
# straight through to /home/live -- the very hardcode it exists to remove, just
# reached by a different road. user/hamdesktop.ad's own _desk_dir_resolve()
# already had to solve this and its comment says so ("the running uid is NOT
# it"); this is that chain, in the library, so the office applications get it
# without copying it.
#
#   1. $HOME, when the ambient env carries a real one (not the "/" placeholder).
#   2. this uid's passwd home, ONLY when the uid is a REGULAR account
#      (>= HD_REGULAR_MIN_UID) and the directory is really there. Root's and
#      hostowner's homes are not the session's, however the program was
#      started.
#   3. each REGULAR account in /etc/passwd, in file order, first one whose home
#      directory exists. On the live medium that is `live`; on an installed
#      machine the installer leaves exactly one regular account and it is the
#      person's.
#   4. the first regular account's home even if it does not exist yet (the
#      caller creates what it needs).
#   5. /home/live, the live medium's user, as the absolute last resort.
#
# THE EXISTS TEST IS LOAD-BEARING AT STEP 3 and is not belt-and-braces: the
# LIVE image's /etc/passwd carries `dave` at uid 1000 BEFORE `live` at 1001, and
# only /home/live is created in the image. Taking the first regular account
# without checking would point every office application on the live medium at
# /home/dave, which does not exist -- turning a fix for installed machines into
# a regression on the medium.
HD_REG_MAX: uint64 = 8


def hd_session_home(out: Ptr[uint8], cap: uint64) -> uint64:
    hl: uint64 = hd_env_home(out, cap)
    if hl > 1 and out[0] == 47 and hd_dir_exists(out) != 0:
        return hl
    uid: uint64 = cast[uint64](sys_getuid())
    if uid >= HD_REGULAR_MIN_UID:
        hl = hd_home_from_passwd(out, cap)
        if hl > 1 and hd_dir_exists(out) != 0:
            return hl
    r: uint64 = 0
    while r < HD_REG_MAX:
        hl = hd_regular_home(r, out, cap)
        if hl == 0:
            break
        if hd_dir_exists(out) != 0:
            return hl
        r = r + 1
    hl = hd_regular_home(0, out, cap)
    if hl > 1:
        return hl
    return hd_fallback_home(out, cap)


# THE SESSION'S HOME, WITH A SUBPATH UNDER IT: "<home>/<sub>" into `out`.
#
# WHY THIS IS HERE AND NOT SPELLED OUT IN EACH APP. hd_resolve_home() answers
# "where is home"; every caller that wants a FILE then has to concatenate, and
# the three office apps that did not have this helper did not call the
# resolver either -- they carried a literal "/home/live/Documents/" instead.
# On an installed machine that directory belongs to uid 0 and the session is
# uid 1001, so a Save went to a path the person cannot write and the document
# was silently lost (the save path has no error report). One helper, so the
# concatenation is written once and the resolver is impossible to skip.
#
# IT RESOLVES THROUGH hd_session_home(), NOT hd_resolve_home(): a launcher
# double-clicked on the desktop is spawned by the ROOT system chrome, so the
# running uid is not the session user's and asking sys_getuid() lands on
# /home/live again. See hd_session_home's header for the measurement.
#
# `sub` has NO leading slash ("Documents/untitled.hdoc"); the separator is
# inserted here, and never doubled if the home already ends in one.
# Returns the length written, 0 if it does not fit (out is then untouched
# beyond a NUL at 0) -- a caller that gets 0 must not write anything.
def hd_home_join(sub: Ptr[uint8], out: Ptr[uint8], cap: uint64) -> uint64:
    if cap < 2:
        return 0
    p: uint64 = hd_session_home(out, cap)
    if p == 0:
        return 0
    if p > 1 and out[p - 1] == 47:                     # never "//"
        p = p - 1
    if p + 1 >= cap:
        out[0] = 0
        return 0
    out[p] = 47
    p = p + 1
    k: uint64 = 0
    while sub[k] != 0:
        if p + 1 >= cap:
            out[0] = 0
            return 0
        out[p] = sub[k]
        p = p + 1
        k = k + 1
    out[p] = 0
    return p


# THE SESSION USER'S UID -- the identity a launcher started by the SYSTEM
# CHROME must drop to before it execs a person's program.
#
# MEASURED, on a real installed machine (tests/linux/installed_documents.sh,
# 2026-08-18): a document saved by an application started from the desktop icon
# column came out OWNED BY UID 0, in a directory owned by the person. Anything
# else the chrome launches can still rewrite it, because that is root too; the
# SAME document opened from a desktop terminal -- which is uid 1001, because
# /etc/rc.de-user drops it -- cannot be saved over. The fix is for the chrome to
# drop privilege at the launch, and this is the number it drops to.
#
# IT IS THE SAME CHAIN hd_session_home() WALKS, AND DELIBERATELY SO: the uid and
# the home must come from ONE account or a program would run as one person and
# write into another's directory. Where hd_session_home returns that account's
# home, this returns its uid.
#
#   1. the RUNNING uid, when it is already a regular account. Nothing to drop:
#      an offscreen harness, a host run, or a chrome some future session manager
#      already starts as the user.
#   2. each REGULAR account in /etc/passwd, in file order, the first whose home
#      directory EXISTS. Same load-bearing exists-test as hd_session_home: the
#      live image's passwd carries `dave` at 1000 before `live` at 1001 and only
#      /home/live is created, so taking the first regular account blindly would
#      hand every launch on the live medium an account with no home.
#   3. the first regular account even if its home is not there yet.
#
# RETURNS 0 WHEN THERE IS NO REGULAR ACCOUNT AT ALL, and 0 means "do not drop",
# never "drop to root". A caller must treat it as a refusal: launching as root
# after failing to find the person is exactly the silent-success shape this
# whole line of work exists to remove.
hd_uid_scratch: Array[256, uint8]


# The uid of the `idx`-th REGULAR account, parsed out of the same buffer and by
# the same field walk as hd_parse_regular_home -- so the two cannot disagree
# about which entry `idx` names. Returns 0 when there is no such entry.
def hd_parse_regular_uid(buf: Ptr[uint8], blen: uint64, minuid: uint64,
                         idx: uint64) -> uint64:
    seen: uint64 = 0
    p: uint64 = 0
    while p < blen:
        q: uint64 = p
        while q < blen and buf[q] != 10:
            q = q + 1
        f: uint64 = 0
        fs: uint64 = p
        uid_val: uint64 = 0
        have_uid: int32 = 0
        home_s: uint64 = 0
        home_e: uint64 = 0
        i: uint64 = p
        while i <= q:
            if i == q or buf[i] == 58:
                if f == 2:
                    v: uint64 = 0
                    k: uint64 = fs
                    ok: int32 = 1
                    while k < i:
                        if buf[k] < 48 or buf[k] > 57:
                            ok = 0
                        else:
                            v = v * 10 + cast[uint64](buf[k] - 48)
                        k = k + 1
                    if ok != 0 and i > fs:
                        uid_val = v
                        have_uid = 1
                elif f == 5:
                    home_s = fs
                    home_e = i
                f = f + 1
                fs = i + 1
            i = i + 1
        if have_uid != 0 and uid_val >= minuid \
                and home_e > home_s + 1 and buf[home_s] == 47:
            if seen == idx:
                return uid_val
            seen = seen + 1
        p = q
        if p < blen and buf[p] == 10:
            p = p + 1
    return 0


def hd_regular_uid(idx: uint64) -> uint64:
    fd: int32 = sys_open(cast[Ptr[char]]("/etc/passwd"))
    if fd < 0:
        return 0
    n: int64 = sys_read(fd, &hd_pw_scratch[0], 4095)
    sys_close(fd)
    if n <= 0:
        return 0
    return hd_parse_regular_uid(&hd_pw_scratch[0], cast[uint64](n),
                                HD_REGULAR_MIN_UID, idx)


def hd_session_uid() -> uint32:
    uid: uint64 = cast[uint64](sys_getuid())
    if uid >= HD_REGULAR_MIN_UID:
        return cast[uint32](uid)
    r: uint64 = 0
    while r < HD_REG_MAX:
        hl: uint64 = hd_regular_home(r, &hd_uid_scratch[0], 256)
        if hl == 0:
            break
        if hd_dir_exists(&hd_uid_scratch[0]) != 0:
            return cast[uint32](hd_regular_uid(r))
        r = r + 1
    u0: uint64 = hd_regular_uid(0)
    if u0 >= HD_REGULAR_MIN_UID:
        return cast[uint32](u0)
    return 0

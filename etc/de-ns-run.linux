#!/bin/sh
# /etc/de-ns-run -- run ONE program from the DE application menu inside a
# distribution namespace, with a display it can actually draw on.
#
# Staged into the Hamnix image as /etc/de-ns-run by scripts/hamlinux_image.sh,
# and COPIED INTO EACH DISTRIBUTION at boot by the generated /etc/rc.distros
# -- at the one moment root holds the medium, which is the same moment the
# mount points inside it are made (user/linux-syscalls.c,
# distro_stage_mountpoints). It has to live inside the tree because by the
# time it runs, that tree is `/`.
#
# WHY IT EXISTS. `/etc/rc.de-ns/<name>` used to end with
#
#     enter <name> { $HAMNIX_DE_PROG }
#
# and a `.desktop` file in Debian or Alpine names an X11 client. Nothing in
# the namespace was serving X, so the honest outcome of a successful `enter`
# was still no window -- the program starting, failing to open $DISPLAY, and
# exiting. A desktop that offers to launch an application owes it a display;
# that is this file.
#
# It is POSIX sh on purpose: it runs under the DISTRIBUTION's shell (busybox
# ash in Alpine, bash in Debian), not under hamsh.
#
# EVERYTHING IT DOES IS SAID, ONCE, in /tmp/de-ns-run.log -- which is inside
# the tree, i.e. readable from the Hamnix side as /n/<name>/tmp/de-ns-run.log.
# The failure this replaces was a menu row that did nothing and logged
# nothing on either side of the boundary.
set -u
LOG=/tmp/de-ns-run.log
# NOT `exec 2>>$LOG`. The first version did that, and it swallowed the
# PROGRAM's own stderr along with the shim's -- so the one probe that runs a
# command-line tool through here to prove the namespace was reached printed
# nothing at all on the console, and looked exactly like the failure it was
# there to rule out. The shim's notes go to the log; what the program writes
# is the program's business.
note() { echo "de-ns-run: $*" >> "$LOG"; }
echo "=== de-ns-run $(date 2>/dev/null): $*" >> "$LOG"

[ $# -gt 0 ] || { note "no program given"; echo "de-ns-run: no program given" >&2; exit 2; }

export WAYLAND_DISPLAY="${WAYLAND_DISPLAY:-wayland-0}"

# THE RUNTIME DIRECTORY, WHICH IS THE FOURTH FAULT OF THE FAMILY BELOW AND IS
# NOW FIXED. It used to be the distribution's whole /run -- 40755 uid 0 -- so
# the session could read everything wsyswl publishes there and create nothing.
# `bind '#distro/<name>' /n/<name>' now stages /run/user/<uid> at 0700 owned by
# the session user, at boot, as root, in the same breath as the mount points
# (user/linux-syscalls.c, distro_stage_runtime). That is the standard Linux
# shape and it is NARROWER than what it replaces, not wider.
#
# PREFER IT OVER AN INHERITED VALUE THAT DOES NOT WORK. A caller that exported
# XDG_RUNTIME_DIR=/run is naming a directory it cannot write, and every
# consequence of that is three layers down in someone else's error message; a
# writable directory that exists beats an unwritable one that was inherited.
# An inherited value that IS writable is left alone -- it is a deliberate
# choice by whoever made it.
_xrd="/run/user/$(id -u 2>/dev/null || echo 1001)"
if [ -d "$_xrd" ] && [ -w "$_xrd" ]; then
    case "${XDG_RUNTIME_DIR:-}" in
        "$_xrd") : ;;
        "") XDG_RUNTIME_DIR="$_xrd" ;;
        *)  [ -w "${XDG_RUNTIME_DIR}" ] || {
                note "XDG_RUNTIME_DIR=$XDG_RUNTIME_DIR is not writable by uid $(id -u 2>/dev/null); using $_xrd"
                XDG_RUNTIME_DIR="$_xrd"
            } ;;
    esac
fi
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run}"

# THE DISPLAY SOCKET, NAMED WITH ITS MODE, BEFORE ANYTHING TRIES TO USE IT.
# connect(2) on a unix socket needs WRITE permission on it, and this is the
# one fact that decided whether a menu-launched application could reach the
# display at all. The per-distribution wsyswl runs OUTSIDE this namespace, as
# root, and its socket used to come out `srwxr-xr-x' owned by a uid that is not
# mapped in here -- so `ls -l' showed `nobody nogroup' and the only symptom was
# Xwayland's `could not connect to wayland server'. user/wsyswl.ad now chmods
# it 0666 at creation (docs/linux_distro_namespaces.md 8.5); this line is the
# WITNESS for that, logged from the side that actually has to connect, and it
# does not depend on which hamnix-x11session this distribution ships.
#
# `ls -lL', NOT `ls -l'. $XDG_RUNTIME_DIR is now /run/user/<uid> and the name
# in it is a SYMLINK to the real socket at /run/wayland-0 -- which is how the
# runtime directory moved without the socket moving (user/linux-syscalls.c,
# distro_stage_runtime). `ls -l' on the link prints `lrwxrwxrwx', and the one
# fact this line exists to witness is the MODE OF THE THING connect(2) opens.
# -L follows it and prints `srw-rw-rw-' either way, so the witness says the
# same thing whether the path is a link or the socket itself.
WLSOCK="$XDG_RUNTIME_DIR/$WAYLAND_DISPLAY"
if [ -S "$WLSOCK" ]; then
    note "wayland socket $(ls -lL "$WLSOCK" 2>/dev/null)"
    [ -w "$WLSOCK" ] || {
        note "ERROR $WLSOCK is NOT writable by uid $(id -u 2>/dev/null), and"
        note "  connect(2) needs write. Every client here will fail with"
        note "  \`could not connect to wayland server'. wsyswl chmods the socket"
        note "  0666 at creation -- an old wsyswl, or a socket left by one, does not."
    }
else
    note "WARNING no wayland socket at $WLSOCK; is /etc/rc.distros-wl running a wsyswl for this distribution?"
fi

# THE FOURTH FAULT OF THE SAME FAMILY, NOW FIXED -- AND PROVED BY CREATING A
# FILE, NOT BY READING A MODE. docs/linux_distro_namespaces.md 8.5 names three:
# a mount point in the medium (/n), a stale X lock in its /tmp, and this
# namespace's Wayland socket in its /run -- each created by root when root was
# its only user, each invisible to the unprivileged session that came later.
# The fourth was the DIRECTORY those last two live in. Measured with debugfs on
# both media, before:
#
#     /run          40755 uid 0        <- $XDG_RUNTIME_DIR
#     /run/dbus     40755 uid 0
#     /run/dconf    40700 uid 0
#
# So the session could READ what wsyswl publishes (wayland-0 at 0666, the
# hamnix-screen geometry file at 0644) and CREATE NOTHING. Fixing the socket
# mode fixed CONNECTING and never touched CREATING.
#
# The boot now stages /run/user/<uid> at 0700 owned by the session user, and
# chowns /run/dbus and /run/dconf to it without changing their modes -- root, at
# the one moment it holds the medium, which is where the first fault of this
# family was fixed too (user/linux-syscalls.c, distro_stage_runtime).
#
# WHY THE PROBE WRITES. `[ -w ]` answers from the mode bits, and this whole
# family of faults is a case of the mode bits being read correctly and the
# effective answer still being no -- a uid that is not mapped into the user
# namespace, a sticky /tmp, a read-only medium under HAMLINUX_DISTRO_RO=1. The
# one honest question is whether this uid can create a file here, so ask it that
# way, once, and say the answer either way. NORTH_STAR.md: a gap must never
# answer something success-shaped instead of the truth.
_probe="$XDG_RUNTIME_DIR/.de-ns-run-probe.$$"
if : > "$_probe" 2>/dev/null; then
    note "runtime dir $XDG_RUNTIME_DIR is WRITABLE by uid $(id -u 2>/dev/null): created $_probe"
    note "  ($(ls -ld "$XDG_RUNTIME_DIR" 2>/dev/null))"
    rm -f "$_probe" 2>/dev/null
else
    note "ERROR uid $(id -u 2>/dev/null) CANNOT create a file in XDG_RUNTIME_DIR=$XDG_RUNTIME_DIR"
    note "  ($(ls -ld "$XDG_RUNTIME_DIR" 2>/dev/null)). Reading what wsyswl"
    note "  publishes here works; anything that must CREATE a runtime file --"
    note "  dbus-daemon's session bus, dconf, a toolkit cache -- will not."
    note "  The boot stages /run/user/<uid> (user/linux-syscalls.c,"
    note "  distro_stage_runtime); if it is missing, this tree was posted by a"
    note "  bind that did not run it, or the medium is read-only."
fi
# THE SYSTEM BUS IS A SEPARATE DIRECTORY AND A SEPARATE ANSWER, and conflating
# the two cost a pass. /run/dbus/system_bus_socket is a COMPILE-TIME path in
# dbus; no XDG_RUNTIME_DIR moves it. Getting the runtime directory right fixes
# the SESSION bus and dconf and does nothing at all for the system bus -- which
# is why the boot chowns /run/dbus to the session user as well, since
# hamnix-x11session is what runs `dbus-daemon --system' here and it runs as that
# user. Named separately so a later reader does not have to rediscover that
# these are two facts.
if [ -d /run/dbus ]; then
    _dprobe="/run/dbus/.de-ns-run-probe.$$"
    if : > "$_dprobe" 2>/dev/null; then
        note "/run/dbus is writable by uid $(id -u 2>/dev/null); the system bus can be started here"
        rm -f "$_dprobe" 2>/dev/null
    else
        note "NOTE /run/dbus is NOT writable by uid $(id -u 2>/dev/null)"
        note "  ($(ls -ld /run/dbus 2>/dev/null)); \`dbus-daemon --system' will fail"
        note "  with \`Failed to bind socket .../system_bus_socket: Permission denied'."
    fi
fi
# hamsh hands an entering program "/" as $HOME when it has not resolved a
# passwd entry, and "/" IS a directory, so `[ -d "$HOME" ]` accepts it -- and
# a toolkit then writes its cache into the root of the namespace. Reject the
# placeholder by name, the way tests/linux/hamnix_x11session.sh does.
case "${HOME:-}" in ""|"/") HOME=/home/live ;; esac
[ -d "$HOME" ] || mkdir -p "$HOME" 2>/dev/null || HOME=/root
export HOME

# HAMNIX_DE_XSESSION=0 -- run the program and start nothing. The operator's
# handle, in the shape user/linux-syscalls.c's HAMNIX_NO_USERNS already uses:
# a test that wants to know whether the NAMESPACE was reached should not have
# to pay for an X server to find out, and an X server it did not want is a
# second thing that can fail in the middle of that measurement.
if [ "${HAMNIX_DE_XSESSION:-1}" = "0" ]; then
    note "HAMNIX_DE_XSESSION=0; running the program with no display"
    exec "$@"
fi

# 1. AN X SESSION THIS DISTRIBUTION ALREADY KNOWS HOW TO START WINS.
# scripts/hamlinux_alpine.sh installs /usr/local/bin/hamnix-x11session, and
# tests/linux/steam_gui_run.sh plants the Debian one. Those are the measured
# recipes (Xwayland geometry, the jwm choice, the stale-lock removal); this
# file must not become a second, divergent copy of them.
if [ -x /usr/local/bin/hamnix-x11session ]; then
    # THE ONE THING THAT STOPS IT DEAD, NAMED BEFORE IT HAPPENS. That script
    # writes /tmp/xwayland.log and unlinks /tmp/.X0-lock; a distribution's
    # /tmp is the medium's own, is sticky 1777, and survives reboots -- so a
    # file a ROOT-run session left there can be neither truncated nor unlinked
    # by uid 1001, and the only symptom is `Xwayland FAILED TO START'. The
    # boot clears these (the generated /etc/rc.distros); if one is still here
    # and not ours, say which and why rather than letting it read as an X bug.
    for f in /tmp/xwayland.log /tmp/.X0-lock /tmp/.X11-unix/X0; do
        [ -e "$f" ] || continue
        [ -O "$f" ] && continue
        note "WARNING $f exists and is not ours; uid $(id -u 2>/dev/null) cannot"
        note "  replace it in a sticky /tmp, and Xwayland will fail to start."
        note "  It is left by a ROOT-run X session; /etc/rc.distros clears it at boot."
    done
    note "delegating to /usr/local/bin/hamnix-x11session"
    exec /usr/local/bin/hamnix-x11session "$@" >>"$LOG" 2>&1
fi

# 2. NO WRAPPER. If this distribution has no Xwayland it has no X clients
# either, so the program is a Wayland-native one (or a CLI) and runs as it is.
if ! command -v Xwayland >/dev/null 2>&1; then
    note "no Xwayland in this namespace; running the program directly"
    note "(if it is an X11 client it will fail to open a display and say so)"
    exec "$@"
fi

# 3. A MINIMAL X SESSION. Same shape as the wrappers above, minus their
# per-distribution measurements, because this path is the fallback.
#
# An X server killed by a power cut leaves its lock in the namespace's /tmp,
# which is ON DISK and survives the reboot -- `Server is already active for
# display 0` on every boot afterwards.
if ! DISPLAY=:0 xdpyinfo >/dev/null 2>&1; then
    rm -f /tmp/.X0-lock /tmp/.X11-unix/X0 2>/dev/null
    GEOMOPT=""
    SW=""; SH=""
    if [ -r "$XDG_RUNTIME_DIR/hamnix-screen" ]; then
        read -r SW SH < "$XDG_RUNTIME_DIR/hamnix-screen" || true
    fi
    case "${SW:-}:${SH:-}" in
        [1-9]*:[1-9]*)
            # -geometry only exists from Xwayland 23.1; 22.1.9 dies on it and
            # is exactly the version that does not need it. Ask, do not assume.
            if Xwayland -help 2>&1 | grep -q -- '-geometry'; then
                GEOMOPT="-geometry ${SW}x${SH}"
            fi
            note "X screen ${SW}x${SH}" ;;
        *)  note "WARNING no $XDG_RUNTIME_DIR/hamnix-screen; the X screen size is Xwayland's default, not the display's" ;;
    esac
    # shellcheck disable=SC2086
    Xwayland -shm -noreset $GEOMOPT :0 >/tmp/de-ns-xwayland.log 2>&1 &
    XWPID=$!
    # WAIT FOR THE SERVER, NOT FOR THE SOCKET: a socket file is not a server.
    i=0
    while [ $i -lt 60 ]; do
        DISPLAY=:0 xdpyinfo >/dev/null 2>&1 && break
        kill -0 "$XWPID" 2>/dev/null || break
        i=$((i+1)); sleep 0.25
    done
    if DISPLAY=:0 xdpyinfo >/dev/null 2>&1; then
        note "Xwayland up after $i polls"
    else
        note "Xwayland FAILED TO START -- the program will not get a display"
        tail -12 /tmp/de-ns-xwayland.log >>"$LOG" 2>/dev/null
    fi
else
    note "an X server is already on :0; reusing it"
fi
export DISPLAY=:0

# The window manager. docs/linux_window_manager.md: rootful Xwayland composites
# its clients onto a root window nobody manages, so without one nothing in here
# can be moved, resized, stacked or closed, and _NET_SUPPORTED comes back empty.
if ! xprop -root _NET_SUPPORTING_WM_CHECK 2>/dev/null | grep -q 'window id'; then
    if command -v jwm >/dev/null 2>&1; then
        if [ -r /etc/jwm/hamnix.jwmrc ]; then
            jwm -f /etc/jwm/hamnix.jwmrc >/tmp/de-ns-wm.log 2>&1 &
        else
            jwm >/tmp/de-ns-wm.log 2>&1 &
        fi
        sleep 1
        note "started jwm"
    else
        note "no jwm in this namespace -- the window will not be movable"
    fi
fi

note "exec $*"
"$@" >>"$LOG" 2>&1
rc=$?
note "$1 exited $rc"
exit $rc

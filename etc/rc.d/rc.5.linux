# /etc/rc.d/rc.5.linux — runlevel 5 (graphical) for the Linux line.
#
# Staged into the image as /etc/rc.d/rc.5. It is NOT etc/rc.d/rc.5, Hamnix's
# own, and the difference is worth stating: that one brings the DE up through
# the declarative service supervisor (/etc/services.d/hamuid.svc) and hands
# /dev/fb to the KERNEL scene compositor with `echo desktop > /dev/wsys/ctl`.
# On this line the compositor is a userland program — user/wsysd.ad — so it is
# started here like any other, and the supervisor is not up yet.
#
# What each piece is:
#
#   wsysd            the scene compositor. Reads every window's display list
#                    from /dev/wsys/<wid>/scene, rasterizes it (lib/hamui_host)
#                    and z-blits the screen to /dev/fb. It must be first: it is
#                    what publishes the screen size on /dev/wsys/ctl, which is
#                    how a client knows how big to be.
#   hamdesktop       the wallpaper and the desktop launcher icons. Started
#                    EARLY and deliberately: its full-screen window takes the
#                    LOWEST z, so every later client stacks above it.
#   hampanelscene    the top panel — Applications menu, taskbar, tray, clock.
#
# No app window is auto-opened. A fresh boot is a clean desktop, the same
# decision Hamnix's rc.5 records: a terminal is one double-click away.

echo '[rc.5] hamnix-linux graphical runlevel'

# The compositor. Everything else is a client of it.
#
# Session output goes to /var/log, not to the console. That is not tidiness:
# hampanelscene emits a [panelbeacon] line several times a second, which on a
# shared console buries every other message -- including the ones you need to
# see when an app misbehaves. A desktop session must not compete with the
# system console for a serial line.
/bin/wsysd > /var/log/wsysd.log &
echo '[rc.5] compositor started'

# Give it a moment to read /dev/fb and publish the screen geometry before the
# clients ask for it. A client that starts first still works — it just sizes
# itself to the default until the next frame.
sleep 1

/bin/hamdesktop > /var/log/hamdesktop.log &
echo '[rc.5] desktop backdrop started'

/bin/hampanelscene > /var/log/panel.log &
echo '[rc.5] panel started'

# One Wayland server per distribution namespace, socket inside that
# distribution's own tree at /n/<name>/run/wayland-0. GENERATED from
# /etc/distros by scripts/hamlinux_image.sh, because wsyswl's socket path is
# an argument and the only thing that differs per distribution is the name.
#
# This is what a GUI application launched from the menu's "<Name> apps"
# fly-out connects to: user/hampanelscene.ad spawns
# `/bin/hamsh /etc/rc.de-ns/<name> <prog>`, which exports
# WAYLAND_DISPLAY=wayland-0 and `enter <name> { … }` -- and inside that root,
# /run/wayland-0 is this socket. Without it the app starts, finds no display
# and dies, which is a launcher that does nothing while reporting a launch.
source '/etc/rc.distros-wl'

echo '[rc.5] desktop up'

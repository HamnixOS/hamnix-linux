# /etc/rc.boot.installed — the boot rc for an INSTALLED hamnix-linux system.
#
# Staged onto the root partition as /etc/rc.boot by scripts/hamlinux_disk.sh.
# It differs from etc/rc.boot.linux (the initramfs one) in exactly one way,
# and it is the way Hamnix's own etc/rc.boot differs too: it brings the real
# root online first.
#
#   bind '#sysroot' /
#
# On Hamnix that rebinds the process's root to the rootfs partition's file
# server, which the kernel posted at boot from the partition's `.hamnix-roots`
# sentinel. On this line sys_bind performs the mount itself -- same verb, same
# meaning, one less layer -- and HAMNIX_ROOT names the device. The verb is the
# tree's own, so this file says what it means whichever kernel is underneath.
#
# What has already happened, in user/linuxinit.ad (the Adder PID 1):
#   bind '#p' /proc   bind '#c' /dev   bind '#s' /srv
#   bind '#sys' /sys  bind '#pts' /dev/pts  bind '#/' /n  bind '#t' /tmp
# and the kernel modules from /etc/modules are loaded.

echo 'rc.boot: hamnix-linux (installed)'

# /dev/cons is Hamnix's console device, and the tree writes diagnostics to it
# by name. devtmpfs has no such node.
ln -s /dev/console /dev/cons

# --- the real root ---------------------------------------------------
# ALREADY DONE, by user/linuxinit.ad, before this shell was even exec'd: the
# switch has to happen before /bin/hamsh is loaded, or the shell running this
# script would be the initramfs copy and every command would come from RAM
# rather than from the disk the operator installed. So `bind '#sysroot' /`
# lives in PID 1 here, not in the rc -- the one place this line's boot differs
# in SHAPE from Hamnix's, and it differs because the initramfs exists at all.

# --- the boot log ----------------------------------------------------
# THE STICK KEEPS ITS OWN LOG, AND THIS IS THE ONLY REASON IT CAN.
#
# The owner boots this medium on a Lenovo with no serial cable, no shell and no
# second machine attached. When a boot goes wrong the ONLY evidence that
# survives is a photograph of the screen -- forty lines, in whatever state the
# console left them, quite possibly with the compositor painted over the top.
# On 2026-08-15 that is exactly what happened, and it took a whole investigation
# to establish that the boot had in fact been fine.
#
# So: `bind '#esp' /boot` mounts the FAT32 EFI System Partition OF THE MEDIUM
# THIS MACHINE BOOTED FROM (user/linux-syscalls.c:esp_device finds it by its
# UEFI type GUID, on the disk that carries the root, so it can never write to
# some other disk's ESP -- a laptop's internal drive, with somebody's real
# operating system on it), and bootlogd snapshots the kernel log ring onto it.
# The ring has the shell's output in it as well as the kernel's, because
# consmirror copies every console write into /dev/kmsg at <7>.
#
# FAT32 rather than the ext4 root because he has to be able to READ it: FAT32
# mounts on Windows, macOS and Linux with nothing installed. The file is
# preallocated at build time and overwritten in place with O_SYNC, which is
# what makes it survive the power button and what makes it unable to fill the
# filesystem. All of that is argued in user/bootlogd.ad's header.
#
# IT IS BEFORE THE NETWORK AND BEFORE THE DESKTOP because the whole point is to
# capture what those do -- and because the ring already holds everything that
# happened before this line, so the first snapshot contains the kernel's boot
# and PID 1's namespace setup too.
#
# DETACHED, so PID 1 never waits on it, and every failure below is a message
# and a boot that carries on. A logging facility that can stop a boot is worse
# than no logging facility. try/except for the reason the distro binds below
# give: it is this tree's idiom for a BUILTIN that can fail, and it reacts only
# to the LAST command in the block, so the bind is alone in its own try.
bootlog_esp = 1
try {
    bind '#esp' /boot
} except {
    bootlog_esp = 0
}
if $bootlog_esp > 0 {
    bootlogns = ns {
    }
    bootlogsvc = spawn detached bootlogns {
        bootlogd
    }
    if $status > 0 {
        echo 'rc.boot: FAILED to start bootlogd -- this boot is NOT being logged to the stick'
    }
} else {
    echo 'rc.boot: NO BOOT LOG: the boot medium has no EFI System Partition this'
    echo 'rc.boot: machine could mount, so nothing can be written to the stick.'
    echo 'rc.boot: The boot continues; only the on-medium log is unavailable.'
}

# --- networking ------------------------------------------------------
# DHCP, BECAUSE THE THREE LINES THAT USED TO BE HERE WERE QEMU'S ADDRESSES.
#
# This file pinned eth0 to 10.0.2.15/24 with gateway 10.0.2.2 and DNS 10.0.2.3.
# Those are not defaults and they are not examples: they are the addresses
# QEMU's user-mode network hands out, hardcoded into the boot of every machine
# installed from this tree. On the owner's laptop that configures an address
# nothing routes and a nameserver that does not exist, so the machine comes up
# with networking that is CONFIGURED AND DEAD -- and `hpm update` on it cannot
# reach 255.one, which breaks the standing rule that work published here must
# be updatable on the machine it was installed on.
#
# user/dhcpc.ad is the DHCP client and its own header says exactly this: "A
# real machine does not know its address; it asks. Until something asks,
# hamnix-linux can boot on hardware and be deaf." It is staged on every medium
# (scripts/hamlinux_image.sh:118) and tests/linux/installed_update_live.sh
# already drives it on an installed disk. etc/rc.boot.full made the same call
# for the live boot -- "let DHCP win" -- so this brings the installed boot into
# line with the one that was already right.
#
# IT STILL WORKS IN THE HARNESS, and not by luck: QEMU's user-mode network runs
# a DHCP server that leases 10.0.2.15 with gateway 10.0.2.2 and DNS 10.0.2.3 --
# the very numbers that were hardcoded. So the VM gets what it always got, by
# asking for it, and a real machine gets whatever its own network says.
#
# To pin a static config on a machine that has no DHCP server, the three lines
# are still the ones to write, by hand, after boot:
#   ifconfig eth0 <addr> netmask <mask> / ifconfig gw <gw> / ifconfig dns <dns>
dhcpc
if $status > 0 {
    echo 'rc.boot: DHCP got no lease -- this machine has no network address.'
    echo 'rc.boot: `hpm update` will not reach the repository until one is set:'
    echo 'rc.boot:   ifconfig eth0 <addr> netmask <mask>; ifconfig gw <gw>; ifconfig dns <dns>'
} else {
    echo 'rc.boot: network configured'
}

# --- the distribution namespaces -------------------------------------
# THE PART NOBODY HAD EVER RUN. Every line of the two-namespace work was
# verified on the live/initramfs boot; this file -- the boot of a machine
# somebody actually installed -- had no distribution bind and no `ns clean { }`
# template in it at all, so `enter debian { sh }` on an installed system
# answered `hamsh: enter: linux is not a namespace template`. The subsystem
# the whole design exists to offer did not exist on the only boot that
# persists.
#
# It is the same three things the initramfs boot does, and it is deliberately
# the SAME TEXT: /etc/rc.distros is generated once from /etc/distros by
# scripts/hamlinux_image.sh and copied onto the root partition with everything
# else, so the installed system and the live one cannot drift.
#
# The media themselves are found by ext4 volume LABEL, which is why this works
# at all on a machine with more disks than the live boot had: the installed
# root is whatever this machine calls the partition whose GPT GUID the kernel
# command line names -- /dev/vda2 in QEMU, /dev/sda2 off a USB stick,
# /dev/nvme0n1p2 on a laptop -- and the distribution disks are whatever the
# firmware enumerated around it. A label travels with the filesystem and a
# partition GUID travels with the partition; a /dev name travels with nothing.
# A MACHINE WITH NO DISTRIBUTION MEDIUM IS A SUPPORTED MACHINE, and it is the
# owner's. Every one of these binds fails there -- no attached filesystem
# carries the label /etc/distros names -- and MEASURED on this tree
# (2026-08-15, the shippable medium booted as usb-storage with no Debian disk
# attached at all) hamsh does NOT abort the script on a failed bind: it prints
# the resolver's refusal, returns nonzero, and carries on. rc.5 runs, the
# compositor takes /dev/fb0, and the desktop comes up. So the distribution
# binds are NOT what kept the laptop's screen still; that was the console, and
# it is fixed elsewhere in this commit.
#
# What they DID do is print eight lines of resolver failure into a boot that
# had gone right, on the one machine where those lines are the only thing the
# operator can see. So the outcome is stated once, as a fact about the machine,
# and the two lines that cannot work without a medium are skipped.
# try/except, not `if $status`, because that is this tree's idiom for a BUILTIN
# that can fail -- etc/rc.boot uses it for `bind '#sysroot' /` and says why:
# "bind returns nonzero; try/except swallows the error noise so the boot
# continues", and it "reacts ONLY to the LAST command in the try block", which
# is why the probe is alone in its own try and the action branches on a flag.
distro_medium = 1
try {
    bind '#distro' /n/distro
} except {
    distro_medium = 0
}
if $distro_medium > 0 {
    source '/etc/rc.distros'
} else {
    echo 'rc.boot: no distribution medium on this machine -- `enter debian` and'
    echo 'rc.boot: `enter alpine` are unavailable. Everything else is up.'
}
linux = ns clean {
    bind '#distro/debian' /
    bind '#c' /dev
    bind '#p' /proc
    bind '#s' /srv
    bind '#/' /n
}

# --- the desktop -----------------------------------------------------
# After the binds, not before: the panel scans /n/<name> at startup, so a
# desktop brought up first has no distribution sections in its menu.
source '/etc/rc.d/rc.5'

echo 'rc.boot: up'

# WHERE THE LOG IS, SAID ON THE SCREEN, AT THE END, WHERE HE WILL PHOTOGRAPH IT.
#
# A log nobody knows about is a log nobody reads. This is the last thing the
# console says before the desktop takes the screen, so it is in the photograph
# of a boot that went right AND in the photograph of one that got this far and
# then went wrong -- which is precisely the case where the file matters and
# where nothing else would have told him it exists.
#
# It is printed unconditionally rather than only when bootlogd started, because
# the failure branch above has already said, in its own words, that there is no
# log; these two lines say what to do when there is one, and the two together
# read correctly in either order on a screen.
if $bootlog_esp > 0 {
    echo 'rc.boot: THIS BOOT IS BEING LOGGED TO THE STICK. If anything goes wrong,'
    echo 'rc.boot: hold the power button, plug this stick into another computer,'
    echo 'rc.boot: and open HAMNIX.LOG in the top of its FAT boot partition.'
}

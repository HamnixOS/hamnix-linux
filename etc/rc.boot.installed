# /etc/rc.boot.installed — the boot rc for an INSTALLED hamnix-linux system.
#
# Staged onto the root partition as /etc/rc.boot by scripts/hamlinux_disk.sh.
# It differs from etc/rc.boot.linux (the initramfs one) in exactly one way,
# and it is the way Hamnix's own etc/rc.boot differs too: it brings the real
# root online first.
#
#   bind '#sysroot' /
#
# On Hamnix that rebinds the process's root to the rootfs partition's file
# server, which the kernel posted at boot from the partition's `.hamnix-roots`
# sentinel. On this line sys_bind performs the mount itself -- same verb, same
# meaning, one less layer -- and HAMNIX_ROOT names the device. The verb is the
# tree's own, so this file says what it means whichever kernel is underneath.
#
# What has already happened, in user/linuxinit.ad (the Adder PID 1):
#   bind '#p' /proc   bind '#c' /dev   bind '#s' /srv
#   bind '#sys' /sys  bind '#pts' /dev/pts  bind '#/' /n  bind '#t' /tmp
# and the kernel modules from /etc/modules are loaded.

echo 'rc.boot: hamnix-linux (installed)'

# /dev/cons is Hamnix's console device, and the tree writes diagnostics to it
# by name. devtmpfs has no such node.
ln -s /dev/console /dev/cons

# --- the real root ---------------------------------------------------
# ALREADY DONE, by user/linuxinit.ad, before this shell was even exec'd: the
# switch has to happen before /bin/hamsh is loaded, or the shell running this
# script would be the initramfs copy and every command would come from RAM
# rather than from the disk the operator installed. So `bind '#sysroot' /`
# lives in PID 1 here, not in the rc -- the one place this line's boot differs
# in SHAPE from Hamnix's, and it differs because the initramfs exists at all.

# --- networking ------------------------------------------------------
# Static, and named here rather than hidden: the kernel's own ip=dhcp runs
# before the initramfs has loaded virtio_net, and a DHCP client is a program
# this line does not have yet. On a real machine these are the three lines to
# change.
ifconfig eth0 10.0.2.15 netmask 255.255.255.0
ifconfig gw 10.0.2.2
ifconfig dns 10.0.2.3
echo 'rc.boot: network configured'

# --- the distribution namespaces -------------------------------------
# THE PART NOBODY HAD EVER RUN. Every line of the two-namespace work was
# verified on the live/initramfs boot; this file -- the boot of a machine
# somebody actually installed -- had no distribution bind and no `ns clean { }`
# template in it at all, so `enter debian { sh }` on an installed system
# answered `hamsh: enter: linux is not a namespace template`. The subsystem
# the whole design exists to offer did not exist on the only boot that
# persists.
#
# It is the same three things the initramfs boot does, and it is deliberately
# the SAME TEXT: /etc/rc.distros is generated once from /etc/distros by
# scripts/hamlinux_image.sh and copied onto the root partition with everything
# else, so the installed system and the live one cannot drift.
#
# The media themselves are found by ext4 volume LABEL, which is why this works
# at all on a machine with more disks than the live boot had: the installed
# root is whatever this machine calls the partition whose GPT GUID the kernel
# command line names -- /dev/vda2 in QEMU, /dev/sda2 off a USB stick,
# /dev/nvme0n1p2 on a laptop -- and the distribution disks are whatever the
# firmware enumerated around it. A label travels with the filesystem and a
# partition GUID travels with the partition; a /dev name travels with nothing.
bind '#distro' /n/distro
source '/etc/rc.distros'
linux = ns clean {
    bind '#distro/debian' /
    bind '#c' /dev
    bind '#p' /proc
    bind '#s' /srv
    bind '#/' /n
}

# --- the desktop -----------------------------------------------------
# After the binds, not before: the panel scans /n/<name> at startup, so a
# desktop brought up first has no distribution sections in its menu.
source '/etc/rc.d/rc.5'

echo 'rc.boot: up'

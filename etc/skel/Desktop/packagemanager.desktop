[Desktop Entry]
Type=Application
Name=Software
Comment=Browse, search, install, remove and upgrade software packages (hpm front-end)
Exec=/bin/hamsoftware
Icon=system-software-install
Categories=System;Administration;
# THE MACHINE'S OWN PROGRAM, not the person's: it writes outside the
# person's home and cannot work as the session user. The desktop chrome
# launches it with the chrome's identity instead of dropping privilege.
# See lib/desktopentry.ad:_de_chrome for why this is a key in this file
# rather than a list of program names in the launcher.
X-Hamnix-SystemChrome=true

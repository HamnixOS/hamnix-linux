home/%USER%/Desktop/hamwrite.desktop    /etc/skel/Desktop/hamwrite.desktop
etc/skel/Desktop/hamwrite.desktop    /etc/skel/Desktop/hamwrite.desktop
home/%USER%/Desktop/installer.desktop    /etc/skel/Desktop/installer.desktop
etc/skel/Desktop/installer.desktop    /etc/skel/Desktop/installer.desktop

# /etc/install/live.manifest — generated by
# scripts/gen_install_manifest.py at image build time.
#
# `%USER%` in a TARGET path is replaced by the install user's
# login name (install_rootfs_from_manifest argv[3]).
# Sources are read off the live medium's cpio /etc/skel.

home/%USER%/Desktop/audioplayer.desktop    /etc/skel/Desktop/audioplayer.desktop
etc/skel/Desktop/audioplayer.desktop    /etc/skel/Desktop/audioplayer.desktop
home/%USER%/Desktop/calculator.desktop    /etc/skel/Desktop/calculator.desktop
etc/skel/Desktop/calculator.desktop    /etc/skel/Desktop/calculator.desktop

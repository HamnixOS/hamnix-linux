# --- man pages (the discovery system) ---
# etc/man/*.md is staged into the live cpio at
# /usr/share/man/ (scripts/build_initramfs.py). No hpm
# package carries them, so before this the installed
# system had NO man pages at all while the live one had
# every topic — `man <topic>` silently died on install.
usr/share/man/cat.1.md    /usr/share/man/cat.1.md
usr/share/man/cp.1.md    /usr/share/man/cp.1.md
usr/share/man/df.1.md    /usr/share/man/df.1.md
usr/share/man/dmesg.1.md    /usr/share/man/dmesg.1.md
usr/share/man/du.1.md    /usr/share/man/du.1.md
usr/share/man/find.1.md    /usr/share/man/find.1.md
usr/share/man/fstab.5.md    /usr/share/man/fstab.5.md
usr/share/man/hamsh.1.md    /usr/share/man/hamsh.1.md
usr/share/man/help.1.md    /usr/share/man/help.1.md
usr/share/man/host.1.md    /usr/share/man/host.1.md
usr/share/man/hpm.1.md    /usr/share/man/hpm.1.md
usr/share/man/ifconfig.1.md    /usr/share/man/ifconfig.1.md
usr/share/man/install.hamsh.8.md    /usr/share/man/install.hamsh.8.md
usr/share/man/ls.1.md    /usr/share/man/ls.1.md
usr/share/man/man.1.md    /usr/share/man/man.1.md
usr/share/man/newshell.1.md    /usr/share/man/newshell.1.md
usr/share/man/ping.1.md    /usr/share/man/ping.1.md
usr/share/man/ps.1.md    /usr/share/man/ps.1.md
usr/share/man/read.1.md    /usr/share/man/read.1.md
usr/share/man/svc.1.md    /usr/share/man/svc.1.md
usr/share/man/top.1.md    /usr/share/man/top.1.md

# --- man pages (discovery system) ---
# Source bytes live in etc/man/ in the Hamnix tree;
# scripts/build_initramfs.py stages them into the cpio
# at /usr/share/man/. The live ISO therefore exposes
# every page at that path (the kernel cpio is mounted
# as the root tmpfs name lookup), so the manifest can
# source them from /usr/share/man/<topic>.<N>.md and
# write them to the target ext4 at the same path.
usr/share/man/cat.1.md    /usr/share/man/cat.1.md
usr/share/man/cp.1.md    /usr/share/man/cp.1.md
usr/share/man/df.1.md    /usr/share/man/df.1.md
usr/share/man/dmesg.1.md    /usr/share/man/dmesg.1.md

# /etc/install/rootfs.manifest — generated by
# scripts/gen_install_manifest.py at ISO build time.
#
# Format: <target_path> <source_path>
# Comments + blank lines ignored.
#
# Read by /bin/install_rootfs_from_manifest, which
# routes each entry through the kernel's install_file
# ctl verb on the target /dev/blk/<dev>/ctl.

# Plan 9 sentinel (mount_rootfs_partition reads this)
.hamnix-roots    /n/distros/.hamnix-roots


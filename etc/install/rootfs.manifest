# --- /etc/skel home skeleton ---
# The standard per-user home template. Source bytes
# live at etc/skel/ in the Hamnix tree; build_initramfs.py
# stages them into the cpio at /etc/skel/*, so we source
# from the live cpio (like the man pages above), not the
# rootfs partition. This puts /etc/skel on the installed
# system for any FUTURE useradd/adduser; the wizard's own
# install user gets its home populated directly by
# user/install.ad::provision_target.
etc/skel/Desktop/audioplayer.desktop    /etc/skel/Desktop/audioplayer.desktop
etc/skel/Desktop/calculator.desktop    /etc/skel/Desktop/calculator.desktop
etc/skel/Desktop/calendar.desktop    /etc/skel/Desktop/calendar.desktop
etc/skel/Desktop/control-center.desktop    /etc/skel/Desktop/control-center.desktop
etc/skel/Desktop/editor.desktop    /etc/skel/Desktop/editor.desktop
etc/skel/Desktop/files.desktop    /etc/skel/Desktop/files.desktop
etc/skel/Desktop/hamsheet.desktop    /etc/skel/Desktop/hamsheet.desktop
etc/skel/Desktop/hamslides.desktop    /etc/skel/Desktop/hamslides.desktop
etc/skel/Desktop/hamwrite.desktop    /etc/skel/Desktop/hamwrite.desktop
etc/skel/Desktop/installer.desktop    /etc/skel/Desktop/installer.desktop
etc/skel/Desktop/logviewer.desktop    /etc/skel/Desktop/logviewer.desktop
etc/skel/Desktop/notes.desktop    /etc/skel/Desktop/notes.desktop
etc/skel/Desktop/packagemanager.desktop    /etc/skel/Desktop/packagemanager.desktop
etc/skel/Desktop/sysmon.desktop    /etc/skel/Desktop/sysmon.desktop
etc/skel/Desktop/terminal.desktop    /etc/skel/Desktop/terminal.desktop
etc/skel/Desktop/videoplayer.desktop    /etc/skel/Desktop/videoplayer.desktop
etc/skel/Documents/.keep    /etc/skel/Documents/.keep
etc/skel/Documents/welcome.txt    /etc/skel/Documents/welcome.txt
etc/skel/Downloads/.keep    /etc/skel/Downloads/.keep
etc/skel/Pictures/.keep    /etc/skel/Pictures/.keep

